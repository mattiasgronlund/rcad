    cuts=(reset-instead:1 reset-as-well:2 no-refusal:3 untyped-verifier:4 no-merger-file:4 merges-at-once:5 push-unchecked:6 lane-pushes:6 missing-claude-rule:7 duplicate-rule:7 no-own-tree-script:8 no-own-tree-doc:8 no-mutation-verdict:9 pins-inferred:10 pins-no-refusal:10 pins-no-conflict:10 pins-verify-missing:10 no-foreground-rule:11 merger-backgrounds:11 prune-unguarded:12 prune-command-drifts:12 no-mark-line:12 no-verified-def:13 verified-merge-only:13 verified-not-returned:13 no-docs-diff:14 no-docs-constant:14 no-docs-bound:14 no-docs-field:14 docs-count-optional:14 no-pass-rule:15 no-pass-rule-doc:15 runs-not-handed:16 runs-waive-any:16 runs-no-refusal:16 runs-unreported-ok:16 runs-any-command:16 runs-optional:16 runs-old-md-rule:16 runs-no-md-rule:16 runs-src-is-test:16 runs-test-never-ends:16 runs-shebang-is-comment:16 runs-nothing-is-silent:16 runs-uncounted:16 runs-count-loose:16 runs-diff-narrow:16 runs-uncapped:17 notes-unbounded:17 notes-unsaid:17 untyped-lander:4 no-lander-file:4 lander-pushes:6 lander-backgrounds:11 lands-a-fix-first:18 lands-everything:18 stop-ends-the-row:18 throw-ends-the-row:18 merger-takes-the-landers-branch:18 merges-twice:18 merges-twice-doc:18 land-command-drifts:18 verify-not-handed:19 verify-no-wait:19 value-unsaid:19 lane-value-unsaid:19 verifier-by-hand:19 record-renamed:19 same-record-unread:19 same-inferred:20 same-with-pins:20 same-names-a-failing-test:20 same-names-nothing:20 same-no-revert:20 same-no-mutation:20 same-any-mutation:20 same-no-steps:20 same-unpointed:20 gate-ignored:18 gate-check-missing:21 gate-reason-missing:21 relay-unbounded:22 relay-no-bound:22 relay-past-the-bound-verified:22 relay-refusal-ignored:22 relay-from-anywhere:22 relay-not-switched:22 relay-trees-forgotten:22 relay-not-an-outcome:22 relay-unsaid:22 relay-holds-the-branch:22 test-not-first:22 hand-over-left-to-lane-md:22 hand-over-unsaid:22 no-prep-file:4 untyped-prep:4 prep-writes:23 prep-on-opus:23 prep-skipped:24 needs-starts-a-lane:24 needs-read-as-ok:24 needs-not-returned:24 model-from-lane:25 write-set-widened:25 model-unchecked:25 both-marks-from-prep:25 both-forms-allowed:26 no-rows-note:27 no-tests-note:27 no-tests-note-recipe:27 no-report-default:27 dnr-not-an-outcome:28 dnr-unsaid:28 dnr-skips-verifier:29 dnr-after-verify-false:29 dnr-lands:29 dnr-no-steps:29 dnr-refused-merges:30 dnr-close-unsaid:30 readonly-no-rows:31 share-guard-missing:32 share-message-missing:32 answers-not-landed:33 answers-unconfirmed:33 answers-not-asked:33 answers-not-told:33 answers-lane-unsaid:33 answers-prep-unsaid:33 answers-verifier-unsaid:33 answers-merger-unsaid:33 dnr-rows-ignored:34 dnr-blocked-unsaid:34)
    for cut in "${cuts[@]}"; do
        name=${cut%:*}
        want=${cut#*:}
        if cmp -s "$file" "$dir/$name/lanes.js" && diff -rq "$agents" "$dir/$name/agents" > /dev/null \
            && cmp -s "$claude" "$dir/$name/CLAUDE.md" && cmp -s "$recipes" "$dir/$name/justfile" \
            && cmp -s "$script" "$dir/$name/verify_lane.py"; then
            echo "the cut '$name' found nothing to cut in $file, $agents, $claude, $recipes or $script, so it proves nothing"
            exit 1
        fi
        got=0
        scan "$dir/$name/lanes.js" "$dir/$name/agents" "$dir/$name/CLAUDE.md" "$dir/$name/justfile" "$dir/$name/verify_lane.py" > /dev/null || got=$?
        if [ "$got" != "$want" ]; then
            echo "the cut '$name' was caught by arm $got, expected arm $want"
            exit 1
        fi
    done
    echo "lanes.js makes each lane's branch with switch -c and resets none, types every agent, merges one lane at a time, lands through the lander only a merge with rows, hands the verifier just verify-lane, relays a lane past its budget to a fresh one, briefs a short-form lane through prep and starts no lane on anything but ok, closes a row whose fault no longer shows only on its verifier's confirm, closes the rows a fix lane also answers only on its verifier's word, and prunes only what merged; ${#cuts[@]} cuts, each caught"

# Print the changed lines between two commits that could change what runs:
# everything but `.md` files, comment lines, and test code -- files under
# `crates/*/tests/` and `fuzz/corpus/`, the items after a column-0
# `#[cfg(test)]` in a `.rs` file, and the bodies of the justfile's `check-*`
# recipes. The `lanes` workflow's verifier runs it on a lane's branch, and a
# print that ends `lines that run: 0` lets the lane merge without a revert
# (§375).
#
# It reads the whole-file diff, so it sees each `#[cfg(test)]` and each recipe
# header above a changed line. The prefixes and the flags are spelled out so no
# one's git config can change what it reads.
#
# **It prints the first ten lines, then how many there are** (§382). A verifier
# copies the print into its report, and before the cap one ran to 199 lines.
# The count line is always printed, so there is no empty print for a verifier to
# report: Q708's verifier wrote one as the two characters `""`, and `lanes.js`
# read that as lines that run.
#
# It is a recipe so a verifier types and reports a short command, not 1.6 KB of
# git and awk: Q753's verifier reported the awk as a paraphrase of it, and its
# merge was refused for that. A verifier runs it before it checks the branch out, so the
# copy of this recipe that judges a branch is never one the branch changed.
[doc("Print the first ten changed lines between two commits that could change what runs, then how many there are.")]
lines-that-run base branch:
    #!/usr/bin/env bash
    set -euo pipefail
    git diff --no-color --no-ext-diff -M --src-prefix=a/ --dst-prefix=b/ -U1000000 "$1" "$2" \
        | awk 'function show(line) { if (++shown <= 10) print line } function test_path(p) { return p ~ /^crates\/[^\/]+\/tests\// || p ~ /^fuzz\/corpus\// } function rust_test(s, c) { if (in_test[s]) { if (c ~ /^}/) in_test[s] = 0; return 1 } if (c ~ /^([ \t]|$)/) return 0; if (c ~ /^#\[cfg\(test\)\][ \t]*$/) { pending[s] = 1; return 0 } if (c ~ /^(\/\/|#\[)/) return 0; if (pending[s]) { pending[s] = 0; in_test[s] = c ~ /\{[ \t]*$/; return 1 } return 0 } function recipe_test(s, c) { if (c ~ /^([ \t]|$)/) return in_check[s]; in_check[s] = c ~ /^@?check-[A-Za-z0-9_-]+[^:]*:([^=]|$)/; return 0 } /^diff --git / { seen = 1; hunk = 0; a = $3; b = $4; sub(/^a\//, "", a); sub(/^b\//, "", b); skip = (a ~ /\.md$/ && b ~ /\.md$/) || (test_path(a) && test_path(b)); rust = b ~ /\.rs$/; slash = b ~ /\.(rs|js)$/; just = b ~ /(^|\/)justfile$/; hash = just || b ~ /\.(toml|sh|py|ya?ml)$/; for (s = 0; s < 2; s++) { pending[s] = 0; in_test[s] = 0; in_check[s] = 0 } next } skip { next } /^@@/ { hunk = 1; next } !hunk { if ($0 ~ /^(rename (from|to)|old mode|new mode|Binary files)/) show(b ": " $0); next } /^\\/ { next } { m = substr($0, 1, 1); c = substr($0, 2); for (s = 0; s < 2; s++) { if (m == (s ? "-" : "+")) continue; t[s] = rust ? rust_test(s, c) : (just ? recipe_test(s, c) : 0) } if (m == " ") next; if (t[m == "+"]) next; if (slash && c ~ /^[ \t]*(\/\/.*)?$/) next; if (hash && c ~ /^[ \t]*(#([^!].*)?)?$/) next; show(b ": " m c) } END { if (!seen) { print "git diff printed nothing, so it shows nothing"; exit 1 } print "lines that run: " (shown + 0) }'

# kache must be the wrapper here and no wrapper on a runner (`mise.toml`).
#
# Both halves are asserted, because each one alone passes for the wrong reason.
# Checking only the CI half passes if somebody deletes the variable outright,
# which would turn the cache off for every human as well. Checking only the
# local half passes on the state that kept CI red for ten pushes.
#
# It asks mise rather than reading the file, because the file is a template and
# what breaks CI is the value mise computes, not the text. That also means this
# fails if the template stops parsing, which the eye does not catch.
#
# **It asks by running a process under mise, not by parsing `mise env`.** Until
# 2026-09-20 it sed'd `^export RUSTC_WRAPPER=` out of `mise env`; mise 2026.9.11
# no longer prints that line in that shape, and this machine's 2026.7.5 does. So
# in a fresh container both halves extracted the empty string: the CI half passed
# vacuously — the one direction that took CI red for ten pushes — and the local
# half failed saying `RUSTC_WRAPPER is ''`, which reads as a broken template and
# was nothing of the sort. `mise exec` is the thing the gate actually relies on,
# and its answer is a value rather than a format. `docs/decisions.md` §173.8.
[doc("kache wraps rustc here, and wraps nothing on a runner.")]
check-kache-off-on-ci:
    @on=$(CI=true mise exec -- sh -c 'echo "${RUSTC_WRAPPER-}"'); \
    off=$(env -u CI mise exec -- sh -c 'echo "${RUSTC_WRAPPER-}"'); \
    if [ -n "$on" ]; then \
        echo "with CI set, RUSTC_WRAPPER is '$on' and should be empty"; \
        echo "mise applies [env] while installing [tools], so cargo would be asked"; \
        echo "to run kache in order to build kache, and every install fails"; \
        exit 1; \
    fi; \
    if [ "$off" != "kache" ]; then \
        echo "off CI, RUSTC_WRAPPER is '$off' and should be kache"; \
        echo "the build cache is now off for everyone, which is not what was wanted"; \
        exit 1; \
    fi

# `gate` runs `check`, `lint`, `test`, `test-slow`, `deny` and every `check-*`
# there is, which is what "the whole gate" in CLAUDE.md promises and so is a
# claim that wants a test (§15.6).
#
# Since 2026-09-07 CI runs `gate` itself rather than those four separately,
# which makes this recipe the thing that carries a new `check-*` onto the runner:
# wire one into `gate` and it is enforced there with no edit to `ci.yml`.
#
# The failure it is really for is the other direction: a `check-*` recipe
# written, committed and never wired into `gate` is a check nobody runs, and
# nothing else in this tree would notice. That has never happened, which is not
# the same as being prevented.
#
# The count is pinned rather than left to the comparison, and that is the whole
# design. Both sides are parsed out of this one file, so an extraction that
# stops matching empties both at once and two empty sets compare equal — the
# recipe would pass having compared nothing, and an empty diff prints nothing,
# which reads exactly like success. `check-ignored` says the same thing about
# itself a hundred lines up. It is not hypothetical, and it has now happened:
# renaming `default` to `gate` broke the anchor on the second line below, the
# pinned count is what turned that into a failure rather than a silent pass, and
# both arms were re-checked by mutation afterwards rather than by running green.
# The anchor moved a second time when `gate` stopped being a dependency list and
# its steps became `gate_steps`, so that a failing gate could still print a
# summary; the count caught that move too.
#
# So bumping the number is how a new `check-*` recipe gets added, deliberately,
# in the commit that adds it.
#
# Another arm pins `check-plugins` **first**, which the three above could not:
# both sides of every comparison here are `sort -u`, so this recipe was blind to
# order by construction. CLAUDE.md says check-plugins is the first failure the
# summary block names when a plugin is missing, and `ci.yml` leans on it, and a
# published claim wants a test (§15.6) — it had none, and `check-plugins` ran
# first only because of where it happened to sit.
#
# What the order buys is the error message. Without plugins `check-plugins` exits
# 1 and names the install command, while `check-hooks` and
# `check-questions-selftest` exit **127** on a missing `selftest.sh` — no
# message, no remedy, and the failure a CI log explains worst. Found by rcad-c2,
# who also noticed that nothing held the ordering it depends on. Since the steps
# run at once (§372) all three fail, and the order is what makes the block name
# `check-plugins` first and print its tail.
#
# **The arm after it holds `gate`'s `cargo_steps` line to the steps whose recipes
# run cargo.** Those run one after another, and one left off the line would wait
# on cargo's lock beside `test`: slower, never wrong, so nothing else would
# notice (§372.10). A recipe runs cargo if a line of it, not a comment, starts a
# command with `cargo` and a subcommand that builds, or calls the `t` recipe. The
# line is read out of `just --show gate`, and an empty read fails, for the
# reason the count above is pinned.
#
# **The last arm holds `test` ahead of `check-t-selftest` in `gate_steps`.** The
# arm above compares the chain as a set, but the chain runs in `gate_steps`
# order, and `check-t-selftest` needs the binaries `test` builds (§372.10).
[doc("Every check-* recipe is in `gate`, check-plugins is first, every step that builds with cargo is in gate's chain, and check-t-selftest comes after test.")]
check-gate-runs-every-check:
    @steps=$(printf '%s\n' {{ gate_steps }}); \
    defined=$(grep -oE '^check-[a-z0-9-]+' justfile | sort -u); \
    listed=$(printf '%s\n' "$steps" | grep '^check-' | sort -u); \
    others=$(printf '%s\n' "$steps" | grep -v '^check-' | grep . | sort -u | tr '\n' ' '); \
    n=$(printf '%s\n' "$defined" | grep -c .); \
    if [ "$n" != "62" ]; then \
        echo "found $n check-* recipes, expected 62"; \
        echo "if you added or removed one, change the number here in the same commit"; \
        echo "if you found none, the parse broke and this recipe just compared nothing"; \
        exit 1; \
    fi; \
    if [ "$defined" != "$listed" ]; then \
        echo "these check-* recipes are defined but not run by gate:"; \
        printf '%s\n' "$defined" | while read -r r; do \
            printf '%s\n' "$listed" | grep -qx "$r" || echo "  $r"; \
        done; \
        echo "a check nobody runs is not a check"; \
        exit 1; \
    fi; \
    if [ "$others" != "check deny lint test test-slow " ]; then \
        echo "gate's non-check-* recipes are '$others', expected 'check deny lint test test-slow '"; \
        echo "gate runs these five and every check-* besides: test-slow is the slow tier,"; \
        echo "which test leaves out (docs/decisions.md §397.4)"; \
        echo "a step added or taken out changes this pin in the same commit"; \
        exit 1; \
    fi; \
    decl=$(awk '/^gate_steps := /{f=1} f{print} f && !/\\$/{exit}' justfile); \
    lines=$(printf '%s\n' "$decl" | grep -c .); \
    steps_n=$(printf '%s\n' "$steps" | grep -c .); \
    if [ "$lines" != "$steps_n" ]; then \
        echo "gate_steps is $steps_n steps written on $lines source lines"; \
        echo "one step per line is what stops two lanes adding two checks from"; \
        echo "conflicting: git merges by line, and as one line this was the worst"; \
        echo "merge shape in the repo (docs/decisions.md §177)"; \
        exit 1; \
    fi; \
    first=$(printf '%s\n' "$steps" | grep -m1 .); \
    if [ "$first" != "check-plugins" ]; then \
        echo "gate names '$first' first, expected 'check-plugins'"; \
        echo "CLAUDE.md says check-plugins is the first failure the summary"; \
        echo "block names, and ci.yml leans on it: with no plugins, check-hooks and"; \
        echo "check-questions-selftest exit 127 on a missing selftest.sh, which is"; \
        echo "the failure a runner explains worst, while check-plugins exits 1 and"; \
        echo "names the command that installs them"; \
        exit 1; \
    fi; \
    chain=$({{ just_executable() }} --show gate | sed -n 's/^ *cargo_steps="\(.*\)"$/\1/p' | tr ' ' '\n' | grep . | sort); \
    if [ -z "$chain" ]; then \
        echo "found no cargo_steps line in just --show gate, so the arm below would compare nothing"; \
        exit 1; \
    fi; \
    builds='(^[[:space:]]*@?|\$\(|&& *|; *|! *)([A-Z_]+=[^ ]* +)*cargo +(\+[a-z]+ +)?(build|check|clippy|nextest|test|run|bench|doc|llvm-cov|fuzz)( |$)|just_executable\(\) *\}\} +t( |$)'; \
    cargo=$(for step in $steps; do \
        {{ just_executable() }} --show "$step" | grep -v '^ *#' | grep -qE "$builds" && echo "$step"; \
    done | sort); \
    if [ "$cargo" != "$chain" ]; then \
        echo "gate's cargo_steps line and the steps whose recipes run cargo disagree:"; \
        for step in $cargo; do printf '%s\n' "$chain" | grep -qx "$step" || echo "  $step runs cargo and is not on the line"; done; \
        for step in $chain; do printf '%s\n' "$cargo" | grep -qx "$step" || echo "  $step is on the line and its recipe builds nothing with cargo"; done; \
        echo "a cargo step off the line waits on cargo's lock beside test (docs/decisions.md §372.10)"; \
        exit 1; \
    fi; \
    test_at=$(printf '%s\n' "$steps" | grep -n -x 'test' | head -1 | cut -d: -f1); \
    t_selftest_at=$(printf '%s\n' "$steps" | grep -n -x 'check-t-selftest' | head -1 | cut -d: -f1); \
    if [ -n "$test_at" ] && [ -n "$t_selftest_at" ] && [ "$t_selftest_at" -lt "$test_at" ]; then \
        echo "check-t-selftest is at line $t_selftest_at of gate_steps, test is at line $test_at"; \
        echo "check-t-selftest needs the binaries test built, so it must come after"; \
        echo "test in gate_steps (docs/decisions.md §372.10)"; \
        exit 1; \
    fi

# Holds `gate-lane` to its callers: `lane.md`, `verifier.md` and
# `verify_lane.py` (§397.4). Everything else runs the whole gate. A caller that
# took `gate-lane` up wrongly would put code on `main` that the slow tier never
# read, and nothing else would notice, since a lane's gate passes like any
# other.
#
# In the justfile a line naming it is allowed in `gate-lane`, in this recipe and
# in a `*-selftest`, and anywhere as a comment or an attribute, which run
# nothing. `docs/` is left out, since the decisions talk about it. The
# justfile, `lane.md` and `verify_lane.py` must each name it, or the search
# found nothing and this compared nothing.
#
# **Not in `gate_reusable_steps`**, because it reads `.md` files and the
# fingerprint leaves those out: a served copy would never see the commit that
# broke it. `dir` is the repository to search, so the selftest can hand it a
# fixture.
[doc("Only lane.md, verifier.md and verify_lane.py call gate-lane; everything else runs the whole gate.")]
check-gate-lane-callers dir=".":
    #!/usr/bin/env bash
    set -euo pipefail
    word='(^|[^A-Za-z0-9_-])gate-lane([^A-Za-z0-9_-]|$)'
    rc=0
    files=$(git -C "{{ dir }}" grep -l -E "$word" -- ':!docs/') || rc=$?
    if [ "$rc" -gt 1 ]; then
        echo "git grep failed in {{ dir }} with exit $rc, so this checked nothing"
        exit 1
    fi
    wrong=0
    while read -r file; do
        case "$file" in
            ''|justfile|.claude/agents/lane.md|.claude/agents/verifier.md|tooling/verify-lane/verify_lane.py) ;;
            *) echo "$file names gate-lane, and only lane.md, verifier.md and verify_lane.py may call it"; wrong=1 ;;
        esac
    done <<<"$files"
    for needed in justfile .claude/agents/lane.md tooling/verify-lane/verify_lane.py; do
        grep -qxF "$needed" <<<"$files" \
            || { echo "$needed does not name gate-lane, so the search found less than it must and compared nothing"; wrong=1; }
    done
    stray=$(awk -v word="$word" '
        /^[A-Za-z_@]/ { item = $0; sub(/^@/, "", item); sub(/[^A-Za-z0-9_-].*/, "", item) }
        /^\[/ || /^[[:space:]]*#/ { next }
        $0 ~ word && item != "gate-lane" && item != "check-gate-lane-callers" && item !~ /-selftest$/ {
            print "  justfile:" NR ", in " item ": " $0
        }' "{{ dir }}/justfile")
    if [ -n "$stray" ]; then
        echo "the justfile names gate-lane outside gate-lane, this check and the selftests:"
        echo "$stray"
        wrong=1
    fi
    if [ "$wrong" -ne 0 ]; then
        echo "everything but a lane and its verifier runs the whole gate, slow tier and all (docs/decisions.md §397.4)"
        exit 1
    fi
    echo "gate-lane is called only from lane.md, verifier.md and verify_lane.py"

[doc("Every public enum is #[non_exhaustive] or says it is exhaustive on purpose.")]
check-enums:
    @! awk '/^$/ {ok = 0} \
            /^#\[non_exhaustive\]/ {ok = 1} \
            /Exhaustive on purpose/ {ok = 1} \
            /^[ \t]*pub enum/ {if (!ok) print FILENAME ":" FNR ": " $0; ok = 0}' \
            $(find crates -path '*/src/*' -name '*.rs') | grep . \
        || (echo "^ a public enum that neither grows nor says why not (docs/decisions.md §40)"; exit 1)

# Where `decisions-toc`, `decision` and the rest read from: one file per `## N.`
# section, named `NNN-<slug>.md` for the number it is cited as, plus
# `00-preamble.md` for the fifteen lines that stood above `## 0.`. A variable so
# the selftest below can point them at fixtures rather than at whatever the real
# sections happen to say today.
#
# **The preamble is two digits and a section is three, and that is the whole
# scheme.** Both wanted to be `000-`: the preamble comes first and §0 is a real
# section whose number is 0. Two digits sorts before three under byte order
# (`-` is 0x2D, below `0`), which is what `LC_ALL=C sort` gives, and it is the
# one distinction a filename can carry that `just decision 0` does not have to
# know about — the lookup matches three digits, so the preamble is invisible to
# it rather than special-cased in it.
#
# **Every listing here sorts under `LC_ALL=C`**, and that is not decoration: a
# plain `ls` collates under the user's locale, which ignores `-` entirely, and
# then `00-preamble.md` lands between `009-` and `010-` — which is exactly where
# the first attempt at this put it, silently, and the concatenation came back
# 15 lines out of order.
decisions_dir := "docs/decisions.d"

# The pointer file. Every citation in the tree spells `docs/decisions.md §N` and
# still does after the split (§179), so the path keeps its name and holds four
# lines of prose. `check-decisions` is what keeps it a pointer.
decisions_file := "docs/decisions.md"

# The map of docs/decisions.md: every top-level section, and what it costs to
# read.
#
# 27 000 lines under 843 headings, so the file is not a thing anyone holds at
# once, and the way it was being read was `sed -n '15690,15900p'` — a guessed
# line range, ~5 000 tokens a guess, landing beside the section about as often
# as on it. On 2026-09-05 that cost 123 calls and ~180 000 tokens in one day,
# more than any other file in the project.
#
# **The line count is the column that earns its place**, because it is the one
# thing the section number does not already tell you: it says whether `just
# decision 49` is 40 lines or 400 before you pay for it. There are deliberately
# no line *offsets* here. The sections are numbered, `just decision 49.6`
# addresses one by its number, and an offset would be a second address for the
# same section that goes stale the moment anybody inserts a paragraph.
[doc("The map of docs/decisions.md: every section, and what it costs to read.")]
decisions-toc:
    #!/usr/bin/env bash
    set -euo pipefail
    dir='{{decisions_dir}}'
    for f in $(ls "$dir" | LC_ALL=C sort); do
        head=$(head -n 1 "$dir/$f")
        case "$head" in '## '*) ;; *) continue ;; esac
        rest=${head#'## '}
        title=${rest#* }
        num=${rest%% *}; num=${num%.}
        printf "  %-5s %-56s %4d lines\n" \
            "$num" "$title" "$(( $(wc -l < "$dir/$f") - 1 ))"
    done

# Every section, concatenated, in the order the numbers run.
#
# This is the file the sections used to be, and it is how the split was checked
# to have lost nothing: at §179's own commit this recipe's output was
# byte-identical to the `docs/decisions.md` it replaced, diffed and empty.
#
# It is not what anybody should read — 40 000 lines — but a whole-file search
# needs it to exist, and `decisions-find` and `check-where-the-work-is` are both
# written against it rather than against a directory walk, because a hit or a
# citation has to be attributed across sections to mean anything.
[doc("Every section concatenated, in number order: the file the sections used to be.")]
decisions-all:
    #!/usr/bin/env bash
    set -euo pipefail
    dir='{{decisions_dir}}'
    for f in $(ls "$dir" | LC_ALL=C sort); do
        cat "$dir/$f"
    done

# One section of docs/decisions.md, by its number.
#
# `just decision 49` gives §49's own prose and then the list of its subsections,
# which is the cheap way in; `just decision 49.6` gives §49.6 in full. A leading
# section sign is accepted so a citation can be pasted as it is written.
#
# **The subsection address is what the split had to preserve** (§179). rscene's
# `###` headings are free text, so its port of this recipe prints whole sections
# and stops; here every subsection is numbered and `just decision 173.10` is how
# one is read. The filename picks the file — `173.10` and `173` both resolve to
# `173-*.md` — and then the awk below is the one that ran against the single
# file, unchanged, reading a file that now holds one section instead of 177.
#
# **A number that does not exist fails rather than printing nothing.** Silence
# reads as "the decisions say nothing about this", which is the opposite of what
# an unknown number means, and it is the same failure `check-ignored` above
# guards against: an empty selection looks exactly like a clean pass.
[doc("One section of docs/decisions.md by number: `just decision 49.6`.")]
decision want:
    #!/usr/bin/env bash
    set -euo pipefail
    want=$(printf '%s' '{{want}}' | sed 's/^§//; s/\.$//')
    if [ -z "$want" ]; then
        echo "which section? try 'just decisions-toc' for the map" >&2
        exit 2
    fi
    dir='{{decisions_dir}}'
    top=${want%%.*}
    file=""
    if [[ $top =~ ^[0-9]+$ ]]; then
        for f in $(ls "$dir" | LC_ALL=C sort); do
            n=${f%%-*}
            [[ $n =~ ^[0-9][0-9][0-9]$ ]] || continue
            [ "$((10#$n))" = "$((10#$top))" ] || continue
            file="$dir/$f"
            break
        done
    fi
    if [ -z "$file" ]; then
        echo "docs/decisions.md has no section $want" >&2
        exit 3
    fi
    case "$want" in
    *.*)
        awk -v want="$want" '
            /^## |^### / {
                if (on) exit
                rest = $0; sub(/^#+ /, "", rest)
                p = index(rest, " "); id = substr(rest, 1, p - 1); sub(/\.$/, "", id)
                if (id == want) { on = 1; found = 1 }
            }
            on { print }
            END { exit(found ? 0 : 3) }' "$file" || {
            echo "docs/decisions.md has no section $want" >&2
            exit 3
        }
        ;;
    *)
        awk -v want="$want" '
            /^## / {
                if (on) exit
                rest = substr($0, 4); p = index(rest, " ")
                id = substr(rest, 1, p - 1); sub(/\.$/, "", id)
                if (id == want) { on = 1; found = 1 }
            }
            /^### / { if (on) exit }
            on { print }
            END { exit(found ? 0 : 3) }' "$file" || {
            echo "docs/decisions.md has no section $want" >&2
            exit 3
        }
        awk -v want="$want" '
            function flush() {
                if (num != "") printf "  %-7s %-54s %4d lines\n", num, title, n
                num = ""
            }
            /^### / {
                flush()
                rest = substr($0, 5); p = index(rest, " ")
                id = substr(rest, 1, p - 1)
                if (index(id, want ".") == 1) { num = id; title = substr(rest, p + 1); n = 0 }
                next
            }
            /^## / { flush(); next }
            num != "" { n++ }
            END { flush() }' "$file"
        ;;
    esac

# Which sections mention this? A text search that answers in section numbers.
#
#     just decisions-find 'refusal rate'
#
# gives the subsections whose text matches, so the next call is `just decision
# 41.13`. A plain grep answers `16820:` instead, and a line number is the one
# thing CLAUDE.md says never to address a decision by — walking back up 17 000
# lines to the heading above the hit was the step that had no recipe.
#
# **The match is case-insensitive.** Of 886 grep commands measured across one
# day's sessions, 97 matched nothing at all, and a search that misses `Refusal`
# because the caller typed `refusal` fails in exactly that silent way. A caller
# who wants the distinction writes the bracket themselves.
#
# **No match fails rather than printing nothing**, for the same reason `decision`
# fails on a number that does not exist: an empty answer here reads as "the
# decisions say nothing about this", and that is a claim a typo can forge.
#
# **This searches the concatenation and not the directory**, which is what keeps
# a hit attributed to the `### N.M` it fell in rather than only to the `## N.`
# file that holds it. rscene's port counts hits per file with `grep -c`, because
# a file is the finest unit it has; here the subsection is finer than the file,
# so the search needs a stream with every heading in it. `decisions-all` is that
# stream, and the awk below is unchanged from the one that read the single file.
[doc("Which sections mention this? Answers in section numbers, not line numbers.")]
decisions-find pattern:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -z "$1" ]; then
        echo "find what? an empty pattern matches every line" >&2
        exit 2
    fi
    all=$(mktemp)
    hits=$(mktemp)
    trap 'rm -f "$all" "$hits"' EXIT
    dir='{{decisions_dir}}'
    for f in $(ls "$dir" | LC_ALL=C sort); do cat "$dir/$f"; done > "$all"
    if ! grep -inE -- "$1" "$all" | cut -d: -f1 > "$hits"; then
        echo "no line in {{decisions_dir}} matches $1" >&2
        exit 1
    fi
    awk -v hits="$hits" '
        BEGIN {
            while ((getline ln < hits) > 0) wanted[ln + 0] = 1
            id = "(preamble)"
        }
        /^## |^### / {
            rest = $0; sub(/^#+ /, "", rest)
            p = index(rest, " "); id = substr(rest, 1, p - 1); sub(/\.$/, "", id)
            title = substr(rest, p + 1)
        }
        wanted[FNR] {
            if (!(id in count)) { order[++k] = id; name[id] = title }
            count[id]++
        }
        END {
            for (i = 1; i <= k; i++)
                printf "  %-7s %-54s %4d hits\n", order[i], name[order[i]], count[order[i]]
        }' "$all"

# Where `claim-section` writes down the numbers it hands out. Empty means a file
# in the repository's common git directory, which every worktree shares and no
# branch carries.
section_claims := ""

# Take the next section number for docs/decisions.md now, before writing it.
#
#     just claim-section 'the lookup trigger, measured'
#
# prints the number and nothing else. **The number is yours from that moment**:
# it is written to the claims file before it is printed, under a lock, so a
# second session asking a second later gets the one after.
#
# Checking by hand — `git log --all -S'## 151. '` — was correct every time and
# lost anyway, because it is a read against a value another session is about to
# write, and a section takes an hour to write. §144.5, §152.7 and §157.6 each
# lost that race while being written; §157.6 lost it three times. What was
# missing was a claim that outlives the read (§159).
#
# The number is one past the highest of: every `## N.` on every local and
# remote-tracking branch, every `## N.` in every worktree's copy of the file —
# committed or not, because a lane writes its section long before it commits —
# and every number claimed before. A claim that is never written leaves a gap,
# and a gap costs nothing: `check-decisions` asks for unique, ascending numbers,
# not consecutive ones. §54 and §65 are two such gaps today.
#
# **It reads both shapes, and that is not tidiness** (§179). The split put the
# sections in `docs/decisions.d/NNN-*.md`, and every lane branch cut before it
# still carries the single `docs/decisions.md` with its sections in it — for
# weeks, since a lane lives as long as its unit. A recipe that read only the new
# shape would see §178 as the top while a branch held §180, and hand §179 out
# twice; reading only the old shape would stop counting the moment the split
# landed. So both are read, on refs and in worktrees alike, and the highest of
# everything wins. This is the failure this repository has already paid for once
# by hand, which is what §159 was written about.
#
# Every worktree of this clone shares the claims, and nothing else does. A
# section written on another machine is seen once it reaches a branch here.
[doc("Take the next docs/decisions.md section number now, before writing it: `just claim-section 'what it is about'`.")]
claim-section what:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -z "$1" ]; then
        echo "claim it for what? the claims file says who holds each number" >&2
        exit 2
    fi
    case "$1" in
        -*)
            echo "a title starting with '-' looks like a flag, not a title; \`just recipe claim-section\` prints the recipe's doc" >&2
            exit 2
            ;;
    esac
    claims="{{section_claims}}"
    if [ -z "$claims" ]; then
        claims="$(git rev-parse --path-format=absolute --git-common-dir)/rcad-section-claims"
    fi
    exec 9>>"$claims.lock"
    flock 9
    touch "$claims"
    file="{{decisions_file}}"
    dir="{{decisions_dir}}"
    top=$({
        git for-each-ref --format='%(refname)' refs/heads refs/remotes \
            | while read -r ref; do git rev-parse -q --verify "$ref:$file" || true; done \
            | sort -u \
            | while read -r blob; do git cat-file blob "$blob"; done \
            | grep -E '^## [0-9]+\. ' || true
        git for-each-ref --format='%(refname)' refs/heads refs/remotes \
            | while read -r ref; do git ls-tree --name-only "$ref:$dir" 2>/dev/null || true; done \
            | sed -nE 's/^([0-9][0-9][0-9])-.*\.md$/## \1./p'
        git worktree list --porcelain | sed -n 's/^worktree //p' \
            | while read -r tree; do
                if [ -f "$tree/$file" ]; then grep -E '^## [0-9]+\. ' "$tree/$file" || true; fi
                if [ -d "$tree/$dir" ]; then
                    ls "$tree/$dir" | sed -nE 's/^([0-9][0-9][0-9])-.*\.md$/## \1./p'
                fi
            done
        cut -f1 "$claims" | sed 's/^/## /'
    } | awk '{ n = $2 + 0; if (n > top) top = n } END { print top + 0 }')
    next=$((top + 1))
    printf '%s\t%s\t%s\t%s\n' "$next" "$(date -u +%FT%TZ)" "{{invocation_directory()}}" "$1" >> "$claims"
    echo "$next"

# Where `check-decisions` looks for a `§N` citation, beyond the section files
# themselves. Overridable so the selftest can point it at a fixture instead of
# scanning this real tree.
decisions_cite_roots := "crates docs justfile .claude fuzz CLAUDE.md AGENTS.md tooling"

# `decision` finds a section by the number its filename starts with and a
# subsection by the number its heading starts with, so either one written
# without a number is a section the lookup cannot reach — and it fails as
# silence, which reads as "nothing was decided about this".
#
# All 487 headings are numbered today, `## N.` and `### N.M`. `####` headings are
# free text on purpose: they sit inside a subsection and are never addressed.
#
# A heading hiding inside a code fence would fool the same match. None exists and
# none ever has, so per §13 that check is not built until something needs it.
#
# **The filename and the heading are two places to write the number**, so they
# are compared. A section file copied to start the next one keeps its old
# heading under a new name, and then two numbers address one text and one
# addresses none.
#
# **Two files sharing a number is the second way to be unreachable**, and it is
# the one that happens by itself. `decision` takes the first file whose number
# matches, so the second §56 is addressed by nothing at all — and it is not a
# typo that puts it there. Whoever finishes a section next takes the next
# number, ten to thirty times a day from as many as four concurrent sessions,
# and two of them reaching for the same one is the ordinary case rather than the
# unlucky one. It happened while §57 was being written (§57.4). The split (§179)
# is what stopped that being a merge conflict every time; the collision it
# cannot prevent is the one worth catching here.
#
# **A `### N.M` sitting in the wrong file, or after a higher one, is the
# third.** A subsection typed by hand during a renumbering can end up under the
# wrong parent — `### 64.3` left under `## 69.` after 64 was renumbered to 67 is
# the shape it takes, and it happened four times in one session and was only
# caught by grepping for it. `docs/decisions.md` §71.
#
# **And the pointer file must stay a pointer.** Every citation in the tree says
# `docs/decisions.md §N`, the habit of four sessions is to append a section to
# that path, and an append there is invisible to every recipe above — the text
# would be live, addressed by nothing, and colliding again. This is the failure
# the split invites and the one nothing else would catch. The pointer's path is
# derived from the directory's own name (`docs/decisions.d` → `docs/decisions.md`)
# so that the selftest below gets it too, against a fixture pointer of its own.
#
# **Contiguity is deliberately not demanded, unlike rscene's port of this.**
# `claim-section` hands a number out under a lock before the section is written,
# so a claim that is never used leaves a permanent hole: §54 and §65 are two
# such holes today and neither is a fault. A check that asked for 0..N would
# have been red on the tree it was written against.
#
# **A `§N` cited anywhere with no `docs/decisions.d/NNN-*.md` behind it fails
# the gate too**, the way `check-queue` already refuses a queue row that cites
# a missing section (`docs/decisions.md` §179). `crates/rcad-fuzz-timing`'s
# `lib.rs` cited §278 three times on `lane-q164-drop-merges` (fac68b59) before
# the file existed, and `check-decisions` passed it — a gap, not a limit
# (§16.10), since the fix is the grep `check-queue` already runs, one level up.
#
# Only the section number is checked; the subsection is dropped, on purpose.
# A cite of a subsection that does not exist under a section that does, such as
# four cites of a §58.11 when §58 stops at §58.10, is real and is not this
# check's job — that needs the subsection ranges `decisions-toc` already knows,
# and is `docs/decisions.md` §179's row to fix, not this one's.
#
# **§54 and §65 are excused by name, and only those two.** They are the
# holes the paragraph above names — numbers `claim-section` handed out and
# nobody wrote a file for — and every one of their nine cites already knows
# it, in words, at the place it cites them. Nothing else is excused: no list
# of excused files, no exception for a fixture, a corpus or a comment. A cite
# this check flags that is not §54 or §65 is either a hole to fill or a typo
# to fix — a stray "14356" after the sign in `docs/decisions.d/050`, cited
# nowhere else, turned out to be §24.1, the only section whose own heading
# matches the sentence around it.
[doc("Every heading in docs/decisions.md can be reached by its number, and no §N cite outruns the file that backs it.")]
check-decisions:
    #!/usr/bin/env bash
    set -euo pipefail
    dir="{{decisions_dir}}"
    [ -d "$dir" ] || { echo "$dir is not a directory"; exit 1; }

    ok=1
    nums=$(mktemp)
    have=$(mktemp)
    trap 'rm -f "$nums" "$have"' EXIT
    for f in $(ls "$dir" | LC_ALL=C sort); do
        path="$dir/$f"
        if [ "$f" = "00-preamble.md" ]; then
            if grep -q '^## ' "$path"; then
                grep -n '^## ' "$path"
                echo "^ $path is the preamble and carries a '## ' heading"
                ok=0
            fi
            continue
        fi
        if [[ ! $f =~ ^([0-9][0-9][0-9])-[a-z0-9-]+\.md$ ]]; then
            echo "$path is not named NNN-<slug>.md, so 'just decision' cannot reach it"
            ok=0
            continue
        fi
        n=$((10#${BASH_REMATCH[1]}))
        echo "$n" >> "$nums"

        headings=$(grep -c '^## ' "$path" || true)
        if [ "$headings" -ne 1 ]; then
            echo "$path has $headings '## ' headings; a file is one section"
            ok=0
            continue
        fi
        if ! head -n 1 "$path" | grep -q "^## $n\. "; then
            head -n 1 "$path"
            echo "^ $path does not open with '## $n. ', so its name and its heading disagree"
            ok=0
            continue
        fi

        bad=$(grep -nE '^(## |### )' "$path" \
            | grep -vE '^[0-9]+:## [0-9]+\. ' \
            | grep -vE '^[0-9]+:### [0-9]+\.[0-9]+ ' || true)
        if [ -n "$bad" ]; then
            echo "$path"
            echo "$bad"
            echo "^ a decisions heading that 'just decision' cannot address"
            ok=0
            continue
        fi

        subs=$(awk -v n="$n" -v path="$path" '
            /^### [0-9]/ {
                rest = $0; sub(/^#+ /, "", rest)
                p = index(rest, " "); id = substr(rest, 1, p - 1)
                split(id, parts, ".")
                if (parts[1] + 0 != n)
                    print path ":" FNR ": ### " id " is not under its own ## " n
                else if (parts[2] + 0 <= lastsub)
                    print path ":" FNR ": ### " id " comes after ### " n "." lastsub
                lastsub = parts[2] + 0
            }' "$path")
        if [ -n "$subs" ]; then
            echo "$subs"
            echo "^ decisions subsection numbers are out of order (docs/decisions.md §71)"
            ok=0
        fi
    done
    [ "$ok" -eq 1 ] || exit 1

    [ -s "$nums" ] || { echo "$dir holds no sections at all"; exit 1; }
    dupes=$(sort -n "$nums" | uniq -d)
    if [ -n "$dupes" ]; then
        for id in $dupes; do ls "$dir" | { grep -E "^0*${id}-" || true; }; done
        echo "^ these files share a section number, and 'just decision' reaches only the first"
        exit 1
    fi

    pointer="${dir%.d}.md"
    if [ -e "$pointer" ] && grep -q '^## ' "$pointer"; then
        grep -n '^## ' "$pointer"
        echo "^ $pointer is the pointer, not a section; that heading is addressed by nothing"
        exit 1
    fi

    sort -n -u "$nums" > "$have"
    excused_missing_sections="54 65"
    roots=""
    for root in {{decisions_cite_roots}}; do
        [ -e "$root" ] && roots="$roots $root"
    done
    bad_cites=""
    if [ -n "$roots" ]; then
        bad_cites=$(grep -rnoE '§[0-9]+' $roots 2>/dev/null | awk -F'§' \
            -v havefile="$have" -v excused="$excused_missing_sections" '
            BEGIN {
                while ((getline line < havefile) > 0) known[line + 0] = 1
                close(havefile)
                m = split(excused, es, " ")
                for (i = 1; i <= m; i++) known[es[i] + 0] = 1
            }
            { if (!(($NF + 0) in known)) print }') || true
    fi
    if [ -n "$bad_cites" ]; then
        echo "$bad_cites"
        echo "^ these cite a §N with no docs/decisions.d/NNN-*.md file (§54 and §65 excused by name, see check-decisions' doc comment)"
        exit 1
    fi

# Pins the lookup against fixtures rather than against the real sections, so it
# stays proven on a tree where the real §1.1 has been rewritten.
#
# `#### ` inside the fixture is the case worth having: it is a heading, and a
# lookup that stops at any heading would cut §1.1 in half without saying so.
#
# **The fixture is a directory now** (§179), and every case below that used to
# be a second `.md` file is a second fixture directory. The cases the split
# added are the ones that were impossible before: a filename and a heading that
# disagree, two files claiming one number, a section appended to the pointer,
# and a `00-preamble.md` that has grown a section heading. The cases it made
# impossible went the other way — two `## 1.` in one file is now "a file is one
# section", and a descending `## 1.` after `## 2.` cannot be expressed at all,
# because the order is the filenames' and the filenames are sorted.
#
# **The stray-cite case is the odd one out**: it does not break the fixture's
# own numbering at all, only what one line inside it points at, so it needs
# `decisions_cite_roots` pointed at the fixture too — everywhere else `$j` or
# `bad` runs `check-decisions`, or the fac68b59 shape (§278, cited before the
# file existed) would be caught by scanning this real tree instead.
[private]
check-decisions-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    mkdir -p "$dir/fixture.d"
    cat > "$dir/fixture.d/00-preamble.md" <<'MD'
    # Design decisions
    MD
    cat > "$dir/fixture.d/001-first.md" <<'MD'
    ## 1. First
    intro to one
    ### 1.1 Alpha
    alpha body
    #### A fourth-level heading that must not end the section
    still alpha
    ### 1.2 Beta
    beta body
    MD
    cat > "$dir/fixture.d/002-second.md" <<'MD'
    ## 2. Second
    intro to two
    MD
    j="{{just_executable()}} --set decisions_dir $dir/fixture.d --set decisions_cite_roots $dir/fixture.d"

    got=$($j decisions-all)
    want=$(printf '%s\n' "# Design decisions" "## 1. First" "intro to one" \
        "### 1.1 Alpha" "alpha body" \
        "#### A fourth-level heading that must not end the section" "still alpha" \
        "### 1.2 Beta" "beta body" "## 2. Second" "intro to two")
    [ "$got" = "$want" ] || { echo "decisions-all drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$($j decision 1.1)
    want=$(printf '%s\n' "### 1.1 Alpha" "alpha body" \
        "#### A fourth-level heading that must not end the section" "still alpha")
    [ "$got" = "$want" ] || { echo "decision 1.1 drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$($j decision 1)
    want=$(printf '%s\n' "## 1. First" "intro to one" \
        "  1.1     Alpha                                                     3 lines" \
        "  1.2     Beta                                                      1 lines")
    [ "$got" = "$want" ] || { echo "decision 1 drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$($j decisions-toc)
    want=$(printf '%s\n' \
        "  1     First                                                       7 lines" \
        "  2     Second                                                      1 lines")
    [ "$got" = "$want" ] || { echo "decisions-toc drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$($j decision §1.1)
    [ "$got" = "$($j decision 1.1)" ] || { echo "a pasted § was not accepted"; exit 1; }

    if $j decision 9 >/dev/null 2>&1; then
        echo "decision 9 found a section that does not exist"; exit 1
    fi

    # `decision 1` above pins the column widths, so what is left to pin here is
    # the attribution: which section a hit is reported under, and how many.
    squashed() { $j decisions-find "$1" | awk '{ $1 = $1; print }'; }

    got=$(squashed ALPHA)
    want=$(printf '%s\n' "1.1 Alpha 3 hits")
    [ "$got" = "$want" ] || { echo "decisions-find ALPHA drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$(squashed intro)
    want=$(printf '%s\n' "1 First 1 hits" "2 Second 1 hits")
    [ "$got" = "$want" ] || { echo "decisions-find intro drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$(squashed decisions)
    [ "$got" = "(preamble) 1 hits" ] || { \
        echo "a hit above the first heading was reported as '$got'"; exit 1; }

    if $j decisions-find zzzz >/dev/null 2>&1; then
        echo "decisions-find said nothing about a pattern nothing matches"; exit 1
    fi

    if $j decisions-find "" >/dev/null 2>&1; then
        echo "decisions-find accepted the empty pattern"; exit 1
    fi

    # Each way the sections can go unreachable, against fixtures for the same
    # reason as above: the real directory is clean today, so pinning the check
    # there would prove nothing.
    $j check-decisions >/dev/null \
        || { echo "the clean fixture failed check-decisions"; exit 1; }

    # `bad <name> <why>` builds a fixture directory from the clean one, lets the
    # caller break it, and fails if `check-decisions` is happy with the wreck.
    bad() {
        cp -r "$dir/fixture.d" "$dir/$1.d"
        "break_$1"
        if {{just_executable()}} --set decisions_dir "$dir/$1.d" \
            --set decisions_cite_roots "$dir/$1.d" \
            check-decisions >/dev/null 2>&1; then
            echo "$2 passed check-decisions"; exit 1
        fi
    }

    break_twice() { cp "$dir/twice.d/001-first.md" "$dir/twice.d/001-first-again.md"; }
    bad twice "two files numbered 001"

    break_twice_sub() {
        printf '%s\n' "### 1.1 Alpha again" >> "$dir/twice_sub.d/001-first.md"
    }
    bad twice_sub "two subsections numbered 1.1"

    # Descending within a section: §1.1 lands after §1.2.
    break_descending_sub() {
        printf '%s\n' "### 1.1 Alpha" >> "$dir/descending_sub.d/001-first.md"
    }
    bad descending_sub "### 1.1 after ### 1.2"

    # Wrong parent: §1.2 is left in §2's file by a renumbering, exactly the way
    # `### 64.3` ended up under `## 69.` in the single file.
    break_wrong_parent() {
        printf '%s\n' "### 1.2 Beta" >> "$dir/wrong_parent.d/002-second.md"
    }
    bad wrong_parent "### 1.2 in ## 2.'s file"

    # The name and the heading disagree: a file copied to start the next section
    # and renamed but not retitled.
    break_renamed() { mv "$dir/renamed.d/002-second.md" "$dir/renamed.d/003-second.md"; }
    bad renamed "a file named 003 whose heading says 2"

    # A file is one section: the old habit of appending, applied to a section
    # file instead of the whole document.
    break_two_in_one() {
        printf '%s\n' "## 3. Third" >> "$dir/two_in_one.d/002-second.md"
    }
    bad two_in_one "two sections in one file"

    # An unnumbered filename, which `just decision` can reach by nothing.
    break_unnumbered() { mv "$dir/unnumbered.d/002-second.md" "$dir/unnumbered.d/second.md"; }
    bad unnumbered "a file named without a number"

    # The preamble grows a section heading, which addresses it to nobody.
    break_preamble_section() {
        printf '%s\n' "## 3. Third" >> "$dir/preamble_section.d/00-preamble.md"
    }
    bad preamble_section "a section heading in the preamble"

    # The pointer grows a section, which is the habit of four sessions and the
    # one failure the split invites (§179).
    break_pointer() { printf '%s\n' "## 3. Third" > "$dir/pointer.md"; }
    bad pointer "a section appended to the pointer file"

    # A cite of a section with no file behind it, the fac68b59 shape: nothing
    # about the fixture's own numbering is wrong, only what it points at.
    break_stray_cite() {
        printf '%s\n' "See §99 for more." >> "$dir/stray_cite.d/001-first.md"
    }
    bad stray_cite "a §99 with no docs/decisions.d/099-*.md file"

# Pins `claim-section` against a throwaway repository with a section in each
# place the recipe must look: on the checked-out branch, on another branch only,
# and uncommitted in another worktree.
#
# **The concurrent round is the one that matters**, because it is the race the
# recipe exists for. Without the lock, eight claims started together hand out
# the same number several times over; that was checked by deleting the `flock`
# line and watching this fail.
[private]
check-claim-section-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    repo="$dir/repo"
    g() { git -C "$repo" -c user.name=selftest -c user.email=selftest@invalid "$@"; }
    mkdir -p "$repo/docs"
    g init -q -b main
    printf '%s\n' "## 1. First" "## 2. Second" > "$repo/docs/decisions.md"
    g add docs/decisions.md
    g commit -q -m one
    g checkout -q -b elsewhere
    printf '%s\n' "## 5. Only on a branch" >> "$repo/docs/decisions.md"
    g commit -q -am five
    g checkout -q main
    claim() { {{just_executable()}} --justfile "{{justfile()}}" --working-directory "$repo" claim-section "$@"; }

    got=$(claim 'past a branch')
    [ "$got" = "6" ] || { echo "the first claim got '$got', want 6: one past §5 on the other branch"; exit 1; }

    g worktree add -q --detach "$dir/lane" main
    printf '%s\n' "## 9. Written, not committed" >> "$dir/lane/docs/decisions.md"
    got=$(claim 'past a worktree')
    [ "$got" = "10" ] || { echo "a claim got '$got', want 10: one past the uncommitted §9"; exit 1; }

    got=$({{just_executable()}} --justfile "{{justfile()}}" --working-directory "$dir/lane" \
        claim-section 'from the other worktree')
    [ "$got" = "11" ] || { echo "a claim from the other worktree got '$got', want 11: §10 was claimed from the first"; exit 1; }

    for i in 1 2 3 4 5 6 7 8; do claim "at once $i" > "$dir/at-once-$i" & done
    wait
    got=$(cat "$dir"/at-once-* | sort -n | tr '\n' ' ')
    [ "$got" = "12 13 14 15 16 17 18 19 " ] || {
        echo "eight claims at once got '$got', want 12 to 19 once each"; exit 1; }

    # Both shapes, which is the whole of §179.2's second point. Everything above
    # is the old single file, because that is what a lane branch cut before the
    # split still carries; these two are the new directory, committed on a
    # branch and uncommitted in a worktree. A recipe that had learnt the new
    # shape and forgotten the old would pass every case above and hand out a
    # number a branch already holds — so the old cases are the test for the new
    # code just as much as these are.
    g checkout -q elsewhere
    mkdir -p "$repo/docs/decisions.d"
    printf '%s\n' "## 40. Split, on a branch" > "$repo/docs/decisions.d/040-split.md"
    g add docs/decisions.d/040-split.md
    g commit -q -m forty
    g checkout -q main
    got=$(claim 'past a split branch')
    [ "$got" = "41" ] || {
        echo "a claim got '$got', want 41: one past §40 in the branch's decisions.d"; exit 1; }

    mkdir -p "$dir/lane/docs/decisions.d"
    printf '%s\n' "## 60. Split, not committed" > "$dir/lane/docs/decisions.d/060-split.md"
    got=$(claim 'past a split worktree')
    [ "$got" = "61" ] || {
        echo "a claim got '$got', want 61: one past the uncommitted §60 in decisions.d"; exit 1; }

    if claim '' >/dev/null 2>&1; then
        echo "claim-section accepted a claim for nothing"; exit 1
    fi

    # A title starting with '-' looks like a flag typed by hand, as
    # '--help' was on 2026-10-12 and got a real section number for it
    # (§159). The refusal must happen before the claim is written, or
    # the next real claim would skip a number for nothing.
    if claim '--help' >/dev/null 2>&1; then
        echo "claim-section accepted a claim for '--help'"; exit 1
    fi
    got=$(claim 'after the refused --help')
    [ "$got" = "62" ] || {
        echo "a claim after the refused '--help' got '$got', want 62: the refusal must not have written a claim"; exit 1; }

# One item of Rust source, by its name, with its doc comment and attributes.
#
#     just src arrange_faces
#     just src new crates/rcad-geom
#
# The habit this replaces is `grep -n 'fn arrange_faces'` followed by a `Read`
# with a hand-guessed `offset` and `limit` — two calls, and the guess either
# cuts the item in half or pays for the next one as well. Measured across 64
# transcripts, `.rs` files are 33% of every character `Read` has delivered in
# this repo, and 0.31 M of those arrived through calls that passed no `limit`
# at all. §57.6 left this recipe open rather than refused; this is it.
#
# **A name defined in more than one place lists the places instead of printing
# all of them**, because printing every `fn new` in the workspace is the cost
# the recipe exists to avoid. The second argument narrows the search to a path.
#
# The extent of an item is read off rustfmt's layout rather than parsed: back to
# the blank line above it, forward to the first `}` at the item's own
# indentation. `just fmt` is what makes that exact. **When the closing brace is
# not where rustfmt would put it this fails and says so**, rather than printing
# to the end of the file — an item that runs on for 7 000 lines is the failure
# this whole recipe is against.
[doc("One item of Rust source by name, with its doc comment: `just src Decision`.")]
src want filter="":
    #!/usr/bin/env bash
    set -euo pipefail
    want="$1"
    case "$want" in
    "")
        echo "which name? try 'just src arrange_faces'" >&2
        exit 2
        ;;
    *[!A-Za-z0-9_]*)
        echo "'$want' is not the name of a Rust item" >&2
        exit 2
        ;;
    esac

    root=$(git rev-parse --show-toplevel)
    filter="${2:-}"
    if [ -n "$filter" ]; then
        files=$(git -C "$root" ls-files -- "$filter" | grep '\.rs$' || true)
    else
        files=$(git -C "$root" ls-files -- '*.rs' || true)
    fi
    if [ -z "$files" ]; then
        echo "no Rust files are tracked${filter:+ under $filter}" >&2
        exit 1
    fi

    kw='fn|struct|enum|trait|type|union|mod|static'
    lead='^[[:space:]]*(pub(\([^)]*\))?[[:space:]]+)?(default[[:space:]]+)?((const|async|unsafe)[[:space:]]+)*(extern[[:space:]]+"[^"]*"[[:space:]]+)?'
    hits=$(cd "$root" && grep -nHE \
        "$lead(($kw)[[:space:]]+$want\b|const[[:space:]]+$want[[:space:]]*:|macro_rules![[:space:]]*$want\b)" \
        -- $files || true)

    if [ -z "$hits" ]; then
        echo "no Rust item named $want${filter:+ under $filter}" >&2
        exit 1
    fi

    if [ "$(printf '%s\n' "$hits" | wc -l)" -gt 1 ]; then
        printf '%s\n' "$hits" | awk '{
            p = index($0, ":"); file = substr($0, 1, p - 1); rest = substr($0, p + 1)
            q = index(rest, ":"); ln = substr(rest, 1, q - 1); code = substr(rest, q + 1)
            sub(/^[ \t]+/, "", code)
            printf "  %-52s %s\n", file ":" ln, code
        }'
        exit 0
    fi

    file=${hits%%:*}
    rest=${hits#*:}
    awk -v L="${rest%%:*}" -v path="$file" '
        { a[NR] = $0 }
        END {
            def = a[L]
            indent = match(def, /[^ ]/) - 1
            pad = substr(def, 1, indent)

            start = L
            while (start > 1) {
                t = a[start - 1]
                sub(/^[ \t]+/, "", t); sub(/[ \t]+$/, "", t)
                if (t == "" || t ~ /\{$/ || t ~ /^\}/) break
                start--
            }

            trimmed = def; sub(/[ \t]+$/, "", trimmed)
            if (trimmed ~ /;$/ || (index(def, "{") > 0 && trimmed ~ /\}$/)) {
                end = L
            } else {
                for (i = L + 1; i <= NR; i++)
                    if (substr(a[i], 1, indent + 1) == pad "}") { end = i; break }
            }
            if (end == 0) {
                print path ":" L " opens an item that has no closing brace at its own" \
                    " indentation — run just fmt, or read it by hand" > "/dev/stderr"
                exit 1
            }

            print path ":" L
            for (i = start; i <= end; i++) print a[i]
        }' "$root/$file"

# Pins the extraction against a fixture repo rather than against the tree, so it
# stays proven on a day the real `arrange_faces` is rewritten. `git ls-files` is
# what the recipe searches, so the fixture is a real index — `git add` with no
# commit is enough for that, and needs no identity configured.
[private]
check-src-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    mkdir -p "$dir/repo/src"
    cat > "$dir/repo/src/a.rs" <<'RS'
    /// Doc for alpha.
    #[derive(Debug)]
    pub struct Alpha {
        pub x: f64,
    }

    pub fn shared() -> u8 {
        1
    }

    const LIMIT: usize = 3;

    impl Alpha {
        /// Doc for the method.
        pub fn beta(
            &self,
        ) -> f64 {
            self.x
        }
    }
    RS
    cat > "$dir/repo/src/b.rs" <<'RS'
    pub fn shared() -> u8 {
        2
    }
    RS
    git -C "$dir/repo" init -q
    git -C "$dir/repo" add -A
    j="{{just_executable()}} --justfile {{justfile()}} --working-directory $dir/repo"

    got=$($j src Alpha)
    want=$(printf '%s\n' "src/a.rs:3" "/// Doc for alpha." "#[derive(Debug)]" \
        "pub struct Alpha {" "    pub x: f64," "}")
    [ "$got" = "$want" ] || { echo "src Alpha drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$($j src beta)
    want=$(printf '%s\n' "src/a.rs:15" "    /// Doc for the method." "    pub fn beta(" \
        "        &self," "    ) -> f64 {" "        self.x" "    }")
    [ "$got" = "$want" ] || { echo "src beta drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$($j src LIMIT)
    want=$(printf '%s\n' "src/a.rs:11" "const LIMIT: usize = 3;")
    [ "$got" = "$want" ] || { echo "src LIMIT drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$($j src shared | awk '{ $1 = $1; print }')
    want=$(printf '%s\n' "src/a.rs:7 pub fn shared() -> u8 {" "src/b.rs:1 pub fn shared() -> u8 {")
    [ "$got" = "$want" ] || { echo "a name defined twice did not list both:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$($j src shared src/b.rs)
    want=$(printf '%s\n' "src/b.rs:1" "pub fn shared() -> u8 {" "    2" "}")
    [ "$got" = "$want" ] || { echo "the path filter did not narrow to one:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    if $j src no_such_item >/dev/null 2>&1; then
        echo "src found an item that does not exist"; exit 1
    fi

    if $j src 'fn beta' >/dev/null 2>&1; then
        echo "src accepted something that is not an item name"; exit 1
    fi

# Which file `recipe` below reads. A variable so `check-recipe-selftest` can
# point it at a fixture: the subject here is a justfile, and a selftest that
# read the real one would be pinned to whatever recipes happen to exist today.
recipes_file := "justfile"

# One recipe of this justfile, by name, with the whole comment block above it.
#
#     just recipe gate
#     just recipe hub          no such recipe: lists the three whose names contain it
#     just recipe              every definition, including the ones `list` hides
#
# `just --show <name>` already prints the attributes, the header and the body.
# What it prints of the comment block is **one line**, because that is just's
# own doc-comment rule — and in this file the comment block is where the
# argument lives: 22 lines above `src`, 6 above `gate_steps`. So `--show`
# truncates exactly the part a reader came for. And `just --show gate_steps`
# answers `error: Justfile does not contain recipe`: the twenty `:=`
# assignments are reachable by no reader at all. This prints both, whole.
#
# The habit it replaces is `grep -n '^check-hub' justfile` followed by a `Read`
# at a guessed offset — the two-call shape §144.6 measured, on the file it
# measured second. §153 landed this at 307 404 characters over 105
# definitions, mean answer 2 934, largest (`check-fuzz-overnight-selftest`)
# 40 344 — kept there as history and not updated. Measured again on
# 2026-10-03: 694 933 characters (`wc -m justfile`) over 158 definitions
# (`just recipe | wc -l`), mean answer 4 408, largest still
# `check-fuzz-overnight-selftest` at 74 896 (both from summing `just recipe
# <name> | wc -m` over every name the index lists).
#
# **The extent is exact rather than guessed**, which is the one place this beats
# `just src`. `src` reads a Rust item's end off rustfmt's layout and fails when
# the closing brace is not where rustfmt would put it. Here indentation *is*
# just's grammar: a body is every following line that is blank or indented, and
# no line inside one can begin at column 0. Nothing is guessed and there is no
# way to run on to the end of the file.
#
# **A name that matches nothing fails**, as `decisions-find` does and for the
# same reason: an empty answer reads as "this justfile has no such recipe", and
# that is a claim a typo can forge. A name that is not exact but is contained in
# several names lists them; contained in exactly one, it prints that one.
#
# **No name at all is the index rather than an error.** It is the only listing
# that shows the `_`-prefixed and `[private]` definitions — `just list` hides
# every selftest on purpose, and they are the ones nobody can find — and it is
# where the selftest's sweep over the real file gets its single call.
#
# **A listed row's one line is the `[doc]` text, or the comment block's *first*
# line — not its last, which is just's own rule.** `list` above records what the
# last line gives here: "35 rows of fragments torn out of mid-sentence". Every
# comment block in this file opens with its thesis, so the first line is a whole
# sentence, and the `[private]` definitions — which carry no `[doc]` precisely
# so `list` will hide them — get a description instead of nothing.
#
# Aliases are not resolved. This justfile has none, and §13 does not build a
# part with no consumer; one would fail here loudly rather than answer wrongly.
[doc("One recipe of this justfile by name, with its comment: `just recipe gate`.")]
recipe want="":
    #!/usr/bin/env bash
    set -euo pipefail
    want="$1"
    case "$want" in
    *[!A-Za-z0-9_-]*)
        echo "'$want' is not the name of a recipe or a variable" >&2
        exit 2
        ;;
    esac

    awk -v want="$want" -v path="{{recipes_file}}" '
        function defname(s,   n, rest, c) {
            sub(/^(export|unexport)[ \t]+/, "", s)
            if (match(s, /^[A-Za-z_][A-Za-z0-9_-]*/) == 0) return ""
            n = substr(s, 1, RLENGTH)
            rest = substr(s, RLENGTH + 1)
            if (rest ~ /^[ \t]*:=/) return n
            c = index(rest, ":")
            if (c == 0 || substr(rest, c + 1, 1) == "=") return ""
            return n
        }

        function blockstart(h,   s) {
            s = h
            while (s > 1 && (a[s - 1] ~ /^\[/ || a[s - 1] ~ /^#/)) s--
            return s
        }

        function blockend(h,   i, e) {
            e = h
            for (i = h + 1; i <= last; i++) {
                if (a[i] ~ /^[ \t]/ || a[i] == "") { e = i; continue }
                break
            }
            while (e > h && a[e] ~ /^[ \t]*$/) e--
            return e
        }

        function oneline(h,   i, t, p, q, first) {
            for (i = h - 1; i >= 1; i--) {
                t = a[i]
                if (t ~ /^\[doc\("/) {
                    p = index(t, "\"")
                    q = index(substr(t, p + 1), "\")]")
                    if (q > 0) return substr(t, p + 1, q - 1)
                }
                if (t ~ /^\[/) continue
                if (t ~ /^#/) {
                    t = substr(t, 2); sub(/^ /, "", t)
                    if (t != "") first = t
                    continue
                }
                break
            }
            return first
        }

        function show(j,   s, e, i) {
            s = blockstart(at[j]); e = blockend(at[j])
            print path ":" at[j]
            for (i = s; i <= e; i++) print a[i]
        }

        function row(j,   line) {
            line = sprintf("  %-26s %-32s %s", path ":" at[j], name[j], oneline(at[j]))
            sub(/[ \t]+$/, "", line)
            print line
        }

        { a[NR] = $0; last = NR }

        END {
            for (i = 1; i <= last; i++) {
                n = defname(a[i])
                if (n == "") continue
                k++
                name[k] = n
                at[k] = i
                if (n == want) exact = k
            }
            if (want == "") {
                for (j = 1; j <= k; j++) row(j)
                exit 0
            }
            if (exact) { show(exact); exit 0 }
            for (j = 1; j <= k; j++)
                if (index(tolower(name[j]), tolower(want)) > 0) hit[++m] = j
            if (m == 0) {
                print "no recipe or variable in " path " is named " want ", or contains it" \
                    > "/dev/stderr"
                exit 1
            }
            if (m == 1) { show(hit[1]); exit 0 }
            for (j = 1; j <= m; j++) row(hit[j])
        }' "{{recipes_file}}"

# Pins the extraction against a fixture rather than against this file, so it
# stays proven on a day `gate` is rewritten — the same reason
# `check-src-selftest` builds a fixture repo of its own.
#
# **The sweep at the end is the other half, and it is the half about silence.**
# A definition the scanner cannot see does not announce itself: it drops out of
# the index and out of every listing, and `just recipe <it>` then says the file
# has no such recipe — the empty answer the recipe above refuses to give. So the
# scanner's own list is held against two greps written a different way, which is
# what makes a new header shape — an alias, an attribute, a colon inside a
# default — fail here rather than disappear.
[private]
check-recipe-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    cat > "$dir/fixture" <<'JF'
    # The first line of alpha's argument.
    # The last line of alpha's argument.
    [doc("Alpha does a thing.")]
    alpha:
        echo one

        echo two

    # The first line of beta's argument.
    # The last line of beta's argument.
    [private]
    beta arg="x":
        echo beta

    # What the answer is measured against.
    export answer := "42"

    alpha-extra:
        echo three
    JF
    j="{{just_executable()}} --justfile {{justfile()}} --set recipes_file $dir/fixture"
    f="$dir/fixture"

    got=$($j recipe alpha)
    want=$(printf '%s\n' "$f:4" "# The first line of alpha's argument." \
        "# The last line of alpha's argument." '[doc("Alpha does a thing.")]' \
        "alpha:" "    echo one" "" "    echo two")
    [ "$got" = "$want" ] || { echo "recipe alpha drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$($j recipe beta)
    want=$(printf '%s\n' "$f:12" "# The first line of beta's argument." \
        "# The last line of beta's argument." "[private]" \
        'beta arg="x":' "    echo beta")
    [ "$got" = "$want" ] || { echo "a [private] recipe drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$($j recipe answer)
    want=$(printf '%s\n' "$f:16" "# What the answer is measured against." \
        'export answer := "42"')
    [ "$got" = "$want" ] || { echo "an exported assignment drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$($j recipe alph | awk '{ print $2 }')
    want=$(printf '%s\n' "alpha" "alpha-extra")
    [ "$got" = "$want" ] || { echo "an inexact name did not list both:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    $j recipe alph | grep -q 'Alpha does a thing.' || { \
        echo "the listing dropped the [doc] text"; exit 1; }

    # A `[private]` recipe has no [doc], so its row is the comment block's first
    # line. just's own rule would take the last, which is `list`'s fragments.
    row=$($j recipe | awk '$2 == "beta"')
    case "$row" in
    *"The first line of beta's argument."*) ;;
    *) echo "a row without [doc] is not the comment block's first line: $row"; exit 1 ;;
    esac

    got=$($j recipe extra)
    want=$(printf '%s\n' "$f:18" "alpha-extra:" "    echo three")
    [ "$got" = "$want" ] || { echo "one inexact match did not print the recipe:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    got=$($j recipe | awk '{ print $2 }')
    want=$(printf '%s\n' "alpha" "beta" "answer" "alpha-extra")
    [ "$got" = "$want" ] || { echo "the index is not every definition in order:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    if $j recipe no_such_recipe >/dev/null 2>&1; then
        echo "recipe found something that does not exist"; exit 1
    fi

    if $j recipe 'alpha beta' >/dev/null 2>&1; then
        echo "recipe accepted something that is not a name"; exit 1
    fi

    # The sweep. Both sides name the real file; neither is allowed to be empty,
    # because two empty lists compare equal and prove nothing.
    got=$({{just_executable()}} --justfile {{justfile()}} recipe \
        | awk '{ split($1, p, ":"); print p[2], $2 }' | sort -n)
    want=$( { grep -nE '^(export[ \t]+)?[A-Za-z_][A-Za-z0-9_-]*[ \t]*:=' {{justfile()}}; \
              grep -nE '^[A-Za-z_][A-Za-z0-9_-]*([ \t][^:]*)?:([^=]|$)' {{justfile()}}; } \
        | sed -E 's/^([0-9]+):(export[ \t]+)?([A-Za-z_][A-Za-z0-9_-]*).*/\1 \3/' | sort -n)
    n=$(printf '%s\n' "$want" | grep -c .)
    if [ "$n" -lt 80 ]; then
        echo "the greps found $n definitions in {{justfile()}}, so the sweep compared nothing"
        exit 1
    fi
    if [ "$got" != "$want" ]; then
        echo "the scanner and a plain grep disagree about what this justfile defines:"
        diff <(printf '%s\n' "$want") <(printf '%s\n' "$got") || true
        echo "a definition only one side sees is one the index drops in silence"
        exit 1
    fi

# Every test but the slow tier, then the doc tests. `test-slow` runs the tier,
# and `gate-lane` leaves that step out of a lane's gate (§397.4).
#
# **It first counts the tests `slow_tests` selects, and fails unless there is
# one for each name.** Every gate has this step, run or served, and `slow_tests`
# is in the fingerprint, so a lane that renames or splits a slow test fails its
# own gate and not the land gate after it. The filter matches binary and test
# exactly, so a name selects one test at most, and the count fails on a name
# that selects none and on a name written twice. Either would leave the list
# saying something about the tier that is not so.
[doc("Every test but the slow tier, which `test-slow` runs, and the doc tests. Fails first unless each name in `slow_tests` selects exactly one test.")]
test:
    #!/usr/bin/env bash
    set -euo pipefail
    filter=$({{ just_executable() }} _slow-tests-filter '{{ slow_tests }}')
    names=$(printf '%s\n' {{ slow_tests }})
    listed=$(cargo nextest list --workspace -E "$filter" --message-format oneline)
    named=$(grep -c . <<<"$names")
    selected=$(grep -c . <<<"$listed" || true)
    if [ "$selected" != "$named" ]; then
        echo "slow_tests names $named tests and selects $selected:"
        while read -r token; do
            grep -qxF "${token%/*} ${token##*/}" <<<"$listed" || echo "  $token selects no test"
        done <<<"$names"
        sort <<<"$names" | uniq -d | sed 's/^/  named twice: /'
        echo "a renamed or split slow test is renamed in slow_tests in the same commit (docs/decisions.md §397.4)"
        exit 1
    fi
    cargo nextest run --workspace -E "not ($filter)"
    cargo test --workspace --doc

# The slow tier `slow_tests` names, and nothing else. The land gate runs it and
# `gate-lane` does not (§397.4).
[doc("Only the slow tier, the tests `slow_tests` names. The land gate runs it; `gate-lane` leaves it out.")]
test-slow:
    #!/usr/bin/env bash
    set -euo pipefail
    filter=$({{ just_executable() }} _slow-tests-filter '{{ slow_tests }}')
    cargo nextest run --workspace --no-tests fail -E "$filter"

# `slow_tests` as a nextest filterset, `(binary_id(=B) & test(=T)) | …`. The `=`
# makes each match exact. The list comes in as a word rather than being read
# here, because a `--set` given to the caller does not reach a nested `just`,
# and `test` must count the same list it filters on.
[private]
_slow-tests-filter names:
    #!/usr/bin/env bash
    set -euo pipefail
    filter=""
    for token in {{ names }}; do
        case "$token" in
            */*) ;;
            *) echo "slow_tests names '$token', which is not binary_id/test_name" >&2; exit 1 ;;
        esac
        filter="$filter | (binary_id(=${token%/*}) & test(=${token##*/}))"
    done
    if [ -z "$filter" ]; then
        echo "slow_tests is empty, so test would leave out nothing and test-slow would run nothing" >&2
        exit 1
    fi
    echo "${filter# | }"

# The tests that are about what a release build does, built the way it ships.
#
# `test` and `test-slow` above run every one of its 1820 tests with `debug_assertions` **on**:
# `Cargo.toml` has no `[profile.release]` section and `[profile.test]` sets only
# `opt-level`, so until this recipe nothing that gates had ever built the
# shipping code path. That is not a speed question — the two profiles measured
# within 3% of each other on the same workload — it is that every
# `debug_assert!` and every `cfg!(debug_assertions)` branch is in all 1820 and
# in none of what a user gets. `ModelId` in `crates/rcad-topo/src/key.rs` is a
# counter with the assertions on and a zero-sized type without them, which
# changes what the kernel *answers*, not how fast it answers.
#
# Filtered, rather than a release arm over the whole gate. The suite is the
# slowest thing anybody here waits for and a second copy of it would buy the
# handful of tests this is about at the price of every other test being run
# twice. So one crate is built in release, and one test binary in it.
#
# `--no-tests fail` is what makes the arm worth trusting. Its tests sit behind
# `#![cfg(not(debug_assertions))]`, so a run that quietly came up in the dev
# profile — or a filter that stopped matching — selects nothing, and a run of no
# tests otherwise reports itself as a pass. `check-ignored` above says the same
# thing about itself for the same reason.
[doc("The tests about what a release build does, with the assertions off.")]
check-release-build:
    cargo nextest run --cargo-profile release -p rcad-topo --test what_only_a_release_build_does --no-tests fail

# Where the open questions live: one file per session, under the session's own
# scratchpad and never in the tree. Overridable so the selftest can point at a
# directory it builds itself, rather than at whatever sessions are live today.
questions_root := env_var_or_default("CLAUDE_QUESTIONS_ROOT", env_var_or_default("TMPDIR", "/tmp") / ("claude-" + `id -u`))

# The parser, the hooks and the shared skills live in plugins and not in this
# repo, because a copy in each repo is a copy that goes stale: `rscene` carried
# a parser that still dropped the second label of a paired entry months after
# the fix landed here.
#
# The name Claude Code knows them by, which is not derivable from the paths
# below and is not this repo's to pick: it comes from the marketplace's own
# `marketplace.json`, and an `extraKnownMarketplaces` key that disagrees with it
# registers nothing, silently.
marketplace := env_var_or_default("CLAUDE_MARKETPLACE", "mattiasgronlund-local")

# The config directory is the installation — settings, `known_marketplaces.json`,
# `installed_plugins.json` — so its absence is what "there is no Claude Code
# here" means. The recipes that need a plugin skip on it, and on `CI` never: a
# human who exports `CI` would lose the check silently, and a runner that does
# not set it would go red with nothing to act on. `docs/decisions.md` §77.
claude_config := env_var_or_default("CLAUDE_CONFIG_DIR", home_directory() / ".claude")

# Three places can hold the plugins, in this order:
#
#   `CLAUDE_PLUGINS_ROOT` — the escape hatch. A checkout elsewhere, or the
#   working tree when the point is to change a plugin and see the change. It is
#   also how one repo tries a version the shared pin has not taken: the
#   marketplace name is fixed, so one name carries one ref and this is what
#   independence looks like instead.
#
#   The marketplace clone, which is the **pinned** tree. `claude plugin
#   marketplace add mattiasgronlund/claude-questions@v0.2.0` clones the tag here
#   and leaves it, so a recipe reading it runs the version the session loaded.
#
#   `$HOME/git/…` — a machine with the repo checked out that never added the
#   marketplace.
#
# Not the install path. A github source installs under
# `<config>/plugins/cache/<marketplace>/<plugin>/<version>` — measured, and
# version-stamped — so a recipe naming it breaks at the next bump in the
# direction of "no questions found", which is the failure this whole apparatus
# exists to prevent. The clone above does not move.
#
# `$HOME`-relative and overridable rather than absolute, so a clone somewhere
# else still resolves.
marketplace_clone := claude_config / "plugins/marketplaces" / marketplace / "plugins"
plugins_root := env_var_or_default("CLAUDE_PLUGINS_ROOT", if path_exists(marketplace_clone) == "true" { marketplace_clone } else { home_directory() / "git/mattiasgronlund/claude-questions/plugins" })
questions_plugin := env_var_or_default("CLAUDE_QUESTIONS_PLUGIN", plugins_root / "questions")
guardrails_plugin := env_var_or_default("CLAUDE_GUARDRAILS_PLUGIN", plugins_root / "guardrails")

# The open questions, in full, by the hash the status line prints beside them.
#
#     just question                 the sessions that have open questions
#     just question 766405          every open question in that session, in full
#     just question 766405 Q19 Q21  those two, answered or not
#     just question 766405 --labels one line per entry, the old default
#     just question 766405 --all    the answered ones too
#     just question 766405 --json   the whole file, for a program
#
# **This recipe is for an agent. `just question-tui` is the one a person types.**
# That split is what sets the default. Terseness here used to be justified by
# what "you came for" and by a finite screen — true of a human at a terminal,
# and false of the caller this actually has. A call is billed the context it is
# made at, not the bytes it returns: across the five longest transcripts in this
# repo the mean turn bills 144 k-182 k input against 850-1 300 output, 97 % of it
# cache reads. One avoidable follow-up costs about what carrying 2 200 extra
# resident tokens for 73 further turns costs, and the largest question file in
# the tree is 2 200 tokens whole. Drilling down is a human affordance and an
# agent tax. `docs/decisions.md` §100.
#
# **The stronger reason is that a malformed entry is only readable here.** It has
# no label to print, so `--labels` can say no more than `??` with a line number
# and the status line no more than `??×1`; the TUI drops it outright. Printing
# bodies by default is what puts a broken entry in front of someone able to fix
# it. That would be worth doing at zero token cost.
#
# **The hash exists because nothing else knows the address.** The file is named
# by the session id, which only the harness has, so reading one question meant
# `!cat` on the whole file, and shell mode then charges the model for every line
# of it on every later turn.
#
# **This and `statusline.sh` are the same parser**, so an entry one of them would
# drop cannot be one the other shows. They used to be two implementations of one
# grammar held in step by a comment, and they disagreed: an entry carrying two
# labels, `**Q7 / Q11**`, counted as one, and Q11 and Q27 stayed open and
# invisible through 2026-09-06. That entry is also why naming two labels prints
# one body: what is deduped is the entry, not the label.
#
# There is deliberately no recipe that *writes* a question. A body is paragraphs
# of prose with backticks and `§` refs in it, so passing one as a shell argument
# costs what `Edit` costs and echoes the whole thing back on top; and marking one
# answered is a substitution, which is the quiet-failure shape §50.8 is about.
# For the caller this recipe is written for, `Write` already is that API.
[doc("The open questions in full, for an agent. `question-tui` is the human one.")]
question hash="" *args:
    #!/usr/bin/env bash
    set -euo pipefail
    q="{{questions_plugin}}/bin/questions.py"

    if [ -z "{{hash}}" ]; then
        exec python3 "$q" sessions "{{questions_root}}"
    fi
    file=$(python3 "$q" find "{{questions_root}}" "{{hash}}")

    mode=open
    labels=()
    given=({{args}})
    for arg in ${given[@]+"${given[@]}"}; do
        case "$arg" in
        --labels) mode=labels ;;
        --all) mode=all ;;
        --json) mode=json ;;
        --*) printf 'unknown flag %s — try --labels, --all or --json\n' "$arg" >&2; exit 2 ;;
        *) labels+=("$arg") ;;
        esac
    done

    # Before anything is printed: a program asked for the file, so it gets the
    # file and nothing appended to it.
    [ "$mode" = json ] && exec python3 "$q" json "$file"

    # A named label bypasses the open filter. Asking for Q2 and being told there
    # is no such question, because Q2 was answered an hour ago, is a worse
    # failure than the one the filter saves.
    if [ ${#labels[@]} -gt 0 ]; then
        python3 "$q" entry "$file" "${labels[@]}"
    elif [ "$mode" = labels ]; then
        python3 "$q" labels "$file"
    elif [ "$mode" = all ]; then
        python3 "$q" entries "$file" --all
    else
        python3 "$q" entries "$file"
    fi

    # The violations are named, not counted. A count is not actionable, and the
    # second call that makes it actionable pays for the whole conversation again
    # to learn three lines — 150 k tokens of context for a few hundred bytes.
    problems=$(python3 "$q" check "$file" || true)
    if [ -n "$problems" ]; then
        printf '\n'
        sed 's/^/  ⚠ /' <<<"$problems"
    fi

# The same questions, to read and answer in rather than to print.
#
# **Run it in a terminal of its own, never in a session's shell mode.** It is
# full-screen curses, so a session running it takes every frame it draws into
# the conversation and pays for them on every later turn — the cost the status
# line and `just question` exist to avoid. That is why it is a recipe of its own
# and not a flag on `question`: a flag is one keystroke from being typed in the
# wrong terminal.
#
# It never writes `open-questions.md`. It composes the answers into the text you
# would have typed and puts it on your clipboard; you paste that into the
# session's own terminal, where it arrives as your turn. An answer to a grilling
# round is consent, and consent cannot arrive as a message some other process
# sent on your behalf — the `asking-questions` skill has the argument, and it is
# the same rule as "a relayed approval is not an approval".
[doc("Read and answer the open questions. A terminal of its own, not shell mode.")]
question-tui *hash:
    @python3 {{questions_plugin}}/bin/questions-tui.py {{hash}}

# The grammar violations in one session's file, in full.
#
# **It takes a hash rather than checking everything, and that is the exemption
# mechanism.** A list of grandfathered sessions would outlive what it names —
# `/tmp` is swept at 30 days, so every id in such a list dangles within a month —
# and it would be a second record beside the thing itself, which is the shape
# §60 rejected for the hub. A dead session's file cannot be fixed, so judging it
# is noise nobody can act on; a live session's can, so it is judged.
[doc("The grammar violations in one session's question file, named in full.")]
question-check hash:
    #!/usr/bin/env bash
    set -euo pipefail
    q="{{questions_plugin}}/bin/questions.py"
    file=$(python3 "$q" find "{{questions_root}}" "{{hash}}")
    exec python3 "$q" check "$file"

# The grammar's own 20 cases live with the parser, in the `questions` plugin.
# What is left here is the seam: that the plugin is where this repo thinks it
# is, and that `just question` — which is this repo's recipe, not the plugin's —
# still reads a file end to end and still announces a violation under the
# listing. The footer is rcad's, so rcad tests it.
#
# Keeping the recipe's name is deliberate: `check-gate-runs-every-check`
# counts `check-*` recipes and this one moving out of that set would be a
# silent change to a number that exists to be loud.
#
# Skipped where there is no Claude Code. These are the plugin's own 20 cases and
# the marketplace repo's CI runs them on every push there; running them again
# out of a clone this job made was checking that repo's tree rather than this
# one's. The seam this file does own is in `check-plugins`, which exercises
# `just question` end to end.
[private]
check-questions-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -d "{{claude_config}}" ]; then
        echo "no {{claude_config}}, so no Claude Code and no plugin here: the questions cases are skipped, not passed"
        exit 0
    fi
    exec {{questions_plugin}}/bin/selftest.sh

# The three plugins this repo's `.claude/` was emptied into, checked for being
# where the recipes above think they are.
#
# It is its own recipe rather than a guard inside each caller because the answer
# is the same for all of them and it is four lines of install instructions. It
# runs early in `gate` so a missing plugin says so once, in words, instead of
# three times as "no such file or directory".
#
# `practices` ships only skills, so nothing here runs it — its directory
# existing is the whole check. A skill that fails to load fails visibly, in the
# session, which is not true of a hook or a parser.
#
# **Two questions, and the first one alone was not enough.** Where the files are
# is the bootstrap and has to be asked here, because it is what runs when the
# plugin is missing. Whether Claude Code has been *told* about them is a
# different question, and `rscene` answered it the hard way on 2026-09-08: three
# plugin directories present, this recipe green, and nothing loaded — no hooks,
# no skills, no message saying so. A directory is not an install.
#
# The second question is asked by the plugin, because the answer is the same for
# both repos and the copy is what goes stale. It cannot prove *this* session
# loaded anything — settings are read at session start — so it rules out the
# silent case and says exactly that rather than claiming more.
[doc("The three Claude plugins are on disk, and Claude Code has been told.")]
check-plugins:
    #!/usr/bin/env bash
    set -euo pipefail
    # Both questions below presuppose a Claude Code, and so does the seam test
    # at the end, which runs `just question` against the plugin's parser. Where
    # there is none, all three are skipped and this says which.
    if [ ! -d "{{claude_config}}" ]; then
        echo "no {{claude_config}}, so no Claude Code to have been told anything: the plugin checks are skipped, not passed"
        exit 0
    fi
    missing=0
    for p in "{{questions_plugin}}" "{{guardrails_plugin}}" "{{plugins_root}}/practices"; do
        [ -d "$p" ] && continue
        echo "not where this repo expects it: $p"
        missing=1
    done
    if [ "$missing" -eq 1 ]; then
        # The ref comes out of the committed settings file rather than being
        # written here, so this cannot name a version the repo is not asking
        # for.
        pin=$(jq -r '.extraKnownMarketplaces["{{marketplace}}"].source.ref // "main"' \
            .claude/settings.json 2>/dev/null || echo main)
        echo
        echo "install them with:"
        echo "  claude plugin marketplace add mattiasgronlund/claude-questions@$pin"
        echo "  claude plugin install -y questions@{{marketplace}}"
        echo "  claude plugin install -y guardrails@{{marketplace}}"
        echo "  claude plugin install -y practices@{{marketplace}}"
        echo "or point CLAUDE_PLUGINS_ROOT at your checkout's plugins directory"
        exit 1
    fi
    echo "3 plugins, all where this repo expects them"
    # On disk is not installed: clone the marketplace and never register it and
    # the files are all there while a session loads no hooks and no skills.
    # `rscene` hit exactly that. So this asks Claude Code whether it has been
    # *told* about them, which is a different question from the loop above.
    #
    # It skips where there is no Claude Code to have been told, and says so
    # rather than passing quietly. That guard used to be four lines here; it is
    # in the script now, with a selftest, because it is the same guard `rscene`
    # needs and a copy per repo is a copy that goes stale. `docs/decisions.md`
    # §77.
    "{{guardrails_plugin}}/bin/check-declared.sh" {{marketplace}} questions guardrails practices

    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    scratch="$dir/-slug-rcad/76640573-f351-4e74/scratchpad"
    mkdir -p "$scratch"
    printf '%s\n' \
        '- [ ] **Q7 / Q11** — a floor unit with no record' \
        '' \
        '  An indented body, mentioning M5 in passing.' \
        '' \
        '- [ ] **Q1** — options in prose, so the footer has something to count: (a) or (b)?' \
        > "$scratch/open-questions.md"
    j="{{just_executable()}} --set questions_root $dir"

    got=$($j question)
    want="  766405   3 open  $(date -d "@$(stat -c %Y "$scratch/open-questions.md")" +%H:%M)  rcad"
    [ "$got" = "$want" ] || { echo "the session list drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    # Captured before it is matched: `grep -q` closes the pipe on its first
    # hit, and under `pipefail` that SIGPIPE reads exactly like the output
    # having failed.
    open=$($j question 766405)
    grep -q 'indented body' <<<"$open" \
        || { echo "the default did not print bodies, only headings"; exit 1; }

    # Named, not counted. The count used to be the whole footer and cost a
    # second call at full context to find out what it meant.
    grep -q 'stated in prose but not marked' <<<"$open" \
        || { echo "the footer did not name the violation it found"; exit 1; }
    if grep -q 'grammar violation' <<<"$open"; then
        echo "the footer counted violations instead of naming them"; exit 1
    fi

    listing=$($j question 766405 --labels)
    grep -q 'Q7, Q11' <<<"$listing" \
        || { echo "--labels did not reach the plugin's parser"; exit 1; }
    grep -q 'indented body' <<<"$listing" \
        && { echo "--labels printed bodies"; exit 1; }

    # One entry, two labels. Deduping by label rather than by entry prints the
    # body twice and reads as two questions that happen to be identical.
    both=$($j question 766405 Q7 Q11)
    [ "$(grep -c 'indented body' <<<"$both")" = 1 ] \
        || { echo "an entry with two labels printed more than once"; exit 1; }

    entry=$($j question 766405 Q11)
    grep -q 'indented body' <<<"$entry" \
        || { echo "an entry did not come back in full"; exit 1; }
    python3 -c 'import json,sys; json.load(sys.stdin)' <<<"$($j question 766405 --json)" \
        || { echo "--json did not come back as json"; exit 1; }
    if $j question 766405 --nonsense >/dev/null 2>&1; then
        echo "an unknown flag was accepted"; exit 1
    fi
    if $j question zzzz >/dev/null 2>&1; then
        echo "a hash matching no session was accepted"; exit 1
    fi

# One test, or a few, with the corpus and the build cache already in place.
#
# `just test` is the whole workspace and takes minutes, so a lane wanting a
# single test reached past `just` for `mise exec -- cargo nextest run ...` and
# hand-typed the corpus path with it. On 2026-09-05 that was 456 targeted runs
# against 104 full ones, which makes the fast path the common one and the one
# worth making correct. Everything after the recipe name goes to nextest:
#
#     just t how_often_a_fuse_with_a_cone_refuses
#     just t -p rcad-geom
#     just t -E 'test(/walk/)'
#
# **The run is captured and digested rather than streamed**, because what a
# reader needs from a test run is one line when it passes and the *first* panic
# when it does not. The habit this replaces was `... 2>&1 | tail -40`, which is
# backwards on both counts: on a pass it prints 40 lines of `PASS`, and on a
# failure it prints the summary block and cuts off the panic that explains it.
# The full log is always at `target/last-test.log`, so nothing is lost — reading
# it back is one more call, and one that is only paid when it is wanted.
#
# `--no-capture` streams instead. It exists to watch output as it happens, and
# it also changes nextest's format, so digesting it would defeat the flag and
# misread it at the same time.
[doc("One test or a few, with the corpus and the build cache in place.")]
t *args:
    #!/usr/bin/env bash
    set -uo pipefail
    for arg in "$@"; do
        case "$arg" in
        --no-capture|--nocapture) exec cargo nextest run "$@" ;;
        esac
    done
    mkdir -p target
    log=target/last-test.log
    CARGO_TERM_COLOR=never cargo nextest run "$@" > "$log" 2>&1
    status=$?
    {{ just_executable() }} _test-digest "$log" "$status"
    exit $status

# The digest itself, kept apart from the run so `check-t-selftest` can hold it
# against logs whose answer is already known.
_test-digest log status:
    #!/usr/bin/env bash
    set -uo pipefail
    log='{{ log }}'
    if ! grep -qE '^ +Summary ' "$log"; then
        echo "the run did not get as far as a summary — first 40 lines:"
        head -40 "$log"
        echo "full log: $log"
        exit 0
    fi
    grep -E '^ +Summary ' "$log" | tail -1
    if [ '{{ status }}' = "0" ]; then
        exit 0
    fi
    awk '/^ +Summary /{s = 1} s && /^ +FAIL \[/' "$log"
    echo
    echo "--- the first failure in full ---"
    awk '!started && /^ +FAIL \[/ { started = 1; print; next }
         started && (/^ +(PASS|FAIL|SLOW|TRY|SKIP) \[/ || /^─/) { exit }
         started' "$log"
    failures=$(awk '/^ +Summary /{s = 1} s && /^ +FAIL \[/' "$log" | grep -c .)
    if [ "$failures" -gt 1 ]; then
        echo "$((failures - 1)) further failure(s) not shown."
    fi
    echo "full log: $log"

# Holds the digest against three logs whose right answer is known, rather than
# against whatever the suite happens to do today.
#
# The failing fixture carries a `PASS` line *between* its two failures on
# purpose. That is the shape a real `--no-fail-fast` run has, and a digest that
# printed "the first failure" by reading to the next `FAIL` would swallow the
# passing test and the second failure's header along with it.
#
# The third fixture has no summary at all, which is what a compile error looks
# like. It is the case where the head and not the tail is the useful end: rustc
# reports the first error first, and every later one may be its consequence.
[private]
check-t-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT

    printf '%s\n' \
        '────────────' \
        '    Starting 2 tests across 125 binaries' \
        '        PASS [   0.005s] (1/2) probe first' \
        '        PASS [   0.006s] (2/2) probe second' \
        '────────────' \
        '     Summary [   0.007s] 2 tests run: 2 passed, 0 skipped' > "$dir/pass.log"

    got=$({{ just_executable() }} _test-digest "$dir/pass.log" 0)
    want='     Summary [   0.007s] 2 tests run: 2 passed, 0 skipped'
    [ "$got" = "$want" ] || { echo "a passing run should be one line:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    printf '%s\n' \
        '        FAIL [   0.005s] (1/3) probe alpha' \
        '  stderr ───' \
        '' \
        "    thread 'alpha' panicked at src/lib.rs:9:9:" \
        '    the first failure has a message' \
        '' \
        '        PASS [   0.006s] (2/3) probe gamma' \
        '        FAIL [   0.007s] (3/3) probe beta' \
        '  stderr ───' \
        '' \
        "    thread 'beta' panicked at src/lib.rs:14:9:" \
        '    the second failure' \
        '' \
        '────────────' \
        '     Summary [   0.010s] 3 tests run: 1 passed, 2 failed, 0 skipped' \
        '        FAIL [   0.005s] (1/3) probe alpha' \
        '        FAIL [   0.007s] (3/3) probe beta' \
        'error: test run failed' > "$dir/fail.log"

    got=$({{ just_executable() }} _test-digest "$dir/fail.log" 1)
    want=$(printf '%s\n' \
        '     Summary [   0.010s] 3 tests run: 1 passed, 2 failed, 0 skipped' \
        '        FAIL [   0.005s] (1/3) probe alpha' \
        '        FAIL [   0.007s] (3/3) probe beta' \
        '' \
        '--- the first failure in full ---' \
        '        FAIL [   0.005s] (1/3) probe alpha' \
        '  stderr ───' \
        '' \
        "    thread 'alpha' panicked at src/lib.rs:9:9:" \
        '    the first failure has a message' \
        '' \
        '1 further failure(s) not shown.' \
        "full log: $dir/fail.log")
    [ "$got" = "$want" ] || { echo "the failing digest drifted:"; \
        echo "--- got ---"; echo "$got"; echo "--- want ---"; echo "$want"; exit 1; }

    printf '%s\n' \
        '   Compiling rcad-geom v0.0.0' \
        'error[E0425]: cannot find value `nope` in this scope' \
        'error: could not compile `rcad-geom`' > "$dir/broken.log"

    got=$({{ just_executable() }} _test-digest "$dir/broken.log" 101)
    case "$got" in
    *'did not get as far as a summary'*'cannot find value'*"full log: $dir/broken.log")
        ;;
    *)
        echo "a run that never reached a summary lost its errors:"; echo "$got"; exit 1
        ;;
    esac

    # The documented example, run for real, because it is the one that was broken.
    # It is here rather than beside the fixtures because it needs the test
    # binaries, which is why `gate` runs this recipe after `test`.
    got=$({{ just_executable() }} t -E 'test(/a_cube_comes_back_sound_and_measuring_the_same/)')
    case "$got" in
    *"1 test run: 1 passed"*)
        ;;
    *)
        echo "a parenthesised filter did not survive the recipe:"; echo "$got"; exit 1
        ;;
    esac

# `corpus/fetch.sh` rebuilds the STEP corpus from upstream, so a runner can have
# one without this repo carrying 133 MiB of other people's CAD files. The pins
# live in the script and the evidence behind them in `corpus/sources.md`.
#
# It refuses a destination that is not empty, which is the whole safety story: a
# corpus is somebody's only copy, it is in no git repository, and a mistyped
# path must not be a way to lose it. So rebuilding over an existing corpus means
# deleting it first, deliberately.
#
# Rebuilds the STEP corpus from upstream into `RCAD_STEP_CORPUS`.
[doc("Rebuild the STEP corpus from upstream into RCAD_STEP_CORPUS.")]
fetch-corpus destination=RCAD_STEP_CORPUS:
    ./corpus/fetch.sh "{{destination}}"

# CI fetches the STEP corpus (see `RCAD_STEP_CORPUS` above) with that script
# rather than having it on disk, so "CI is green" and "my machine is green" have
# to mean the same corpus. `corpus/manifest.sha256` pins the
# sha256 of every `.stp`/`.step` file the test suite reads (`files_under` in
# `crates/rcad-step/tests/every_file_in_the_corpus_reads.rs` — the walk that
# picks those two extensions, case-insensitively, and nothing else); this
# recipe is what checks a corpus against it.
#
# `sha256sum --check` already tells missing and altered apart in its own
# output — a listed file it could not open ends its line "FAILED open or
# read", one it read but that hashed wrong just ends "FAILED" — so this reads
# that rather than re-implementing it. What it cannot tell us is a `.stp`/
# `.step` file on disk the manifest never heard of, which means the corpus
# grew since the manifest was made; that half is a plain `find` against the
# manifest's own path list.
#
# Checks the STEP corpus on this machine against `corpus/manifest.sha256`.
[doc("The STEP corpus on this machine matches corpus/manifest.sha256.")]
check-corpus manifest="corpus/manifest.sha256":
    #!/usr/bin/env bash
    set -euo pipefail
    root="$RCAD_STEP_CORPUS"
    if [ ! -d "$root" ]; then
        echo "RCAD_STEP_CORPUS points at $root, which is not a directory"
        exit 1
    fi
    if [ ! -f "{{manifest}}" ]; then
        echo "{{manifest}} does not exist"
        exit 1
    fi
    manifest_abs=$(readlink -f "{{manifest}}")

    set +e
    out=$(cd "$root" && sha256sum --check --quiet "$manifest_abs" 2>&1)
    rc=$?
    set -e

    missing=$(grep ': FAILED open or read$' <<<"$out" | sed 's/: FAILED open or read$//' || true)
    mismatched=$(grep -v ': FAILED open or read$' <<<"$out" | grep ': FAILED$' | sed 's/: FAILED$//' || true)

    manifest_paths=$(cut -c67- "$manifest_abs" | sort)
    disk_paths=$(cd "$root" && find . -type f \( -iname '*.stp' -o -iname '*.step' \) -printf '%P\n' | sort)
    extra=$(comm -13 <(echo "$manifest_paths") <(echo "$disk_paths"))

    ok=1
    if [ -n "$missing" ]; then
        ok=0
        echo "named in {{manifest}} but not on disk under $root:"
        sed 's/^/  /' <<<"$missing"
    fi
    if [ -n "$mismatched" ]; then
        ok=0
        echo "on disk under $root but the contents do not match {{manifest}}:"
        sed 's/^/  /' <<<"$mismatched"
    fi
    if [ -n "$extra" ]; then
        ok=0
        echo "STEP files on disk under $root that {{manifest}} does not name:"
        sed 's/^/  /' <<<"$extra"
        echo "the corpus grew; regenerate {{manifest}} to cover the new files"
    fi
    if [ "$ok" -eq 1 ] && [ "$rc" -ne 0 ]; then
        echo "sha256sum --check failed in a way this recipe does not parse:"
        sed 's/^/  /' <<<"$out"
        exit 1
    fi
    if [ "$ok" -eq 0 ]; then
        exit 1
    fi
    echo "corpus matches {{manifest}}: $(wc -l <"$manifest_abs") files, $root"

# `check-corpus` above passed the first time it ran, on a corpus that was
# right, and that proved less than it looked like: run against corpora that
# were *wrong*, `rscene`'s copy of it named no file at all. These are the
# mutations that found that, kept as a recipe, so the next thing to silence an
# arm is caught by the gate rather than by somebody thinking to try it.
# `rscene`'s `docs/decisions.md` §12 is the finding; §79 here is what porting
# it to this repo changed. Written there and copied here, the same way
# `corpus/fetch.sh` was and for the same reason: their §12 holds the case list.
#
# **A synthetic corpus of six files, not a hardlinked copy of the real one.**
# Nothing here touches `RCAD_STEP_CORPUS`, which also means it runs on a
# machine that has never fetched a corpus — so it sits in `gate` *beside*
# `check-corpus` rather than behind it.
#
# **The filenames are the point.** `ab.stp`, `a-b.stp`, `aB.stp` and `a_c.stp`
# sort one way by byte and another by dictionary. That difference is the only
# thing that catches the bug this exists for: path lists sorted `LC_ALL=C`
# against a `comm` left in the ambient locale, which reads its input as
# disordered, exits 1, and takes the recipe down with `set -e`. Four ordinary
# names collate identically under both and would pass with that bug in place.
# `a_new.stp` is named to land *inside* the run where the two orders disagree,
# between `a_c.stp` and `ab.stp` by byte and elsewhere by dictionary, because
# `comm`'s order check only fires where it compares unequal lines.
#
# **This repo has no such bug to delete, and that is the difference from
# `rscene`.** All three of `check-corpus`'s sorts and its one `comm` are
# ambient, so they agree by construction and it is not exposed. There the
# selftest holds a fix; here it is a tripwire for an edit nobody has made. So
# the mutation that proves the fourth case is not vacuous is *adding*
# `LC_ALL=C` to the two sorts above while leaving the `comm` alone — see §79.2
# for what each mutation did.
#
# **One mutation at a time, and each case asserts the file its arm names**
# rather than the exit code. One corpus carrying three faults stops after the
# first under `set -e` and hides the other two; and an exit code standing in
# for an assertion is the layer the original bug hid inside.
[doc("check-corpus names the file for each way a corpus can be wrong.")]
check-corpus-selftest:
    #!/usr/bin/env bash
    set -euo pipefail

    dictionary=""
    for candidate in $(locale -a 2>/dev/null); do
        case "$candidate" in C|C.*|POSIX) continue ;; esac
        if [ "$(printf 'ab\na_c\n' | LC_ALL="$candidate" sort 2>/dev/null | head -1)" = "ab" ]; then
            dictionary="$candidate"
            break
        fi
    done
    if [ -z "$dictionary" ]; then
        echo "No locale here collates by dictionary order, so the case that"
        echo "would catch a collation bug in check-corpus cannot run — and the"
        echo "other three pass with that bug in place, which is worse than not"
        echo "running them at all. docs/decisions.md section 79."
        echo "  sudo locale-gen en_US.UTF-8 && sudo update-locale"
        exit 1
    fi

    work=$(mktemp -d -- "${TMPDIR:-/tmp}/rcad-corpus-selftest.XXXXXX")
    trap 'rm -rf -- "$work"' EXIT

    pristine="$work/pristine"
    mkdir -p "$pristine/nested"
    for name in ab.stp a-b.stp aB.stp a_c.stp; do
        printf 'ISO-10303-21;\n/* %s */\nEND-ISO-10303-21;\n' "$name" >"$pristine/$name"
    done
    printf 'ISO-10303-21;\nEND-ISO-10303-21;\n' >"$pristine/nested/deep one.step"
    printf 'not a STEP file\n' >"$pristine/notes.txt"

    manifest="$work/manifest.sha256"
    (cd "$pristine" \
        && find . -type f \( -iname '*.stp' -o -iname '*.step' \) -printf '%P\0' \
        | LC_ALL=C sort -z | xargs -0 sha256sum) >"$manifest"

    failed=0
    every_output=""
    check() {
        local name=$1 root=$2 want_rc=$3
        shift 3
        local out rc needle
        set +e
        out=$(RCAD_STEP_CORPUS="$root" LC_ALL="$dictionary" \
            {{ just_executable() }} check-corpus "$manifest" 2>&1)
        rc=$?
        set -e
        every_output+="$out"$'\n'
        if [ "$rc" -ne "$want_rc" ]; then
            echo "FAIL  $name: check-corpus exited $rc, wanted $want_rc"
            sed 's/^/        /' <<<"$out"
            failed=1
            return
        fi
        for needle in "$@"; do
            if ! grep -qF -- "$needle" <<<"$out"; then
                echo "FAIL  $name: nothing in the output named '$needle'"
                sed 's/^/        /' <<<"$out"
                failed=1
                return
            fi
        done
        echo "ok    $name"
    }

    mutate() {
        local into="$work/$1"
        rm -rf -- "$into"
        cp -a -- "$pristine" "$into"
        echo "$into"
    }

    # The happy path asserts two fragments rather than one sentence: this
    # repo's success line reads "corpus matches <manifest>: 5 files, <root>",
    # where `rscene`'s reads "5 files match". Copying their needle across gave
    # a case that passes without checking anything — on the one arm that is
    # supposed to be green, which is where nobody looks.
    check "a corpus that matches its manifest" "$pristine" 0 "corpus matches" "5 files"

    gone=$(mutate gone)
    rm -- "$gone/nested/deep one.step"
    check "a file the manifest names and disk lacks" "$gone" 1 \
        "not on disk" "nested/deep one.step"

    altered=$(mutate altered)
    printf 'ISO-10303-21;\n/* not what it was */\nEND-ISO-10303-21;\n' >"$altered/aB.stp"
    check "a file whose bytes changed" "$altered" 1 \
        "do not match" "aB.stp"

    grown=$(mutate grown)
    printf 'ISO-10303-21;\nEND-ISO-10303-21;\n' >"$grown/a_new.stp"
    check "a STEP file on disk the manifest never heard of" "$grown" 1 \
        "does not name" "a_new.stp"

    # `notes.txt` sits in all four corpora and is not a STEP file. If it ever
    # surfaces in an arm, `check-corpus`'s walk has stopped agreeing with
    # `files_under` in `crates/rcad-step/tests/every_file_in_the_corpus_reads.rs`,
    # which is the list `corpus/manifest.sha256` is defined against.
    if grep -qF 'notes.txt' <<<"$every_output"; then
        echo "FAIL  a file that is not STEP was reported by some arm:"
        grep -nF 'notes.txt' <<<"$every_output" | sed 's/^/        /'
        failed=1
    fi

    # No arm may leave `sha256sum`'s own wording in what it prints. The four
    # cases above cannot tell a trimmed name from an untrimmed one — a needle
    # is a substring, and `nested/deep one.step` sits inside
    # `nested/deep one.step: FAILED open or read` just as happily. Dropping
    # either of `check-corpus`'s two trims therefore passed all four when this
    # was first ported, which is a mutation surviving a suite written to catch
    # exactly that. Both are verified against this guard in §79.3.
    #
    # It is safe only while no case exercises `check-corpus`'s "failed in a way
    # this recipe does not parse" arm, which prints `sha256sum`'s output raw and
    # means to. A case that reaches that arm must assert on it rather than be
    # excused from this guard.
    if grep -qE 'FAILED( open or read)?$' <<<"$every_output"; then
        echo "FAIL  an arm printed sha256sum's wording rather than a bare name:"
        grep -nE 'FAILED( open or read)?$' <<<"$every_output" | sed 's/^/        /'
        failed=1
    fi

    [ "$failed" -eq 0 ] || exit 1
    echo "check-corpus named its file in every case, under $dictionary"

# Apart from `lint` since §381, so that `pre-gate` can run the two at once and a
# misformatted file no longer stops clippy before it has said anything.
[doc("Rust and TOML formatting, checked. `just fmt` fixes both.")]
check-fmt:
    cargo fmt --all -- --check
    taplo fmt --check

[doc("Clippy, warnings denied. Formatting is `check-fmt`.")]
lint:
    cargo clippy --workspace --all-targets -- -D warnings

[doc("cargo-deny: advisories, bans, licences, sources. No LGPL at runtime.")]
deny:
    cargo deny check

# The five fuzz recipes the overnight run starts. They run together, so this is
# the order they are started and waited on and not the order they get the
# machine — but it is still the order the summary line names them in.
#
# Recipe names rather than fuzz-target names, because what each target wants on
# its command line is the recipe's business and not this list's.
fuzz_all := "fuzz fuzz-reader fuzz-writer fuzz-fuse fuzz-cones-and-tori"

# Where a night's logs go. One directory per date, plus a one-line `latest`.
fuzz_log_root := env_var_or_default("RCAD_FUZZ_LOGS", env_var("HOME") / "rcad-fuzz-logs")

# Where systemd looks for the timers. An argument only so `check-systemd-units`'s
# selftest can point it somewhere hermetic; nothing else sets it.
systemd_user_dir := env_var_or_default("RCAD_SYSTEMD_USER", env_var("HOME") / ".config/systemd/user")

# Where the overnight run accumulates what it finds worth keeping.
#
# **Outside the tree, and that is the whole of decision §81.** The corpus under
# `fuzz/corpus/` is tracked, 30 MB of it; eight hours a night would add
# thousands of files to it, so the tree would be dirty every morning and every
# lane would merge past a thousand-file commit it never read. So the tracked
# corpus is handed to libFuzzer as a *read-only seed* and the night's own
# findings land here. What is worth keeping is promoted into `fuzz/corpus/` by
# hand, which is a thing somebody decided rather than a thing that accrued.
fuzz_corpus_root := env_var_or_default("RCAD_FUZZ_CORPUS", env_var("HOME") / "rcad-fuzz-corpus")

# Fuzz every target at once, inside a fixed window, unattended.
#
# `window` is seconds, and it is a *deadline* and not a budget: the window is
# measured against the clock once the build is done, so a slow build is paid for
# out of the same window rather than added to the end of it. The 08:10 in
# `rcad-fuzz.timer` is that deadline.
#
# **All five together, each for the whole window.** Until 2026-09-18 they ran in
# turn on a fifth of the window each, which put one core of 24 to work and left
# the other 23 idle for eight hours. Nothing is shared between the five, so the
# only thing sequencing bought was politeness, and `Nice=10` buys that already.
#
# A crash does not end the night. `cargo fuzz` exits non-zero and writes the
# input to `fuzz/artifacts/<target>/` (ignored, so it survives a `git clean`
# without dirtying anything), and a crash in the reader is no reason to cost the
# fuse its hours — so each target is reported and the run carries on, failing at
# the end if anything failed. A crash still ends *that* target's night, which is
# the next thing to fix.
#
# Same nightly-compiler caveat as `fuzz` below.
[doc("Fuzz all five targets at once, inside a window in seconds. What the timer runs.")]
fuzz-overnight window="28800":
    #!/usr/bin/env bash
    set -euo pipefail

    # The same parse `check-hub` uses: git documents the main working tree as
    # the first entry. An eight-hour job in the hub is the one kind of work that
    # cannot be seen — `git worktree lock` refuses there, so `just lanes` would
    # show `free` all night beside a tree somebody is using (docs/decisions.md
    # §60). Give the timer a worktree of its own and lock it.
    listing=$(git worktree list --porcelain)
    hub=$(awk '/^worktree /{print $2; exit}' <<<"$listing")
    if [ "$(grep -c '^worktree ' <<<"$listing")" -gt 1 ] \
        && [ "$(git rev-parse --show-toplevel)" = "$hub" ]; then
        echo "this is the hub, and nobody works in the hub: $hub"
        echo "  an unattended run here can never be recorded as anyone's; point the"
        echo "  timer at a locked worktree instead:"
        echo "      git worktree add ../rcad-fuzz && git worktree lock ../rcad-fuzz --reason 'overnight fuzzing'"
        exit 1
    fi

    deadline=$(( $(date +%s) + {{window}} ))
    night="{{fuzz_log_root}}/$(date +%Y-%m-%d)"
    mkdir -p "$night"

    # Per-run timings, which libFuzzer keeps none of. Its `Slowest unit:` line
    # ratchets and is whole seconds, so a night that ran a thousand slow inputs
    # leaves one behind and says nothing about how the rest were spread. Each
    # target writes a percentile table and its slowest inputs under here, named
    # so they can be handed straight back to `cargo fuzz run`.
    #
    # Exported rather than passed, because it has to reach past `just`, `cargo`
    # and `cargo-fuzz` to the target's own process, and every one of those
    # passes the environment through untouched.
    export RCAD_FUZZ_TIMINGS="$night/timings"

    # The night follows the tip of `main` (docs/decisions.md §186).
    #
    # §81.4 refused to advance this tree at all and priced the cost as a timer
    # that can sit on one commit for a month. That cost came due on the third
    # night: the run of 2026-09-11 re-found §85's crash on a base from two days
    # earlier, twelve hours after the fix for it went green. What the refusal was
    # buying is a revert, and `main` has had one in 1003 commits.
    #
    # §90 then made it follow the last *green* commit, and that bought the same
    # staleness back in a smaller size: the night of 2026-09-21 fuzzed a commit
    # from before §182's fix and re-found that fix's family. Every morning's
    # finding is replayed against `main` by `fuzz-triage`, which
    # `rcad-fuzz-triage.timer` runs at 08:30 (§410), so a tip that nothing has
    # read yet costs at most a finding that triage calls stale.
    #
    # Deciding is separate from doing, in `fuzz-watermark` below, so that what
    # the night would move to can be asked without moving anything.
    if [ -n "${RCAD_FUZZ_ALREADY_ADVANCED:-}" ]; then
        echo "standing where the night that started this one put us"
    else
        target=$({{just_executable()}} fuzz-watermark 2>"$night/watermark.log") || true
        cat "$night/watermark.log"
        if [ -n "$target" ]; then
            echo "advancing to $target, the tip of main"
            git checkout --quiet --detach "$target"

            # **Start again, from the justfile that was just checked out.** `just`
            # hands bash the whole recipe body before the first line of it runs,
            # so without this a change to this recipe takes effect the night
            # *after* it lands. That is not a hypothetical: the night of
            # 2026-09-14 kept none of the six artifacts it found, because the
            # body it was running had been read from a commit of 2026-09-11 and
            # §91's copy-out landed on 2026-09-13.
            #
            # **A night advances once.** The commit just checked out was the
            # tip a moment ago, so the recipe taking over would almost always
            # find nothing to move to and stop of its own accord — but "almost
            # always" is a bound on how often `main` moves and not on this loop,
            # and a night that spent itself chasing a busy branch would say
            # nothing about why. The night fuzzes the tip as of when it started.
            export RCAD_FUZZ_ALREADY_ADVANCED=1
            exec {{just_executable()}} fuzz-overnight "$(( deadline - $(date +%s) ))"
        fi
    fi

    # How far behind `main` the night is, which is the indicator §81.4 asked for
    # and did not get. It printed the commit's *age*, and a commit can be one day
    # old and sixty-eight commits behind — which is exactly what `latest` read on
    # the night that proved nothing. Age answers "when was this written"; the
    # question is "what has landed since".
    commit=$(git rev-parse --short HEAD)
    age=$(( ( $(date +%s) - $(git log -1 --format=%ct) ) / 86400 ))
    behind=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo '?')
    echo "fuzzing $commit ($age days old, $behind behind main) until $(date -d "@$deadline" '+%H:%M:%S'), logs in $night"

    # Built once, before the window is divided, so that the compiler comes out
    # of the night as a whole and not out of whichever target went first.
    #
    # `RUSTC` points at the stand-in (docs/decisions.d/267.4, §292): cargo-fuzz
    # hands every crate the same coverage flags through `RUSTFLAGS`, with no
    # allow-list, so the only working way to leave `rcad-fuzz-timing`
    # uninstrumented is to catch its compile in a script that appends a second,
    # overriding `-sanitizer-coverage-level` and let everything else through.
    # `CI=1` keeps kache out of this build: the `cargo` on this PATH is mise's
    # shim, and it puts `RUSTC_WRAPPER=kache` back on every call unless `CI` is
    # set, which would run kache *around* the stand-in and risk a cache key
    # computed before the flag is appended. §292 keeps kache out rather than
    # answers whether it would in fact conflate the two builds.
    if ! (cd fuzz && CI=1 RUSTC="{{ justfile_directory() }}/fuzz/rustc-stand-in.sh" \
            RUSTFLAGS="-C target-cpu=x86-64-v3" \
            cargo +nightly fuzz build) >"$night/build.log" 2>&1; then
        tail -n 20 "$night/build.log"
        echo "the fuzz targets did not build, so nothing was fuzzed: $night/build.log"
        # Which advice is the right advice depends on whether there is a `cargo`
        # here at all. On 2026-09-15 there was not, and the night printed the
        # nightly sentence over a `build.log` reading `cargo: command not found`
        # — the one operator-facing line it wrote, naming the one thing that was
        # never the question (§108.2).
        if command -v cargo >/dev/null 2>&1; then
            echo "nightly is not pinned by this repo (docs/decisions.md §29.9); \`rustup toolchain install nightly\` is the usual answer"
        else
            echo "there is no \`cargo\` on this PATH at all, so the toolchain is not the question:"
            echo "  PATH=$PATH"
            echo "a systemd run gets no profile. rcad-fuzz.service sets PATH itself for this reason, and \`just check-systemd-units\` says whether the copy systemd runs is the one in the tree"
        fi
        printf '%s  BUILD FAILED  %s\n' "$(date '+%Y-%m-%d %H:%M')" "$night" >"{{fuzz_log_root}}/latest"
        exit 1
    fi

    # A stale build would pass silently: cargo's fingerprint cannot see a flag
    # the stand-in adds on top of `RUSTFLAGS`, so a build made before the
    # stand-in existed, or made with it broken, looks exactly as fresh as one
    # made with it working, and `cargo fuzz run` below would not know to redo
    # it. So the night checks the artifact rather than trusting the build that
    # made it: `rcad-fuzz-timing`'s rlib lands under `build/<pkg>-<hash>/out/`
    # on this nightly rather than under `deps/`, because that is the directory
    # cargo passes as `--out-dir` for a lib crate here — found by name since the
    # hash in the path is not otherwise known.
    timing_rlibs=$(find fuzz/target/x86_64-unknown-linux-gnu/release/build/rcad-fuzz-timing \
        -name 'librcad_fuzz_timing-*.rlib' 2>/dev/null)
    if [ -z "$timing_rlibs" ]; then
        echo "rcad-fuzz-timing's rlib was not found by name after the build, so whether it carries coverage could not be checked"
        printf '%s  BUILD FAILED  %s\n' "$(date '+%Y-%m-%d %H:%M')" "$night" >"{{fuzz_log_root}}/latest"
        exit 1
    fi
    # More than one of these can exist at once — a hash directory left over
    # from before the stand-in was wired in, or from a build made with
    # different flags, sitting beside the one this build just made — and
    # `find`'s order between them is not the order they were written in, so
    # `| head -n1` used to read whichever one it met first (Q288, Q857).
    # There is no mtime to sort by instead: a `cargo build` that changes
    # nothing does not even touch the files in the directory it would have
    # written to, checked directly by running the same build twice and
    # comparing `find -printf '%T@'` before and after — every file, including
    # `fingerprint/invoked.timestamp`, kept the first run's timestamp to the
    # microsecond. So this checks every rlib `find` turns up, not one chosen
    # among them, and fails if *any* carries a sancov reference. That can
    # still fail a night over a stale rlib this build did not write — a build
    # failure that costs a retry — but it can never pass a night whose
    # current rlib carries one, which is the fault that must not happen.
    sancov_found=()
    while IFS= read -r candidate; do
        [ -n "$candidate" ] || continue
        refs=$(nm "$candidate" 2>/dev/null | grep -ic sancov || true)
        [ "$refs" -eq 0 ] || sancov_found+=("$candidate ($refs)")
    done <<<"$timing_rlibs"
    if [ "${#sancov_found[@]}" -gt 0 ]; then
        echo "rcad-fuzz-timing's rlib carries a sancov reference, so the stand-in did not keep it out of coverage:"
        printf '    %s\n' "${sancov_found[@]}"
        printf '%s  BUILD FAILED  %s\n' "$(date '+%Y-%m-%d %H:%M')" "$night" >"{{fuzz_log_root}}/latest"
        exit 1
    fi

    # `docs/decisions.d/273` found the timing crate itself, in a fuzz target's
    # own build, making calls that reach libFuzzer's `__sanitizer_weak_hook_*`
    # memcmp-family hooks from outside `SlowRun::is` — handing it bytes from a
    # `totals` file or a `slowest/` name to libFuzzer's mutator whenever the
    # crate's own bookkeeping compares unequal mid-draw. Checked here, after
    # every target's own binary exists and before any of them is started, so a
    # build that reintroduces one fails loudly instead of quietly steering the
    # night's mutations. `RCAD_FUZZ_TIMING_CHECK` overrides which script runs,
    # for `check-fuzz-overnight-selftest` alone; nothing else sets it.
    timing_check="${RCAD_FUZZ_TIMING_CHECK:-{{ justfile_directory() }}/fuzz/timing-hooked-calls.py}"
    if ! "$timing_check" \
            fuzz/target/x86_64-unknown-linux-gnu/release/where_two_surfaces_cross \
            fuzz/target/x86_64-unknown-linux-gnu/release/no_step_file_makes_the_reader_panic \
            fuzz/target/x86_64-unknown-linux-gnu/release/no_model_makes_the_writer_panic \
            fuzz/target/x86_64-unknown-linux-gnu/release/two_solids_fused_by_a_stranger \
            fuzz/target/x86_64-unknown-linux-gnu/release/where_a_cone_or_a_torus_crosses \
            >"$night/timing-hooked-calls.log" 2>&1; then
        tail -n 20 "$night/timing-hooked-calls.log"
        echo "the timing crate reaches a memcmp-family hook from outside SlowRun::is: $night/timing-hooked-calls.log"
        printf '%s  BUILD FAILED  %s\n' "$(date '+%Y-%m-%d %H:%M')" "$night" >"{{fuzz_log_root}}/latest"
        exit 1
    fi

    # The input a target found is kept beside the log that describes it, because
    # `fuzz/artifacts/` is the wrong place to leave the only copy of anything
    # (§91). Two reasons, and each one lost a finding.
    #
    # **libFuzzer never reads that directory back as a seed.** So the next night
    # starts from a corpus without the crash in it, rolls a fresh seed, and does
    # not re-find it: on 2026-09-13 a night reported "nothing found" on the very
    # commit the night before had crashed on, and nothing had been fixed in
    # between.
    #
    # **It lives in this worktree, and `.gitignore` hides it.** §89's slow unit
    # sat there as its only copy for three days in a tree that had been unlocked
    # and was due to be reclaimed.
    #
    # `-n` makes the repeat cheap and keeps the first copy of a name that
    # libFuzzer rewrites.
    copy_out() {
        [ -d fuzz/artifacts ] || return 0
        mkdir -p "$night/artifacts"
        cp -Rn fuzz/artifacts/. "$night/artifacts/" 2>/dev/null || true
    }

    # **On a clock, and not at each target's end, because the ends are all in
    # the same minute now.** The reason §91 wanted this at all is a night killed
    # from outside, and the sequential loop got its protection for free: four
    # target boundaries spread across the night, about ninety minutes apart. Run
    # together, the five targets finish within seconds of each other and there
    # are no boundaries left before the deadline — so a night killed at 04:00
    # would keep nothing, which is worse than what this replaced rather than
    # better. An interval so a test can afford one.
    # `kill "$copier"` below reaches the subshell, not whatever it is
    # currently running: a bare `sleep` inside it is a separate process, and a
    # shell killed by SIGTERM while blocked in `wait` does not pass the signal
    # on to a child it never trapped for. Q806: the subshell's own `sleep 300`
    # kept running with `ppid 1` after the subshell that started it was gone,
    # and `check-fuzz-overnight-selftest`'s eight `run()`s a gate left about
    # sixteen of them. The `trap … TERM` here is what the subshell needs to
    # kill its own `sleep` before it exits — `wait "$sleep_pid"` is what makes
    # that `$sleep_pid` current no matter where in the loop the signal lands.
    copy_every="${RCAD_FUZZ_COPY_EVERY:-300}"
    ( trap 'kill "${sleep_pid:-}" 2>/dev/null; exit' TERM
      while :; do
          sleep "$copy_every" &
          sleep_pid=$!
          wait "$sleep_pid"
          copy_out
      done ) &
    copier=$!
    trap 'kill "$copier" 2>/dev/null || true' EXIT

    # **Every target for the whole window, all five at once, rather than a fifth
    # of the window each.** One target at a time was one core of 24 (§81), and
    # the night of 2026-09-18 spent 8 core-hours of the 192 it could have had.
    # Nothing here is shared: each target has its own corpus directory, its own
    # log, and its own `RCAD_FUZZ_TIMINGS/<target>/` — so the five are
    # independent processes that happen to start together, and peak resident was
    # 689 MB apiece against 125 GB.
    #
    # `Nice=10` and `IOSchedulingClass=idle` in `rcad-fuzz.service` are what make
    # this polite rather than rude, and children inherit both: a lane compiling
    # at three in the morning still wins every core it asks for.
    #
    # The five `cargo fuzz run`s serialise for a few seconds at startup on the
    # build directory lock, each doing the no-op build that `cargo fuzz build`
    # above already did. That is the whole cost of not having a flag to skip it.
    recipes=({{fuzz_all}})
    to_look_at=()
    left=$(( deadline - $(date +%s) ))
    pids=()
    started=()

    # The machine, split five ways, because all five run at once. `nproc` and not
    # a number in the file: 24 here, and a recipe carrying `4` would quietly
    # under-use a bigger machine and thrash a smaller one. A floor of 1, since
    # `-fork=1` still isolates the crash even where there is no parallelism left
    # to win — and `-fork=0` would mean "don't fork", which is a different night.
    fork=$(( $(nproc) / ${#recipes[@]} ))
    [ "$fork" -ge 1 ] || fork=1

    # Which artifacts are **this night's**, as opposed to every night's.
    #
    # `fuzz/artifacts/` is gitignored, so it survives across nights in the tree
    # the timer keeps checked out, and `copy_out` below copies all of it. The
    # count in the summary has always been carry-over for that reason. It could
    # stay a wart while the count was only ever *reported*; now that a crash file
    # is what says a night failed (§134), a five-day-old crash would fail every
    # night from here on, which is the same "night nobody believes" §91 exists to
    # prevent, running the other way.
    #
    # A marker of when tonight began, kept for whoever reads the directory by
    # hand afterwards (docs/decisions.d/240's own reading of it against
    # `build.log` and the "Running" line). §270.3 found the summary below
    # cannot use it as `-newer` once did: a `-fork` worker rewrites a name
    # already on disk, unchanged bytes and all, and that rewrite bumps the
    # mtime exactly as a genuine new find would — on 2026-09-26, 71 timeouts
    # and 42 slow units that were byte-identical copies of the previous
    # night's own files got counted as new because `-newer "$since"` cannot
    # tell the two apart. The listing below is what replaces it.
    since="$night/.started"
    : >"$since"

    # Which files each target's writable corpus already held, before any
    # target is started tonight — the record §240.3 and §240.7 say an mtime
    # alone cannot give: a later night's `-merge=1` rewrites whatever file
    # already sits at the same name, same bytes, with a fresh mtime, so a
    # file's mtime says only when some night's merge last decided it was new
    # to that night, not which night actually found it first. A file's
    # arrival night is the first night whose list here names it — nothing
    # later ever has to ask its mtime again.
    #
    # One list per target, and each one is the target's own *writable*
    # directory under `{{fuzz_corpus_root}}` — the only place a file can
    # arrive tonight, by libFuzzer's own write or by tonight's own merge
    # below:
    #
    #   - the four non-reader targets write straight into
    #     `{{fuzz_corpus_root}}/<target>`, so that is what is listed for them.
    #   - the reader writes tonight into `…-scratch`, not
    #     `{{fuzz_corpus_root}}/no_step_file_makes_the_reader_panic` — but the
    #     scratch directory is one the night makes fresh (or inherits
    #     unmerged from a night that died before its own merge, §237), so it
    #     says nothing yet about which night a file belongs to. What Q237's
    #     merge folds tonight's scratch *into* is the same persistent
    #     directory every other target already has one of, so that is what is
    #     listed for the reader too — named once, from the same directory a
    #     later night's rewrite would land in.
    #
    # `fuzz/corpus/` — the tracked one — is not among them: it is handed to
    # libFuzzer as a read-only seed for every target (§81) and nothing ever
    # writes into it during a night, so no list would ever gain a name there.
    mkdir -p "$night/corpus-names"
    for target in where_two_surfaces_cross no_step_file_makes_the_reader_panic \
            no_model_makes_the_writer_panic two_solids_fused_by_a_stranger \
            where_a_cone_or_a_torus_crosses; do
        target_corpus="{{fuzz_corpus_root}}/$target"
        if [ -d "$target_corpus" ]; then
            find "$target_corpus" -maxdepth 1 -type f -printf '%f\n' | sort \
                >"$night/corpus-names/$target"
        else
            : >"$night/corpus-names/$target"
        fi
    done

    # Which artifact names `fuzz/artifacts/<target>/` already held, before any
    # target is started tonight — what the summary below diffs against instead
    # of trusting mtime. libFuzzer names every artifact its prefix plus the
    # SHA-1 of the input's bytes (`WriteUnitToFileWithPrefix`,
    # `FuzzerLoop.cpp:647`, hashed by `Hash()` in `FuzzerSHA1.cpp:218` — both
    # in libfuzzer-sys's vendored copy under `~/.cargo/registry`), so a name
    # already on this list is bytes a night has already seen, however many
    # times a `-fork` worker rewrites it tonight.
    mkdir -p "$night/artifact-names-before"
    if [ -d fuzz/artifacts ]; then
        for target_dir in fuzz/artifacts/*/; do
            [ -d "$target_dir" ] || continue
            target=$(basename "${target_dir%/}")
            find "$target_dir" -maxdepth 1 -type f -printf '%f\n' | sort \
                >"$night/artifact-names-before/$target"
        done
    fi

    for recipe in "${recipes[@]}"; do
        # No floor beyond "there is time left". A minimum worth starting would
        # be a number nobody can defend — an 18 MB corpus takes seconds just to
        # load, so the honest floor depends on the target — and it would make
        # the window untestable at any size a test can afford to wait for.
        if [ "$left" -lt 1 ]; then
            echo "$recipe: skipped, $left s left in the window" | tee -a "$night/$recipe.log"
            to_look_at+=("$recipe:no-time")
            continue
        fi
        echo "$recipe: $left s"
        # libFuzzer's own `-timeout` bounds one input and not the process, and a
        # target wedged outside the fuzzer's control would eat the whole night.
        # The grace is for the corpus write on the way out.
        timeout --kill-after=60 "$(( left + 300 ))" \
            {{just_executable()}} "$recipe" "$left" "{{fuzz_corpus_root}}" "$fork" \
            >"$night/$recipe.log" 2>&1 &
        pids+=("$!")
        started+=("$recipe")
    done

    # Waited in the order they were started, which is not the order they finish.
    # It costs nothing: they were all given the same deadline, so the last wait
    # returns within seconds of the first however they are ordered, and reading
    # them in a fixed order keeps the summary's list stable night to night.
    # **`$status` here says nothing about the night**, in either direction, and
    # reading it as "crash" is how a night stops being believed.
    #
    # `$status` is `cargo fuzz run`'s own exit code, not libFuzzer's. libFuzzer's
    # fork parent keeps one `ExitCode`, overwrites it with each job it collects,
    # never resets it, and exits with it — `FuzzerFork.cpp:400-461` and the
    # `exit(ExitCode)` at 490, under the comment *"Use the exit code from the
    # last child process"* — so a job that only timed out can leave the fuzz
    # binary's own process exiting 70: non-zero, as a crash in that job would
    # leave it too, with 77 or a signal (§134.2). But
    # `cargo fuzz run`'s `exec_fuzz` never passes that 70 on: it turns any
    # non-zero child status into a bail, and a plain `fn main() -> Result<()>`
    # turns any bail into a flat process exit of 1 (§275.1). So a last job that
    # only timed out reads here as 1, indistinguishable from a real crash in the
    # last job — a status mapping that trusted 1 as "crash" would be wrong. And
    # the other direction is still open: a crash in job 3 of 40 000, with the
    # last job clean, exits the fuzz binary 0, which `cargo fuzz run` passes
    # through unchanged, so a status mapping that trusted 0 as "clean" would be
    # wrong too.
    #
    # What is left that the status can still answer is the one thing no child
    # decides: `timeout` killing the whole target from outside.
    for i in "${!started[@]}"; do
        recipe="${started[$i]}"
        status=0
        wait "${pids[$i]}" || status=$?
        case "$status" in
            124|137)
                echo "$recipe: overran the window and was killed"
                to_look_at+=("$recipe:overran") ;;
            *)
                # The fuzzer ran, and ran to the end. `INFO: exiting:` is the last
                # line `FuzzWithFork` prints before `exit`, so it is present
                # exactly when the fork loop finished of its own accord — which is
                # the question the exit status used to be asked and can no longer
                # answer. A target whose build or launch failed prints nothing of
                # the sort, and that is a night that fuzzed four targets while
                # reporting five.
                grep -q '^INFO: exiting:' "$night/$recipe.log" \
                    || { echo "$recipe: never got fuzzing (exited $status) — see $night/$recipe.log"
                         to_look_at+=("$recipe:no-run"); } ;;
        esac
        copy_out
    done

    kill "$copier" 2>/dev/null || true
    trap - EXIT
    copy_out

    # Every night so far has copied the whole of `fuzz/artifacts/` again, so a
    # name 21 nights hold is 21 copies of the same bytes (docs/decisions.d/436
    # §436.3, §436.4). From here on, a file tonight holds that the nearest
    # earlier night also holds — same target, same name — becomes a hard link
    # to that night's file instead of a second copy.
    #
    # By name first: every name libFuzzer writes is the prefix plus the SHA-1
    # of its own bytes (`WriteUnitToFileWithPrefix`, `FuzzerLoop.cpp:647`), so
    # two nights agreeing on a name already claim the same bytes. **Checked
    # against the tree, not trusted from the name**: the copier above runs
    # every five minutes while a target writes, so a name can be `cp -n`'d out
    # of a half-written file, and `-n` then keeps that short copy for the rest
    # of the night (and, without this check, for every later night linked to
    # it). So a file is linked only once the earlier night's copy is checked
    # to hold the same bytes as `fuzz/artifacts/` does right now — which, this
    # late, with every target stopped, no longer changes.
    #
    # This runs after this last `copy_out` and not any earlier one: only now
    # has every target stopped, so only now is `fuzz/artifacts/` done
    # changing under the files this reads.
    #
    # **Never a link into the tree.** libFuzzer reopens a name it has written
    # before with `fopen(…, "wb")` (`FuzzerIO.cpp:82`), which truncates it, so
    # a link to `fuzz/artifacts/` itself would be cut short by the next night
    # that rewrites the name — and so would every later night linked to this
    # one. Only ever linked to another night's own copy.
    #
    # Made under a temporary name outside `artifacts/` and renamed into place,
    # so a night killed mid-link leaves no stray name for `fuzz-triage` or
    # `fuzz-yield` to trip on — `mv` within `$night` is one rename, and nothing
    # reads `$night` itself as artifacts.
    #
    # One Python process walking `$night/artifacts/` itself, rather than a
    # shell loop forking `cmp`, `mktemp`, `ln` and `mv` once per file (Q1753):
    # that loop was correct — `thirty`/`thirty_one`/`thirty_two` below pass
    # against it unchanged — but on `cp -R` copies of the 2026-10-08 and
    # 2026-10-09 nights (about 87 000 and 91 000 files) it had not finished
    # after 220 s, the point it was killed. Every decision below is the
    # shell loop's own: `os.path.isfile` is `[ -f ]`, `filecmp.cmp(...,
    # shallow=False)` reads both files and is `cmp -s`, and `os.link` then
    # `os.replace` is `ln -f` then `mv -f` — a temporary name under `$night`,
    # outside `artifacts/`, renamed into place, so a night killed mid-link
    # still leaves no stray name. None of the three forks a process.
    link_started=$(date +%s)
    python3 - "$night" "{{fuzz_log_root}}" "$link_started" <<'PY'
    import filecmp
    import os
    import sys
    import time

    night, log_root, link_started = sys.argv[1], sys.argv[2], int(sys.argv[3])
    night_name = os.path.basename(night)

    def is_night_dir(name):
        return (
            len(name) == 10
            and name[4] == "-"
            and name[7] == "-"
            and name[:4].isdigit()
            and name[5:7].isdigit()
            and name[8:].isdigit()
        )

    earlier = None
    if os.path.isdir(log_root):
        for name in sorted(os.listdir(log_root)):
            if not is_night_dir(name) or name >= night_name:
                continue
            candidate = os.path.join(log_root, name)
            if os.path.isdir(os.path.join(candidate, "artifacts")):
                earlier = candidate

    linked = 0
    night_artifacts = os.path.join(night, "artifacts")
    if earlier is not None and os.path.isdir(night_artifacts):
        for target in sorted(os.listdir(night_artifacts)):
            target_dir = os.path.join(night_artifacts, target)
            if not os.path.isdir(target_dir):
                continue
            for name in sorted(os.listdir(target_dir)):
                tonight_file = os.path.join(target_dir, name)
                if not os.path.isfile(tonight_file):
                    continue
                earlier_file = os.path.join(earlier, "artifacts", target, name)
                tree_file = os.path.join("fuzz", "artifacts", target, name)
                if not os.path.isfile(earlier_file) or not os.path.isfile(tree_file):
                    continue
                if not filecmp.cmp(earlier_file, tree_file, shallow=False):
                    continue
                link_tmp = os.path.join(
                    night, "link-tmp." + str(os.getpid()) + "-" + name
                )
                if os.path.lexists(link_tmp):
                    os.remove(link_tmp)
                os.link(earlier_file, link_tmp)
                os.replace(link_tmp, tonight_file)
                linked += 1

    link_elapsed = int(time.time()) - link_started
    with open(os.path.join(night, "link-artifacts.log"), "w") as f:
        f.write(
            "linked "
            + str(linked)
            + " file(s) to the nearest earlier night's copies, took "
            + str(link_elapsed)
            + "s\n"
        )
    PY

    # The reader's STEP-corpus finds, merged out of tonight's scratch directory
    # and into the small persistent corpus `fuzz-target` seeds the next night
    # from, at a smaller `-max_len` (docs/decisions.md §295.6, §295.7). Gated on
    # the scratch directory existing rather than on `RCAD_STEP_CORPUS` again:
    # `fuzz-target` only ever creates it inside the branch that already checked
    # `RCAD_STEP_CORPUS` is a real directory, so its absence already says a
    # night with nothing fetched there took no scratch branch at all — the
    # night that keeps today's behaviour, with neither a scratch directory nor
    # a merge.
    reader_target="no_step_file_makes_the_reader_panic"
    reader_persistent="{{fuzz_corpus_root}}/$reader_target"
    reader_scratch="{{fuzz_corpus_root}}/$reader_target-scratch"
    if [ -d "$reader_scratch" ]; then
        mkdir -p "$reader_persistent"
        scratch_bytes=$(du -sb "$reader_scratch" 2>/dev/null | cut -f1)
        persistent_files_before=$(find "$reader_persistent" -type f | wc -l)
        {
            echo "reader corpus merge: scratch is ${scratch_bytes:-0} bytes; persistent has $persistent_files_before files before merging"
        } >"$night/reader-corpus-merge.log"

        # Merged into a fresh copy of the persistent corpus, and only swapped
        # in on success, so a merge that times out or crashes partway through
        # never leaves the persistent corpus half-written — libFuzzer's merge
        # mutates its first argument in place as it goes, and that argument
        # must never be the real thing. A merge that fails this way is not
        # retried: tonight's scratch directory is moved aside with a
        # timestamp instead of being deleted, since `fuzz-target` always
        # starts the next night from a fresh, empty scratch directory and
        # would otherwise silently overwrite it — moving it aside is what
        # keeps tonight's un-merged finds around for a person to look at.
        merge_tmp=$(mktemp -d "{{fuzz_corpus_root}}/$reader_target-merge-tmp.XXXXXX")
        cp -R "$reader_persistent/." "$merge_tmp/" 2>/dev/null || true

        # Bounded, because libFuzzer's own `-merge=1` carries no deadline of
        # its own and this runs after the window above is already spent —
        # every second it takes is a second off `rcad-fuzz.service`'s outer
        # grace (`TimeoutStartSec=29400`, 600 s past the 28800 s window this
        # recipe divides among the five targets) before systemd kills the
        # whole night from outside, merge and all. A merge that hits this
        # bound is treated exactly like one that fails outright below: it has
        # left the corpus in whatever state the kill caught it in, so that
        # state is never swapped in. 120 s is two orders of magnitude over
        # §295.6's own measured cost (about a second), with most of the 600 s
        # still free for whichever target's own `timeout --kill-after=60`
        # grace ran long, and for the summary this recipe still has to write.
        # `RCAD_FUZZ_MERGE_TIMEOUT` overrides it for
        # `check-fuzz-overnight-selftest` alone; nothing else sets it.
        merge_timeout="${RCAD_FUZZ_MERGE_TIMEOUT:-120}"

        # `-merge=1` replays every file in `$reader_scratch` through the reader
        # target's own binary, which calls `timed()` on every draw (Q263: `just
        # src timed`, and the reader target's own `fuzz_target!` wraps its one
        # call in it). `RCAD_FUZZ_TIMINGS` is still exported from the top of
        # this recipe, so without this, each of tonight's replayed finds lands
        # in `timings/no_step_file_makes_the_reader_panic` beside the real
        # draws the five targets above just made — inputs Q174 compares a
        # week of night to night are not draws. `env -u` scopes the unset to
        # this one command; nothing after it should ever see the variable
        # missing.
        merge_started=$(date +%s)
        if (cd fuzz && CI=1 RUSTC="{{ justfile_directory() }}/fuzz/rustc-stand-in.sh" \
                RUSTFLAGS="-C target-cpu=x86-64-v3" \
                timeout --kill-after=10 "$merge_timeout" \
                env -u RCAD_FUZZ_TIMINGS \
                cargo +nightly fuzz run "$reader_target" -- \
                -merge=1 -max_len=5110 "$merge_tmp" "$reader_scratch") \
                >>"$night/reader-corpus-merge.log" 2>&1; then
            merge_elapsed=$(( $(date +%s) - merge_started ))
            rm -rf "$reader_persistent"
            mv "$merge_tmp" "$reader_persistent"
            rm -rf "$reader_scratch"
            persistent_files_after=$(find "$reader_persistent" -type f | wc -l)
            echo "reader corpus merge: persistent has $persistent_files_after files after merging, took ${merge_elapsed}s" \
                >>"$night/reader-corpus-merge.log"

            # `MERGE-OUTER: N new files` is libFuzzer's own count of which
            # *input* files its greedy pass picked, not of what landed on
            # disk: two picks that agree once cut to this merge's
            # `-max_len=5110`, or a pick that agrees with a file already in
            # the output directory, are one file on disk and N counts them
            # twice (docs/decisions.md §306.7). What the corpus actually
            # gained is `persistent_files_after` minus `persistent_files_before`,
            # so that is the number this log ends on; N is kept beside it,
            # named for what it counts rather than left to be read as the
            # same thing.
            net_new=$(( persistent_files_after - persistent_files_before ))
            merge_outer_n=$(grep -oE 'MERGE-OUTER: [0-9]+ new files' "$night/reader-corpus-merge.log" \
                | tail -n 1 | grep -oE '[0-9]+' || true)
            echo "reader corpus merge: net-new files tonight: $net_new (MERGE-OUTER picks: ${merge_outer_n:-0})" \
                >>"$night/reader-corpus-merge.log"
        else
            merge_elapsed=$(( $(date +%s) - merge_started ))
            rm -rf "$merge_tmp"
            mv "$reader_scratch" "$reader_scratch-failed-$(date +%Y%m%d%H%M%S)"
            echo "READER CORPUS MERGE FAILED after ${merge_elapsed}s — see $night/reader-corpus-merge.log; the persistent corpus was left as it was, and tonight's scratch directory was moved aside rather than merged or discarded" \
                >>"$night/reader-corpus-merge.log"
            echo "reader corpus merge FAILED — see $night/reader-corpus-merge.log"
            to_look_at+=("reader-merge:failed")
        fi
    fi

    # Counted after the loop and named in the summary, because a copy nobody is
    # told about is very nearly as lost as the original was. A clean night writes
    # slow units too — the night of 2026-09-13 wrote three and said "nothing
    # found" — so this is reported whether or not anything failed.
    kept=0
    if [ -d "$night/artifacts" ]; then
        kept=$(find "$night/artifacts" -type f | wc -l)
    fi
    artifacts=""
    [ "$kept" -eq 0 ] || artifacts="  $kept artifacts in $night/artifacts"

    # **What failed the night, now that the exit status cannot say.** libFuzzer
    # names every input it writes for what happened to it (`FuzzerLoop.cpp`), and
    # three of those five names are a bug: `crash-`, `oom-`, `leak-`.
    #
    # The other two are a measurement and not a fault. `slow-unit-` means an input
    # was slower than its neighbours — the night of 2026-09-13 wrote three while
    # being an entirely good night. `timeout-` means it was slower than the
    # `-timeout=10` §135 sets, which on `where_two_surfaces_cross` is a nightly
    # certainty rather than news: its tracked corpus holds inputs of 17 to 19
    # seconds, so the replay writes one before any fuzzing starts. A standing
    # population cannot be what fails a night — that is §91's failure reached by
    # crying wolf instead of by staying quiet.
    #
    # Read out of the worktree rather than out of `$night/artifacts`, because the
    # copy is made with `cp -Rn` and a name it already held keeps its old mtime,
    # which would make a carried-over find look older than it is read against —
    # but named against `$night/artifact-names-before/<target>`, taken above, and
    # not against `$since`'s mtime: §270.3 found a `-fork` worker rewrites a name
    # already on disk, unchanged bytes and all, and that rewrite bumps the mtime
    # exactly as a genuine new find would. A name already on that list is the
    # same bytes libFuzzer already wrote once — its own naming, prefix plus the
    # SHA-1 of the unit, makes that certain — so it is excluded by name and never
    # miscounted by mtime.
    #
    # **Per target and per kind, not one cumulative pile.** The count used to be
    # everything `fuzz/artifacts/` had ever held, across every night since the
    # directory was created, and the line said "nothing found" beside it — so the
    # fuse's first timeouts ever, three written 2026-09-24/25, sat unseen under a
    # pile that was already in the thousands (§226.3). What is new tonight, and
    # where, is the only thing worth a line; the running total stays in
    # `$artifacts` below for whoever wants it.
    #
    # Guarded rather than left to `find` to report: a night where no target wrote
    # anything has no `fuzz/artifacts` at all, `find` exits 1, and `pipefail`
    # takes the recipe down before the summary is written — the same trap arm Ten
    # of the selftest records falling into.
    kinds=(crash oom leak timeout slow-unit)
    crash_new=0
    new_summary=""
    if [ -d fuzz/artifacts ]; then
        for target_dir in fuzz/artifacts/*/; do
            [ -d "$target_dir" ] || continue
            target=$(basename "${target_dir%/}")
            before="$night/artifact-names-before/$target"
            [ -f "$before" ] || before=/dev/null
            target_new=""
            for kind in "${kinds[@]}"; do
                n=$(comm -13 "$before" \
                    <(find "$target_dir" -maxdepth 1 -type f -name "$kind-*" -printf '%f\n' | sort) \
                    | wc -l)
                [ "$n" -gt 0 ] || continue
                case "$kind" in
                    crash|oom|leak) crash_new=$(( crash_new + n )) ;;
                esac
                target_new="${target_new:+$target_new, }$n $kind"
            done
            [ -n "$target_new" ] || continue
            new_summary="${new_summary:+$new_summary; }$target: $target_new"
        done
    fi
    if [ "$crash_new" -gt 0 ]; then
        echo "$crash_new crash-class artifacts written tonight — see $night/artifacts"
        to_look_at+=("crashed:$crash_new")
    fi
    summary_word="nothing found"
    [ -z "$new_summary" ] || summary_word="new tonight: $new_summary"

    if [ "${#to_look_at[@]}" -eq 0 ]; then
        printf '%s  %s (%d days old, %s behind main)  %d targets, %s%s  %s\n' \
            "$(date '+%Y-%m-%d %H:%M')" "$commit" "$age" "$behind" "${#recipes[@]}" \
            "$summary_word" "$artifacts" "$night" >"{{fuzz_log_root}}/latest"
        cat "{{fuzz_log_root}}/latest"
        exit 0
    fi
    printf '%s  %s (%d days old, %s behind main)  %d targets, %d TO LOOK AT (%s), %s%s  %s\n' \
        "$(date '+%Y-%m-%d %H:%M')" "$commit" "$age" "$behind" "${#recipes[@]}" \
        "${#to_look_at[@]}" "${to_look_at[*]}" "$summary_word" "$artifacts" "$night" >"{{fuzz_log_root}}/latest"
    cat "{{fuzz_log_root}}/latest"
    exit 1

# Which commit the night should fuzz: the tip of `origin/main`, fetched fresh.
#
# Prints that sha, or prints nothing and says on stderr why it is staying put.
# **It never exits non-zero.** A night that cannot work out where to stand is a
# night that runs where it already is; failing here would trade a stale run for
# no run at all, which is the worse of the two.
#
# **Not the last green commit**, which is what it chose from §90 to §186. The
# fuzzer finds what the gate cannot, so whether the gate has read the tip yet is
# not a question the night needs answered — and waiting for it cost the night of
# 2026-09-21 its freshness: it fuzzed a commit from before §182's fix. A finding
# on a tip that turns out broken is replayed against `main` by `fuzz-triage`,
# which is the check that does the work, every morning at 08:30 (§410).
#
# Two conditions, each of them a way the night could otherwise go wrong:
#
#   - **a clean tree**, because the night is unattended and whatever is
#     uncommitted there is somebody's.
#   - **forward only**, so a tree somebody advanced by hand past the tip, or off
#     `main` altogether, is never dragged back.
#
# Separate from `fuzz-overnight` so that what the night would move to can be
# asked without moving anything.
[doc("Which commit the overnight run should fuzz: the tip of origin/main, forward only.")]
fuzz-watermark:
    #!/usr/bin/env bash
    set -euo pipefail

    staying() { echo "staying on $(git rev-parse --short HEAD): $1" >&2; exit 0; }

    git diff --quiet && git diff --cached --quiet \
        || staying "the tree has uncommitted changes"
    git fetch --quiet origin 2>/dev/null \
        || staying "origin could not be reached"

    tip=$(git rev-parse origin/main)
    [ "$tip" != "$(git rev-parse HEAD)" ] \
        || staying "already on the tip of main"
    git merge-base --is-ancestor HEAD "$tip" \
        || staying "the tip of main is not ahead of it"
    echo "$tip"

# The property fuzzer, over a pair of surfaces (docs/decisions.md §24.14).
#
# NOT part of `just gate`, and not because anybody chose to leave it out:
# `cargo-fuzz` builds with a sanitizer that needs a nightly compiler and
# `rust-toolchain.toml` pins a stable one, so this is the one recipe here that
# uses a compiler the repo does not pin. What runs on every commit is the same
# property over the same decoder, in
# `crates/rcad-geom/tests/every_pair_of_surfaces_the_fuzzer_draws_is_named_honestly.rs`.
[doc("Fuzz the predicates over a pair of surfaces. Needs a nightly compiler.")]
fuzz duration="60" corpus_root="" fork="0": (fuzz-target "where_two_surfaces_cross" duration corpus_root "71" fork)

# The Part 21 reader, over arbitrary bytes (docs/decisions.md §42.12 criterion 5).
#
# Same nightly-compiler caveat as `fuzz` above. What runs on every commit
# instead is `crates/rcad-step/tests/what_the_reader_refuses_and_by_what_name.rs`,
# which covers the shapes somebody thought of; this covers the ones nobody did.
#
# No `-max_len` here, unlike `fuzz`: the reader's promise is about any length of
# anything, and the truncation cases live at every length there is. When the
# real STEP corpus below is actually seeded in, `fuzz-target` pins one of its
# own (docs/decisions.md §264.7) — that pin lives in the branch that appends
# the corpus, not in this recipe's arguments, so a night with nothing fetched
# there still runs with no `-max_len` at all.
#
# `fuzz/step.dict` is the one dictionary any target here gets, because it is
# the one target whose input is text with keywords in it — the other four
# decode bytes into numbers and enum tags, where a STEP keyword splices in
# nothing a Part 21 file would ever hold.
#
# The real STEP files under `RCAD_STEP_CORPUS` are the other target-specific
# argument, and only the reader gets them: the tracked corpus started from
# nothing and has only ever grown itself, so a night never once started from a
# real file. `fuzz-target` passes the directory itself, read-only and last, and
# skips it outright when nothing has been fetched there yet (§226.1).
#
# `corpus_root` is passed straight through unchanged; it is `fuzz-target`'s own
# STEP-corpus branch that turns it into a scratch-plus-persistent pair rather
# than the one growing writable directory it used to be (docs/decisions.md
# §295.7) — this recipe does not need to know the difference.
[doc("Fuzz the Part 21 reader over arbitrary bytes.")]
fuzz-reader duration="60" corpus_root="" fork="0": (fuzz-target "no_step_file_makes_the_reader_panic" duration corpus_root "" fork "step.dict" RCAD_STEP_CORPUS)

# The Part 21 writer, over an arbitrary `Model` (docs/decisions.md §42.12).
#
# Same nightly-compiler caveat as `fuzz` above. `Model` is `Deserialize`
# (`crates/rcad-topo/src/serialize.rs`), so this target draws bytes through
# `postcard::from_bytes` — the same route a stranger's saved file takes — and
# whatever `Model` comes out, sound or not, goes straight into
# `rcad_step::write`, which owes an `Err` and never a panic either way.
[doc("Fuzz the Part 21 writer over an arbitrary Model.")]
fuzz-writer duration="60" corpus_root="" fork="0": (fuzz-target "no_model_makes_the_writer_panic" duration corpus_root "" fork)

# The fuse, over two arbitrary `Model`s (docs/decisions.md §17).
#
# Same nightly-compiler caveat as `fuzz` above. Decodes two `Model`s per run
# and, for each that passes `Model::validate`, fuses a byte-chosen split of
# its own solids against each other — see
# `fuzz/fuzz_targets/two_solids_fused_by_a_stranger.rs` for why two `Model`s
# and not one cross-fused pair.
[doc("Fuzz the fuse over two arbitrary Models.")]
fuzz-fuse duration="60" corpus_root="" fork="0": (fuzz-target "two_solids_fused_by_a_stranger" duration corpus_root "" fork)

# A cone or a torus crossing another surface, over its own byte decoder.
#
# Same nightly-compiler caveat as `fuzz` above. Needs its own `-max_len`,
# like `fuzz` above and unlike the reader/writer/fuse targets: a torus-vs-torus
# pair is this decoder's worst case, at 1 byte of choice plus two 8-byte
# doubles for each of a torus's five numbers, so 81 and not `fuzz`'s 71.
[doc("Fuzz the predicates over a cone or a torus and another surface.")]
fuzz-cones-and-tori duration="60" corpus_root="" fork="0": (fuzz-target "where_a_cone_or_a_torus_crosses" duration corpus_root "81" fork)

# The one place that knows how to start a fuzz target. The five recipes above
# are its five call sites and differ only in the name, `-max_len`, and — for
# the reader alone — a dictionary and a read-only STEP corpus.
#
# RUSTFLAGS has to be repeated: cargo-fuzz sets it as an environment variable,
# and that shadows the `.cargo/config.toml` entry `inari` needs to build at all.
#
# With no `corpus_root` — a hand-run `just fuzz 60` — libFuzzer gets no corpus
# argument and writes to the tracked `fuzz/corpus/<target>` as it always has.
# With one, that directory becomes the *second* argument and libFuzzer treats it
# as a read-only seed, writing only to the first (§81).
#
# `corpus_root`, when given, must be absolute, or already relative to this
# `fuzz/` directory, because this recipe `cd`'s there before using it: a path
# relative to the repository root silently resolves to an empty directory
# here, and the run then merges only the tracked corpus. Q271's first attempt
# passed one that way before catching it, §297.3.
#
# `fork` is how many jobs libFuzzer runs at once, and **0 means don't fork at
# all**, which is what a hand-run `just fuzz 60` wants: one crash, one report, and
# the run stops so you can read it. Only the night asks for a number, because only
# the night would rather lose the report than lose the other eight hours (§134).
#
# `dict`, when given, is a path relative to this `fuzz/` directory: this recipe
# has already `cd`'d there by the time it is used, and `fuzz-reader` passes
# `step.dict` for exactly that reason. Empty, as the other four call sites leave
# it, means no `-dict` flag at all rather than one pointed at nothing.
#
# `step_corpus`, when given, is an absolute path — `RCAD_STEP_CORPUS` itself,
# not a path under `fuzz/` — and is always appended last, never first, so it is
# always a read-only seed and libFuzzer never writes a mutated input under it
# (§81 again, one directory further; §226.1 for why the reader wants it at
# all). When `corpus_root` is empty this recipe would otherwise pass no corpus
# argument at all and let cargo-fuzz default to the tracked one on its own —
# so here it names that default explicitly, to keep it first. A `step_corpus`
# that does not exist on this machine is left out rather than handed to
# libFuzzer, so a night with no corpus fetched yet still fuzzes.
[private]
fuzz-target target duration corpus_root="" max_len="" fork="0" dict="" step_corpus="":
    #!/usr/bin/env bash
    set -euo pipefail
    cd fuzz
    corpus=()
    if [ -n "{{corpus_root}}" ]; then
        mkdir -p "{{corpus_root}}/{{target}}"
        corpus=("{{corpus_root}}/{{target}}" "corpus/{{target}}")
    fi
    max_len_flag=()
    if [ -n "{{max_len}}" ]; then
        max_len_flag=(-max_len={{max_len}})
    fi
    if [ -n "{{step_corpus}}" ] && [ -d "{{step_corpus}}" ]; then
        # §295.7: this branch used to hand libFuzzer `{{corpus_root}}/{{target}}`
        # itself as the writable directory — the same directory the *next*
        # night starts from, and the one §291.3 measured growing ≈18.5 MB/h.
        # Below, that directory goes back to being a read-only seed: libFuzzer
        # writes into a scratch directory instead — ordinarily fresh each
        # night and never handed back as a seed — and `fuzz-overnight` folds
        # its finds into `{{corpus_root}}/{{target}}` with `-merge=1
        # -max_len=5110` once this run is done, before throwing the scratch
        # directory away (docs/decisions.md §295.6, §295.7). Not fresh when
        # last night never got to fold its own in: see the comment beside
        # `mkdir -p "$scratch"` below. A hand run with no `corpus_root`
        # has nowhere to put a scratch directory and keeps writing straight
        # into the tracked corpus, as before.
        if [ -n "{{corpus_root}}" ]; then
            scratch="{{corpus_root}}/{{target}}-scratch"
            # Never `rm -rf` here: a scratch directory already at this path is
            # last night's, left behind because the whole run died somewhere
            # between its targets finishing and its own merge running, and
            # deleting it would throw those finds away unmerged. `mkdir -p` on
            # an existing directory is a no-op, so tonight's run adds to
            # whatever is already there, and it merges in with tonight's own
            # finds at the usual point in `fuzz-overnight` — simpler than
            # teaching this recipe, which has no `to_look_at` of its own, to
            # name a leftover directory in the night's summary (Q237).
            mkdir -p "$scratch"
            corpus=("$scratch" "{{corpus_root}}/{{target}}" "corpus/{{target}}" "{{step_corpus}}")
        else
            if [ ${#corpus[@]} -eq 0 ]; then
                corpus=("corpus/{{target}}")
            fi
            corpus+=("{{step_corpus}}")
        fi
        # **Pinned here, in this branch, and not in `max_len` or in
        # `fuzz-reader`'s own arguments** (docs/decisions.md §264.7): with the
        # whole STEP corpus seeded in and no pin, libFuzzer derives its cap from
        # the largest file there, about 1 MB, and runs at 0.3% to 0.8% of arm
        # B's rate after a merge that times out on those files (§264.5). At
        # 65536 it keeps 92% to 97.5% of those edges at a tenth of B's rate. A
        # night with no STEP corpus fetched never takes this branch, so it
        # still derives 5 110 on its own.
        max_len_flag=(-max_len=65536)
    fi

    # `-ignore_crashes=1` is the flag that buys the night: without it the first
    # crash calls `StopJobs()` and the target is done for the evening, however
    # many hours were left (`FuzzerFork.cpp:441-450`).
    #
    # `-ignore_timeouts=1` and `-ignore_ooms=1` are already libFuzzer's defaults
    # (`FuzzerFlags.def:66-67`) and are passed anyway, because the night now
    # *depends* on them rather than merely tolerating them: with a per-input
    # `-timeout` the slow units of §91.3 time out on the corpus replay, and a
    # default that changed under us would end every target in its first minute.
    #
    # **`-timeout=10` is in here and not outside it, because it is only safe
    # inside it** (§133.7, §135). `-ignore_timeouts` is a fork-mode flag; without
    # `-fork` a timeout kills the process, and `fuzz/corpus/where_two_surfaces_cross`
    # holds inputs of 17 to 19 seconds — so a hand-run `just fuzz 60` carrying this
    # flag would die on its own corpus replay before fuzzing anything.
    #
    # Ten seconds is 1 270 times that target's p99 of 7.9 ms and caps a tail that
    # took 19% of its night in 0.025% of its inputs. Deliberately loose rather
    # than tight: an input killed here never enters the corpus, and on this target
    # the slow inputs are the nearly-parallel crossings §0's unit is about.
    fork_flags=()
    if [ "{{fork}}" -gt 0 ]; then
        fork_flags=(-fork={{fork}} -timeout=10 -ignore_crashes=1 -ignore_timeouts=1 -ignore_ooms=1)
    fi
    dict_flag=()
    if [ -n "{{dict}}" ]; then
        dict_flag=(-dict={{dict}})
    fi
    # `RUSTC` and `CI=1` here for the same reason as `fuzz-overnight`'s build
    # (docs/decisions.d/267.4, §292): a run started here without a build already
    # done — a hand `just fuzz` or `just fuzz-target` on its own — does the real
    # build itself, and it needs the same stand-in and the same kache bypass as
    # that build does. When the night has already built, cargo's fingerprint
    # sees no change and this run does not recompile, so setting it here again
    # costs nothing.
    CI=1 RUSTC="{{ justfile_directory() }}/fuzz/rustc-stand-in.sh" \
        RUSTFLAGS="-C target-cpu=x86-64-v3" \
        cargo +nightly fuzz run {{target}} ${corpus[@]+"${corpus[@]}"} -- \
        -max_total_time={{duration}} ${max_len_flag[@]+"${max_len_flag[@]}"} \
        ${fork_flags[@]+"${fork_flags[@]}"} \
        ${dict_flag[@]+"${dict_flag[@]}"}

# Pins `fuzz-overnight` against a `cargo` it brings with it, because the real one
# wants a sanitizer build and eight hours before it says anything at all. The
# stub sleeps half the time it was granted and logs when it started, so both the
# clock the recipe runs against and the order it starts things in are real.
#
# **It takes about thirty seconds, and arm Twenty-six fails it past 60.** Three
# runs of `just check-fuzz-overnight-selftest` on 24 idle cores took 29.3, 30.4
# and 30.4 s, with 12.6 to 13.8 CPU-seconds each by bash's `time`, and two runs
# of `just gate quiet fresh` gave the step 31.7 and 33.1 s, starting at a load
# of 10 and 19 (Q709, 2026-10-02). Most arms run beside each other, and the end
# of the body says which and why; run in turn they took 86 s. About 27 s of the
# thirty is the stub asleep: eleven seconds while Four overruns with the other
# arms beside it, then four seconds for each of the four arms run alone that
# sleep. Load cannot stretch a sleep, only the 13 CPU-seconds, and all of them
# added one after another to the sleep make 41 s. Reaching 60 takes that and
# every CPU-second also taking two and a half. On CI's four-core runner the
# gate runs four steps at once (§372.12), so this step shares four cores with
# three others; it has not been run there, since the Actions allowance is
# spent. The shape this replaced fails the bound on its own, by 26 s.
#
# Two things about the window, and neither can be seen from the clock alone.
# **It is a deadline and not a budget**: a recipe that gave each of five targets
# a fresh window would run five times as long as it was told to, which nobody
# would notice until the fuzzer was still going at lunch. And **every target
# gets the whole of it**, at once — which is the same sentence read the other
# way, and is why the pair has to be asserted on what each target was *told*
# (arm one) and on when each one *started* (arm four) rather than on how long
# the night took. Running in turn on a fifth each and running together on the
# whole each take about the same wall-clock time; that is exactly how the first
# of them went unquestioned for nine nights while 23 of 24 cores sat idle.
#
# The rest are each a way the night could quietly do nothing: a crash in one
# target taking the other four down with it, one target's overrun starving them,
# the run reporting success after a target died, a finding left in a gitignored
# directory in a tree due to be reclaimed (§91), and — the reason the hub case is
# here rather than trusted to `check-hub` — a timer left pointing at the one tree
# whose owner cannot be written down, where `just lanes` would show `free` all
# night (§60).
[private]
check-fuzz-overnight-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)

    # The stub writes its artifacts into the real `fuzz/artifacts/`, because that
    # is the one path the recipe under test is not free to choose — `cargo-fuzz`
    # fixes `-artifact_prefix` and nothing in the environment moves it. So the tag
    # is unique per run, two lanes can gate at once, and the trap takes away
    # exactly what this run put there and nothing a real night left.
    #
    # It goes by the tag alone and never by kind. It used to name `crash-` and
    # `slow-unit-`, so every `timeout-` an arm wrote stayed behind whenever that
    # arm failed, and `prune-worktrees` then kept the tree for ever (§315.3).
    # The trap runs on TERM, INT and HUP too, but not on KILL, and what a killed
    # run leaves is `prune-worktrees`' to ignore.
    #
    # An arm run beside others writes under `<arm>-$tag` (see `beside`, at the
    # end), so every name either kind of arm writes still ends in `-$tag`. The
    # trap first waits for any such arm still running: one that went on writing
    # after the files were taken away would leave its own behind.
    tag="overnight-selftest-$$-${RANDOM}"
    clean_up() {
        wait
        rm -rf "$dir"
        rm -f fuzz/artifacts/*/*-"$tag"
        rm -rf fuzz/target/x86_64-unknown-linux-gnu/release/build/rcad-fuzz-timing/selftest-*"$tag"
    }
    trap clean_up EXIT

    # A gate killed mid-run (`SIGKILL`, so this recipe's own `trap` above
    # never fires) leaves its `selftest-*` directories behind under the real
    # `fuzz/target/`, forever — nothing else ever looks there to clean them
    # up (Q244, Q437). The guard above now fails on *any* sancov rlib it
    # finds rather than trusting whichever one `find` met first, so a stale
    # one left this way no longer makes a bad night pass, but it could still
    # fail a *good* night for a reason that has nothing to do with this run.
    # So this run clears every leftover before any arm runs, rather than
    # leaving the next run to inherit what a killed one did not finish
    # cleaning up.
    rm -rf fuzz/target/x86_64-unknown-linux-gnu/release/build/rcad-fuzz-timing/selftest-*
    mkdir -p "$dir/bin"

    # A fixture for `RCAD_STEP_CORPUS`, standing in for the 375 MiB the real
    # one holds: what this arm needs is a directory that exists and is not
    # empty, not the real files, since the question is where `fuzz-target`
    # puts it on the command line and not what libFuzzer does with its bytes.
    mkdir -p "$dir/step-corpus"
    echo "ISO-10303-21;" >"$dir/step-corpus/seed.step"

    # Logs its whole command line, then sleeps **half** the slice it was given.
    #
    # Half, and not all of it, is what keeps this arm from being a race. Sleeping
    # the whole slice makes the five sleeps add up to the window by
    # construction, which leaves nothing for the arm's own overhead — `timeout`
    # around a nested `just`, five times over, about 1.2 s under load. `date +%s`
    # truncates to whole seconds and hides that until it crosses a second
    # boundary; then `(deadline - now) / left` truncates to 0 for the last
    # target, it is skipped, and the night correctly exits 1 for a reason the
    # fixture never meant to create. Four passes and a fail in five runs, on one
    # tree, found by rcad-15 on 2026-09-09.
    #
    # It still has to scale with the slice rather than being a fixed nap, or the
    # mutation this arm exists to catch — handing every target the whole window —
    # would sleep the same amount as the correct recipe and go unnoticed.
    cat >"$dir/bin/cargo" <<'STUB'
    #!/usr/bin/env bash
    set -euo pipefail
    # `at=` is when this target started, and it is the only thing in the log that
    # can say whether the five ran together. Elapsed time cannot: the night is as
    # long as its slowest target however the rest are arranged, so a recipe that
    # started one target, waited for it, and then ran the other four at once
    # would spend about what a correct one spends.
    printf '%s [timings=%s] [at=%s]\n' "$*" "${RCAD_FUZZ_TIMINGS:-unset}" "$(date +%s)" >>"$STUB_LOG"
    case " $* " in
        *" build "*)
            # The real build's rlib is what §292's guard reads back, so every
            # arm needs one here too, real or not — clean unless
            # `STUB_TIMING_SANCOV` asks for the kind that must fail the night.
            timing_dir="target/x86_64-unknown-linux-gnu/release/build/rcad-fuzz-timing/selftest-${STUB_ARTIFACT_TAG:-notag}/out"
            mkdir -p "$timing_dir"
            symbol="clean_selftest_symbol"
            [ -z "${STUB_TIMING_SANCOV:-}" ] || symbol="__sancov_selftest_symbol"
            printf '.globl %s\n%s:\n' "$symbol" "$symbol" >"$timing_dir/sym.s"
            as "$timing_dir/sym.s" -o "$timing_dir/sym.o"
            ar rcs "$timing_dir/librcad_fuzz_timing-selftest-${STUB_ARTIFACT_TAG:-notag}.rlib" "$timing_dir/sym.o"
            exit 0 ;;
    esac

    # Writes what libFuzzer would write, where libFuzzer would write it: the real
    # `cargo fuzz run` is handed `-artifact_prefix=<worktree>/fuzz/artifacts/<target>/`
    # and this stub's cwd is that `fuzz/` directory, because `fuzz-target` cd's
    # into it. Named with a tag the arm picks, so the assertion is about this run's
    # own file and not about whatever a real session left lying there.
    # `write_dir` is the argument right after `target` — libFuzzer's own
    # writable corpus directory (`fuzz-target`'s `corpus[0]`, above) — kept
    # alongside `target` for `STUB_CORPUS_ADD` below, which needs to know
    # where a real fuzzer would drop a newly found input.
    target=""
    write_dir=""
    prev=""
    for arg in "$@"; do
        if [ "$prev" = "run" ]; then
            target="$arg"
        elif [ -n "$target" ] && [ "$prev" = "$target" ] && [ -z "$write_dir" ]; then
            write_dir="$arg"
        fi
        prev="$arg"
    done

    # The merge call's own three behaviors, checked before any of the
    # per-target artifact/rendezvous/sleep logic below (a merge is not a fuzz
    # run and none of that applies to it): fail on demand, hang on demand — so
    # the recipe's own `timeout` around it can be tested without a real merge
    # slow enough to hit it — or otherwise return in effectively no time, the
    # way a merge with nothing to do behaves for real (§295.6, about a
    # second).
    for arg in "$@"; do
        if [ "$arg" = "-merge=1" ]; then
            [ -z "${STUB_MERGE_FAIL:-}" ] || exit 1
            [ -z "${STUB_MERGE_HANG:-}" ] || sleep "$STUB_MERGE_HANG"

            # `STUB_MERGE_ADD` and `STUB_MERGE_OUTER` are two separate knobs
            # because a real merge's two numbers separate the same way
            # (§306.7): what libFuzzer prints is a count of picks, and what
            # lands on disk is whatever this stub writes into the merge's
            # first directory argument — the one right after `-max_len=...`,
            # which is `$merge_tmp` and becomes the persistent corpus on
            # success. Set to different values, an arm can tell the night's
            # own net-new count apart from libFuzzer's MERGE-OUTER count.
            if [ -n "${STUB_MERGE_ADD:-}" ]; then
                merge_dest=""
                merge_prev=""
                for merge_arg in "$@"; do
                    case "$merge_prev" in
                        -max_len=*) merge_dest="$merge_arg" ;;
                    esac
                    merge_prev="$merge_arg"
                done
                [ -z "$merge_dest" ] \
                    || echo "a pick the stub kept" >"$merge_dest/$STUB_MERGE_ADD"
            fi
            [ -z "${STUB_MERGE_OUTER:-}" ] \
                || echo "MERGE-OUTER: $STUB_MERGE_OUTER new files"
            exit 0
        fi
    done
    #
    # **`slow-unit-` by default, and `crash-` only when an arm asks.** A clean
    # night writes slow units — the night of 2026-09-13 wrote three — so that is
    # what an unremarkable target leaves behind.
    # Since §134 a crash file is what fails a night, and a stub that wrote one
    # every time would leave no fixture able to express a good night at all.
    kind="${STUB_ARTIFACT_KIND:-slow-unit-}"
    if [ -n "${STUB_ARTIFACT_KIND_TARGET:-}" ] && [ "$target" != "$STUB_ARTIFACT_KIND_TARGET" ]; then
        kind="slow-unit-"
    fi
    if [ -n "$target" ] && [ -n "${STUB_ARTIFACT_TAG:-}" ]; then
        mkdir -p "artifacts/$target"
        echo "what a target found" >"artifacts/$target/$kind$STUB_ARTIFACT_TAG"
    fi

    # A real fuzzer's other kind of find: a new corpus file, dropped into the
    # directory it was told to write into. `STUB_CORPUS_ADD` names it, so an
    # arm can ask whether a list taken before this run started already knew
    # about a file that only exists because of this run (Q53).
    if [ -n "${STUB_CORPUS_ADD:-}" ] && [ -n "$write_dir" ] && [ -d "$write_dir" ]; then
        echo "found during the run" >"$write_dir/$STUB_CORPUS_ADD"
    fi

    # **A barrier, and not a stopwatch** (§139). Armed only by `STUB_RENDEZVOUS`,
    # because this stub is shared by every arm in the recipe, and an arm that
    # launches between one and four targets would wait out the deadline for
    # targets that were never coming. (`run 0` is not that case: a recipe with
    # under a second left is skipped before it is launched, so it never gets
    # here — §139.7.)
    #
    # Each target appends its name and then waits for the file to hold five
    # lines. Run together, all five arrive and every one of them sees five. Run
    # in turn, the first blocks here and the other four are never launched, so
    # the file ends at one line and no target sees five. That holds at every
    # timeout *above the instant the five have arrived* — the deadline has a
    # floor and no ceiling, where a bound on the launch spread had both and they
    # met. Loosening this costs the check nothing; loosening that cost it
    # everything.
    #
    # It sits after the `at=` printf above and before the sleep below. Before
    # the printf, the log would stop recording when a target launched and the
    # paired `max_total_time`/`at=` check would lose its input; after the sleep,
    # the five would have finished waiting for each other before they met.
    if [ -n "${STUB_RENDEZVOUS:-}" ] && [ -n "$target" ]; then
        echo "$target" >>"$STUB_RENDEZVOUS"
        want="${STUB_RENDEZVOUS_COUNT:-5}"
        # The deadline is a deadlock escape and not a tuning knob: without it a
        # recipe that launches one target hangs `just gate` instead of failing
        # it. A correct recipe never reaches it, provided it is set above the
        # time five targets take to arrive — at 0 even a correct recipe times
        # out, which is the floor §139.7 records.
        deadline=$(( $(date +%s) + ${STUB_RENDEZVOUS_TIMEOUT:-15} ))
        while [ "$(grep -c '' "$STUB_RENDEZVOUS")" -lt "$want" ] \
            && [ "$(date +%s)" -lt "$deadline" ]; do
            sleep 0.1
        done
        printf 'rendezvous %s saw %s of %s\n' \
            "$target" "$(grep -c '' "$STUB_RENDEZVOUS")" "$want" >>"$STUB_LOG"
    fi

    # `STUB_OVERRUN_TARGET` aims the overrun at one target and leaves the other
    # four alone, which is the only way to ask whether an overrun costs them
    # anything. While the five ran in turn it could not be asked: an overrun in
    # the first one spent the window, and that was the whole of the old arm.
    overrun=0
    if [ -n "${STUB_OVERRUN:-}" ] \
        && { [ -z "${STUB_OVERRUN_TARGET:-}" ] || [ "$target" = "$STUB_OVERRUN_TARGET" ]; }; then
        overrun="$STUB_OVERRUN"
    fi
    for arg in "$@"; do
        case "$arg" in
            -max_total_time=*)
                half=$(( ${arg#*=} / 2 ))
                [ "$half" -ge 1 ] || half=1
                sleep "$(( half + overrun ))"
                ;;
        esac
    done
    # The line libFuzzer's fork parent prints last, which since §134 is what says
    # the target got as far as fuzzing. `STUB_NO_EXITING_TARGET` withholds it from
    # one target, which is how an arm asks for a target that never got going —
    # the failure the exit status used to carry and can no longer.
    if [ "$target" != "${STUB_NO_EXITING_TARGET:-}" ]; then
        echo "INFO: exiting: 0 time: 1s"
    fi

    # Exits non-zero while still having fuzzed the whole window, which is fork
    # mode's ordinary ending and not a failure: the code is whichever of forty
    # thousand jobs happened to be collected last (§133.7).
    for arg in "$@"; do
        if [ "$arg" = "${STUB_CRASH:-}" ]; then exit "${STUB_CRASH_CODE:-70}"; fi
    done
    exit 0
    STUB
    chmod +x "$dir/bin/cargo"

    # A stand-in for `fuzz/timing-hooked-calls.py` (docs/decisions.d/273,
    # Q181): the real script disassembles a real binary, which a stub cargo
    # never produces, so this is what `RCAD_FUZZ_TIMING_CHECK` points the
    # recipe at instead, armed by `STUB_TIMING_HOOKED`.
    cat >"$dir/bin/timing-check-stub.sh" <<'STUB'
    #!/usr/bin/env bash
    if [ -n "${STUB_TIMING_HOOKED:-}" ]; then
        echo "stub-binary: 1 call from rcad_fuzz_timing reaches a memcmp-family hook outside SlowRun::is"
        exit 1
    fi
    echo "stub-binary: clean"
    exit 0
    STUB
    chmod +x "$dir/bin/timing-check-stub.sh"

    # These arms run the night in whatever worktree the gate was run from, and
    # `fuzz-watermark` would move that tree onto the tip of `origin/main` — a
    # lane's tree, checked out from under it by its own gate. So `run` tells the
    # night it has already advanced, and the watermark is never asked here; the
    # HEAD assertion after the last arm is what says so. The arm that does want the
    # night to move does it in a fixture repository with an origin of its own.
    head_before=$(git rev-parse HEAD)

    # Each arm is a function named after it, and `arm` holds that name while it
    # runs, so a failure says which arm it came from even when several run at
    # once. Which run at once, and why that is safe, is at the end.
    arm=""
    fail() {
        echo "fuzz-overnight drifted from its own fixtures, in arm $arm: $1"
        [ -f "$dir/log" ] && sed 's/^/    /' "$dir/log"
        exit 1
    }

    # `RCAD_FUZZ_TIMING_CHECK` defaults every arm to the clean stub, because
    # the stub `cargo` above never writes a real target binary for the real
    # `fuzz/timing-hooked-calls.py` to disassemble — Twenty-four is the one
    # arm that overrides `STUB_TIMING_HOOKED` to see the other branch.
    run() {
        STUB_LOG="$dir/log" PATH="$dir/bin:$PATH" STUB_ARTIFACT_TAG="$tag" \
            RCAD_FUZZ_LOGS="$dir/logs" RCAD_FUZZ_CORPUS="$dir/corpus" \
            RCAD_FUZZ_ALREADY_ADVANCED=1 RCAD_STEP_CORPUS="$dir/step-corpus" \
            RCAD_FUZZ_TIMING_CHECK="$dir/bin/timing-check-stub.sh" \
            {{just_executable()}} fuzz-overnight "$1" >"$dir/out" 2>&1
    }

    # One: five targets inside a twelve-second window, with the second of them
    # never getting as far as fuzzing. Every one still runs, every one is given
    # the whole window, the run ends inside it rather than five times past it, and
    # it reports the failure rather than swallowing it.
    #
    # **The second target fails by printing no `INFO: exiting:`, not by exiting
    # non-zero**, and that is §134: under `-fork` a non-zero status is the last of
    # forty thousand jobs and says nothing about the night, so the fixture that
    # used to express "this target died" by `exit 1` now expresses a target that
    # exited 70 and was fine. Arm Eleven is that case, and this one is the failure
    # the status used to carry — a target whose build or launch never happened.
    #
    # **The clock alone cannot say whether they ran together**, and that is why
    # the `-max_total_time` assertions below are here rather than a tighter
    # bound. A correct recipe spends about 6 s, running five targets that each
    # sleep half of twelve; the recipe this replaced spent about 9 s, running
    # five targets that each slept half of a fifth. Both sit inside any bound
    # wide enough to survive a loaded machine. What separates them exactly is
    # what each target was *told*: one window, five times over, against five
    # shares that shrink. 16 still catches the mutation the clock can see —
    # handing every target the whole window and then running them in turn.
    one_and_two() {
    : >"$dir/log"
    started=$(date +%s)
    status=0
    STUB_NO_EXITING_TARGET=no_step_file_makes_the_reader_panic run 12 || status=$?
    elapsed=$(( $(date +%s) - started ))
    [ "$status" -ne 0 ] || fail "a target never got fuzzing and the night reported success"
    # `.*max_total_time` and not bare `'fuzz run'`: the reader's STEP corpus is
    # seeded in for every arm using `run()`, so this night's own reader-corpus
    # merge (Q237) is itself a `fuzz run … -merge=1 …` line, and it carries no
    # `-max_total_time` — only a per-target run does. Counting it here would
    # overcount by one and this exact-count check would fail on a correct
    # recipe.
    ran=$(grep -c 'fuzz run.*max_total_time' "$dir/log" || true)
    [ "$ran" -eq 5 ] || fail "a failure in the second target left $ran of 5 targets run"
    [ "$elapsed" -ge 4 ] || fail "a twelve-second window was over in $elapsed s, so nothing was fuzzed"
    [ "$elapsed" -le 16 ] || fail "a twelve-second window took $elapsed s, so the window is a budget and not a deadline"
    grep -q 'TO LOOK AT.*fuzz-reader' "$dir/logs/latest" \
        || fail "the summary line does not name the target that died"

    # Every target got the whole of what was left when *it* launched, and not a
    # fifth of it. This is the assertion that holds §129's change — five targets
    # at once rather than a fifth of the window each.
    #
    # **The yardstick is what was left, not the twelve the window was asked for.**
    # The night spends its preamble — the watermark, git, a nested `just` per
    # target — inside the window, and hands each target `deadline - now`, so what
    # arrives is twelve minus the preamble. Here the preamble rounds to nothing
    # and the grant is 12. On a GitHub runner it was **9 s of the 12**, so the
    # correct recipe granted 3 and a `-ge 8` assertion called it a share: run
    # 35399208851, red on a commit that changed one line of `docs/decisions.md`.
    # Worse than red — at 3 s a fifth of twelve is 2, so the arm had almost no
    # power left to tell the correct recipe from the mutation it exists to catch.
    #
    # **Asked per target, against that target's own launch instant, because no
    # bound on the five values together is sound.** Requiring one value forbids a
    # correct recipe: one computing `deadline - now` inside the launch loop hands
    # a target that started two seconds later two seconds less, which is right,
    # and a set-wide check calls it a divided window. Allowing the values to
    # differ is what lets a genuinely divided window through. Pairing each grant
    # with its own `at=` escapes the choice, and needs no new instrumentation —
    # the stub already logs its whole argv and its stamp on one line, so it is one
    # `sed` with two groups where there were two greps with one each.
    #
    # `started` is read before `fuzz-overnight` begins, so `started + 12` is at or
    # before the deadline the recipe sets, and each `whole` is a *lower bound* on
    # what a correct recipe grants that target. This cannot fail a merely slow
    # machine, only a recipe that shares the window out. A preamble long enough to
    # leave nothing to launch with is caught by the `ran -eq 5` check above.
    pairs=$(sed -n 's/.*max_total_time=\([0-9]*\).*\[at=\([0-9]*\)\].*/\1 \2/p' "$dir/log")
    [ "$(grep -c . <<<"$pairs")" -eq 5 ] \
        || fail "$(grep -c . <<<"$pairs") of 5 targets logged both a window and a start time, so what they were given cannot be judged"
    while read -r granted at; do
        whole=$(( started + 12 - at ))
        [ "$granted" -ge "$whole" ] \
            || fail "a target was given $granted s of the $whole s still left when it launched, so the window is still being shared"
    done <<<"$pairs"

    # Every target is told where to write its per-run timings, and the place is
    # this night's own directory. A target that was not told keeps nothing, and
    # the morning has libFuzzer's one ratcheted `Slowest unit:` line and no
    # spread — which is the state this replaced.
    # `.*max_total_time.*` again excludes the reader's own merge line: it is
    # exported the timings path too (it runs after `export RCAD_FUZZ_TIMINGS`
    # like everything else in this recipe), so it would otherwise match this
    # pattern as a sixth "target".
    timed=$(grep -c "fuzz run.*max_total_time.*\[timings=$dir/logs/$(date +%Y-%m-%d)/timings\]" "$dir/log" || true)
    [ "$timed" -eq 5 ] \
        || fail "$timed of 5 targets were told where to write their timings"

    # What each target found is carried out of the worktree and into the night's
    # own directory (§91). `fuzz/artifacts/` is gitignored, lives in a tree that
    # gets unlocked and reclaimed, and is never read back as a seed — so an input
    # left only there is an input the next night cannot re-find and a sweep can
    # delete. A night on 2026-09-13 reported "nothing found" over a crash sitting
    # in it.
    night="$dir/logs/$(date +%Y-%m-%d)"
    for target in where_two_surfaces_cross no_step_file_makes_the_reader_panic \
            no_model_makes_the_writer_panic two_solids_fused_by_a_stranger \
            where_a_cone_or_a_torus_crosses; do
        [ -f "$night/artifacts/$target/slow-unit-$tag" ] \
            || fail "$target's artifact was left in the worktree instead of kept in $night/artifacts"
    done

    # Every target forks, and every one is told to survive a crash. Without
    # `-ignore_crashes=1` the first crash calls `StopJobs()` and that target's
    # night ends there, which is the whole of what §134 bought; without `-fork`
    # the flag is not even read. The number is the machine split five ways and so
    # cannot be asserted exactly, but it can be asserted to be one number, shared,
    # and at least 1 — a recipe handing out 0 would silently stop forking.
    forked=$(grep -o 'fork=[0-9]*' "$dir/log" | cut -d= -f2 | sort -un)
    [ "$(wc -l <<<"$forked")" -eq 1 ] \
        || fail "the five targets were given different fork counts: $(tr '\n' ' ' <<<"$forked")"
    [ "$forked" -ge 1 ] \
        || fail "the night asked for -fork=$forked, so nothing is isolated and one crash still ends a target"
    [ "$(grep -c 'ignore_crashes=1' "$dir/log")" -eq 5 ] \
        || fail "a target forks without -ignore_crashes=1, so its first crash still ends its night"

    # And every target bounds one input (§135). Without it `where_two_surfaces_cross`
    # spends 19% of its night on 0.025% of its inputs, at 17 to 19 seconds apiece.
    [ "$(grep -c 'timeout=10' "$dir/log")" -eq 5 ] \
        || fail "a target runs with no per-input timeout, so one input can still take twenty seconds of its night"

    # And the morning is told, because a copy nobody is told about is very nearly
    # as lost as the original. This arm's night also failed, so it proves the
    # count rides along with `TO LOOK AT` rather than replacing it.
    #
    # **At least five, and not exactly five.** The stub writes into the real
    # `fuzz/artifacts/`, so a tree where somebody has actually fuzzed has more in
    # it than this arm put there. Pinning the number would make the arm pass or
    # fail on a property of the machine rather than of the recipe, which is §77.6's
    # mistake made a third time.
    kept=$(sed -n 's/.*  \([0-9]*\) artifacts in .*/\1/p' "$dir/logs/latest")
    [ -n "$kept" ] \
        || fail "the summary line does not say how many artifacts were kept: $(cat "$dir/logs/latest")"
    [ "$kept" -ge 5 ] \
        || fail "five targets each left an artifact and the summary counted $kept"

    # Two: the tracked corpus is a read-only seed and never the directory
    # libFuzzer writes to, which is the whole of §81. Order is the only thing
    # that says so, and only `fuzz` carries `-max_len`.
    grep -q "run where_two_surfaces_cross $dir/corpus/where_two_surfaces_cross corpus/where_two_surfaces_cross " "$dir/log" \
        || fail "the night's own corpus is not first, so libFuzzer would write into the tracked one"
    [ "$(grep -c 'max_len=71' "$dir/log")" -eq 1 ] \
        || fail "-max_len=71 belongs to where_two_surfaces_cross and to nothing else"

    # And the reader's third corpus is the same read-only seed, one directory
    # further: `$dir/step-corpus` stands in for `RCAD_STEP_CORPUS`, and this
    # one line fails whether it is dropped (the tail of the match is gone) or
    # moved first (the head of the match, the night's own writable directory
    # in first place, is gone instead). Neither half alone would catch both.
    #
    # The night's own writable directory is the *scratch* one now, ahead of
    # the persistent corpus it used to be (§295.7, Q237): libFuzzer still
    # writes first and reads the rest read-only, so the order after it is
    # unchanged — persistent, tracked, real STEP corpus.
    grep -q "run no_step_file_makes_the_reader_panic $dir/corpus/no_step_file_makes_the_reader_panic-scratch $dir/corpus/no_step_file_makes_the_reader_panic corpus/no_step_file_makes_the_reader_panic $dir/step-corpus " "$dir/log" \
        || fail "the reader's real STEP corpus is missing or not last: $(grep 'run no_step_file_makes_the_reader_panic' "$dir/log")"

    # And with the STEP corpus actually seeded in, the reader's own `-max_len`
    # is pinned to 65536 (docs/decisions.md §264.7) — belonging to no other
    # target, the same way `max_len=71` above belongs only to
    # `where_two_surfaces_cross`.
    [ "$(grep -c 'max_len=65536' "$dir/log")" -eq 1 ] \
        || fail "-max_len=65536 belongs to the reader's STEP-corpus branch and to nothing else"
    }

    # A machine with nothing fetched at `RCAD_STEP_CORPUS` yet still fuzzes the
    # reader rather than failing on it: the directory is a bonus seed, not a
    # dependency the night goes down with. `fuzz-target` is asked for one that
    # does not exist, and the proof is negative — its path never reaches the
    # command line at all, rather than reaching it and libFuzzer refusing it.
    # And with it missing, the reader also carries neither corpus argument nor
    # `-max_len=65536`: a night with nothing fetched stays arm B, at whatever
    # libFuzzer derives on its own (§264.7's D1, 5 110).
    #
    # `STUB_ARTIFACT_TAG="$tag"`, the same as every other arm's, and not left
    # unset: unset, the build stub writes its timing rlib fixture under a
    # second, untagged `selftest-notag` directory, and the sancov guard a few
    # arms down finds *that* rlib by name (`find | head -n1`) instead of this
    # run's own — a stale, untagged fixture masking arm Sixteen's real one.
    two_with_no_step_corpus() {
    : >"$dir/log"
    status=0
    RCAD_STEP_CORPUS="$dir/no-such-step-corpus" STUB_LOG="$dir/log" PATH="$dir/bin:$PATH" \
        STUB_ARTIFACT_TAG="$tag" RCAD_FUZZ_ALREADY_ADVANCED=1 \
        RCAD_FUZZ_LOGS="$dir/logs" RCAD_FUZZ_CORPUS="$dir/corpus" \
        RCAD_FUZZ_TIMING_CHECK="$dir/bin/timing-check-stub.sh" \
        {{just_executable()}} fuzz-overnight 8 >"$dir/out" 2>&1 || status=$?
    [ "$status" -eq 0 ] \
        || fail "a night with no STEP corpus fetched yet failed instead of fuzzing without it: $(cat "$dir/out")"
    ! grep -q "no-such-step-corpus" "$dir/log" \
        || fail "a missing STEP corpus directory was handed to libFuzzer anyway"
    ! grep -q 'max_len=65536' "$dir/log" \
        || fail "a night with no STEP corpus fetched yet still pinned -max_len=65536"
    # A night that never took the STEP-corpus branch never makes the scratch
    # directory that branch is the only thing that creates, and so never runs
    # the merge gated on that directory existing (Q237 item 4).
    [ ! -d "$dir/corpus/no_step_file_makes_the_reader_panic-scratch" ] \
        || fail "a night with no STEP corpus fetched yet still made a scratch directory for the reader"
    ! grep -q -- '-merge=1' "$dir/log" \
        || fail "a night with no STEP corpus fetched yet still ran the reader's nightly merge"
    }

    # Three: a night with no crash-class artifacts exits 0, and the routine slow
    # unit every target leaves behind is named rather than folded into "nothing
    # found" — that wording is §226.3's bug, which hid three new timeouts behind
    # a pile it never said was old. No clock assertions here, so the window only
    # has to be wide enough that every target gets a slice worth having.
    #
    # Cleared first because §270.3's fix goes by name: a `slow-unit-$tag` an
    # earlier arm under this same tag had left in a target's real
    # `fuzz/artifacts/` would no longer read as tonight's own find. Today none
    # has, since this is the first arm run alone and the arms before it each
    # ran under a tag of their own. The clearing is what keeps that true if the
    # order changes, and what makes this arm's write the first this tag has made
    # under these names, the freshness the old mtime check assumed for free.
    three() {
    rm -f fuzz/artifacts/*/slow-unit-"$tag"
    : >"$dir/log"
    run 8 || fail "a night with no crash-class artifacts exited non-zero"
    grep -q 'new tonight:.*where_two_surfaces_cross: 1 slow-unit' "$dir/logs/latest" \
        || fail "a night that wrote a slow unit per target did not name where: $(cat "$dir/logs/latest")"
    ! grep -q 'nothing found' "$dir/logs/latest" \
        || fail "a night that wrote five new slow units still said nothing found"
    grep -q "$(git rev-parse --short HEAD) ([0-9]* days old, [0-9?]* behind main)" "$dir/logs/latest" \
        || fail "the summary line does not say which commit was fuzzed and how far behind main it is, so a timer left on a stale one reads as a good night"
    rm -f fuzz/artifacts/*/slow-unit-"$tag"
    }

    # The tree the gate ran in is where it was. `fuzz-watermark` is the only
    # thing here that can move a worktree, and it follows the tip — so a `run`
    # that stopped saying the night had already advanced would have `just gate`
    # check out somebody else's commit under them. Asked once every arm is done.
    head_did_not_move() {
    [ "$(git rev-parse HEAD)" = "$head_before" ] \
        || fail "the night moved the tree it ran in, from $head_before to $(git rev-parse HEAD)"
    }

    # Four: an overrun in one target costs the other four nothing.
    #
    # This is the arm the change of 2026-09-18 turned round, and it is worth
    # saying what it used to assert: that an overrun in the first target spent
    # the window and the remaining four were skipped and said to be skipped.
    # That was correct of a recipe that ran them in turn, and it was the single
    # worst property of that recipe — one slow target could take four others'
    # hours with it. Run together they cannot, so the same fixture now asks the
    # opposite question and the old assertion is what would fail.
    #
    # Six and eight, so the overrunner is eleven seconds into a six-second
    # window when it returns while the other four have been done since three.
    # The skip path it used to reach on the way is arm Nine's now.
    four() {
    : >"$dir/log"
    : >"$dir/rendezvous"
    started=$(date +%s)
    status=0
    STUB_OVERRUN=8 STUB_OVERRUN_TARGET=where_two_surfaces_cross \
        STUB_RENDEZVOUS="$dir/rendezvous" run 6 || status=$?
    elapsed=$(( $(date +%s) - started ))
    [ "$status" -eq 0 ] \
        || fail "one target overran and the night reported $status for the other four"
    # `.*max_total_time` again excludes the reader's own merge line (Q237),
    # which this arm's STEP corpus fixture triggers same as every other.
    [ "$(grep -c 'fuzz run.*max_total_time' "$dir/log")" -eq 5 ] \
        || fail "one target overran and took the rest of the window with it"
    # And all five were alive at one instant, which is the assertion the clock
    # cannot make. A night is as long as its slowest target however the rest are
    # arranged, so total elapsed time is satisfied by a recipe that runs one
    # target, waits for it, and only then starts the other four. What is not
    # satisfied by that recipe is five targets meeting at a barrier.
    #
    # **This replaced a bound on the launch spread, and the reason is §139.**
    # `spread <= 3` had to sit between five `just` forks below and a sequential
    # recipe's spread above, so a loaded runner failed it and raising the number
    # deleted the check rather than weakening it. Worse, its margin came entirely
    # from the overrun target leading `fuzz_all`: point `STUB_OVERRUN_TARGET`
    # anywhere else and the adversary spread exactly 3, so the arm kept passing
    # and stopped discriminating. A barrier does not care which target leads, and
    # asserts the stronger property the comment above already claimed.
    #
    # **Before the clock below, and not after**, because a recipe that fails this
    # one fails it by waiting out the barrier's deadline — which is itself time on
    # the clock. Checked the other way round, every sequential recipe reports the
    # elapsed bound, and the symptom buries the cause.
    [ "$(grep -c '^rendezvous .* saw 5 of 5$' "$dir/log")" -eq 5 ] \
        || fail "the five targets never met at one instant, so they are still waiting for each other: $(grep '^rendezvous ' "$dir/log" | tr '\n' ' ')"

    [ "$elapsed" -le 20 ] || fail "one eight-second overrun cost the night $elapsed s"
    }

    # Five: the hub is refused before anything is built, so a timer pointed at
    # it fails on the first night rather than on the night it matters.
    five() {
    hub="$dir/hub"
    git init -q -b main "$hub"
    cp justfile "$hub/justfile"
    git -C "$hub" add justfile
    git -C "$hub" -c user.email=t@t -c user.name=t commit -q -m "root"
    git -C "$hub" worktree add -q --detach "$dir/lane"
    : >"$dir/log"
    status=0
    (cd "$hub" && STUB_LOG="$dir/log" PATH="$dir/bin:$PATH" \
        RCAD_FUZZ_LOGS="$dir/logs" RCAD_FUZZ_CORPUS="$dir/corpus" \
        {{just_executable()}} fuzz-overnight 4) >"$dir/out" 2>&1 || status=$?
    [ "$status" -ne 0 ] || fail "the hub was handed an eight-hour job and took it"
    grep -q 'nobody works in the hub' "$dir/out" \
        || fail "the hub was refused without saying why: $(cat "$dir/out")"
    [ ! -s "$dir/log" ] \
        || fail "the hub was refused only after cargo had been run"
    }

    # Six: a night runs the justfile it checked out, and not the one it woke up
    # on. `just` reads the whole recipe body before the first line of it runs, so
    # a recipe that advanced the tree and carried on would be fuzzing one commit
    # with another commit's instructions — and every fix to this file would take
    # effect the night after it landed. That is what happened on 2026-09-14: six
    # artifacts kept nowhere, by a body read from a commit two days older than
    # §91's copy-out.
    #
    # The fixture says which body ran by making the two commits disagree: the
    # night starts on the real recipe and the commit it advances to carries a
    # `fuzz-overnight` that does nothing but name itself.
    six_and_seven() {
    night_repo="$dir/night"
    git init -q -b main "$night_repo"
    mkdir -p "$night_repo/fuzz"
    touch "$night_repo/fuzz/.keep"
    cp justfile "$night_repo/justfile"
    git -C "$night_repo" add justfile fuzz/.keep
    git -C "$night_repo" -c user.email=t@t -c user.name=t commit -q -m "the real recipe"
    woke_on=$(git -C "$night_repo" rev-parse HEAD)
    cat >"$night_repo/justfile" <<'STUB'
    fuzz-overnight window="28800":
        @echo "the checked-out justfile ran, with {{{{ window }} s left"
    STUB
    git -C "$night_repo" add justfile
    git -C "$night_repo" -c user.email=t@t -c user.name=t commit -q -m "a recipe that names itself"
    tip=$(git -C "$night_repo" rev-parse HEAD)
    git init -q --bare "$dir/night-origin.git"
    git -C "$night_repo" remote add origin "$dir/night-origin.git"
    git -C "$night_repo" push -q origin main
    git -C "$night_repo" checkout -q --detach "$woke_on"

    # The status is read last, and not with `||`. A night that carried on with
    # the wrong body goes on to build and fuzz, and then fails or passes for
    # reasons of its own — so asserting on it first answers "did the fixture's
    # stubs behave" where the arm means to ask "whose recipe ran".
    : >"$dir/log"
    status=0
    (cd "$night_repo" && STUB_LOG="$dir/log" PATH="$dir/bin:$PATH" \
        RCAD_FUZZ_LOGS="$dir/logs" RCAD_FUZZ_CORPUS="$dir/corpus" \
        {{just_executable()}} fuzz-overnight 20) >"$dir/out" 2>&1 || status=$?
    grep -q "advancing to $tip" "$dir/out" \
        || fail "the night did not advance onto the tip of main: $(cat "$dir/out")"
    grep -q 'the checked-out justfile ran' "$dir/out" \
        || fail "the night carried on with the recipe it woke up on: $(cat "$dir/out")"
    [ ! -s "$dir/log" ] \
        || fail "the recipe that woke up on the old commit built and fuzzed before handing over"
    [ "$(git -C "$night_repo" rev-parse HEAD)" = "$tip" ] \
        || fail "the night ended on $(git -C "$night_repo" rev-parse HEAD) rather than the commit it advanced to"
    [ "$status" -eq 0 ] || fail "a night that advanced exited $status: $(cat "$dir/out")"

    # What is left of the window is handed on, rather than a fresh one. A night
    # that started the clock again would run until morning past its deadline,
    # which is arm one's mistake made where nothing else would catch it.
    left=$(sed -n 's/.*ran, with \([0-9-]*\) s left.*/\1/p' "$dir/out")
    [ -n "$left" ] || fail "the recipe taking over was told no window at all"
    [ "$left" -le 20 ] \
        || fail "the recipe taking over was given $left s of a twenty-second window"

    # Seven: a night advances once. The commit it lands on was the tip a moment
    # ago, so the recipe taking over almost always finds nothing to move to —
    # but "almost always" is a bound on how often `main` moves and not on this
    # loop, and a night that spent itself chasing a busy branch would say
    # nothing about why.
    git -C "$night_repo" checkout -q --detach "$woke_on"
    : >"$dir/log"
    (cd "$night_repo" && STUB_LOG="$dir/log" PATH="$dir/bin:$PATH" \
        RCAD_FUZZ_ALREADY_ADVANCED=1 \
        RCAD_FUZZ_LOGS="$dir/logs" RCAD_FUZZ_CORPUS="$dir/corpus" \
        RCAD_FUZZ_TIMING_CHECK="$dir/bin/timing-check-stub.sh" \
        {{just_executable()}} fuzz-overnight 8) >"$dir/out" 2>&1 \
        || fail "a night told it had already advanced exited non-zero: $(cat "$dir/out")"
    [ "$(git -C "$night_repo" rev-parse HEAD)" = "$woke_on" ] \
        || fail "a night told it had already advanced moved the tree a second time"
    # Counted off `fuzz_all` rather than written down. What this arm is about is
    # the hand-over, not the roster — arm one owns the roster and says the
    # number out loud there — and a literal here is a second place to remember
    # when a target is added. One was, between this arm being written and the
    # branch it was written on reaching `main`.
    targets=$(wc -w <<<"{{ fuzz_all }}")
    # `.*max_total_time` again excludes the reader's own merge line (Q237).
    # This arm's `night_repo` fixture carries no `RCAD_STEP_CORPUS`, so on its
    # own the merge would not fire here — narrowed anyway, so this check keeps
    # meaning "every target ran" if that ever changes.
    [ "$(grep -c 'fuzz run.*max_total_time' "$dir/log")" -eq "$targets" ] \
        || fail "the night that took over did not go on to fuzz all $targets targets: $(cat "$dir/out")"
    }

    # Eight: with no `cargo` on the PATH at all, the night says that and does not
    # offer to install a nightly toolchain. This is 2026-09-15 exactly (§108.2):
    # the real reason was in `build.log` and the only sentence addressed to a
    # person named the toolchain, which was never the question.
    #
    # **The PATH is built here rather than borrowed, and asserted empty of
    # `cargo` before it is used.** Borrowing `/usr/bin:/bin` passes on this
    # machine, where cargo lives under `~/.cargo`, and silently tests nothing
    # wherever cargo comes from a package — an arm passing for a property of the
    # environment it ran in, which is §77.6's mistake and which this repo has
    # now made three times.
    # Built by dropping every PATH entry that holds a `cargo` and keeping the
    # rest, rather than by listing the tools the night needs into a fresh
    # directory. That list was tried and it is not a list anybody can finish:
    # the first attempt died on `id`, which this justfile runs in a top-level
    # backtick before any recipe body starts.
    eight() {
    bare=""
    IFS=: read -ra path_parts <<<"$PATH"
    for part in "${path_parts[@]}"; do
        [ -n "$part" ] || continue
        if [ -x "$part/cargo" ]; then continue; fi
        bare="${bare:+$bare:}$part"
    done
    if PATH="$bare" command -v cargo >/dev/null 2>&1; then
        fail "the no-cargo fixture still has a cargo in it, so the arm below would prove nothing"
    fi
    # And the drop has to have taken cargo and nothing else. Where cargo ships in
    # the same directory as the coreutils — a distribution package rather than
    # rustup — this arm cannot run, and it says so instead of failing further
    # down for a reason that reads like the night's fault.
    for needed in bash git id date find sed awk grep tail wc timeout mktemp; do
        if ! PATH="$bare" command -v "$needed" >/dev/null 2>&1; then
            fail "dropping cargo from the PATH also dropped $needed, so this arm cannot run on this machine"
        fi
    done

    : >"$dir/log"
    status=0
    PATH="$bare" STUB_LOG="$dir/log" RCAD_FUZZ_ALREADY_ADVANCED=1 \
        RCAD_FUZZ_LOGS="$dir/logs" RCAD_FUZZ_CORPUS="$dir/corpus" \
        {{just_executable()}} fuzz-overnight 8 >"$dir/out" 2>&1 || status=$?
    [ "$status" -ne 0 ] || fail "a night with no cargo at all reported success"
    grep -q 'no `cargo` on this PATH at all' "$dir/out" \
        || fail "a night with no cargo did not say so: $(cat "$dir/out")"
    if grep -q 'rustup toolchain install nightly' "$dir/out"; then
        fail "a night with no cargo offered to install a nightly, which is the sentence that misled on 2026-09-15"
    fi
    grep -q 'BUILD FAILED' "$dir/logs/latest" \
        || fail "a night that could not build did not say BUILD FAILED in the summary line"
    }

    # Nine: a window with nothing left in it skips every target and says so,
    # rather than starting five fresh eight-hour runs past the deadline.
    #
    # Arm four used to reach this path on its way past an overrun, and cannot
    # any more: the five no longer wait for each other, so there is no longer a
    # way for one of them to spend the window before the others are started.
    # A window of zero is what is left of that case, and it is the whole of it.
    nine() {
    : >"$dir/log"
    status=0
    run 0 || status=$?
    [ "$status" -ne 0 ] || fail "every target was skipped and the night reported success"
    [ "$(grep -c 'fuzz run' "$dir/log")" -eq 0 ] \
        || fail "a window with no seconds in it still started a target"
    grep -q 'TO LOOK AT.*no-time' "$dir/logs/latest" \
        || fail "a night that skipped every target did not say so: $(cat "$dir/logs/latest")"
    }

    # Ten: what a target found is carried out of the worktree on a clock, and
    # not only when a target finishes.
    #
    # §91's reason for copying at all is a night killed from outside, and while
    # the five ran in turn the copy rode along on four target boundaries spread
    # across the night. Run together, every target finishes in the same minute
    # at the far end of the window, so those boundaries are gone and a copy that
    # waited for them would keep nothing from a night killed at 04:00 — strictly
    # worse than what it replaced.
    #
    # Its own log root, where nothing but this run's copier can have put
    # anything, because the question here is whether *this* run copied anything
    # yet. Four seconds into a twelve-second window: the targets are six seconds
    # from returning, so nothing but the clock can have done it.
    ten() {
    : >"$dir/log"
    copier_logs="$dir/logs-copier"
    RCAD_FUZZ_COPY_EVERY=1 STUB_LOG="$dir/log" PATH="$dir/bin:$PATH" \
        STUB_ARTIFACT_TAG="$tag" RCAD_FUZZ_ALREADY_ADVANCED=1 \
        RCAD_FUZZ_LOGS="$copier_logs" RCAD_FUZZ_CORPUS="$dir/corpus" \
        RCAD_FUZZ_TIMING_CHECK="$dir/bin/timing-check-stub.sh" \
        {{just_executable()}} fuzz-overnight 12 >"$dir/out" 2>&1 &
    night_pid=$!
    sleep 4
    # Guarded, and not left to `find` to report: with nothing copied the
    # directory does not exist at all, `find` exits 1, and `pipefail` takes the
    # recipe down before the assertion below can say which arm failed or why.
    # Which is what happened the first time this arm was run against a night
    # with its copier taken out — the test failed, correctly, and said nothing.
    carried=0
    copier_night="$copier_logs/$(date +%Y-%m-%d)/artifacts"
    if [ -d "$copier_night" ]; then
        carried=$(find "$copier_night" -name "slow-unit-$tag" | wc -l)
    fi
    wait "$night_pid" || fail "the night under the copier exited non-zero: $(cat "$dir/out")"
    [ "$carried" -ge 1 ] \
        || fail "four seconds into a twelve-second window nothing had been carried out of the worktree, so a night killed before its targets finish keeps nothing"
    }

    # Eleven: exit 70 is not a crash. This is §133.7 as an arm, and it is the one
    # the recipe this replaced would fail: every target fuzzed the whole window,
    # found nothing, and exited 70 because the last of its jobs happened to time
    # out. Two real runs of the same command on the same corpus exited 70 and 0,
    # so a night that read the status would have called one of them a find.
    eleven() {
    : >"$dir/log"
    status=0
    STUB_CRASH=run run 8 || status=$?
    [ "$status" -eq 0 ] \
        || fail "every target exited 70 after fuzzing its whole window and the night reported $status: $(cat "$dir/logs/latest")"
    ! grep -q 'TO LOOK AT' "$dir/logs/latest" \
        || fail "a night whose targets exited 70 was reported as needing a look: $(cat "$dir/logs/latest")"
    }

    # Twelve: a crash is found by what it wrote, not by what anything exited.
    # **The night exits 0 everywhere here** — which is fork mode's other half and
    # the more dangerous one: a crash in job 3 of 40 000 leaves the parent's
    # `ExitCode` holding whichever job was collected last, so a status mapping
    # that trusted zero would report this night clean.
    twelve() {
    : >"$dir/log"
    status=0
    STUB_ARTIFACT_KIND=crash- STUB_ARTIFACT_KIND_TARGET=two_solids_fused_by_a_stranger \
        run 8 || status=$?
    [ "$status" -ne 0 ] \
        || fail "a target wrote a crash artifact and the night reported success: $(cat "$dir/logs/latest")"
    grep -q 'TO LOOK AT.*crashed:' "$dir/logs/latest" \
        || fail "the summary line does not say a crash was written: $(cat "$dir/logs/latest")"
    rm -f fuzz/artifacts/two_solids_fused_by_a_stranger/crash-"$tag"
    }

    # Thirteen: and it is **tonight's** crash that fails tonight, not one from a
    # week ago. `fuzz/artifacts/` is gitignored and never cleaned, so it
    # accumulates in the tree the timer keeps; a night that counted all of it
    # would fail every night from the first crash onwards and stop being read,
    # which is §91's failure with the sign flipped.
    #
    # Dated a day back rather than merely written before the run: the marker is
    # made seconds before the targets start, and a file written in the same second
    # cannot be told from one written just after it.
    thirteen() {
    : >"$dir/log"
    mkdir -p fuzz/artifacts/where_two_surfaces_cross
    stale="fuzz/artifacts/where_two_surfaces_cross/crash-stale-$tag"
    echo "what last week found" >"$stale"
    touch -d "1 day ago" "$stale"
    status=0
    run 8 || status=$?
    rm -f "$stale"
    [ "$status" -eq 0 ] \
        || fail "a crash left over from an earlier night failed this one: $(cat "$dir/logs/latest")"
    ! grep -q 'crashed:' "$dir/logs/latest" \
        || fail "a carried-over crash artifact triggered a look tonight: $(cat "$dir/logs/latest")"
    ! grep -q 'where_two_surfaces_cross:.*crash' "$dir/logs/latest" \
        || fail "a carried-over crash artifact was named as tonight's find: $(cat "$dir/logs/latest")"
    }

    # Fourteen: a `timeout-` artifact is a measurement and not a fault (§135),
    # but it still has to be named, against a pile of old ones and not added to
    # it. This is §226.3 reproduced directly: a stale timeout from a night ago
    # sits in the same directory as tonight's first new one, and the two must
    # not be summed. `-timeout=10` makes a timeout a nightly certainty on
    # `where_two_surfaces_cross`, whose tracked corpus holds inputs of 17 to 19
    # seconds — the replay writes one before any fuzzing starts. A night that
    # failed on it would fail every night, and a night that always fails is a
    # night nobody reads.
    fourteen() {
    : >"$dir/log"
    mkdir -p fuzz/artifacts/where_two_surfaces_cross
    old_timeout="fuzz/artifacts/where_two_surfaces_cross/timeout-old-$tag"
    echo "last night's pile" >"$old_timeout"
    touch -d "1 day ago" "$old_timeout"
    status=0
    STUB_ARTIFACT_KIND=timeout- STUB_ARTIFACT_KIND_TARGET=where_two_surfaces_cross \
        run 8 || status=$?
    rm -f "$old_timeout"
    [ "$status" -eq 0 ] \
        || fail "a timed-out input failed the night, so every night fails from here on: $(cat "$dir/logs/latest")"
    line=$(grep -o 'where_two_surfaces_cross: [0-9]* timeout' "$dir/logs/latest" || true)
    [ "$line" = "where_two_surfaces_cross: 1 timeout" ] \
        || fail "tonight's one new timeout was miscounted against last night's pile: $(cat "$dir/logs/latest")"
    ! grep -q 'nothing found' "$dir/logs/latest" \
        || fail "a timed-out input written tonight was reported as nothing found — this is §226.3's bug"
    night="$dir/logs/$(date +%Y-%m-%d)"
    [ -f "$night/artifacts/where_two_surfaces_cross/timeout-$tag" ] \
        || fail "a timed-out input was not carried out of the worktree, so nobody can see a new one appear"
    rm -f fuzz/artifacts/where_two_surfaces_cross/timeout-"$tag"
    }

    # Fifteen: **a hand run gets neither flag**, and that is not tidiness.
    # `-ignore_timeouts` is a fork-mode flag, so without `-fork` a timeout kills
    # the process — and `fuzz/corpus/where_two_surfaces_cross` is where the 17-to-19
    # second inputs live. A `just fuzz 60` carrying `-timeout=10` would die on its
    # own corpus replay before fuzzing a single new input (§133.7).
    #
    # Run against `fuzz-target` through `fuzz` rather than through `fuzz-overnight`,
    # because the hand path is the one call site the night never takes. It lives in
    # this arm's file because this is where the stub `cargo` is.
    fifteen() {
    : >"$dir/log"
    STUB_LOG="$dir/log" PATH="$dir/bin:$PATH" {{just_executable()}} fuzz 2 >"$dir/out" 2>&1 \
        || fail "a hand-run \`just fuzz\` failed: $(cat "$dir/out")"
    grep -q 'fuzz run where_two_surfaces_cross' "$dir/log" \
        || fail "a hand-run \`just fuzz\` did not reach the target at all: $(cat "$dir/log")"
    # Negated with `!` and not written as `grep && fail`: the passing case is the
    # grep finding nothing, which is a non-zero status, and `set -e` would take
    # the recipe down on the arm that just succeeded.
    ! grep -q 'timeout=' "$dir/log" \
        || fail "a hand run was given a per-input timeout, which without -fork kills it on its own corpus replay"
    ! grep -q 'fork=' "$dir/log" \
        || fail "a hand run was given -fork, so a crash no longer stops it and prints"
    }

    # Sixteen: the guard that reads `rcad-fuzz-timing`'s own rlib back after the
    # build (docs/decisions.d/267.4, §292) fails the night loudly when that rlib
    # carries a sancov reference, before any target is started — a stale build,
    # one made before the stand-in existed or with it broken, must not pass
    # silently. The stub `cargo` above writes this arm's fixture rlib itself
    # (`STUB_TIMING_SANCOV=1`), so this is a test of the guard and not of the
    # stand-in, which 267.5 already measured on a real build.
    #
    # The guard reads whichever rlib `find | head -n1` meets first, so this arm
    # runs alone, after the clean rlibs the arms run beside each other left
    # under their own tags are gone (see the end): any one of those, met first,
    # would pass this night and fail the arm.
    sixteen() {
    : >"$dir/log"
    status=0
    STUB_TIMING_SANCOV=1 run 8 || status=$?
    [ "$status" -ne 0 ] \
        || fail "rcad-fuzz-timing's rlib carried a sancov reference and the night reported success"
    grep -q 'sancov reference' "$dir/out" \
        || fail "the night did not say why it failed: $(cat "$dir/out")"
    grep -q 'BUILD FAILED' "$dir/logs/latest" \
        || fail "an instrumented timing rlib did not read as a build failure in the summary: $(cat "$dir/logs/latest")"
    [ "$(grep -c 'fuzz run' "$dir/log")" -eq 0 ] \
        || fail "the night fuzzed targets after finding a sancov reference in rcad-fuzz-timing's rlib"
    }

    # Seventeen: the same guard passes a night whose rlib has none, which is the
    # ordinary case — every arm above already relies on this, and this one says
    # so directly rather than leaving it to be inferred from the rest passing.
    seventeen() {
    : >"$dir/log"
    run 8 || fail "a night with a clean timing rlib failed: $(cat "$dir/out")"
    ! grep -q 'sancov reference' "$dir/out" \
        || fail "a clean timing rlib was still read as carrying a sancov reference"
    }

    # Eighteen: the reader's nightly merge itself (§295.7, Q237) — folding
    # tonight's scratch corpus into the small persistent one at -max_len=5110,
    # persistent copy first and scratch second so libFuzzer never mutates the
    # real thing in place — runs exactly once, in that order, and the scratch
    # directory is gone once it has succeeded. It also runs with
    # RCAD_FUZZ_TIMINGS unset (Q263, §295.6, §295.7), since it replays finds
    # through timed() the same as any other draw, and it writes its own
    # wall-clock seconds to reader-corpus-merge.log.
    eighteen() {
    : >"$dir/log"
    run 8 || fail "a night with the reader's STEP corpus seeded in failed: $(cat "$dir/out")"
    [ "$(grep -c -- '-merge=1' "$dir/log")" -eq 1 ] \
        || fail "the reader's nightly merge did not run exactly once: $(grep -- '-merge=1' "$dir/log" || true)"
    grep -q -- "run no_step_file_makes_the_reader_panic -- -merge=1 -max_len=5110 $dir/corpus/no_step_file_makes_the_reader_panic-merge-tmp\.[^ ]* $dir/corpus/no_step_file_makes_the_reader_panic-scratch " "$dir/log" \
        || fail "the merge did not run persistent-copy-first, scratch-second: $(grep -- '-merge=1' "$dir/log" || true)"
    grep -q -- "run no_step_file_makes_the_reader_panic -- -merge=1 -max_len=5110 $dir/corpus/no_step_file_makes_the_reader_panic-merge-tmp\.[^ ]* $dir/corpus/no_step_file_makes_the_reader_panic-scratch \[timings=unset\]" "$dir/log" \
        || fail "the reader-corpus merge ran with RCAD_FUZZ_TIMINGS still exported: $(grep -- '-merge=1' "$dir/log" || true)"
    grep -qE 'took [0-9]+s' "$dir/logs/$(date +%Y-%m-%d)/reader-corpus-merge.log" \
        || fail "the merge's wall-clock seconds were not written to reader-corpus-merge.log: $(cat "$dir/logs/$(date +%Y-%m-%d)/reader-corpus-merge.log" 2>/dev/null || true)"
    [ ! -d "$dir/corpus/no_step_file_makes_the_reader_panic-scratch" ] \
        || fail "the scratch directory survived a successful merge"
    }

    # Nineteen: a failing merge — anything that makes libFuzzer's own
    # `-merge=1` exit non-zero — never touches the persistent corpus and never
    # silently drops tonight's scratch directory: the scratch is moved aside
    # with a timestamp, the persistent corpus is left exactly as it was, and
    # the night names it under TO LOOK AT (Q237 item 5).
    nineteen() {
    : >"$dir/log"
    reader_persistent="$dir/corpus/no_step_file_makes_the_reader_panic"
    rm -rf "$reader_persistent"
    mkdir -p "$reader_persistent"
    echo "an earlier night's minimized find" >"$reader_persistent/kept-from-before"
    status=0
    STUB_MERGE_FAIL=1 run 8 || status=$?
    [ "$status" -ne 0 ] \
        || fail "a failing reader-corpus merge did not fail the night"
    [ "$(cat "$reader_persistent/kept-from-before")" = "an earlier night's minimized find" ] \
        || fail "a failing merge changed a file in the persistent corpus it should have left alone"
    [ "$(find "$reader_persistent" -type f | wc -l)" -eq 1 ] \
        || fail "a failing merge added or removed files in the persistent corpus"
    failed_scratch=$(find "$dir/corpus" -maxdepth 1 -name 'no_step_file_makes_the_reader_panic-scratch-failed-*' -type d)
    [ -n "$failed_scratch" ] \
        || fail "a failing merge did not move tonight's scratch directory aside"
    grep -q 'TO LOOK AT.*reader-merge:failed' "$dir/logs/latest" \
        || fail "a failing merge was not named in the summary: $(cat "$dir/logs/latest")"
    rm -rf "$reader_persistent" "$failed_scratch"
    }

    # Twenty: a scratch directory left over from a night that died before its
    # own merge — the whole `fuzz-overnight` process killed between its
    # targets finishing and the merge running — survives tomorrow's
    # `fuzz-target` call instead of being thrown away unmerged (Q237 item 6a).
    # Folded into tonight's run rather than moved aside on its own: since
    # `fuzz-target` no longer empties the scratch directory it is handed,
    # whatever tonight's run adds joins what was already there, and both merge
    # in together at the end of `fuzz-overnight` — simpler than teaching
    # `fuzz-target`, which has no `to_look_at` of its own, to name a leftover
    # directory in the night's summary.
    twenty() {
    : >"$dir/log"
    scratch_dir="$dir/corpus/no_step_file_makes_the_reader_panic-scratch"
    rm -rf "$scratch_dir"
    mkdir -p "$scratch_dir"
    echo "last night's unmerged find" >"$scratch_dir/leftover"
    STUB_LOG="$dir/log" PATH="$dir/bin:$PATH" STUB_ARTIFACT_TAG="$tag" \
        {{just_executable()}} fuzz-target no_step_file_makes_the_reader_panic 2 "$dir/corpus" "" 0 step.dict "$dir/step-corpus" \
        >"$dir/out" 2>&1 \
        || fail "fuzz-target with a leftover scratch directory failed: $(cat "$dir/out")"
    [ -f "$scratch_dir/leftover" ] \
        || fail "a scratch directory left over from an unmerged night was thrown away instead of kept for tonight's merge"
    rm -rf "$scratch_dir"
    }

    # Twenty-one: the merge itself is bounded, so a merge that hangs takes the
    # failure path rather than running past the night's own outer deadline
    # (`TimeoutStartSec=29400` in tooling/systemd/rcad-fuzz.service, 600 s past
    # the 28800 s window `fuzz-overnight` divides on its own — Q237 item 6b).
    # `RCAD_FUZZ_MERGE_TIMEOUT` overrides the real 120 s bound for exactly this
    # arm; nothing else in this file sets it, so every other arm's merge keeps
    # the real one.
    twenty_one() {
    : >"$dir/log"
    reader_persistent="$dir/corpus/no_step_file_makes_the_reader_panic"
    rm -rf "$reader_persistent"
    mkdir -p "$reader_persistent"
    echo "kept before the hang" >"$reader_persistent/kept-from-before"
    status=0
    RCAD_FUZZ_MERGE_TIMEOUT=1 STUB_MERGE_HANG=5 run 8 || status=$?
    [ "$status" -ne 0 ] \
        || fail "a merge that hung past its bound did not fail the night"
    [ "$(cat "$reader_persistent/kept-from-before")" = "kept before the hang" ] \
        || fail "a merge killed by its own timeout still touched the persistent corpus"
    failed_scratch=$(find "$dir/corpus" -maxdepth 1 -name 'no_step_file_makes_the_reader_panic-scratch-failed-*' -type d)
    [ -n "$failed_scratch" ] \
        || fail "a merge killed by its own timeout did not move tonight's scratch directory aside"
    grep -q 'TO LOOK AT.*reader-merge:failed' "$dir/logs/latest" \
        || fail "a merge killed by its own timeout was not named in the summary: $(cat "$dir/logs/latest")"
    rm -rf "$reader_persistent" "$failed_scratch"
    }

    # Twenty-two: the corpus-name lists (Q53) are written before any target
    # starts, name exactly what was already in each target's writable corpus
    # at that moment — sorted, one file per target — and are never touched by
    # what a target goes on to find during the night. That is the whole point
    # of taking the list first: §240.3's rewrite gives an old file a new mtime
    # under its old name, so only a list written *before* the night's own
    # merge runs can say a given name was already there.
    twenty_two() {
    : >"$dir/log"
    night="$dir/logs/$(date +%Y-%m-%d)"
    rm -rf "$dir/corpus"
    mkdir -p "$dir/corpus/where_two_surfaces_cross" \
        "$dir/corpus/no_step_file_makes_the_reader_panic" \
        "$dir/corpus/no_model_makes_the_writer_panic" \
        "$dir/corpus/two_solids_fused_by_a_stranger"
    echo "b" >"$dir/corpus/where_two_surfaces_cross/b-before"
    echo "a" >"$dir/corpus/where_two_surfaces_cross/a-before"
    echo "c" >"$dir/corpus/no_step_file_makes_the_reader_panic/c-before"
    echo "d" >"$dir/corpus/no_model_makes_the_writer_panic/d-before"
    echo "e" >"$dir/corpus/two_solids_fused_by_a_stranger/e-before"
    # `where_a_cone_or_a_torus_crosses` is left with no directory at all — the
    # "never listed" side of the row's own "no inputs" vs "never listed"
    # distinction.

    STUB_CORPUS_ADD="found-tonight" run 8 \
        || fail "a night with corpus-name fixtures in place failed: $(cat "$dir/out")"

    [ "$(cat "$night/corpus-names/where_two_surfaces_cross")" = "$(printf 'a-before\nb-before')" ] \
        || fail "where_two_surfaces_cross's corpus-names list is wrong: $(cat "$night/corpus-names/where_two_surfaces_cross" 2>&1)"
    [ "$(cat "$night/corpus-names/no_step_file_makes_the_reader_panic")" = "c-before" ] \
        || fail "the reader's corpus-names list should name its persistent directory, not its scratch one: $(cat "$night/corpus-names/no_step_file_makes_the_reader_panic" 2>&1)"
    [ "$(cat "$night/corpus-names/no_model_makes_the_writer_panic")" = "d-before" ] \
        || fail "no_model_makes_the_writer_panic's corpus-names list is wrong: $(cat "$night/corpus-names/no_model_makes_the_writer_panic" 2>&1)"
    [ "$(cat "$night/corpus-names/two_solids_fused_by_a_stranger")" = "e-before" ] \
        || fail "two_solids_fused_by_a_stranger's corpus-names list is wrong: $(cat "$night/corpus-names/two_solids_fused_by_a_stranger" 2>&1)"
    [ -f "$night/corpus-names/where_a_cone_or_a_torus_crosses" ] \
        || fail "a target with no corpus directory yet got no list at all, instead of an empty one"
    [ -z "$(cat "$night/corpus-names/where_a_cone_or_a_torus_crosses")" ] \
        || fail "a target with no corpus directory yet got a non-empty list: $(cat "$night/corpus-names/where_a_cone_or_a_torus_crosses")"

    # And the file this run itself found is real — `STUB_CORPUS_ADD` did land
    # in the directory a real fuzzer would have used — so the checks above are
    # not vacuously passing over a run that added nothing anywhere.
    [ -f "$dir/corpus/where_two_surfaces_cross/found-tonight" ] \
        || fail "STUB_CORPUS_ADD did not write into the target's own writable corpus, so the exclusion above proves nothing"
    ! grep -q '^found-tonight$' "$night/corpus-names/where_two_surfaces_cross" \
        || fail "the corpus-names list named a file this same run added, not just what was there before it started"
    }

    # Twenty-three: an artifact already sitting under `fuzz/artifacts/<target>/`
    # before `.started` is written, and then rewritten under that same name
    # during tonight's run — exactly what a `-fork` worker does to a name
    # libFuzzer has already written once (§270.3) — must not count as new,
    # while a name with nothing before it tonight still does.
    #
    # This is not Fourteen's stale-timeout fixture again: that file is dated a
    # day back and never touched again, so its mtime was always older than
    # `.started` and even the old `-newer "$since"` check excluded it. The bug
    # this arm exists to catch only shows up when the *same name* is written a
    # second time — its mtime lands *after* `.started`, indistinguishable by
    # mtime alone from a genuine new find, which is exactly what the old check
    # could not do and this one, going by name, does not need to.
    # Every arm run alone before this one also wrote `slow-unit-$tag` into
    # every target's real `fuzz/artifacts/`, none of it cleared since: cleared
    # here so `no_model_makes_the_writer_panic`'s write below is this tag's
    # first under that name, and the "still counts as new" half of this arm
    # proves what it claims to.
    twenty_three() {
    rm -f fuzz/artifacts/*/slow-unit-"$tag"
    : >"$dir/log"
    mkdir -p fuzz/artifacts/where_two_surfaces_cross
    carried="fuzz/artifacts/where_two_surfaces_cross/timeout-$tag"
    echo "last night's find" >"$carried"
    status=0
    STUB_ARTIFACT_KIND=timeout- STUB_ARTIFACT_KIND_TARGET=where_two_surfaces_cross \
        run 8 || status=$?
    [ "$status" -eq 0 ] \
        || fail "a carried-over artifact rewritten tonight failed the night: $(cat "$dir/logs/latest")"
    night="$dir/logs/$(date +%Y-%m-%d)"
    # The rewrite actually happened — the stub overwrites the same path every
    # time its target runs, same as a `-fork` worker does — so a check that
    # still trusted mtime would see this file as new. Without this, the two
    # greps below would pass whether or not the fixture exercised anything.
    [ "$carried" -nt "$night/.started" ] \
        || fail "the fixture never rewrote the carried-over file after .started, so this arm proves nothing"
    ! grep -q 'where_two_surfaces_cross:.*timeout' "$dir/logs/latest" \
        || fail "a carried-over artifact rewritten unchanged tonight was counted as new: $(cat "$dir/logs/latest")"
    line=$(grep -o 'no_model_makes_the_writer_panic: [0-9]* slow-unit' "$dir/logs/latest" || true)
    [ "$line" = "no_model_makes_the_writer_panic: 1 slow-unit" ] \
        || fail "a target with nothing before tonight was not counted as new: $(cat "$dir/logs/latest")"
    }

    # Twenty-four: the scan for a timing-crate call that reaches libFuzzer's
    # memcmp-family hook from outside `SlowRun::is` (docs/decisions.d/273,
    # Q181) fails the night loudly, before any target is started, when it
    # finds one. This is a test of the recipe's own wiring — that a non-zero
    # exit from the scan reads as a build failure and stops every target —
    # and not of the scan's own logic, which a stub can never exercise
    # because it never disassembles a real binary; docs/decisions.d/273
    # demonstrates the scan itself against a real build of 3319f838.
    twenty_four() {
    : >"$dir/log"
    status=0
    STUB_TIMING_HOOKED=1 run 8 || status=$?
    [ "$status" -ne 0 ] \
        || fail "a timing-crate call reaching a hook outside SlowRun::is was found and the night reported success"
    grep -q 'reaches a memcmp-family hook' "$dir/out" \
        || fail "the night did not say why it failed: $(cat "$dir/out")"
    grep -q 'BUILD FAILED' "$dir/logs/latest" \
        || fail "a hooked timing-crate call did not read as a build failure in the summary: $(cat "$dir/logs/latest")"
    [ "$(grep -c 'fuzz run' "$dir/log")" -eq 0 ] \
        || fail "the night fuzzed targets after finding a timing-crate call reaching a hook"
    }

    # Twenty-five: the same check passes a night whose scan finds nothing to
    # report, which is the ordinary case — every arm above already relies on
    # this, since `run()` defaults every one of them to the clean stub, and
    # this one says so directly.
    twenty_five() {
    : >"$dir/log"
    run 8 || fail "a night with a clean timing-hooked-calls scan failed: $(cat "$dir/out")"
    ! grep -q 'reaches a memcmp-family hook' "$dir/out" \
        || fail "a clean scan was still read as finding a hooked call"
    }

    # Twenty-seven: nothing the night starts outlives it — in particular the
    # copier's own `sleep`, orphaned with `ppid 1` once the subshell holding
    # it was killed from outside (Q806). `copy_every` is set to a number
    # nothing else on the machine runs `sleep` with, so a `sleep` process
    # still carrying it after the night has exited can only be this arm's.
    # Polled rather than checked once, because `kill` only asks the process to
    # die and this arm cares whether it did, not whether the signal was sent.
    twenty_seven() {
    : >"$dir/log"
    marker=28351
    RCAD_FUZZ_COPY_EVERY="$marker" run 8
    deadline=$(( $(date +%s) + 2 ))
    while pgrep -f "^sleep $marker\$" >/dev/null && [ "$(date +%s)" -lt "$deadline" ]; do
        sleep 0.1
    done
    ! pgrep -f "^sleep $marker\$" >/dev/null \
        || fail "the copier's sleep outlived the night it belongs to: $(pgrep -af "^sleep $marker\$")"
    }

    # Twenty-eight: the merge log's last line names the persistent corpus's
    # own growth as the night's net-new count, with libFuzzer's own
    # MERGE-OUTER pick count kept beside it rather than copied onto it
    # (§306.7 — two picks that agree once cut to this merge's -max_len, or a
    # pick that agrees with a file already on disk, are one file and not
    # two, so MERGE-OUTER's N overcounts what the corpus gained). The stub
    # merge here picks five and adds one, so a log that read N as the growth
    # would fail this arm's grep.
    twenty_eight() {
    : >"$dir/log"
    reader_persistent="$dir/corpus/no_step_file_makes_the_reader_panic"
    rm -rf "$reader_persistent"
    mkdir -p "$reader_persistent"
    echo "kept from before" >"$reader_persistent/kept-from-before"
    echo "kept from before too" >"$reader_persistent/kept-from-before-2"
    STUB_MERGE_OUTER=5 STUB_MERGE_ADD="one-real-pick" run 8 \
        || fail "a night whose merge picked more files than it added failed: $(cat "$dir/out")"
    [ "$(find "$reader_persistent" -type f | wc -l)" -eq 3 ] \
        || fail "the stub's one real pick did not land in the persistent corpus: $(find "$reader_persistent" -type f)"
    night="$dir/logs/$(date +%Y-%m-%d)"
    grep -qF "net-new files tonight: 1 (MERGE-OUTER picks: 5)" "$night/reader-corpus-merge.log" \
        || fail "the merge log's net-new count did not read as the corpus's own growth, kept beside MERGE-OUTER's own pick count: $(cat "$night/reader-corpus-merge.log" 2>&1)"
    rm -rf "$reader_persistent"
    }

    # Twenty-nine: the fix for Q288/Q857 is that the guard scans every
    # `librcad_fuzz_timing-*.rlib` it finds rather than trusting whichever one
    # `find | head -n1` met first. This plants a second, unrelated rlib —
    # clean, built directly here rather than by the stub `cargo` above, and
    # left beside the one this build writes — so a guard that went back to
    # reading only one of them could pick the clean one and miss the dirty
    # one the stub writes when `STUB_TIMING_SANCOV=1`. The night must still
    # fail on the one it actually built, not on whichever `find` meets first.
    #
    # `find`'s own order between the two is not alphabetical and not the
    # order they were created in — checked directly: three directories
    # created in one order came back in a different one, and the same two
    # names that sorted one way at one tag sorted the other way at another.
    # ext4 hashes each full name with a seed fixed for this filesystem, so
    # the order is stable for a given name but not predictable from the name
    # alone, and `$tag` carries this run's own PID and `$RANDOM`. So rather
    # than assume any one stale name sorts first, this tries a few until one
    # does, against a placeholder standing in for the real slot.
    #
    # Q1519: every one of those 26 tries is checked against the *same*
    # planted name, so they are not 26 independent coin flips — a run where
    # that one name's own hash happens to be the lowest of the 27 loses all
    # 26 at once, which for a uniform hash is about 1 run in 27, not the old
    # comment's 2^-26. Measured directly on this filesystem: 300 runs of
    # this same plant-26-against-one-fixed-name loop, in a fresh directory
    # each time, lost 5 — the same order of magnitude as 1-in-27, nowhere
    # near 2^-26. So this no longer trusts one planted name's luck: a loss
    # replants the real slot under a fresh name too, for a fresh 1-in-27
    # draw against the same 26 tries, up to eight times. Eight independent
    # ~1-in-27 draws losing in a row is under 2e-12 even by the old (wrong)
    # coin-flip arithmetic, let alone the measured rate — low enough that a
    # real loss here is a filesystem whose order is not acting as roughly
    # uniform, not a flake.
    #
    # Named so every directory this makes ends in `-$tag`: the retry's own
    # discriminator goes in front of it, never after, so `clean_up`'s
    # `selftest-*"$tag"` glob still sweeps every attempt, tried or kept, with
    # everything else this run planted. `tag` is shadowed with `local` for
    # the retry's own directory names and reverts to the run-wide value the
    # moment this function returns, so `clean_up` and every other arm still
    # see the one tag they always did — which means the next arm's own build
    # no longer writes into this arm's `real_out`, the way it did when every
    # arm shared the one plain name and each one's fresh, clean rebuild
    # overwrote the last one's rlib in passing. So this arm removes its own
    # `real_out` and `stale_out` once it is done with them, rather than
    # leaving the dirty one for whichever arm runs next to find.
    twenty_nine() {
    : >"$dir/log"
    base="fuzz/target/x86_64-unknown-linux-gnu/release/build/rcad-fuzz-timing"
    outer_tag="$tag"
    stale=""
    attempt=0
    while [ -z "$stale" ] && [ "$attempt" -lt 8 ]; do
        attempt=$((attempt + 1))
        local tag="r$attempt-$outer_tag"
        real_out="$base/selftest-$tag/out"
        mkdir -p "$real_out"
        touch "$real_out/librcad_fuzz_timing-selftest-$tag.rlib"

        for probe in a b c d e f g h i j k l m n o p q r s t u v w x y z; do
            stale_out="$base/selftest-stale-$probe-$tag/out"
            mkdir -p "$stale_out"
            touch "$stale_out/librcad_fuzz_timing-selftest-stale-$probe-$tag.rlib"
            first=$(find "$base" -name 'librcad_fuzz_timing-*.rlib' | head -n1)
            case "$first" in
                *"/selftest-stale-$probe-$tag/"*) stale="$probe"; break ;;
            esac
            rm -rf "$base/selftest-stale-$probe-$tag"
        done
        [ -n "$stale" ] || rm -rf "$real_out"
    done
    [ -n "$stale" ] \
        || fail "none of 26 stale rlib names sorted before the real one under find, on $attempt different real names in a row — this filesystem's hash order is not acting as roughly uniform"

    stale_out="$base/selftest-stale-$stale-$tag/out"
    rm -f "$real_out"/librcad_fuzz_timing-*.rlib "$stale_out"/librcad_fuzz_timing-*.rlib
    printf '.globl clean_stale_symbol\nclean_stale_symbol:\n' >"$stale_out/sym.s"
    as "$stale_out/sym.s" -o "$stale_out/sym.o"
    ar rcs "$stale_out/librcad_fuzz_timing-selftest-stale-$stale-$tag.rlib" "$stale_out/sym.o"

    status=0
    STUB_TIMING_SANCOV=1 run 8 || status=$?
    [ "$status" -ne 0 ] \
        || fail "a clean rlib beside the one this build wrote let the night report success"
    grep -q 'sancov reference' "$dir/out" \
        || fail "the night did not say why it failed: $(cat "$dir/out")"
    grep -q 'BUILD FAILED' "$dir/logs/latest" \
        || fail "an instrumented timing rlib did not read as a build failure in the summary: $(cat "$dir/logs/latest")"
    [ "$(grep -c 'fuzz run' "$dir/log")" -eq 0 ] \
        || fail "the night fuzzed targets after finding a sancov reference in rcad-fuzz-timing's rlib"
    rm -rf "$real_out" "$stale_out"
    }

    # Thirty: docs/decisions.d/436 §436.4's rule, now built into the recipe
    # rather than done by hand. An earlier night, planted here with a file
    # byte-identical to the one tonight's stub writes under the same target
    # and name, is what tonight's own copy becomes a hard link to — one
    # inode shared by the two nights, and never the tree's own copy, which
    # the next night that meets this name would reopen with `fopen(…, "wb")`
    # and cut short.
    thirty() {
    rm -f fuzz/artifacts/*/slow-unit-"$tag"
    : >"$dir/log"
    earlier_night="$dir/logs/2000-01-01"
    mkdir -p "$earlier_night/artifacts/where_two_surfaces_cross"
    printf 'what a target found\n' \
        >"$earlier_night/artifacts/where_two_surfaces_cross/slow-unit-$tag"
    run 8 || fail "a night beside a byte-identical earlier night failed: $(cat "$dir/out")"
    night="$dir/logs/$(date +%Y-%m-%d)"
    tonight_file="$night/artifacts/where_two_surfaces_cross/slow-unit-$tag"
    earlier_file="$earlier_night/artifacts/where_two_surfaces_cross/slow-unit-$tag"
    tree_file="fuzz/artifacts/where_two_surfaces_cross/slow-unit-$tag"
    [ -f "$tonight_file" ] || fail "tonight's artifact never landed at $tonight_file"
    [ "$(stat -c %i "$tonight_file")" = "$(stat -c %i "$earlier_file")" ] \
        || fail "a file the second night shares with the first was not linked to it: $(ls -li "$tonight_file" "$earlier_file")"
    [ "$(stat -c %i "$tonight_file")" != "$(stat -c %i "$tree_file")" ] \
        || fail "a night's file shares an inode with the tree's own copy: $(ls -li "$tonight_file" "$tree_file")"
    grep -qE '^linked [1-9][0-9]* file' "$night/link-artifacts.log" \
        || fail "the night's log did not say how many files it linked: $(cat "$night/link-artifacts.log" 2>&1)"
    grep -qE 'took [0-9]+s$' "$night/link-artifacts.log" \
        || fail "the night's log did not say how long linking took: $(cat "$night/link-artifacts.log" 2>&1)"
    rm -f fuzz/artifacts/*/slow-unit-"$tag"
    rm -rf "$earlier_night"
    }

    # Thirty-one: a name only tonight holds — the earlier night planted here
    # holds a file for the same target, but under a different name — is a
    # plain copy, with one link and nowhere else to find it.
    thirty_one() {
    rm -f fuzz/artifacts/*/slow-unit-"$tag"
    : >"$dir/log"
    earlier_night="$dir/logs/2000-01-01"
    mkdir -p "$earlier_night/artifacts/where_two_surfaces_cross"
    printf 'an older nights unrelated find\n' \
        >"$earlier_night/artifacts/where_two_surfaces_cross/slow-unit-not-tonight-$tag"
    run 8 || fail "a night beside an earlier night with no matching name failed: $(cat "$dir/out")"
    night="$dir/logs/$(date +%Y-%m-%d)"
    tonight_file="$night/artifacts/where_two_surfaces_cross/slow-unit-$tag"
    [ -f "$tonight_file" ] || fail "tonight's artifact never landed at $tonight_file"
    [ "$(stat -c %h "$tonight_file")" = "1" ] \
        || fail "a file new to the second night was linked to something: $(ls -li "$tonight_file")"
    rm -f fuzz/artifacts/*/slow-unit-"$tag"
    rm -rf "$earlier_night"
    }

    # Thirty-two: an earlier night's copy under the same target and name, but
    # with bytes that do not match what is in the tree right now, is never
    # linked to — a short copy from the five-minute copier meeting a
    # half-written file, carried into one night, must not be carried into
    # every night after it. Tonight stays its own copy, with the tree's own
    # bytes.
    thirty_two() {
    rm -f fuzz/artifacts/*/slow-unit-"$tag"
    : >"$dir/log"
    earlier_night="$dir/logs/2000-01-01"
    mkdir -p "$earlier_night/artifacts/where_two_surfaces_cross"
    printf 'a short copy from a race, not what the tree holds\n' \
        >"$earlier_night/artifacts/where_two_surfaces_cross/slow-unit-$tag"
    run 8 || fail "a night beside an earlier night with a differing copy failed: $(cat "$dir/out")"
    night="$dir/logs/$(date +%Y-%m-%d)"
    tonight_file="$night/artifacts/where_two_surfaces_cross/slow-unit-$tag"
    earlier_file="$earlier_night/artifacts/where_two_surfaces_cross/slow-unit-$tag"
    [ -f "$tonight_file" ] || fail "tonight's artifact never landed at $tonight_file"
    [ "$(stat -c %i "$tonight_file")" != "$(stat -c %i "$earlier_file")" ] \
        || fail "a night's file was linked to an earlier copy whose bytes differ from the tree's"
    grep -qF "what a target found" "$tonight_file" \
        || fail "tonight's file lost the tree's own bytes: $(cat "$tonight_file")"
    rm -f fuzz/artifacts/*/slow-unit-"$tag"
    rm -rf "$earlier_night"
    }

    # **Which arms run at once, and why each still asserts what it says.** Run
    # in turn they took 86 s, nearly all of it the stub's sleeps (Q709), so
    # most of them run beside each other.
    #
    # An arm run beside others gets a directory of its own, as `$dir`, and a
    # tag of its own, `<arm>-$tag`, as `$tag`. So its log, out, logs, corpus,
    # rendezvous file and fixture repositories are its own, and so are the
    # artifact names its stub writes and the timing rlib its build writes. One
    # thing is shared, and no arm can be given its own: the real
    # `fuzz/artifacts/`, which every night that gets as far as its summary
    # scans whole. A night beside others sees their slow units as new tonight.
    # That decides which arms may share the tree:
    #
    #   - Beside each other: arms whose stubs write slow units only, or
    #     Fourteen's timeouts, and whose assertions no extra slow unit or
    #     timeout can change. None of them counts slow units, and none writes
    #     a crash, which would fail every night that asserts it exited 0.
    #   - Alone, after them: Three and Twenty-three count slow units exactly,
    #     Twelve and Thirteen write crashes, and Sixteen and Twenty-nine write
    #     a sancov rlib and a clean one beside it, either of which any other
    #     night's guard could meet first.
    #
    # The clock arms. One, Four and Ten start first, together. One's ceiling
    # of 16 s is about 10 s above what it takes, and Four's 20 s about 9 s
    # above; extra arms cost each of them only CPU time. One's grants are read
    # against its own `started`, and Four's five targets meet at its own
    # barrier, which waits up to 15 s for them.
    # Ten's check is the tight one: its copier must have copied by four
    # seconds in, and it first copies a second after its night starts it, so
    # a burst of fifteen arms starting beside it is what could make it late.
    # So the rest start only once Ten has returned, while One and Four are
    # still asleep. None of the rest asserts on the clock.
    beside() {
        local name
        for name in "$@"; do
            (
                arm="$name"
                dir="$dir/$name"
                tag="$name-$tag"
                mkdir "$dir"
                ln -s ../bin "$dir/bin"
                ln -s ../step-corpus "$dir/step-corpus"
                "$name"
            ) >"$dir/$name.out" 2>&1 &
            running[$name]=$!
        done
    }
    # Waits for the arms named, or for every one still running, and prints
    # what a failed arm printed. Its `fail` line names it.
    settle() {
        local name names=("$@") failed=0
        [ "$#" -gt 0 ] || names=("${!running[@]}")
        for name in "${names[@]}"; do
            wait "${running[$name]}" || { failed=1; cat "$dir/$name.out"; }
            unset "running[$name]"
        done
        [ "$failed" -eq 0 ] || exit 1
    }
    alone() {
        arm="$1"
        "$1"
    }

    declare -A running=()
    beside one_and_two four ten
    settle ten
    beside two_with_no_step_corpus five six_and_seven eight nine eleven \
        fourteen fifteen seventeen eighteen nineteen twenty twenty_one \
        twenty_two twenty_four twenty_five twenty_seven twenty_eight
    settle
    rm -rf fuzz/target/x86_64-unknown-linux-gnu/release/build/rcad-fuzz-timing/selftest-*-"$tag"
    alone three
    alone twelve
    alone thirteen
    alone sixteen
    alone twenty_nine
    alone twenty_three
    alone thirty
    alone thirty_one
    alone thirty_two
    arm="after the last"
    head_did_not_move

    # Twenty-three leaves its `timeout-` for `clean_up` rather than removing
    # it itself. That is how this recipe checks that the trap takes every kind
    # an arm writes, and not only the kinds somebody thought to name. It runs
    # after the last arm, because `clean_up` removes `$dir` too.
    clean_up
    left=$(find fuzz/artifacts -name "*-$tag")
    [ -z "$left" ] || { echo "the trap leaves this run's artifacts behind: $left"; exit 1; }

    # Twenty-six: the whole selftest inside its bound (§15.6), counted by bash
    # from the moment it started, so time lost anywhere in it counts.
    #
    # Q1769: Thirty, Thirty-one and Thirty-two put three more `alone` arms on
    # this list after the sixty-second bound was set (Q709, 2026-10-02, idle).
    # Measured instead under the fuzz night that was actually running (24
    # cores, `uptime`'s load average logged beside each run): three runs of
    # this recipe before Q1753 (789396ef, six alone arms, no link pass) took
    # 34.8, 37.0 and 37.2 s wall (10.2-10.5 s user, 16.4-17.3 s sys; load
    # 34-48), and three after it (41d96a4e, nine alone arms, every `run()`
    # call now shelling out to the link pass below) took 55.5, 52.9 and
    # 50.7 s (12.0-12.4 s user, 19.5-20.0 s sys; load 41-50). A bare `python3
    # -c pass` took 0.06-0.07 s under the same load, and the whole selftest
    # makes about 22 calls into `run()`, so the link pass's own startup
    # accounts for under two of the fifteen-to-eighteen-second wall increase
    # — the lead that named it as the cause was wrong. What does account for
    # it: each of the three new arms is one more `alone` arm with its own
    # four-second stub sleep, run strictly in turn, so three more seconds of
    # unavoidable, unoverlapped sleep landed on a bound that never priced
    # them in, on top of their own CPU work. Q1766's lander gate saw this
    # step take 66 s against the old bound of 60, with four lanes going —
    # heavier contention than this session raised on its own. Running these
    # three beside the others instead would change what they test: all
    # three share one fixed "earlier night" directory name with each other
    # and would race on it, so that is a correctness change for a later row
    # (queued below), not a one-line move tonight. The bound moves instead,
    # by the same ratio Q709 set it by — about twice the worst wall time
    # measured — taking the lander's own 66 s rather than this session's
    # smaller ones, since the lander's four-lane night is the closer match
    # to what this bound has to survive.
    bound=130
    [ "$SECONDS" -le "$bound" ] \
        || { echo "check-fuzz-overnight-selftest took $SECONDS s, over its bound of $bound s: arms that should run beside each other are running in turn, or one of them is waiting on something new"; exit 1; }

# `fuzz/timing-hooked-calls.py`'s split, pinned against a hand-assembled
# object rather than a compiled one — the exact instructions are under test
# this way, and no optimiser gets a vote on whether a jump table exists.
# docs/decisions.d/419 (Q1444).
#
# Four sequences, one function each so no register state leaks from one into
# the next:
#
#   a real relative jump table — `lea table(%rip),%rax; movslq
#   (%rax,%r12,4),%rcx; add %rax,%rcx; jmp *%rcx` — which must count as
#   staying inside its own function;
#
#   a bare `jmp *%rax` with no load or add in front of it, which must count
#   as able to leave;
#
#   the same load and add, but a jump through a *different* register — a
#   near miss that must still count as able to leave, since the register the
#   jump actually uses was never shown to hold the table's own base plus
#   offset;
#
#   and a `call *%rax`, which always counts as able to leave — cautious-side,
#   even though nothing about the instruction itself rules out the same
#   sequence.
#
# None of the four is a call to a hooked function, so the first two counts
# this script prints stay 0 and the exit code stays 0; this recipe is purely
# about the two counts the jump-table split adds.
#
# A second, separate fixture pins the transitive walk added for
# docs/decisions.d/273 §273.8's second blind spot (Q1452): a function named
# `rcad_fuzz_timing_reaches_out` whose only call is to a function outside
# the crate, which itself calls `bcmp` — defined locally in the fixture, at
# its own address, so `nm` resolves it the way a linked binary's `bcmp`
# interceptor does. Before the walk, this scan never looked past a
# function's own name, so it missed this the same way it missed
# `how_slow_the_name_says`'s `split_once("us-")` reaching `bcmp` through
# `core`'s `StrSearcher::new`.
#
# A third fixture pins the half the walk's own commit left untested
# (docs/decisions.d/419 §419.N, Q1452): a function named
# `rcad_fuzz_timing_computed_through_helper` whose only call is to a helper
# outside the crate, and the helper's only instruction is `call *%rax` —
# computed, and with nothing in front of it that could set `%rax` from a
# hooked GOT slot. Before `reachable_from` existed, `timing_computed` kept
# only the computed calls found inside a function whose own symbol named
# `rcad_fuzz_timing`, so this one — found in a function the walk must first
# reach through a direct call — was invisible to it.
#
# A fourth fixture pins the GOT-slot edge added for docs/decisions.d/419
# §419.5's own finding (Q1533): a function named `rcad_fuzz_timing_got_slot`
# whose only instruction calls through a GOT-shaped slot — `call
# *slot(%rip)` — that a real `R_X86_64_RELATIVE` relocation, from an actual
# `ld -pie` link rather than a guess at one, resolves to a helper outside the
# crate, and the helper calls `bcmp`. Before this fix, a slot not on the
# hooked list fell through both the hooked-slot check and the computed-call
# bucket — `(%rip)` with a comment excused it from the latter on
# the assumption the former had already decided it — so neither `calls_out`
# nor `reachable_from` ever saw this edge, the same wall §419.5 met building
# `3319f838`: `merge_out` reaches `core`'s `StrSearcher::new` through a GOT
# slot, not a literal `call <name>`.
#
# A fifth fixture pins the function-pointer walk (docs/decisions.d/419
# §419.7, Q323): `rcad_fuzz_timing_fn_pointer` takes the address of a
# function that calls `bcmp` with a `lea` and calls it through `%rax`, and
# `rcad_fuzz_timing_dyn_call` takes the address of a vtable-shaped object
# whose fourth word names another such function, and calls through
# `0x18(%rax)`. Before the walk, both calls were only counted as computed
# calls that can leave the function, and the scan exited 0.
#
# A sixth fixture pins `NOT_ENTERED` (§419.7, Q323): three crate functions
# each call one of std's `panic_with_hook`, std's `rust_oom` and ASan's
# `AsanInitInternal`, under a crate hash no toolchain made, and each of those
# calls `bcmp`; none may count. A fourth calls std's `default_hook`, which
# also calls `bcmp`, and must count, so a cut that excused every function
# would fail here.
[doc("The jump-table split, the transitive walk and the function-pointer walk in timing-hooked-calls.py, pinned against hand-assembled fixtures.")]
check-timing-hooked-calls-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    cat >"$dir/fixture.s" <<'ASM'
    .text
    .globl rcad_fuzz_timing_table_jump
    .type rcad_fuzz_timing_table_jump, @function
    rcad_fuzz_timing_table_jump:
    lea jumptable(%rip), %rax
    movslq (%rax,%r12,4), %rcx
    add %rax, %rcx
    jmp *%rcx

    .globl rcad_fuzz_timing_bare_jmp
    .type rcad_fuzz_timing_bare_jmp, @function
    rcad_fuzz_timing_bare_jmp:
    jmp *%rax

    .globl rcad_fuzz_timing_near_miss
    .type rcad_fuzz_timing_near_miss, @function
    rcad_fuzz_timing_near_miss:
    lea jumptable(%rip), %rax
    movslq (%rax,%r12,4), %rcx
    add %rax, %rcx
    jmp *%rdx

    .globl rcad_fuzz_timing_call_star
    .type rcad_fuzz_timing_call_star, @function
    rcad_fuzz_timing_call_star:
    call *%rax

    .section .rodata
    .align 4
    jumptable:
    .long 0
    .long 0
    ASM
    as "$dir/fixture.s" -o "$dir/fixture.o"

    got=$(fuzz/timing-hooked-calls.py "$dir/fixture.o") \
        || { echo "$got"; echo "timing-hooked-calls.py exited non-zero against a fixture with no hooked call at all"; exit 1; }

    leave_line="  calls or tail jumps in rcad_fuzz_timing through a computed pointer that can leave the function: 3"
    printf '%s\n' "$got" | grep -qxF "$leave_line" || {
        echo "$got"
        echo "expected the line above (3: the bare jmp, the near miss, and the call)"
        exit 1
    }
    stays_line="  tail jumps in rcad_fuzz_timing through a relative jump table, staying inside their own function: 1"
    printf '%s\n' "$got" | grep -qxF "$stays_line" || {
        echo "$got"
        echo "expected the line above (1: only the real jump table)"
        exit 1
    }

    cat >"$dir/offender.s" <<'ASM'
    .text
    .globl rcad_fuzz_timing_reaches_out
    .type rcad_fuzz_timing_reaches_out, @function
    rcad_fuzz_timing_reaches_out:
    call outside_the_crate_helper

    .globl outside_the_crate_helper
    .type outside_the_crate_helper, @function
    outside_the_crate_helper:
    call bcmp

    .globl bcmp
    .type bcmp, @function
    bcmp:
    ret
    ASM
    as "$dir/offender.s" -o "$dir/offender.o"
    # Linked for the same reason as the fixtures below: an unlinked `.o`
    # leaves `call outside_the_crate_helper` as a zero displacement and a
    # relocation, so `objdump` names whatever instruction follows the call —
    # which happens to be `outside_the_crate_helper` only because it sits
    # right after `rcad_fuzz_timing_reaches_out` in this file.
    ld -pie -e rcad_fuzz_timing_reaches_out -o "$dir/offender" "$dir/offender.o"

    if offender_got=$(fuzz/timing-hooked-calls.py "$dir/offender"); then
        echo "$offender_got"
        echo "timing-hooked-calls.py exited 0 against a fixture where rcad_fuzz_timing calls out to a function that calls bcmp — it must count as an offender"
        exit 1
    fi
    offender_line="  calls from rcad_fuzz_timing reaching a hooked function through another function outside the crate: 1"
    printf '%s\n' "$offender_got" | grep -qxF "$offender_line" || {
        echo "$offender_got"
        echo "expected the line above (1: rcad_fuzz_timing_reaches_out, through outside_the_crate_helper, to bcmp)"
        exit 1
    }
    chain_line="    rcad_fuzz_timing_reaches_out -> outside_the_crate_helper -> bcmp"
    printf '%s\n' "$offender_got" | grep -qxF "$chain_line" || {
        echo "$offender_got"
        echo "expected the chain line above"
        exit 1
    }

    cat >"$dir/computed.s" <<'ASM'
    .text
    .globl rcad_fuzz_timing_computed_through_helper
    .type rcad_fuzz_timing_computed_through_helper, @function
    rcad_fuzz_timing_computed_through_helper:
    call helper_with_a_computed_call

    .globl helper_with_a_computed_call
    .type helper_with_a_computed_call, @function
    helper_with_a_computed_call:
    call *%rax
    ASM
    as "$dir/computed.s" -o "$dir/computed.o"
    # Linked for the same reason: an unlinked `call helper_with_a_computed_call`
    # would also be a zero displacement and a relocation, naming whatever
    # instruction follows it rather than the function this fixture means to
    # reach.
    ld -pie -e rcad_fuzz_timing_computed_through_helper -o "$dir/computed" "$dir/computed.o"

    computed_got=$(fuzz/timing-hooked-calls.py "$dir/computed") \
        || { echo "$computed_got"; echo "timing-hooked-calls.py exited non-zero against a fixture where the only thing reached is a computed call, never a hook — a call this scan cannot see past is not itself an offender"; exit 1; }
    computed_line="  calls or tail jumps in rcad_fuzz_timing through a computed pointer that can leave the function: 1"
    printf '%s\n' "$computed_got" | grep -qxF "$computed_line" || {
        echo "$computed_got"
        echo "expected the line above (1: helper_with_a_computed_call's call *%rax, reached from rcad_fuzz_timing_computed_through_helper)"
        exit 1
    }

    cat >"$dir/gotslot.s" <<'ASM'
    .text
    .globl rcad_fuzz_timing_got_slot
    .type rcad_fuzz_timing_got_slot, @function
    rcad_fuzz_timing_got_slot:
    call *slot(%rip)

    .globl outside_the_crate_through_a_slot
    .type outside_the_crate_through_a_slot, @function
    outside_the_crate_through_a_slot:
    call bcmp

    .globl bcmp
    .type bcmp, @function
    bcmp:
    ret

    .data
    .align 8
    slot:
    .quad outside_the_crate_through_a_slot
    ASM
    as "$dir/gotslot.s" -o "$dir/gotslot.o"
    # `-pie` is what turns the assembler's own `R_X86_64_64` for `.quad
    # outside_the_crate_through_a_slot` into a linked PIE's `R_X86_64_RELATIVE`
    # against that same address — a plain `.o` never carries that relocation
    # type, only a linked, position-independent image does, the same kind
    # `cargo fuzz build`'s own ASan/libFuzzer binary is. `-e` names an existing
    # symbol as the entry point only to keep `ld` quiet about missing `_start`;
    # nothing here is ever run.
    ld -pie -e rcad_fuzz_timing_got_slot -o "$dir/gotslot" "$dir/gotslot.o"

    if gotslot_got=$(fuzz/timing-hooked-calls.py "$dir/gotslot"); then
        echo "$gotslot_got"
        echo "timing-hooked-calls.py exited 0 against a fixture where rcad_fuzz_timing calls through a GOT slot whose relocation resolves to a function that calls bcmp — it must count as an offender"
        exit 1
    fi
    gotslot_line="  calls from rcad_fuzz_timing reaching a hooked function through another function outside the crate: 1"
    printf '%s\n' "$gotslot_got" | grep -qxF "$gotslot_line" || {
        echo "$gotslot_got"
        echo "expected the line above (1: rcad_fuzz_timing_got_slot, through outside_the_crate_through_a_slot, to bcmp)"
        exit 1
    }
    gotslot_chain_line="    rcad_fuzz_timing_got_slot -> outside_the_crate_through_a_slot -> bcmp"
    printf '%s\n' "$gotslot_got" | grep -qxF "$gotslot_chain_line" || {
        echo "$gotslot_got"
        echo "expected the chain line above"
        exit 1
    }

    cat >"$dir/pointer.s" <<'ASM'
    .text
    .globl rcad_fuzz_timing_fn_pointer
    .type rcad_fuzz_timing_fn_pointer, @function
    rcad_fuzz_timing_fn_pointer:
    lea taken_by_a_pointer(%rip), %rax
    call *%rax

    .globl taken_by_a_pointer
    .type taken_by_a_pointer, @function
    taken_by_a_pointer:
    call bcmp

    .globl rcad_fuzz_timing_dyn_call
    .type rcad_fuzz_timing_dyn_call, @function
    rcad_fuzz_timing_dyn_call:
    lea a_vtable(%rip), %rax
    call *0x18(%rax)

    .globl behind_a_vtable
    .type behind_a_vtable, @function
    behind_a_vtable:
    call bcmp

    .globl bcmp
    .type bcmp, @function
    bcmp:
    ret

    .section .data.rel.ro, "aw"
    .align 8
    a_vtable:
    .quad 0
    .quad 8
    .quad 8
    .quad behind_a_vtable
    ASM
    as "$dir/pointer.s" -o "$dir/pointer.o"
    # Linked for the same reason as the GOT-slot fixture: an unlinked `.o`
    # leaves `lea taken_by_a_pointer(%rip)` as a zero displacement and a
    # relocation, so `objdump` names no target, and `.quad behind_a_vtable`
    # becomes a real `R_X86_64_RELATIVE` only in a linked PIE.
    ld -pie -e rcad_fuzz_timing_fn_pointer -o "$dir/pointer" "$dir/pointer.o"

    if pointer_got=$(fuzz/timing-hooked-calls.py "$dir/pointer"); then
        echo "$pointer_got"
        echo "timing-hooked-calls.py exited 0 against a fixture where rcad_fuzz_timing calls through a function pointer, and through a vtable, to functions that call bcmp — both must count as offenders"
        exit 1
    fi
    pointer_line="  calls from rcad_fuzz_timing reaching a hooked function through a function pointer: 2"
    printf '%s\n' "$pointer_got" | grep -qxF "$pointer_line" || {
        echo "$pointer_got"
        echo "expected the line above (2: the plain function pointer and the vtable slot)"
        exit 1
    }
    for chain in \
        "    rcad_fuzz_timing_fn_pointer -> &taken_by_a_pointer -> bcmp" \
        "    rcad_fuzz_timing_dyn_call -> &behind_a_vtable -> bcmp"; do
        printf '%s\n' "$pointer_got" | grep -qxF "$chain" || {
            echo "$pointer_got"
            echo "expected the chain line: $chain"
            exit 1
        }
    done

    cat >"$dir/not_entered.s" <<'ASM'
    .text
    .globl rcad_fuzz_timing_panics
    .type rcad_fuzz_timing_panics, @function
    rcad_fuzz_timing_panics:
    call _RNvNtCs1a2B3c_3std9panicking15panic_with_hook

    .globl _RNvNtCs1a2B3c_3std9panicking15panic_with_hook
    .type _RNvNtCs1a2B3c_3std9panicking15panic_with_hook, @function
    _RNvNtCs1a2B3c_3std9panicking15panic_with_hook:
    call bcmp

    .globl rcad_fuzz_timing_runs_out_of_memory
    .type rcad_fuzz_timing_runs_out_of_memory, @function
    rcad_fuzz_timing_runs_out_of_memory:
    call _RNvNtCs1a2B3c_3std5alloc8rust_oom

    .globl _RNvNtCs1a2B3c_3std5alloc8rust_oom
    .type _RNvNtCs1a2B3c_3std5alloc8rust_oom, @function
    _RNvNtCs1a2B3c_3std5alloc8rust_oom:
    call bcmp

    .globl rcad_fuzz_timing_starts_asan
    .type rcad_fuzz_timing_starts_asan, @function
    rcad_fuzz_timing_starts_asan:
    call _ZN6__asanL16AsanInitInternalEv

    .globl _ZN6__asanL16AsanInitInternalEv
    .type _ZN6__asanL16AsanInitInternalEv, @function
    _ZN6__asanL16AsanInitInternalEv:
    call bcmp

    .globl rcad_fuzz_timing_calls_the_default_hook
    .type rcad_fuzz_timing_calls_the_default_hook, @function
    rcad_fuzz_timing_calls_the_default_hook:
    call _RNvNtCs1a2B3c_3std9panicking12default_hook

    .globl _RNvNtCs1a2B3c_3std9panicking12default_hook
    .type _RNvNtCs1a2B3c_3std9panicking12default_hook, @function
    _RNvNtCs1a2B3c_3std9panicking12default_hook:
    call bcmp

    .globl bcmp
    .type bcmp, @function
    bcmp:
    ret
    ASM
    as "$dir/not_entered.s" -o "$dir/not_entered.o"
    # Linked because an unlinked `.o` leaves each `call` to a global symbol
    # as a zero displacement and a relocation, so `objdump` names whatever
    # follows the call, and only the last function's `call bcmp` would land.
    ld -pie -e rcad_fuzz_timing_panics -o "$dir/not_entered" "$dir/not_entered.o"

    if not_entered_got=$(fuzz/timing-hooked-calls.py "$dir/not_entered"); then
        echo "$not_entered_got"
        echo "timing-hooked-calls.py exited 0 against a fixture where rcad_fuzz_timing calls std's default panic hook directly, and that hook calls bcmp — only panic_with_hook, rust_oom and AsanInitInternal are never entered"
        exit 1
    fi
    not_entered_line="  calls from rcad_fuzz_timing reaching a hooked function through another function outside the crate: 1"
    printf '%s\n' "$not_entered_got" | grep -qxF "$not_entered_line" || {
        echo "$not_entered_got"
        echo "expected the line above (1: the default hook; none through panic_with_hook, rust_oom or AsanInitInternal)"
        exit 1
    }
    printf '%s\n' "$not_entered_got" | grep -qF "panicking::default_hook -> bcmp" || {
        echo "$not_entered_got"
        echo "expected a chain through std's default panic hook to bcmp"
        exit 1
    }

# `fuzz-watermark` picks the night's commit, and every way it can pick wrongly
# costs a night: too far back and the fuzzer re-finds what is already fixed, and
# the wrong way at all and it undoes somebody's hand.
#
# Run against a fixture repository with a local bare origin, so no arm here
# needs the network, an account, or the state of this tree.
[doc("`fuzz-watermark` moves onto the tip of main, forward only, and stays put when it cannot tell.")]
check-fuzz-watermark-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT

    repo="$dir/repo"
    git init -q -b main "$repo"
    echo "a file to dirty later" >"$repo/README"
    git -C "$repo" add README
    at() {
        git -C "$1" -c user.email=t@t -c user.name=t \
            commit -q --allow-empty -m "$2"
        git -C "$1" rev-parse HEAD
    }
    first=$(at "$repo" one)
    second=$(at "$repo" two)
    third=$(at "$repo" three)
    git init -q --bare -b main "$dir/origin.git"
    git -C "$repo" remote add origin "$dir/origin.git"
    git -C "$repo" push -q origin main

    git -C "$repo" checkout -q -b elsewhere "$first"
    aside=$(at "$repo" aside)
    git -C "$repo" checkout -q main

    greens="$repo/.git/rcad-greens"

    fail() {
        echo "fuzz-watermark drifted from its own fixtures: $1"
        [ -f "$dir/why" ] && sed 's/^/    /' "$dir/why"
        exit 1
    }

    # Stdout is the answer and stderr is the reason for a blank one, so the
    # night can print the reason and still test the answer for emptiness.
    picked() {
        {{just_executable()}} --justfile "{{justfile()}}" \
            --working-directory "$repo" fuzz-watermark 2>"$dir/why"
    }

    # One: the tip, and not the last green. A local gate recorded green on the
    # commit behind the tip, which is exactly what the night stood on from §90
    # to §186; the tip must win over it.
    git -C "$repo" checkout -q --detach "$first"
    printf '%s 2026-09-20T00:00:00Z here\n' "$second" >"$greens"
    got=$(picked) || fail "deciding exited non-zero, so a night would not have run"
    [ "$got" = "$third" ] \
        || fail "with $second recorded green and $third the tip it chose ${got:-nothing}"
    rm -f "$greens"

    # Two: the tip as origin has it now, not as this clone last heard. Somebody
    # else pushed after this tree's last fetch, and the night must see it.
    git clone -q "$dir/origin.git" "$dir/other"
    fourth=$(at "$dir/other" four)
    git -C "$dir/other" push -q origin main
    got=$(picked) || fail "deciding exited non-zero"
    [ "$got" = "$fourth" ] \
        || fail "origin's tip is $fourth and it chose ${got:-nothing}, so it never fetched"

    # Three: a tree already on the tip stays, and says so rather than checking
    # out what it is already on.
    git -C "$repo" checkout -q --detach "$fourth"
    got=$(picked) || fail "deciding exited non-zero"
    [ -z "$got" ] || fail "it offered to advance to $got from the commit it is on"
    grep -q 'already on the tip of main' "$dir/why" \
        || fail "standing on the tip was not said out loud"

    # Four: never backwards and never sideways. Somebody advanced this tree by
    # hand past the tip, or onto a branch, and the night must not undo it.
    ahead=$(at "$repo" ahead)
    got=$(picked) || fail "deciding exited non-zero"
    [ -z "$got" ] \
        || fail "it offered to move back to $got from $ahead, a commit further along"
    git -C "$repo" checkout -q --detach "$aside"
    got=$(picked) || fail "deciding exited non-zero"
    [ -z "$got" ] \
        || fail "it offered to move to $got from $aside, a commit off main"
    grep -q 'not ahead of it' "$dir/why" \
        || fail "a tip that is not ahead was passed over without saying why"

    # Five: an origin that cannot be reached leaves the night where it is, and
    # exits 0 so that the night still runs. A stale run beats no run.
    git -C "$repo" checkout -q --detach "$first"
    git -C "$repo" remote set-url origin "$dir/nowhere.git"
    got=$(picked) || fail "an origin that cannot be reached made the whole night fail"
    [ -z "$got" ] || fail "it named $got on a fetch that never happened"
    grep -q 'origin could not be reached' "$dir/why" \
        || fail "it stayed put without saying why"
    git -C "$repo" remote set-url origin "$dir/origin.git"

    # Six: a dirty tree is never checked out from under. The night is unattended
    # and whatever is uncommitted there is somebody's, however it got there.
    echo "something uncommitted" >>"$repo/README"
    got=$(picked) || fail "deciding exited non-zero"
    [ -z "$got" ] || fail "it offered to check out $got over uncommitted work"
    grep -q 'uncommitted changes' "$dir/why" \
        || fail "uncommitted work was passed over without saying why"
    git -C "$repo" checkout -q -- README

    # Seven, which is `_record-green`'s and not the watermark's: the night no
    # longer reads the record, but `just status` does. What may be written down
    # in the first place. `gate-docs` re-enters
    # `gate` with a trimmed step list and reaches the recorder as a pass, having
    # compiled nothing — and a green that skipped `test` is not a reading of the
    # code. This is the mistake that would leave no trace afterwards: the file
    # would name a commit and say nothing about how little ran for it.
    record() {
        {{just_executable()}} --justfile "{{justfile()}}" \
            --working-directory "$repo" _record-green "$1"
    }
    record "check-decisions check-hub" >"$dir/said" 2>&1
    [ ! -s "$greens" ] \
        || fail "a step list that compiles nothing recorded a green anyway"
    grep -q 'did not read the code end to end' "$dir/said" \
        || fail "it declined to record without saying why: $(cat "$dir/said")"
    # `gate-lane`'s list, every step but the slow tier (§397.4).
    record "$(printf '%s\n' {{ gate_steps }} | grep -vx test-slow | tr '\n' ' ')" >"$dir/said" 2>&1
    [ ! -s "$greens" ] \
        || fail "a step list without test-slow recorded a green, and a lane's gate never ran the slow tier"
    grep -q 'skipped test-slow' "$dir/said" \
        || fail "a step list without test-slow was refused for another reason: $(cat "$dir/said")"

    record "{{ gate_steps }}" >"$dir/said" 2>&1
    grep -q "^$(git -C "$repo" rev-parse HEAD) " "$greens" \
        || fail "a full gate's green was not written down: $(cat "$dir/said")"

    record "{{ gate_steps }}" >"$dir/said" 2>&1
    [ "$(wc -l <"$greens")" = "1" ] \
        || fail "the same commit was recorded twice"

    echo "something uncommitted" >>"$repo/README"
    rm -f "$greens"
    record "{{ gate_steps }}" >"$dir/said" 2>&1
    [ ! -s "$greens" ] \
        || fail "a green was recorded against a tree the sha does not name"
    grep -q 'uncommitted changes' "$dir/said" \
        || fail "it declined a dirty tree without saying why: $(cat "$dir/said")"
    git -C "$repo" checkout -q -- README

# `gate-fresh` writes its green down, which is what `exec docker` made
# impossible: `exec` replaces the shell, so there was no process left to record
# anything and the recipe still exited 0. The strongest green this machine can
# produce was the only one leaving no trace, and nothing said so.
#
# The container is stubbed rather than run. Ten minutes and a docker daemon are
# not what this is asking about — it asks whether a pass reaches `_record-green`
# on the host and a failure does not, and that is answered by a stub that exits
# with whichever status the arm wants.
[doc("`gate-fresh` records a green when the container passes, and not when it fails.")]
check-gate-fresh-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    mkdir -p "$dir/bin" "$dir/corpus"

    repo="$dir/repo"
    git init -q -b main "$repo"
    echo "a tree to clone" >"$repo/README"
    git -C "$repo" add README
    git -C "$repo" -c user.email=t@t -c user.name=t commit -q -m one
    head=$(git -C "$repo" rev-parse HEAD)
    greens="$repo/.git/rcad-greens"

    cat >"$dir/bin/docker" <<'STUB'
    #!/usr/bin/env bash
    printf '%s\n' "$@" >>"$DOCKER_ARGV"
    exit "${DOCKER_STATUS:-0}"
    STUB
    chmod +x "$dir/bin/docker"

    fail() {
        echo "gate-fresh drifted from its own fixtures: $1"
        [ -f "$dir/said" ] && sed 's/^/    /' "$dir/said"
        exit 1
    }

    # The corpus is pointed at an empty directory rather than this machine's,
    # because the recipe only checks that one is there and a selftest that reads
    # the real one is answering a question about the machine (§77.6).
    fresh() {
        DOCKER_STATUS="$1" DOCKER_ARGV="$dir/argv" \
            PATH="$dir/bin:$PATH" RCAD_STEP_CORPUS="$dir/corpus" \
            {{ just_executable() }} --justfile "{{ justfile() }}" \
            --working-directory "$repo" gate-fresh >"$dir/said" 2>&1
    }

    # One: a container that passed is a green on the host, under the sha that was
    # cloned. This is the arm `exec docker` fails while exiting 0.
    fresh 0 || fail "it failed over a container that passed"
    grep -q "^$head " "$greens" 2>/dev/null \
        || fail "it passed and wrote no green for $(git -C "$repo" rev-parse --short HEAD)"

    # Two: a container that failed records nothing, and its status is what comes
    # out. Bookkeeping that ran anyway would write down a green for a gate that
    # went red, which is the one entry no reader could catch.
    rm -f "$greens"
    status=0
    fresh 3 || status=$?
    [ "$status" -eq 3 ] \
        || fail "a container exiting 3 came out as $status"
    [ ! -s "$greens" ] \
        || fail "a green was recorded for a container that failed"

    # Three: the clone is gone afterwards. `exec` discarded the EXIT trap with
    # the shell, so every run left its tree behind and nothing noticed for as
    # long as nothing else needed the trap. Read out of the arguments the stub
    # was handed, because the path is a `mktemp -d` this arm never sees
    # otherwise.
    clone=$(grep -o '^/.*/rcad:/rcad$' "$dir/argv" | head -1 | cut -d: -f1)
    [ -n "$clone" ] \
        || fail "the stub was handed no clone to mount, so this arm compared nothing"
    [ ! -e "$clone" ] \
        || fail "the clone was left behind at $clone"

# `cleanup`'s plain `rm -rf "$work"` is the one call in the trap that a died
# container can defeat: root wrote into the tree, `chown` never ran, and no
# `chmod -R u+w` by this uid reaches a file it does not own. A real root-owned
# file needs real root to make, which a selftest does not have — so a marker
# file stands in for it. The fake `docker` from the main run drops the marker
# inside the mounted tree instead of exiting cleanly, and a fake `rm` ahead of
# it on `PATH` refuses to remove anything that still carries it, the same
# refusal the host's own `rm` would hit. Only the fallback `docker run ... rm
# -rf /w/rcad` — told apart from the main run by its own `-v ...:/w` mount —
# clears the marker, exactly as a container really would, being root inside
# too. Everything the fake `rm` does not recognise it hands straight to the
# real one, so it cannot break anything outside the one case it models.
[doc("gate-fresh's cleanup reaches for docker when the plain rm on a leftover tree fails.")]
check-gate-fresh-cleanup-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    mkdir -p "$dir/bin" "$dir/corpus"

    repo="$dir/repo"
    git init -q -b main "$repo"
    echo "a tree to clone" >"$repo/README"
    git -C "$repo" add README
    git -C "$repo" -c user.email=t@t -c user.name=t commit -q -m one

    # Captured before PATH is narrowed to $dir/bin, so the fake rm below can
    # still reach the real one, and the fake docker can delete for real.
    real_rm=$(command -v rm)

    cat >"$dir/bin/docker" <<'STUB'
    #!/usr/bin/env bash
    printf '%s\n' "$@" >>"$DOCKER_ARGV"
    fallback_mount=""
    clone_mount=""
    for a in "$@"; do
        case "$a" in
            *:/w) fallback_mount="$a" ;;
            *:/rcad) clone_mount="$a" ;;
        esac
    done
    if [ -n "$fallback_mount" ]; then
        host="${fallback_mount%%:*}"
        if [ "${DOCKER_CLEANUP_STATUS:-0}" -eq 0 ]; then
            "$REAL_RM" -rf "$host/rcad" 2>/dev/null || true
        fi
        exit "${DOCKER_CLEANUP_STATUS:-0}"
    fi
    host="${clone_mount%%:*}"
    touch "$host/.root-owned" 2>/dev/null || true
    exit "${DOCKER_STATUS:-1}"
    STUB
    chmod +x "$dir/bin/docker"

    cat >"$dir/bin/rm" <<'STUB'
    #!/usr/bin/env bash
    for a in "$@"; do
        case "$a" in -*) continue ;; esac
        if [ -e "$a" ] && find "$a" -name .root-owned -print -quit 2>/dev/null | grep -q .; then
            echo "rm: cannot remove '$a/.root-owned': Operation not permitted" >&2
            exit 1
        fi
    done
    exec "$REAL_RM" "$@"
    STUB
    chmod +x "$dir/bin/rm"

    fail() {
        echo "gate-fresh cleanup drifted from its own fixtures: $1"
        [ -f "$dir/said" ] && sed 's/^/    /' "$dir/said"
        exit 1
    }

    # The corpus is pointed at an empty directory rather than this machine's,
    # for the same reason `check-gate-fresh-selftest` does: the recipe only
    # checks that one is there (§77.6).
    fresh() {
        DOCKER_STATUS=5 DOCKER_CLEANUP_STATUS="$1" DOCKER_ARGV="$dir/argv" \
            REAL_RM="$real_rm" PATH="$dir/bin:$PATH" RCAD_STEP_CORPUS="$dir/corpus" \
            {{ just_executable() }} --justfile "{{ justfile() }}" \
            --working-directory "$repo" gate-fresh >"$dir/said" 2>&1
    }

    # One: the fallback docker removes what the plain rm could not, so the
    # tree is gone and the exit code is still the died container's own — the
    # cleanup neither swallows it nor overwrites it with the fallback's.
    status=0
    fresh 0 || status=$?
    [ "$status" -eq 5 ] \
        || fail "a died container's status 5 came out as $status"
    grep -qx '/w/rcad' "$dir/argv" \
        || fail "the fallback docker was never called"
    work=$(grep -o '^/.*/rcad:/rcad$' "$dir/argv" | head -1 | sed 's#/rcad:/rcad$##')
    [ -n "$work" ] || fail "no work directory recovered from the stub's log"
    [ ! -e "$work" ] \
        || fail "the tree is still at $work after the fallback docker cleaned it"

    # Two: the fallback docker fails too, so the tree is really left behind and
    # the message names it — but the exit code still carries the original rc,
    # not the fallback's own failure.
    rm -f "$dir/argv"
    status=0
    fresh 9 || status=$?
    [ "$status" -eq 5 ] \
        || fail "a died container's status 5 came out as $status over a failed fallback"
    grep -qx '/w/rcad' "$dir/argv" \
        || fail "the fallback docker was never called"
    work=$(grep -o '^/.*/rcad:/rcad$' "$dir/argv" | head -1 | sed 's#/rcad:/rcad$##')
    [ -n "$work" ] || fail "no work directory recovered from the stub's log"
    [ -e "$work" ] \
        || fail "the tree at $work is gone even though the fallback docker failed"
    grep -q "is left behind, owned by the container's root" "$dir/said" \
        || fail "no message named the leftover tree"

# The morning after a night's fuzzing, in one call.
#
# **`rcad-fuzz-triage.timer` runs it at 08:30, with no arguments** (§410).
# Before that timer a night was replayed when somebody remembered to, and of
# the eighteen nights up to 2026-10-05 that left inputs, one had been.
#
# What this replaces is four or five calls that each had to read a directory
# somebody else wrote: the `latest` line, then the night's directory, then the
# artifacts under it, then the decoder on each one, then whether any of it still
# matters. Every one of those costs a fresh session the whole context of the
# ones before it.
#
# `night` defaults to whatever `latest` names, which is what the timer wrote
# when it finished. Giving one by hand reads an older night, and then the commit
# is only known if `latest` still describes it — a night's directory does not
# record its own commit, and this says "unknown" rather than reporting the wrong
# one.
#
# **Both places an input can be.** `fuzz-overnight` copies what a target found
# into `<night>/artifacts/` (§91), but the nights before that landed have their
# inputs in `<root>/artifacts-rescued-<date>/` beside the night instead, put
# there by hand — and the night of 2026-09-14 is one of them, because the body
# that ran had been read from a commit older than the copy-out. Both layouts are
# `<target-name>/<file>`, which is where the target name for the decoder comes
# from: it is the artifact's own parent directory, not a guess off the `TO LOOK
# AT` list, which names recipes rather than targets.
#
# **`against` is the tree the decoder runs in, and `main` is the point.** The
# night stands on an older commit by design (§90), so "it crashed" is yesterday's
# news and "it still crashes on `main`" is the question. When `main` is not what
# this worktree is standing on, a detached worktree of it is made and taken away
# again, so nobody's tree moves.
#
# A decode that fails is reported and not fatal: the exit code here says whether
# the triage ran, because a morning that stops on the first undecodable input
# tells you nothing about the other five.
#
# **Every crash file is replayed once, but in one process rather than one
# `cargo run` each.** `no_model_makes_the_writer_panic` wrote 22 528 crash files
# on 2026-09-26 alone, and a `cargo run` per file is what made those uncountable
# (§265.2). `rcad-fuzz-explain --triage` reads `<target>\t<path>` lines off
# stdin and replays every one of them inside itself, so the whole night costs
# one build and one process, and it says on stderr every 2000 inputs how far it
# has got. What it hands back is already grouped: one bucket
# per panic's own message and place — which already names both, see
# `Outcome::Panicked` in `crates/rcad-fuzz-explain/src/lib.rs` — and one bucket
# per target for everything that no longer fails. **The night's verdicts land
# in the night's own directory**, at `$night/fuzz-triage-verdicts.tsv`, for
# `just fuzz-yield` (Q146) to read: five tab-separated columns, header first —
# `target`, `files`, `still_fails` (`yes`/`no`), `sample` (one input from the
# bucket), `group` (the panic's place and words with every number in the words
# written `N`, or a fixed name for a bucket that no longer fails). A fault is a
# row with `still_fails` = `yes`. Keyed on the whole message instead, the one
# writer assertion that prints two planes made 1 676 rows out of one fault.
#
# **Two more files land beside it, for `_status-triage` to read (§418.4).**
# `$night/fuzz-triage-members.tsv` names every crash file of each bucket still
# failing — `target`, `group`, `file`, one line per file — because a queue row
# can name a group by any one of its files, not only the `sample` column
# above, and the sample changes as a group grows.
# `$night/fuzz-triage-replayed-main.txt` holds the one full sha of the `main`
# this replayed against, which before this only went to the `replayed:` line
# below, read by nobody.
#
# **The decoder is built in the `test` profile, not `dev` and not `release`.**
# `cargo fuzz` builds its targets optimised with `debug_assertions` on, and
# `[profile.test]` is the one profile here that is both. `dev` gives the same
# verdicts and is slow: 2026-09-26's 22 633 crash files took 28 minutes in it,
# and a sample of 1 232 of them took 276 s against 16.5 s, identical verdicts
# byte for byte. `release` turns the assertions off, and that changes what the
# kernel answers rather than how fast (`check-release-build` says how), so a
# replay in it is not a replay of what the fuzzer ran.
#
# **Only `crash-*` files are replayed; every other kind is counted by kind and
# named, not decoded.** The per-file recipe before this one took every file
# under the night. A `timeout-` or `slow-unit-` input has no panic to
# group by, and in one process one that hangs stalls every file after it: the
# first real run over 2026-09-26, with its 3 072 timeouts and 1 365 slow-units
# in the manifest, sat for 21 CPU-minutes and was killed.
#
# **The target comes from the artifact's own parent directory, and that name is
# checked against `fuzz/fuzz_targets/*.rs` before anything is decoded.** A flat
# directory of rescued artifacts — no target subdirectory at all — hands the
# decoder a name that is not a target, and every one of those used to come back
# as "did not come back clean", which reads exactly like a live crash and is
# none. That input is counted as untellable instead, apart from every bucket
# that was actually decoded.
#
# **Then the fuse fuzzer's corpus is replayed for its refusals (§437.5).** The
# fuzzer counts a refusal and drops it, and keeps the input that reached it, so
# the refusals come back out of `fuzz_corpus_root/two_solids_fused_by_a_stranger`
# the morning after. `rcad-fuzz-explain --refusals` replays every file of it on
# `against`, in one process, giving each file 120 s; a file still running then
# is left behind and counted hung, and the rest carry on. Two files land in the
# night's directory. `$night/fuzz-refusals.tsv` has one row per group: `variant`,
# `key` (an `Undecidable`'s predicates still undecided, any other refusal's
# words with every number written `N`), `refusals`, `files`, `certified`,
# `tolerant`, `first_way_round`, `other_way_round`, one `sample` file, and
# `class` (`limit`, `gap` or `not known`, from `Error::limit_or_gap`, §437.6).
# `$night/fuzz-refusals-faults.tsv` names each file that `panicked`, `hung` or
# was `unreadable`: `fault`, `file`, `said`. The `since:` line compares the
# groups with the latest earlier night that has a `fuzz-refusals.tsv`, and an
# `appeared:` or `vanished:` line names each group that came or went. It runs
# on a night with no crash file too, since the corpus is there either way, and
# before the fold, so what the fold adds this morning is replayed the next. No
# row is filed from it: §437.5 says why.
#
# **Then a crash file that passed on `main` is folded into the corpus, and the
# tree stops carrying it (§434.3).** Each target's passing files are merged
# into `fuzz_corpus_root/<target>` with `-merge=1 -timeout=10` by the night's
# own binary under `fuzz/target/x86_64-unknown-linux-gnu/release/`, into a copy
# that replaces the corpus only once the merge exits 0. The merge keeps a file
# only when it takes the code down a path no kept file takes (§434.2). A morning
# hands it at most `RCAD_FUZZ_FOLD_AT_MOST` (2000) of a target's passing files,
# so the writer's first 68 013 fold over many mornings instead of running past
# the service's four hours every morning (§434.7). A file
# leaves this tree's `fuzz/artifacts/` only when the replay saw it pass and the
# merge's control file says it was read to the end, so one the night's older
# binary crashes on, or one that runs past ten seconds, stays for the next
# morning. A kept file not named for a crash file's hash was cut on the way in,
# and its target folds nothing. What libFuzzer writes during the merge goes to
# a scratch directory and never into `fuzz/artifacts/`, and no target's
# directory is removed, since `fuzz-yield` diffs against it. Each removed file
# gets a line in `fuzz_log_root/removed-crash-files.tsv` (`night`, `target`,
# `file`, `replayed_main`, `kept`), appended and never rewritten. All of it
# happens only in a tree standing on the commit of the night `latest` names,
# after a night that built, having replayed `main`. Anywhere else the `fold:`
# line says why and nothing moves.
[doc("The morning after: what the night found, decoded, and whether main still fails.")]
fuzz-triage night="" against="main":
    #!/usr/bin/env bash
    set -uo pipefail
    root='{{ fuzz_log_root }}'
    corpus_root='{{ fuzz_corpus_root }}'
    latest="$root/latest"
    night='{{ night }}'
    if [ -z "$night" ]; then
        if [ ! -f "$latest" ]; then
            echo "nothing to triage: $latest does not exist, so no run has reported a night"
            exit 1
        fi
        night=$(awk 'END{print $NF}' "$latest")
    fi
    if [ ! -d "$night" ]; then
        echo "nothing to triage: $night is not a directory"
        exit 1
    fi

    line=""
    if [ -f "$latest" ] && [ "$(awk 'END{print $NF}' "$latest")" = "$night" ]; then
        line=$(tail -1 "$latest")
    fi
    echo "night:    $night"
    if [ -z "$line" ]; then
        echo "commit:   unknown — $latest describes another night, and a night's directory does not record its own"
        echo "targets:  unknown for the same reason; each artifact below names its own"
    elif [ "$(awk '{print $3}' <<<"$line")" = "BUILD" ]; then
        echo "commit:   none — the targets did not build that night: $night/build.log"
        echo "targets:  none ran"
    else
        echo "commit:   $(awk '{print $3}' <<<"$line")"
        flagged=$(sed -n 's/.*TO LOOK AT (\([^)]*\)).*/\1/p' <<<"$line")
        echo "targets:  ${flagged:-nothing flagged}"
    fi
    echo "summary:  ${line:-(this night is not the one $latest describes)}"

    artifacts="$night/artifacts"
    rescued="$root/artifacts-rescued-$(basename "$night")"
    if [ -d "$artifacts" ]; then
        echo "inputs:   $artifacts"
    elif [ -d "$rescued" ]; then
        echo "inputs:   $rescued (rescued beside the night; $artifacts is not there)"
        artifacts="$rescued"
    else
        echo "inputs:   none — neither $artifacts nor $rescued exists"
        artifacts=""
    fi
    files=""
    if [ -n "$artifacts" ]; then
        files=$(find "$artifacts" -type f | sort)
        if [ -z "$files" ]; then
            echo "no files under $artifacts, so there is nothing to decode"
        fi
    fi

    at=$(git rev-parse --verify --quiet '{{ against }}^{commit}')
    if [ -z "$at" ]; then
        echo "there is no commit named '{{ against }}' here, so nothing can be replayed against it"
        exit 1
    fi
    work="."
    borrowed=""
    manifest=$(mktemp)
    report=$(mktemp)
    members=$(mktemp)
    refusals=$(mktemp)
    refusal_faults=$(mktemp)
    refusals_said=$(mktemp)
    fold_scratch=""
    fold_copy=""
    cleanup() {
        rm -f "$manifest" "$report" "$members" "$refusals" "$refusal_faults" "$refusals_said"
        [ -z "$fold_scratch" ] || rm -rf "$fold_scratch"
        [ -z "$fold_copy" ] || rm -rf "$fold_copy"
        if [ -n "$borrowed" ]; then
            git worktree remove --force "$borrowed/tree" >/dev/null 2>&1 || true
            rm -rf "$borrowed"
        fi
    }
    # Detached, so it never asks for a branch that is checked out elsewhere,
    # and taken away on the way out however this ends — a worktree left behind
    # would show up in `just lanes` as a lane nobody dispatched.
    trap cleanup EXIT
    if [ "$at" != "$(git rev-parse HEAD)" ]; then
        borrowed=$(mktemp -d)
        if ! git worktree add --quiet --detach "$borrowed/tree" "$at"; then
            echo "could not borrow a worktree at {{ against }}, so nothing was replayed against it"
            exit 1
        fi
        work="$borrowed/tree"
    fi
    echo "replayed: {{ against }} ($(git rev-parse --short "$at")) in $work"

    # The morning refusal replay, §437.5. Run whether or not the night left a
    # crash file, since the corpus is there either way, and before the fold, so
    # what the fold adds this morning is replayed the next.
    replay_the_corpus() {
        echo
        local corpus="$corpus_root/two_solids_fused_by_a_stranger"
        if [ ! -d "$corpus" ]; then
            echo "refusals: none — $corpus is not there"
            return 0
        fi
        local replay=(cargo run -q --profile test -p rcad-fuzz-explain -- --refusals "$corpus" --faults "$refusal_faults")
        echo "\$ ${replay[*]}"
        (cd "$work" && "${replay[@]}") >"$refusals" 2>"$refusals_said"
        local status=$?
        if [ "$status" -ne 0 ]; then
            echo "fuzz-triage: the refusal replay itself failed (exit $status); it ended:"
            tail -5 "$refusals_said" | sed 's/^/          /'
            exit 1
        fi
        cp "$refusals" "$night/fuzz-refusals.tsv"
        cp "$refusal_faults" "$night/fuzz-refusals-faults.tsv"
        echo "refusals: $night/fuzz-refusals.tsv"
        sed -n 's/^--refusals: /          /p' "$refusals_said"
        awk -F'\t' 'NR > 1 { print "fault:    " $1 " " $2 ": " $3 }' "$refusal_faults"

        local this_night before changes
        this_night=$(basename "$night")
        before=$(for earlier in "$(dirname "$night")"/*/fuzz-refusals.tsv; do
                [ -f "$earlier" ] && basename "$(dirname "$earlier")"
            done | LC_ALL=C awk -v this="$this_night" '$0 < this' | LC_ALL=C sort | tail -n 1)
        if [ -z "$before" ]; then
            echo "since:    no night before $this_night has a fuzz-refusals.tsv, so there is nothing to compare"
            return 0
        fi
        changes=$(LC_ALL=C awk -F'\t' -v before="$before" '
            FNR == 1 { next }
            FILENAME == ARGV[1] { old[$1 FS $2] = $0; next }
            { now[$1 FS $2] = 1 }
            !(($1 FS $2) in old) { print "appeared: " $1 ": " $2 " (" $3 " refusals in " $4 " file(s), " $9 ")" }
            END {
                for (key in old) {
                    if (key in now) continue
                    split(old[key], was, FS)
                    print "vanished: " was[1] ": " was[2] " (" was[3] " refusals in " was[4] " file(s) on " before ")"
                }
            }
        ' "$(dirname "$night")/$before/fuzz-refusals.tsv" "$night/fuzz-refusals.tsv" | LC_ALL=C sort)
        if [ -z "$changes" ]; then
            echo "since:    $before, no group appeared or vanished"
        else
            echo "since:    $before"
            printf '%s\n' "$changes"
        fi
    }

    if [ -z "$files" ]; then
        replay_the_corpus
        exit 0
    fi

    valid_targets=""
    for target_rs in "$work"/fuzz/fuzz_targets/*.rs; do
        [ -e "$target_rs" ] || continue
        valid_targets="$valid_targets $(basename "$target_rs" .rs)"
    done

    untellable=0
    crash_files=0
    not_crash=0
    declare -A not_crash_kinds=()
    while IFS= read -r file; do
        name="${file##*/}"
        case "$name" in
            crash-*) crash_files=$((crash_files + 1)) ;;
            *)
                kind="${name%-*}"
                not_crash=$((not_crash + 1))
                not_crash_kinds[$kind]=$(( ${not_crash_kinds[$kind]:-0} + 1 ))
                continue
                ;;
        esac
        target="${file%/*}"
        target="${target##*/}"
        case " $valid_targets " in
            *" $target "*) printf '%s\t%s\n' "$target" "$file" ;;
            *)
                untellable=$((untellable + 1))
                echo "target:   unknown — $target names no fuzz_targets/*.rs on {{ against }}, so this could not be placed and was not decoded" >&2
                ;;
        esac
    done <<<"$files" >"$manifest"

    tellable=$(grep -c . <"$manifest" || true)
    echo
    # `cargo` by name and not through `mise exec`: the 08:30 timer has no `mise`
    # on its PATH, and the `mise exec -- just` that started this recipe has
    # already set what mise.toml's `[env]` adds. `check-fuzz-triage-selftest`.
    decode=(cargo run -q --profile test -p rcad-fuzz-explain -- --triage --members "$members")
    echo "\$ ${decode[*]}   (replaying $tellable input(s) in one process)"
    (cd "$work" && "${decode[@]}") <"$manifest" >"$report"
    triage_status=$?
    if [ "$triage_status" -ne 0 ]; then
        echo "fuzz-triage: the decoder itself failed (exit $triage_status), so nothing was replayed"
        exit 1
    fi

    cp "$report" "$night/fuzz-triage-verdicts.tsv"
    cp "$members" "$night/fuzz-triage-members.tsv"
    echo "$at" >"$night/fuzz-triage-replayed-main.txt"
    echo
    echo "verdicts: $night/fuzz-triage-verdicts.tsv"
    groups=$(($(wc -l <"$report") - 1))
    faults=$(awk -F'\t' 'NR>1 && $3=="yes"' "$report" | grep -c . || true)
    decoded=$(awk -F'\t' 'NR>1{n+=$2} END{print n+0}' "$report")
    total=$(grep -c . <<<"$files")
    echo "groups:   $groups, $faults of them still failing on {{ against }}"
    echo "files:    $decoded decoded of $crash_files crash file(s), out of $total in all"
    if [ "$not_crash" -gt 0 ]; then
        kinds=""
        for kind in $(printf '%s\n' "${!not_crash_kinds[@]}" | LC_ALL=C sort); do
            kinds="${kinds:+$kinds, }$kind: ${not_crash_kinds[$kind]}"
        done
        echo "not replayed: $not_crash that are not crash files ($kinds) — none has a panic to group by, and one that hangs would stall every file after it"
    fi
    if [ "$untellable" -gt 0 ]; then
        echo "$untellable of $total input(s) could not be told which target they came from, and are not in the groups above"
    fi

    replay_the_corpus

    # The fold, §434.3. What it removes is this tree's own `fuzz/artifacts/`
    # and what it merges with is this tree's own build, so both have to be the
    # night's, and each guard says why it folds nothing.
    echo
    night_named=$(awk '{print $3}' <<<"$line")
    fold_refusal=""
    if [ -z "$line" ]; then
        fold_refusal="$latest describes another night, and only the latest night's tree holds its files and its binaries"
    elif [ "$night_named" = "BUILD" ]; then
        fold_refusal="the night's targets did not build, so there is no night binary to merge with"
    elif [ "$(git rev-parse --verify --quiet "$night_named^{commit}")" != "$(git rev-parse HEAD)" ]; then
        fold_refusal="this tree stands on $(git rev-parse --short HEAD) and the night on $night_named, so neither this tree's fuzz/artifacts/ nor its fuzz binaries are the night's"
    elif [ "$at" != "$(git rev-parse --verify --quiet 'main^{commit}')" ]; then
        fold_refusal="this replayed {{ against }}, not main, and a crash file leaves only once it passes on main"
    fi
    if [ -n "$fold_refusal" ]; then
        echo "fold:     none — $fold_refusal"
        exit 0
    fi
    # At most this many of a target's passing files a morning (§434.7). The
    # writer's first fold is 68 013 files, merged at about 1.3 a second, and a
    # merge the service's four hours cut off keeps nothing, so without a cap it
    # would be killed every morning with nothing folded.
    at_most=${RCAD_FUZZ_FOLD_AT_MOST:-2000}
    if ! [[ $at_most =~ ^[1-9][0-9]*$ ]]; then
        echo "fold:     none — RCAD_FUZZ_FOLD_AT_MOST is '$at_most', and a morning's cap is a whole number above 0"
        exit 1
    fi

    fold_scratch=$(mktemp -d)
    record="$root/removed-crash-files.tsv"
    tree=$(pwd)
    awk -F'\t' 'FILENAME == ARGV[1] { if (FNR > 1) failing[$NF] = 1; next } !($2 in failing)' \
        "$members" "$manifest" >"$fold_scratch/passing"
    if [ ! -s "$fold_scratch/passing" ]; then
        echo "fold:     nothing passed on main, so nothing leaves fuzz/artifacts/"
        exit 0
    fi
    [ -f "$record" ] || printf 'night\ttarget\tfile\treplayed_main\tkept\n' >"$record"
    for target in $(cut -f1 "$fold_scratch/passing" | LC_ALL=C sort -u); do
        here="$fold_scratch/$target"
        mkdir -p "$here/in" "$here/libfuzzer"
        awk -F'\t' -v target="$target" '$1 == target { print $2 }' "$fold_scratch/passing" >"$here/passing"
        passing=$(grep -c . <"$here/passing")
        said_passing=$(awk -F'\t' -v target="$target" \
            'NR > 1 && $1 == target && $3 == "no" { n += $2 } END { print n + 0 }' "$report")
        if [ "$passing" != "$said_passing" ]; then
            echo "fold:     $target: none — the verdicts say $said_passing passed and the members file leaves $passing, so which ones passed is not known"
            continue
        fi
        binary="$tree/fuzz/target/x86_64-unknown-linux-gnu/release/$target"
        if [ ! -x "$binary" ]; then
            echo "fold:     $target: none — there is no night binary at $binary, so all $passing passing file(s) stay"
            continue
        fi
        head -n "$at_most" "$here/passing" | xargs -d '\n' cp -t "$here/in" --
        # A copy, swapped in only when the merge succeeded, as the reader's
        # nightly merge does (§295.7). The tracked `fuzz/corpus/<target>` is not
        # handed in, so a file is kept for a path only a tracked file takes.
        mkdir -p "$corpus_root"
        fold_copy=$(mktemp -d "$corpus_root/$target-fold-tmp.XXXXXX")
        if [ -d "$corpus_root/$target" ]; then
            cp -R "$corpus_root/$target/." "$fold_copy/"
        fi
        ls -A "$fold_copy" | LC_ALL=C sort >"$here/before"
        # In a scratch directory, with libFuzzer's own files sent there too: a
        # crash or a timeout it writes into `fuzz/artifacts/` would be carried
        # as if a night had found it (§434.3, fifth rule).
        (cd "$here/libfuzzer" && env -u RCAD_FUZZ_TIMINGS "$binary" -merge=1 -timeout=10 \
            -merge_control_file="$here/control" -artifact_prefix="$here/libfuzzer/" \
            "$fold_copy" "$here/in") >"$here/merge.log" 2>&1
        merged=$?
        if [ "$merged" -ne 0 ]; then
            rm -rf "$fold_copy"
            fold_copy=""
            echo "fold:     $target: none — the merge failed (exit $merged), so the corpus is as it was and all $passing passing file(s) stay; it ended:"
            tail -5 "$here/merge.log" | sed 's/^/          /'
            continue
        fi
        # The control file names every file the merge was given, then writes
        # `FT <index>` only once one has run to the end. One that crashed the
        # night's older binary or ran past ten seconds has none, and stays.
        awk -v in_dir="$here/in/" '
            NR == 1 { files = $1; next }
            NR == 2 { next }
            NR <= files + 2 { path[NR - 3] = $0; next }
            $1 == "FT" && index(path[$2], in_dir) == 1 { print substr(path[$2], length(in_dir) + 1) }
        ' "$here/control" | LC_ALL=C sort -u >"$here/read-whole"
        ls -A "$fold_copy" | LC_ALL=C sort | LC_ALL=C comm -13 "$here/before" - \
            | sed 's/^/crash-/' >"$here/kept"
        # libFuzzer names a corpus file for the SHA-1 of its bytes, as it named
        # the crash file, so a kept name that is no crash file's was cut on the
        # way in and is another input.
        cut_short=$(LC_ALL=C comm -23 "$here/kept" "$here/read-whole")
        if [ -n "$cut_short" ]; then
            rm -rf "$fold_copy"
            fold_copy=""
            echo "fold:     $target: none — the merge kept $(grep -c . <<<"$cut_short") file(s) named for no crash file it read whole, so it cut them (first: ${cut_short%%$'\n'*}); the corpus is as it was and all $passing passing file(s) stay"
            continue
        fi
        rm -rf "${corpus_root:?}/$target"
        mv "$fold_copy" "$corpus_root/$target"
        fold_copy=""
        while IFS= read -r name; do
            if [ -f "fuzz/artifacts/$target/$name" ]; then printf '%s\n' "$name"; fi
        done <"$here/read-whole" >"$here/leaving"
        (cd "fuzz/artifacts/$target" && xargs -r -d '\n' rm -f -- <"$here/leaving")
        while IFS= read -r name; do
            if [ ! -e "fuzz/artifacts/$target/$name" ]; then printf '%s\n' "$name"; fi
        done <"$here/leaving" >"$here/removed"
        awk -v night="$(basename "$night")" -v target="$target" -v main="$at" '
            FILENAME == ARGV[1] { kept[$0] = 1; next }
            { print night "\t" target "\t" $0 "\t" main "\t" (($0 in kept) ? "yes" : "no") }
        ' "$here/kept" "$here/removed" >>"$record"
        folded=$(grep -c . <"$here/removed")
        kept=$(grep -c . <"$here/kept")
        left=$((passing - $(grep -c . <"$here/read-whole")))
        echo "fold:     $target: $passing passed, $folded folded ($kept kept by the merge), $left left for the next morning"
    done
    echo "removed:  $record"

# Turns one artifact `fuzz-triage` found into a seed, which today is a `cp`
# somebody has to remember — and §98.5 is what happens when nobody does.
#
# **The kind comes off the source file's own name, not a hardcoded `crash`.**
# libFuzzer writes `crash-<sha1>`, `slow-unit-<sha1>`, `oom-<sha1>` and
# `timeout-<sha1>` — a slow-unit promoted under the crash kind would be a lie
# in the one place a later reader trusts, the file name. So the kind is read
# off, not invented: everything before the trailing sha1 and its separating
# dash. A name with nothing readable there — no dash before the sha1 at all —
# is refused rather than promoted under a guess.
#
# `name` is the human-readable slug, `crash-a-thin-pipe-on-a-fat-ones-skin` is
# the shape already in the corpus, but the sha1 on the end is what makes the
# name unique and it is never typed by hand: it is read off the file's own
# name and checked against the file's own bytes before anything is written, so
# a renamed or truncated artifact is refused rather than seeded under a false
# name. Leave `name` out and the promoted file is just `<kind>-<sha1>`.
[doc("Promote a fuzz artifact into fuzz/corpus/<target>/, sha1-checked, under its own kind.")]
fuzz-promote target file name="":
    #!/usr/bin/env bash
    set -euo pipefail
    target_rs="fuzz/fuzz_targets/{{target}}.rs"
    if [ ! -f "$target_rs" ]; then
        echo "no such target: $target_rs does not exist"
        exit 1
    fi
    file="{{file}}"
    if [ ! -f "$file" ]; then
        echo "no such file: $file"
        exit 1
    fi
    base=$(basename "$file")
    embedded=""
    if [ "${#base}" -ge 40 ]; then
        embedded="${base: -40}"
    fi
    if ! [[ "$embedded" =~ ^[0-9a-f]{40}$ ]]; then
        echo "refused: $base does not end in a 40-character sha1, so nothing was promoted"
        exit 1
    fi
    actual=$(sha1sum "$file" | awk '{print $1}')
    if [ "$actual" != "$embedded" ]; then
        echo "refused: $base names sha1 $embedded but the file hashes to $actual"
        exit 1
    fi
    kind="${base%-$embedded}"
    if [ "$kind" = "$base" ] || [ -z "$kind" ]; then
        echo "refused: $base has no <kind>-<sha1> shape, so no kind could be read from it"
        exit 1
    fi
    dest_dir="fuzz/corpus/{{target}}"
    name="{{name}}"
    if [ -n "$name" ]; then
        dest="$dest_dir/$kind-$name-$embedded"
    else
        dest="$dest_dir/$kind-$embedded"
    fi
    if [ -e "$dest" ]; then
        if cmp -s "$file" "$dest"; then
            echo "already there: $dest"
            exit 0
        fi
        echo "refused: $dest already exists with different contents"
        exit 1
    fi
    mkdir -p "$dest_dir"
    cp "$file" "$dest"
    echo "promoted: $dest"

# Pins `fuzz-triage` against nights this builds itself: a `latest` line in the
# shape `fuzz-overnight` writes, artifacts in both of the two places they land,
# and a night nothing has reported.
#
# **The decoder is asserted by name, first, and that is not decoration.**
# Without it every arm below would still pass: a decoder that cannot run
# reports as an input that did not come back clean, which is the right thing
# for the recipe to do and says nothing at all about whether the decoder was
# ever there. So this arm fails loudly if `rcad-fuzz-explain` is ever missing
# from the workspace, rather than going quietly green over a contract nothing
# implements.
#
# `HEAD` rather than `main` for `against`, because the arms are about the
# recipe's parse and not about which tree it borrows: pointing it at `main` from
# a lane would have every gate build a second worktree of the workspace to
# decode a fixture of twenty junk bytes.
#
# **Every arm runs with a `mise` on its PATH that fails as a missing one does.**
# `rcad-fuzz-triage.service` has no `mise` on its PATH: it starts `mise` by
# absolute path, and `mise exec` does not add its own directory to the PATH it
# passes on. The recipe called `mise exec` a second time, inside itself, and both
# of the timer's first two mornings, 2026-10-07 and 10-08, ended on `mise:
# command not found` with nothing replayed. Every arm passed on a session's
# PATH, so none of them could have caught it.
#
# **The refusal replay (§437.5) runs for real on the checked-in fuse corpus,
# in the last arm only.** Every other arm points `RCAD_FUZZ_CORPUS` at a
# directory with no fuse corpus in it, and checks the morning says so and goes
# on. Which refusals that corpus meets is the kernel's business, so the last
# arm checks only what the recipe owes: one call, the two files and their
# headers, counts that add up, a sample from the corpus for every group, and
# which groups appeared or vanished since the night before.
[private]
check-fuzz-triage-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    metadata=$(cargo metadata --no-deps --format-version 1 2>/dev/null)
    grep -q '"name":"rcad-fuzz-explain"' <<<"$metadata" \
        || { echo "fuzz-triage decodes an artifact with rcad-fuzz-explain, and cargo metadata does not list that crate here"; \
             exit 1; }

    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    logs="$dir/logs"
    night="$logs/2026-09-14"
    crash="$night/artifacts/where_two_surfaces_cross/crash-deadbeef"
    mkdir -p "$(dirname "$crash")"
    printf 'not a real crash input' >"$crash"
    printf '%s  %s  %s  %s  %s\n' \
        "2026-09-14 08:10" "9b82e9e (0 days old, 0 behind main)" \
        "4 targets, 1 TO LOOK AT (fuzz:crash)" "1 artifacts in $night/artifacts" \
        "$night" >"$logs/latest"

    fail() {
        echo "fuzz-triage drifted from its own fixtures: $1"
        echo "--- got ---"; echo "$got"
        exit 1
    }
    no_mise="$dir/no-mise"
    mkdir -p "$no_mise"
    printf '#!/bin/sh\necho "mise: command not found (the 08:30 timer has no mise on its PATH)" >&2\nexit 127\n' \
        >"$no_mise/mise"
    chmod +x "$no_mise/mise"
    triage_corpus="$dir/corpus"
    triage() {
        PATH="$no_mise:$PATH" RCAD_FUZZ_LOGS="$logs" RCAD_FUZZ_CORPUS="$triage_corpus" \
            just fuzz-triage "$1" HEAD 2>&1
    }

    verdicts="$night/fuzz-triage-verdicts.tsv"
    header=$(printf 'target\tfiles\tstill_fails\tsample\tgroup')

    # One: no night given, so it reads the one `latest` names, and everything
    # the morning asks for comes out of that one line. A second file with the
    # same undecodable bytes as the first, under the same target, and a third
    # under a different target, prove the batch call replays every input but
    # groups them — two into one bucket, one into a bucket of its own — rather
    # than costing one `cargo run` each. A fourth, a timeout, is counted and
    # named but never replayed: the first real night's 3 072 timeouts, replayed
    # back to back in one process, stalled it for 21 CPU-minutes.
    crash2="$night/artifacts/where_two_surfaces_cross/crash-beadfeed"
    printf 'not a real crash input' >"$crash2"
    third="$night/artifacts/two_solids_fused_by_a_stranger/crash-c0ffee"
    mkdir -p "$(dirname "$third")"
    printf 'nor is this one' >"$third"
    hang="$night/artifacts/where_two_surfaces_cross/timeout-feedface"
    printf 'a hang is not a panic' >"$hang"
    got=$(triage "") || fail "a night with four artifacts made the triage itself fail"
    grep -qF "night:    $night" <<<"$got" || fail "it did not say which night it read"
    grep -q '^commit:   9b82e9e$' <<<"$got" \
        || fail "it did not name the commit that was fuzzed, which is the whole of §90"
    grep -q '^targets:  fuzz:crash$' <<<"$got" || fail "it did not name the target that was flagged"
    calls=$(grep -c 'cargo run -q --profile test -p rcad-fuzz-explain -- --triage' <<<"$got" || true)
    [ "$calls" = 1 ] \
        || fail "three artifacts cost $calls optimised batch call(s), not the one this recipe exists to hold at"

    [ -f "$verdicts" ] || fail "no verdict file landed in the night's own directory"
    [ "$(head -1 "$verdicts")" = "$header" ] \
        || fail "the verdict file's header does not name its five columns"
    row1=$(printf 'where_two_surfaces_cross\t2\tyes\t')
    grep -qF "$row1" "$verdicts" \
        || fail "the two files with the same undecodable bytes were not collapsed into one bucket of 2"
    row2=$(printf 'two_solids_fused_by_a_stranger\t1\tyes\t')
    grep -qF "$row2" "$verdicts" \
        || fail "the file under the other target did not get a bucket of its own"
    [ "$(grep -c . "$verdicts")" = 3 ] \
        || fail "the verdict file should hold a header and two group rows, not $(grep -c . "$verdicts")"
    grep -q '^groups:   2, 2 of them still failing on HEAD$' <<<"$got" \
        || fail "the tally did not say two groups, both still failing"
    grep -q '^files:    3 decoded of 3 crash file(s), out of 4 in all$' <<<"$got" \
        || fail "the tally did not say all three crash files were decoded, out of four"
    grep -q '^not replayed: 1 that are not crash files (timeout: 1)' <<<"$got" \
        || fail "the timeout was not counted by its kind"
    ! grep -qF "$hang" "$verdicts" \
        || fail "a timeout was replayed and grouped, and one that hangs stalls every file after it"

    members="$night/fuzz-triage-members.tsv"
    members_header=$(printf 'target\tgroup\tfile')
    [ -f "$members" ] || fail "no members file landed beside the verdicts"
    [ "$(head -1 "$members")" = "$members_header" ] \
        || fail "the members file's header does not name its three columns"
    grep -qF "$crash" "$members" \
        || fail "the first file of a still-failing group was not listed in the members file"
    grep -qF "$crash2" "$members" \
        || fail "the second file of the same still-failing group was not listed in the members file"
    grep -qF "$third" "$members" \
        || fail "the other target's still-failing group's file was not listed in the members file"
    ! grep -qF "$hang" "$members" \
        || fail "a timeout, never replayed, was listed in the members file"

    replayed_main="$night/fuzz-triage-replayed-main.txt"
    [ -f "$replayed_main" ] || fail "no replayed-main file landed beside the verdicts"
    [ "$(cat "$replayed_main")" = "$(git rev-parse HEAD)" ] \
        || fail "the replayed-main file did not hold the full sha of the commit this replayed against"
    grep -qxF "refusals: none — $dir/corpus/two_solids_fused_by_a_stranger is not there" <<<"$got" \
        || fail "a night with crash files did not go on to the refusal replay, or did not say the corpus is missing"
    [ ! -e "$night/fuzz-refusals.tsv" ] \
        || fail "a corpus that is not there still got a fuzz-refusals.tsv written for it"

    # Two: the nights before §91's copy-out landed keep their inputs in a
    # rescued directory beside the night, and 2026-09-14 is one of them.
    rm -rf "$night/artifacts"
    rescued="$logs/artifacts-rescued-2026-09-14/two_solids_fused_by_a_stranger"
    mkdir -p "$rescued"
    printf 'nor is this one' >"$rescued/crash-c0ffee"
    got=$(triage "") || fail "a night whose inputs were rescued beside it made the triage fail"
    grep -qF "inputs:   $logs/artifacts-rescued-2026-09-14" <<<"$got" \
        || fail "it did not look beside the night for the rescued inputs"
    calls=$(grep -c 'cargo run -q --profile test -p rcad-fuzz-explain -- --triage' <<<"$got" || true)
    [ "$calls" = 1 ] || fail "one rescued input cost $calls optimised batch call(s)"
    row=$(printf 'two_solids_fused_by_a_stranger\t1\tyes\t')
    grep -qF "$row" "$verdicts" || fail "the rescued input's own bucket was not written"
    grep -qF "$rescued/crash-c0ffee" "$verdicts" || fail "the rescued input was not named as a sample"

    # Three: a night nothing reported still says what it can, and says the
    # commit is unknown rather than borrowing the one `latest` happens to name.
    other="$logs/2026-09-09"
    mkdir -p "$other"
    got=$(triage "$other") || fail "a night with no artifacts at all made the triage fail"
    grep -q '^commit:   unknown' <<<"$got" \
        || fail "it read another night's commit off the latest line and reported it as this one's"
    grep -qF "inputs:   none" <<<"$got" \
        || fail "a night that kept nothing did not say so"
    [ ! -e "$other/fuzz-triage-verdicts.tsv" ] \
        || fail "a night with nothing to decode still got a verdict file written into it"
    grep -q '^refusals: none — ' <<<"$got" \
        || fail "a night with no artifacts stopped before the refusal replay"

    # Four: a directory that is not there is a failure and not an empty report.
    if triage "$logs/2026-01-01" >/dev/null 2>&1; then
        got=$(triage "$logs/2026-01-01")
        fail "a night that does not exist was triaged anyway"
    fi

    # Five: a flat directory of artifacts, no target subdirectory at all — the
    # shape `~/rcad-fuzz-logs/artifacts-rescued-2026-09-13/` was in, 88 files
    # whose parent directory names no target. Every one of those used to read
    # as "did not come back clean", indistinguishable from a live crash.
    flat_night="$logs/2026-09-13"
    mkdir -p "$flat_night"
    flat_rescued="$logs/artifacts-rescued-2026-09-13"
    mkdir -p "$flat_rescued"
    printf 'flat, no target subdirectory' >"$flat_rescued/crash-baadf00d"
    got=$(triage "$flat_night") || fail "a flat directory of artifacts made the triage itself fail"
    grep -q '^target:   unknown' <<<"$got" \
        || fail "an artifact whose parent directory names no real target was decoded anyway"
    grep -qF "1 of 1 input(s) could not be told which target they came from" <<<"$got" \
        || fail "the untellable count did not reach the tail line"
    grep -q '^groups:   0, 0 of them still failing on HEAD$' <<<"$got" \
        || fail "an untellable input was folded into a group instead of being left out of every one"
    grep -q '^files:    0 decoded of 1 crash file(s), out of 1 in all$' <<<"$got" \
        || fail "an untellable input was counted as decoded"
    [ "$(head -1 "$flat_night/fuzz-triage-verdicts.tsv")" = "$header" ] \
        || fail "a night with only untellable input still needs a header-only verdict file, for Q146 to read without special-casing it"
    [ "$(head -1 "$flat_night/fuzz-triage-members.tsv")" = "$members_header" ] \
        || fail "a night with only untellable input still needs a header-only members file"

    # Six: promoting a good artifact keeps the trailing sha1 and lands it under
    # a name — `crash-<name>-<sha1>` is the shape already in the corpus.
    promote_repo="$dir/promote-repo"
    mkdir -p "$promote_repo/fuzz/fuzz_targets" "$promote_repo/fuzz/corpus"
    touch "$promote_repo/fuzz/fuzz_targets/where_two_surfaces_cross.rs"
    git -C "$promote_repo" init -q
    promote() {
        {{just_executable()}} --justfile "{{justfile()}}" \
            --working-directory "$promote_repo" fuzz-promote "$@" 2>&1
    }
    src="$dir/crash-tmp"
    printf 'a thin pipe on a fat ones skin' >"$src"
    sha1=$(sha1sum "$src" | awk '{print $1}')
    mv "$src" "$dir/crash-$sha1"
    src="$dir/crash-$sha1"
    got=$(promote where_two_surfaces_cross "$src" a-thin-pipe-on-a-fat-ones-skin) \
        || fail "promoting a good artifact failed"
    dest="$promote_repo/fuzz/corpus/where_two_surfaces_cross/crash-a-thin-pipe-on-a-fat-ones-skin-$sha1"
    [ -f "$dest" ] || fail "promote did not land the file at $dest"
    cmp -s "$src" "$dest" || fail "the promoted file's contents do not match the source"

    # Seven: a target that does not exist is refused, and gets no corpus
    # directory of its own.
    if got=$(promote no_such_target "$src" 2>&1); then
        fail "promoting into a target that does not exist was not refused"
    fi
    grep -q 'no such target' <<<"$got" || fail "the refusal did not say the target does not exist"
    [ ! -d "$promote_repo/fuzz/corpus/no_such_target" ] \
        || fail "a target that does not exist got a corpus directory anyway"

    # Eight: a file whose contents do not hash to the sha1 in its own name is
    # refused, and nothing is written into the corpus for it.
    zeros=$(printf '%040d' 0)
    bad="$dir/crash-$zeros"
    printf 'these bytes do not hash to forty zeros' >"$bad"
    if got=$(promote where_two_surfaces_cross "$bad" 2>&1); then
        fail "promoting a file whose contents do not match its own sha1 was not refused"
    fi
    grep -q 'hashes to' <<<"$got" || fail "the refusal did not say the hash mismatched"
    [ ! -e "$promote_repo/fuzz/corpus/where_two_surfaces_cross/crash-$zeros" ] \
        || fail "a hash-mismatched file was written into the corpus anyway"

    # Nine: a slow-unit is not a crash, and does not get promoted as one — the
    # kind comes off the source name, not a hardcoded "crash".
    slow_content="$dir/slow-content"
    printf 'this one just took too long, it never crashed' >"$slow_content"
    slow_sha1=$(sha1sum "$slow_content" | awk '{print $1}')
    slow="$dir/slow-unit-$slow_sha1"
    mv "$slow_content" "$slow"
    got=$(promote where_two_surfaces_cross "$slow") || fail "promoting a slow-unit artifact failed"
    slow_dest="$promote_repo/fuzz/corpus/where_two_surfaces_cross/slow-unit-$slow_sha1"
    [ -f "$slow_dest" ] || fail "a slow-unit was not promoted under its own kind"
    cmp -s "$slow" "$slow_dest" || fail "the promoted slow-unit's contents do not match the source"
    [ ! -e "$promote_repo/fuzz/corpus/where_two_surfaces_cross/crash-$slow_sha1" ] \
        || fail "a slow-unit was promoted under the crash kind"

    # Ten: a source name with nothing readable before its sha1 — no dash, no
    # kind — is refused rather than promoted under an invented kind.
    noprefix_content="$dir/noprefix-content"
    printf 'the whole name is the sha1, nothing before it' >"$noprefix_content"
    noprefix_sha1=$(sha1sum "$noprefix_content" | awk '{print $1}')
    noprefix="$dir/$noprefix_sha1"
    mv "$noprefix_content" "$noprefix"
    if got=$(promote where_two_surfaces_cross "$noprefix" 2>&1); then
        fail "promoting a file with no kind before its sha1 was not refused"
    fi
    grep -q 'no kind could be read' <<<"$got" \
        || fail "the refusal did not say it could not read a kind"

    # Eleven onwards: the fold (§434.3), in a tree of its own standing on the
    # night's commit, as `rcad-nightly-fuzz` does at 08:30. The decoder is the
    # real one, run from this workspace by a `cargo` ahead on the PATH, since
    # the fixture tree has no workspace. The reader takes any bytes without a
    # panic, so its files pass on main; `where_two_surfaces_cross` decodes
    # nothing from these bytes, so its file still fails. The night's binary is a
    # stand-in that answers `-merge=1` as far as the fold reads it: the control
    # file's `STARTED` and `FT` lines, a kept file named for the SHA-1 of its
    # bytes, and a crash or a timeout written under `-artifact_prefix`, which
    # is where libFuzzer writes them. What each input does is in its bytes.
    reader=no_step_file_makes_the_reader_panic
    surfaces=where_two_surfaces_cross
    tree="$dir/night-tree"
    fold_logs="$dir/fold-logs"
    fold_corpus="$dir/fold-corpus"
    record="$fold_logs/removed-crash-files.tsv"
    cargo_here="$dir/cargo-here"
    mkdir -p "$cargo_here" "$fold_logs" "$fold_corpus/$reader" "$dir/tmp"
    # The stand-in puts this run's own PATH back before it names `cargo`: mise's
    # `cargo` shim looks for the next `cargo` on the PATH, finds this one, and
    # the two exec each other for ever.
    printf '#!/bin/sh\ncd "%s" && PATH="%s" exec cargo "$@"\n' "$PWD" "$PATH" >"$cargo_here/cargo"
    chmod +x "$cargo_here/cargo"
    mkdir -p "$tree/fuzz/fuzz_targets" "$tree/fuzz/corpus/$reader"
    touch "$tree/fuzz/fuzz_targets/$reader.rs" "$tree/fuzz/fuzz_targets/$surfaces.rs"
    printf 'a tracked seed' >"$tree/fuzz/corpus/$reader/tracked-seed"
    git -C "$tree" init -q -b main
    commit() { git -C "$tree" -c user.name=selftest -c user.email=selftest@invalid commit -q --allow-empty -m "$1"; }
    commit "the night's commit"
    bin="$tree/fuzz/target/x86_64-unknown-linux-gnu/release"
    mkdir -p "$bin"
    cat >"$bin/$reader" <<'STAND_IN'
    #!/usr/bin/env bash
    set -eu
    shopt -s nullglob
    printf '%s\n' "$*" >>"$0.calls"
    prefix="" control="" dirs=()
    for arg in "$@"; do
        case "$arg" in
            -artifact_prefix=*) prefix="${arg#*=}" ;;
            -merge_control_file=*) control="${arg#*=}" ;;
            -*) ;;
            *) dirs+=("$arg") ;;
        esac
    done
    out="${dirs[0]}"
    first=("$out"/*)
    inputs=()
    for d in "${dirs[@]:1}"; do inputs+=("$d"/*); done
    { echo $((${#first[@]} + ${#inputs[@]})); echo "${#first[@]}"; printf '%s\n' "${first[@]}" "${inputs[@]}"; } >"$control"
    status=0
    i=${#first[@]}
    for f in "${inputs[@]}"; do
        echo "STARTED $i $(wc -c <"$f")" >>"$control"
        hash=$(sha1sum "$f" | cut -d' ' -f1)
        if grep -q 'crashes the night' "$f"; then
            cp "$f" "${prefix}crash-$hash"
        elif grep -q 'runs past ten seconds' "$f"; then
            cp "$f" "${prefix}timeout-$hash"
        else
            if grep -q 'takes a new path' "$f"; then cp "$f" "$out/$hash"; fi
            if grep -q 'is cut by the merge' "$f"; then
                head -c 4 "$f" >"$out/$(head -c 4 "$f" | sha1sum | cut -d' ' -f1)"
            fi
            if grep -q 'fails the whole merge' "$f"; then cp "$f" "$out/$hash"; status=1; fi
            echo "FT $i 1" >>"$control"
        fi
        i=$((i + 1))
    done
    exit "$status"
    STAND_IN
    chmod +x "$bin/$reader"
    cp "$bin/$reader" "$bin/$surfaces"
    put() {
        local hash
        hash=$(printf '%s' "$2" | sha1sum | cut -d' ' -f1)
        mkdir -p "$tree/fuzz/artifacts/$1"
        printf '%s' "$2" >"$tree/fuzz/artifacts/$1/crash-$hash"
        echo "crash-$hash"
    }
    a_night() {
        mkdir -p "$fold_logs/$1/artifacts"
        cp -R "$tree/fuzz/artifacts/." "$fold_logs/$1/artifacts/"
        printf '%s  %s  %s  %s  %s\n' "$1 08:10" "$2 (0 days old, 0 behind main)" \
            "2 targets, 1 TO LOOK AT (fuzz:crash)" "some artifacts in $fold_logs/$1/artifacts" \
            "$fold_logs/$1" >"$fold_logs/latest"
    }
    fold() {
        PATH="$no_mise:$cargo_here:$PATH" RCAD_FUZZ_LOGS="$fold_logs" RCAD_FUZZ_CORPUS="$fold_corpus" TMPDIR="$dir/tmp" \
            {{ just_executable() }} --justfile "{{ justfile() }}" --working-directory "$tree" \
            fuzz-triage "$@" 2>&1
    }

    # Eleven: a night's passing files leave `fuzz/artifacts/` once the merge
    # has read them whole, and the one that takes a new path joins the corpus.
    seen=$(printf 'already in the corpus' | sha1sum | cut -d' ' -f1)
    printf 'already in the corpus' >"$fold_corpus/$reader/$seen"
    new_path=$(put "$reader" 'this one takes a new path')
    no_path=$(put "$reader" 'this one adds no path')
    slow=$(put "$reader" 'this one runs past ten seconds')
    older=$(put "$reader" 'this one crashes the night binary')
    failing=$(put "$surfaces" 'not a real crash input')
    main_sha=$(git -C "$tree" rev-parse HEAD)
    a_night 2026-10-12 "$(git -C "$tree" rev-parse --short HEAD)"
    got=$(fold) || fail "a night with files to fold made the triage itself fail"
    grep -q "^fold:     $reader: 4 passed, 2 folded (1 kept by the merge), 2 left for the next morning$" <<<"$got" \
        || fail "the fold did not say per target how many it folded, how many the merge kept, and how many stay"
    [ ! -e "$tree/fuzz/artifacts/$reader/$new_path" ] && [ ! -e "$tree/fuzz/artifacts/$reader/$no_path" ] \
        || fail "a file the replay saw pass and the merge read whole is still in fuzz/artifacts/"
    [ -f "$tree/fuzz/artifacts/$reader/$slow" ] && [ -f "$tree/fuzz/artifacts/$reader/$older" ] \
        || fail "a file the merge did not read to the end, because it crashed the night's binary or ran past ten seconds, left fuzz/artifacts/"
    [ -f "$tree/fuzz/artifacts/$surfaces/$failing" ] || fail "a file that still fails on main left fuzz/artifacts/"
    [ ! -e "$bin/$surfaces.calls" ] || fail "a file that still fails on main was handed to the merge"
    [ -f "$fold_logs/2026-10-12/artifacts/$reader/$new_path" ] \
        || fail "the night's own copy of a folded file was removed, and a row naming it could no longer replay it"
    left_behind=$(cd "$tree" && find . -path ./.git -prune -o -type f \( -name 'crash-*' -o -name 'timeout-*' \) -print | LC_ALL=C sort)
    expected=$(printf '%s\n' "./fuzz/artifacts/$reader/$older" "./fuzz/artifacts/$reader/$slow" \
        "./fuzz/artifacts/$surfaces/$failing" | LC_ALL=C sort)
    [ "$left_behind" = "$expected" ] \
        || fail "the merge wrote a crash or a timeout into the tree, where the next night would carry it as found: $left_behind"
    calls=$(cat "$bin/$reader.calls")
    [ "$(grep -c . <<<"$calls")" = 1 ] || fail "the night's binary was not run once for the one target with passing files"
    grep -q -- '-merge=1 ' <<<"$calls" || fail "the fold did not run a -merge=1"
    grep -q -- '-timeout=10 ' <<<"$calls" || fail "the merge was not given -timeout=10"
    grep -q -- "-artifact_prefix=$dir/" <<<"$calls" && ! grep -q -- "-artifact_prefix=$tree" <<<"$calls" \
        || fail "what libFuzzer writes during the merge was not sent to a scratch directory: $calls"
    merge_dirs=$(tr ' ' '\n' <<<"$calls" | grep -v '^-')
    [ "$(grep -c . <<<"$merge_dirs")" = 2 ] \
        || fail "the merge was handed more than the copy of the corpus and the passing files: $merge_dirs"
    grep -q "^$fold_corpus/$reader-fold-tmp\." <<<"$(head -1 <<<"$merge_dirs")" \
        || fail "the merge wrote into something other than a copy of the corpus: $merge_dirs"
    [ "$(ls -A "$fold_corpus/$reader" | LC_ALL=C sort)" = "$(printf '%s\n' "$seen" "${new_path#crash-}" | LC_ALL=C sort)" ] \
        || fail "the corpus does not hold what it held and the one file that took a new path: $(ls -A "$fold_corpus/$reader")"
    [ "$(ls -A "$fold_corpus")" = "$reader" ] || fail "the copy the merge wrote into was left beside the corpus"
    [ -z "$(ls -A "$dir/tmp")" ] || fail "the fold left its scratch behind: $(ls -A "$dir/tmp")"
    [ "$(head -1 "$record")" = "$(printf 'night\ttarget\tfile\treplayed_main\tkept')" ] \
        || fail "the record of removed files does not name its five columns"
    [ "$(tail -n +2 "$record" | LC_ALL=C sort)" = "$(printf '2026-10-12\t%s\t%s\t%s\t%s\n' \
        "$reader" "$new_path" "$main_sha" yes "$reader" "$no_path" "$main_sha" no | LC_ALL=C sort)" ] \
        || fail "the record does not give each removed file's night, target, name, replayed main and whether it was kept: $(cat "$record")"

    # Twelve: a kept file named for no crash file's hash was cut on the way in
    # and is another input, so nothing of that target's merge is let in.
    cut_short=$(put "$reader" 'this one is cut by the merge')
    corpus_before=$(ls -A "$fold_corpus/$reader")
    record_before=$(cat "$record")
    a_night 2026-10-13 "$(git -C "$tree" rev-parse --short HEAD)"
    got=$(fold) || fail "a merge that cut an input made the triage itself fail"
    grep -q "^fold:     $reader: none — the merge kept 1 file(s) named for no crash file it read whole" <<<"$got" \
        || fail "a kept file not named for its crash file's hash was let into the corpus"
    [ "$(ls -A "$fold_corpus/$reader")" = "$corpus_before" ] || fail "a merge that cut an input still replaced the corpus"
    [ -f "$tree/fuzz/artifacts/$reader/$cut_short" ] || fail "a file the merge cut left fuzz/artifacts/"
    [ "$(cat "$record")" = "$record_before" ] || fail "a fold that let nothing in still wrote to the record"
    rm "$tree/fuzz/artifacts/$reader/$cut_short"

    # Thirteen: a merge that fails leaves the corpus as it was, since it wrote
    # into a copy, and every passing file stays for the next morning.
    broken=$(put "$reader" 'this one fails the whole merge')
    a_night 2026-10-14 "$(git -C "$tree" rev-parse --short HEAD)"
    got=$(fold) || fail "a merge that failed made the triage itself fail"
    grep -q "^fold:     $reader: none — the merge failed (exit 1)" <<<"$got" || fail "a failed merge was not reported"
    [ "$(ls -A "$fold_corpus/$reader")" = "$corpus_before" ] || fail "a merge that failed still changed the corpus"
    [ "$(ls -A "$fold_corpus")" = "$reader" ] || fail "the copy a failed merge wrote into was left beside the corpus"
    [ -f "$tree/fuzz/artifacts/$reader/$broken" ] || fail "a file left fuzz/artifacts/ though the merge failed"
    [ "$(cat "$record")" = "$record_before" ] || fail "a failed merge still wrote to the record"

    # Fourteen: a target whose every file folds keeps its directory, which
    # fuzz-yield's nearest earlier night needs (§434.5), and the record grows
    # by a line rather than being written again.
    rm "$tree/fuzz/artifacts/$reader/$broken" "$tree/fuzz/artifacts/$reader/$slow" \
        "$tree/fuzz/artifacts/$reader/$older"
    last=$(put "$reader" 'the last of them, and it adds no path')
    a_night 2026-10-15 "$(git -C "$tree" rev-parse --short HEAD)"
    got=$(fold) || fail "a fold that empties a target made the triage itself fail"
    grep -q "^fold:     $reader: 1 passed, 1 folded (0 kept by the merge), 0 left for the next morning$" <<<"$got" \
        || fail "the last of a target's files did not fold"
    [ -d "$tree/fuzz/artifacts/$reader" ] || fail "a target whose every file folded lost its directory"
    [ "$(head -n 3 "$record")" = "$record_before" ] || fail "the record was written again rather than appended to"
    [ "$(tail -n 1 "$record")" = "$(printf '2026-10-15\t%s\t%s\t%s\tno' "$reader" "$last" "$main_sha")" ] \
        || fail "the second fold's file was not appended to the record"

    # Fifteen: a night that is not the latest, a night whose targets did not
    # build, a tree not on the night's commit, and a replay of anything but
    # main fold nothing, and each says why.
    stays=$(put "$reader" 'a passing file that must stay')
    a_night 2026-10-16 "$(git -C "$tree" rev-parse --short HEAD)"
    got=$(fold "$fold_logs/2026-10-15") || fail "an older night made the triage itself fail"
    grep -q "^fold:     none — .* describes another night" <<<"$got" || fail "a night that is not the latest was folded"
    grep -qxF "refusals: none — $fold_corpus/two_solids_fused_by_a_stranger is not there" <<<"$got" \
        || fail "a morning that folds nothing skipped the refusal replay, which runs before the fold"
    a_night 2026-10-17 BUILD
    got=$(fold) || fail "a night that did not build made the triage itself fail"
    grep -q "^fold:     none — the night's targets did not build" <<<"$got" \
        || fail "a night whose targets did not build was folded"
    a_night 2026-10-18 "$(git -C "$tree" rev-parse --short HEAD)"
    commit "main moves on, and this tree with it"
    got=$(fold) || fail "a tree off the night's commit made the triage itself fail"
    grep -q "^fold:     none — this tree stands on" <<<"$got" || fail "a tree not on the night's commit was folded"
    git -C "$tree" checkout -q --detach HEAD~1
    got=$(fold "" HEAD) || fail "a replay of HEAD made the triage itself fail"
    grep -q "^fold:     none — this replayed HEAD, not main" <<<"$got" || fail "a replay of something other than main was folded"
    [ -f "$tree/fuzz/artifacts/$reader/$stays" ] || fail "a night that folds nothing removed a file"
    [ "$(tail -n 1 "$record")" = "$(printf '2026-10-15\t%s\t%s\t%s\tno' "$reader" "$last" "$main_sha")" ] \
        || fail "a night that folds nothing wrote to the record"

    # Sixteen: when the members file and the replay's own list name files in
    # different forms, every failing file would look like a passing one. The
    # verdicts' count of passing files is checked against it, and a target
    # where they differ folds nothing.
    git -C "$tree" checkout -q main
    printf '#!/bin/sh\n(cd "%s" && PATH="%s" exec cargo "$@") || exit $?\nwhile [ $# -gt 1 ]; do [ "$1" = --members ] && sed -i "s|\\t/|\\t//|" "$2"; shift; done\n' \
        "$PWD" "$PATH" >"$cargo_here/cargo"
    a_night 2026-10-19 "$(git -C "$tree" rev-parse --short HEAD)"
    got=$(fold) || fail "a members file in another form made the triage itself fail"
    grep -q "^fold:     $surfaces: none — the verdicts say 0 passed and the members file leaves 1" <<<"$got" \
        || fail "a members file naming files in another form than the replay's let a failing file look like a passing one"
    [ -f "$tree/fuzz/artifacts/$surfaces/$failing" ] && [ ! -e "$bin/$surfaces.calls" ] \
        || fail "a file that still fails on main was folded"

    # Seventeen: a morning hands the merge at most RCAD_FUZZ_FOLD_AT_MOST of a
    # target's passing files, and the rest stay for the next morning. Without
    # the cap the writer's first fold, 68 013 files, runs past the service's
    # four hours and is killed every morning with nothing folded (§434.7).
    printf '#!/bin/sh\ncd "%s" && PATH="%s" exec cargo "$@"\n' "$PWD" "$PATH" >"$cargo_here/cargo"
    find "$tree/fuzz/artifacts/$reader" -type f -delete
    put "$reader" 'the first of three, and it adds no path' >/dev/null
    put "$reader" 'the second of three, and it adds no path' >/dev/null
    put "$reader" 'the third of three, and it adds no path' >/dev/null
    a_night 2026-10-20 "$(git -C "$tree" rev-parse --short HEAD)"
    if got=$(RCAD_FUZZ_FOLD_AT_MOST=0 fold); then
        fail "a cap of 0 was taken, and a fold with nothing to merge would pass for a fold that ran"
    fi
    grep -q "^fold:     none — RCAD_FUZZ_FOLD_AT_MOST is '0'" <<<"$got" || fail "a cap of 0 was refused without saying so"
    [ "$(find "$tree/fuzz/artifacts/$reader" -type f | grep -c .)" = 3 ] || fail "a refused cap still moved files"
    got=$(RCAD_FUZZ_FOLD_AT_MOST=2 fold) || fail "a fold past its cap made the triage itself fail"
    grep -q "^fold:     $reader: 3 passed, 2 folded (0 kept by the merge), 1 left for the next morning$" <<<"$got" \
        || fail "a morning handed the merge more passing files than RCAD_FUZZ_FOLD_AT_MOST, so the first fold would never end inside the service's four hours"
    [ "$(find "$tree/fuzz/artifacts/$reader" -type f | grep -c .)" = 1 ] \
        || fail "the file past the cap did not stay in fuzz/artifacts/ for the next morning"

    # Eighteen: the fuse fuzzer's corpus is replayed for its refusals on a night
    # with no crash file too (§437.5), every file of it in one call, into a file
    # whose counts add up both ways; and the next night names each group that
    # came or went since the latest night before it with such a file. The
    # checked-in corpus stands in for the night's: it meets refusals of many
    # kinds, and the whole of it replays in under a second.
    triage_corpus="$PWD/fuzz/corpus"
    fuse_corpus="$triage_corpus/two_solids_fused_by_a_stranger"
    corpus_files=$(find "$fuse_corpus" -maxdepth 1 -type f | grep -c .)
    first_night="$logs/2026-09-20"
    mkdir -p "$first_night"
    got=$(triage "$first_night") || fail "a night with a corpus to replay and no crash file made the triage itself fail"
    grep -qF "inputs:   none" <<<"$got" || fail "a night that kept no crash file did not say so"
    [ ! -e "$first_night/fuzz-triage-verdicts.tsv" ] \
        || fail "a night with no crash file got a verdict file for the refusal replay's sake"
    calls=$(grep -c "cargo run -q --profile test -p rcad-fuzz-explain -- --refusals $fuse_corpus " <<<"$got" || true)
    [ "$calls" = 1 ] || fail "the corpus cost $calls replay call(s), not the one it is replayed in"
    refusals_file="$first_night/fuzz-refusals.tsv"
    [ -f "$refusals_file" ] || fail "no fuzz-refusals.tsv landed in the night's own directory"
    [ "$(head -1 "$refusals_file")" = "$(printf 'variant\tkey\trefusals\tfiles\tcertified\ttolerant\tfirst_way_round\tother_way_round\tsample\tclass')" ] \
        || fail "fuzz-refusals.tsv's header does not name the ten columns of §437.5 and §437.6"
    groups=$(tail -n +2 "$refusals_file" | grep -c . || true)
    [ "$groups" -gt 0 ] || fail "the checked-in corpus met no refusal, and every_model_the_fuse_fuzzer_kept_is_fused_again says it meets many"
    not_adding_up=$(awk -F'\t' 'NR > 1 && (NF != 10 || $5 + $6 != $3 || $7 + $8 != $3 || $4 < 1 || $4 > $3)' "$refusals_file")
    [ -z "$not_adding_up" ] \
        || fail "a group's certified and tolerant, or its two ways round, do not add up to its refusals: $not_adding_up"
    while IFS= read -r sample; do
        [ "$(dirname "$sample")" = "$fuse_corpus" ] && [ -f "$sample" ] \
            || fail "a group's sample is not a file of the corpus it came from: $sample"
    done < <(tail -n +2 "$refusals_file" | cut -f9)
    refusals=$(awk -F'\t' 'NR > 1 { n += $3 } END { print n + 0 }' "$refusals_file")
    grep -q "^          $corpus_files files replayed, $refusals refusals in [0-9]* files, $groups groups, " <<<"$got" \
        || fail "the replay's own tally did not say every one of the corpus's $corpus_files files was replayed, into the $refusals refusals and $groups groups of fuzz-refusals.tsv"
    [ "$(head -1 "$first_night/fuzz-refusals-faults.tsv")" = "$(printf 'fault\tfile\tsaid')" ] \
        || fail "fuzz-refusals-faults.tsv's header does not name its three columns"
    grep -qx 'since:    no night before 2026-09-20 has a fuzz-refusals.tsv, so there is nothing to compare' <<<"$got" \
        || fail "the first night with a fuzz-refusals.tsv was compared with something"

    dropped=$(tail -n 1 "$refusals_file")
    { head -n -1 "$refusals_file"; printf 'NoSuchRefusal\tnever\t1\t1\t1\t0\t1\t0\tnowhere\n'; } >"$dir/edited"
    mv "$dir/edited" "$refusals_file"
    second_night="$logs/2026-09-21"
    mkdir -p "$second_night"
    got=$(triage "$second_night") || fail "a second night's refusal replay made the triage itself fail"
    grep -qx 'since:    2026-09-20' <<<"$got" || fail "the second night was not compared with the night before it"
    grep -qxF "$(awk -F'\t' '{ print "appeared: " $1 ": " $2 " (" $3 " refusals in " $4 " file(s), " $9 ")" }' <<<"$dropped")" <<<"$got" \
        || fail "a group the night before did not have was not named as appeared: $dropped"
    grep -qxF 'vanished: NoSuchRefusal: never (1 refusals in 1 file(s) on 2026-09-20)' <<<"$got" \
        || fail "a group the night before had and this night did not was not named as vanished"
    [ "$(grep -c '^appeared: \|^vanished: ' <<<"$got")" = 2 ] \
        || fail "a group both nights had was named as having come or gone"

    third_night="$logs/2026-09-22"
    mkdir -p "$third_night"
    got=$(triage "$third_night") || fail "a third night's refusal replay made the triage itself fail"
    grep -qx 'since:    2026-09-21, no group appeared or vanished' <<<"$got" \
        || fail "a night was not compared with the latest night before it, or two nights alike were said to differ"

# Each timer's two unit files are tracked here and **copied** into
# `~/.config/systemd/user/`. That is two records of one thing, which §60 says is
# the shape to delete, and on 2026-09-15 it had a price: the night lost eight
# hours to a `cargo` that was not on its PATH, and the fix for that lands in
# `tooling/systemd/` where systemd will never read it. Nothing made the two
# agree and neither file said whether anyone had.
#
# **An installed copy must match the tracked one; a machine with no installed
# copy is not checked.** Almost nowhere runs the night — a runner has no
# `~/.config/systemd/user` at all — so absence is the ordinary case and not a
# finding.
#
# The gap that leaves is named rather than claimed away: this cannot tell a
# machine that never installed the timer from one where the installed file was
# removed, because both look the same from here and only the second is a
# problem. What it does catch is the case that cost the night — installed, and
# behind the tree.
#
# **Half an install is a failure, not an absence.** The pair goes in together;
# one of the two on disk means somebody copied by hand and stopped, which is the
# same mistake this recipe exists for, one file earlier.
#
# **Every pair in `tooling/systemd/` is read, and each is its own install.**
# There were two by §371, the overnight fuzz and the hourly `clean-targets`, so
# the names come from the directory rather than from a list here that a third
# timer would have to remember to join.
[doc("Every installed rcad timer is the one tracked in tooling/systemd.")]
check-systemd-units tracked="tooling/systemd":
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob
    names=$(for file in "{{tracked}}"/*.service "{{tracked}}"/*.timer; do
        base=$(basename "$file")
        echo "${base%.*}"
    done | LC_ALL=C sort -u)
    [ -n "$names" ] || { echo "there is no unit in {{tracked}} to compare anything against"; exit 1; }

    failed=0
    for name in $names; do
        for unit in "$name.service" "$name.timer"; do
            [ -f "{{tracked}}/$unit" ] \
                || { echo "{{tracked}} has $name but no $unit beside it"; exit 1; }
        done
        reinstall="cp {{tracked}}/$name.service {{tracked}}/$name.timer {{systemd_user_dir}}/ && systemctl --user daemon-reload"

        present=""
        missing=""
        for unit in "$name.service" "$name.timer"; do
            if [ -f "{{systemd_user_dir}}/$unit" ]; then
                present="$present $unit"
            else
                missing="$missing $unit"
            fi
        done
        if [ -z "$present" ]; then
            echo "no $name timer installed under {{systemd_user_dir}}, so there is nothing to drift"
            continue
        fi
        if [ -n "$missing" ]; then
            echo "half of the $name timer is installed under {{systemd_user_dir}}:"
            echo "  there:$present"
            echo "  not there:$missing"
            echo "the pair goes in together; copy both and reload:"
            echo "    $reinstall"
            failed=1
            continue
        fi

        drifted=""
        for unit in "$name.service" "$name.timer"; do
            cmp -s "{{tracked}}/$unit" "{{systemd_user_dir}}/$unit" || drifted="$drifted $unit"
        done
        if [ -n "$drifted" ]; then
            for unit in $drifted; do
                echo "installed $unit is not {{tracked}}/$unit:"
                diff -u "{{systemd_user_dir}}/$unit" "{{tracked}}/$unit" | sed 's/^/    /' || true
            done
            echo "systemd runs the installed copy, so the tree is not what fires next:"
            echo "    $reinstall"
            failed=1
            continue
        fi
        echo "the installed $name timer matches {{tracked}}"
    done
    [ "$failed" -eq 0 ]

# Pins `check-systemd-units` against installs this builds itself, because the one
# case that matters cannot be arranged on the machine running the gate without
# breaking that machine's timer.
#
# **Each arm asserts the sentence its case produces, not the exit code.** A
# recipe that always failed would satisfy the two failing arms and nothing else;
# a recipe that always passed would satisfy the two passing ones. The pair of
# them together is what says it is reading the files.
[private]
check-systemd-units-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    work=$(mktemp -d -- "${TMPDIR:-/tmp}/rcad-systemd-units-selftest.XXXXXX")
    trap 'rm -rf -- "$work"' EXIT

    tracked="$work/tracked"
    installed="$work/installed"
    mkdir -p "$tracked" "$installed"
    printf '[Service]\nEnvironment=PATH=%%h/.cargo/bin:/usr/bin\n' >"$tracked/rcad-fuzz.service"
    printf '[Timer]\nOnCalendar=*-*-* 00:10:00\n' >"$tracked/rcad-fuzz.timer"

    failed=0
    check() {
        local name=$1 want_rc=$2 needle=$3
        local out rc=0
        out=$(RCAD_SYSTEMD_USER="$installed" \
            {{ just_executable() }} check-systemd-units "$tracked" 2>&1) || rc=$?
        if [ "$rc" -ne "$want_rc" ]; then
            echo "check-systemd-units drifted from its own fixtures: $name wanted exit $want_rc, got $rc"
            sed 's/^/    /' <<<"$out"
            failed=1
            return
        fi
        if ! grep -qF -- "$needle" <<<"$out"; then
            echo "check-systemd-units drifted from its own fixtures: $name did not say \"$needle\""
            sed 's/^/    /' <<<"$out"
            failed=1
        fi
    }

    # One: nothing installed. The ordinary case on every machine but this one,
    # and on every runner, so it has to pass and say why rather than pass in
    # silence that would look the same as a match.
    check "nothing installed" 0 "so there is nothing to drift"

    # Two: half of it. The pair goes in together.
    cp "$tracked/rcad-fuzz.service" "$installed/"
    check "half installed" 1 "not there: rcad-fuzz.timer"

    # Three: both, byte for byte. The passing case.
    cp "$tracked/rcad-fuzz.timer" "$installed/"
    check "installed and equal" 0 "matches"

    # Four: installed, and behind the tree. This is the night of 2026-09-15 —
    # the fix sitting in `tooling/systemd/` while systemd runs the old copy — so
    # the arm asserts the unit's name and the line that differs, not just a
    # non-zero exit.
    printf '[Service]\n' >"$installed/rcad-fuzz.service"
    check "installed and stale" 1 "installed rcad-fuzz.service is not"
    check "installed and stale names the missing line" 1 "Environment=PATH="
    cp "$tracked/rcad-fuzz.service" "$installed/"

    # Five: a second timer, not installed beside a first that matches. Each pair
    # is its own install, so a machine that runs one and not the other passes.
    printf '[Service]\nExecStart=just clean-targets\n' >"$tracked/rcad-clean-targets.service"
    printf '[Timer]\nOnCalendar=hourly\n' >"$tracked/rcad-clean-targets.timer"
    check "second timer not installed" 0 "no rcad-clean-targets timer installed"
    check "second timer not installed, first still read" 0 "the installed rcad-fuzz timer matches"

    # Six: the second timer installed and behind the tree. A check that read only
    # the first pair passes here, and this is the arm §371 added it for.
    cp "$tracked/rcad-clean-targets.service" "$installed/"
    printf '[Timer]\nOnCalendar=daily\n' >"$installed/rcad-clean-targets.timer"
    check "second timer stale" 1 "installed rcad-clean-targets.timer is not"
    check "second timer stale names the line" 1 "OnCalendar=hourly"

    # Seven: a service tracked with no timer beside it is half a pair in the tree.
    printf '[Service]\n' >"$tracked/rcad-alone.service"
    check "service with no timer" 1 "no rcad-alone.timer beside it"

    [ "$failed" -eq 0 ]

# `fuzz-triage` with no argument replays the night `latest` names, and `latest`
# is written when a night finishes. A replay that starts while the night still
# runs reads the night before instead, and every morning's verdicts are then a
# day behind with nothing to say so. This holds the triage timer's hour clear of
# the night's hard stop, and its own backstop clear of the next night (§410).
#
# **The hard stop is a sum, read out of the files:** the timer's hour, plus its
# `AccuracySec=` (systemd's one minute when unset) and `RandomizedDelaySec=`,
# plus the service's `TimeoutStartSec=` and `TimeoutStopSec=`. The replay's end
# is the same sum over its own pair. Both are counted from the night's start, so
# a night that crosses midnight needs no case of its own.
#
# **What it cannot read, it refuses.** An `OnCalendar=` that is not one time
# every day, a span in a unit it does not know, a missing timeout, a key written
# twice: each fails naming the line, because a guess here is a pass that holds
# nothing. So does `Persistent=true` on either timer, since a catch-up run fires
# at boot, at an hour no line here says.
[doc("The morning's fuzz triage timer fires after the night's hard stop and ends before the next night.")]
check-triage-waits-for-the-night tracked="tooling/systemd":
    #!/usr/bin/env bash
    set -euo pipefail

    # What `key=` is set to in a unit file, or nothing. systemd adds up a key
    # like `OnCalendar=` written twice and keeps the last of most others, so
    # reading one of them would be a guess either way.
    value() {
        local file=$1 key=$2 count
        count=$(grep -cE "^[[:space:]]*$key[[:space:]]*=" "$file" || true)
        [ "$count" -le 1 ] || { echo "$file sets $key= $count times, and this reads one"; exit 1; }
        sed -nE "s/^[[:space:]]*$key[[:space:]]*=[[:space:]]*(.*[^[:space:]])?[[:space:]]*\$/\1/p" "$file"
    }

    # A span in seconds: a bare number, or a number of s, min or h. systemd
    # reads `8h 10min` and `infinity` too, and this refuses both.
    seconds() {
        local file=$1 key=$2 default=${3:-} span
        span=$(value "$file" "$key") || { echo "$span"; exit 1; }
        if [ -z "$span" ]; then
            [ -n "$default" ] || { echo "$file sets no $key=, and this adds up only what is written"; exit 1; }
            span=$default
        fi
        [[ "$span" =~ ^([0-9]+)(s|min|h)?$ ]] \
            || { echo "$file: $key=$span is a span this cannot read; write seconds, or one number of s, min or h"; exit 1; }
        case "${BASH_REMATCH[2]}" in
            "" | s) echo $((10#${BASH_REMATCH[1]})) ;;
            min) echo $((10#${BASH_REMATCH[1]} * 60)) ;;
            h) echo $((10#${BASH_REMATCH[1]} * 3600)) ;;
        esac
    }

    # Seconds after midnight, for the one `OnCalendar=` form that fires once a day.
    at() {
        local file=$1 cal daily='^\*-\*-\* ([0-9]{2}):([0-9]{2})(:([0-9]{2}))?$'
        cal=$(value "$file" OnCalendar) || { echo "$cal"; exit 1; }
        [[ "$cal" =~ $daily ]] \
            || { echo "$file: OnCalendar=$cal is not one time every day (*-*-* HH:MM:SS), and this reads no other form"; exit 1; }
        echo $((10#${BASH_REMATCH[1]} * 3600 + 10#${BASH_REMATCH[2]} * 60 + 10#${BASH_REMATCH[4]:-0}))
    }

    # The longest a run can last past its timer's hour: how late the timer may
    # fire, then how long the service may take to start and to stop.
    runs_for() {
        local unit=$1 late spread start stop
        late=$(seconds "$unit.timer" AccuracySec 1min) || { echo "$late"; exit 1; }
        spread=$(seconds "$unit.timer" RandomizedDelaySec 0) || { echo "$spread"; exit 1; }
        start=$(seconds "$unit.service" TimeoutStartSec) || { echo "$start"; exit 1; }
        stop=$(seconds "$unit.service" TimeoutStopSec) || { echo "$stop"; exit 1; }
        echo $((late + spread + start + stop))
    }

    clock() {
        printf '%02d:%02d:%02d' $(($1 / 3600 % 24)) $(($1 / 60 % 60)) $(($1 % 60))
    }

    night="{{tracked}}/rcad-fuzz"
    triage="{{tracked}}/rcad-fuzz-triage"
    for unit in "$night.service" "$night.timer" "$triage.service" "$triage.timer"; do
        [ -f "$unit" ] || { echo "$unit is not there, so there is no morning to hold clear of the night"; exit 1; }
    done

    for timer in "$night.timer" "$triage.timer"; do
        persistent=$(value "$timer" Persistent) || { echo "$persistent"; exit 1; }
        case "$persistent" in
            "" | 0 | no | false | off) ;;
            *)
                echo "$timer sets Persistent=$persistent: a catch-up run fires at boot, whatever the hour, and no sum here bounds it"
                exit 1
                ;;
        esac
    done

    night_at=$(at "$night.timer") || { echo "$night_at"; exit 1; }
    night_end=$(runs_for "$night") || { echo "$night_end"; exit 1; }
    triage_clock=$(at "$triage.timer") || { echo "$triage_clock"; exit 1; }
    triage_runs=$(runs_for "$triage") || { echo "$triage_runs"; exit 1; }
    triage_at=$(( (triage_clock - night_at + 86400) % 86400 ))
    triage_end=$((triage_at + triage_runs))

    if [ "$triage_at" -lt "$night_end" ]; then
        echo "the night can run until $(clock $((night_at + night_end))), and the triage timer fires at $(clock "$triage_clock")"
        echo "a replay started then reads the night before's latest, so every morning's verdicts would be a day behind"
        exit 1
    fi
    if [ "$triage_end" -gt 86400 ]; then
        echo "the triage can run until $(clock $((night_at + triage_end))), past the next night's start at $(clock "$night_at")"
        exit 1
    fi
    echo "the triage timer fires at $(clock "$triage_clock"), after the night's hard stop at $(clock $((night_at + night_end))), and is stopped by $(clock $((night_at + triage_end))), before the next night at $(clock "$night_at")"

# Pins `check-triage-waits-for-the-night` against unit files this writes itself,
# so each way the morning can land on the night is tried without touching the
# real timers. Each arm asserts the sentence its case produces, for the reason
# `check-systemd-units-selftest` gives: an always-failing check passes every
# failing arm, and only the passing arms catch it.
[private]
check-triage-waits-for-the-night-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    work=$(mktemp -d -- "${TMPDIR:-/tmp}/rcad-triage-waits-selftest.XXXXXX")
    trap 'rm -rf -- "$work"' EXIT
    tracked="$work/tracked"
    mkdir -p "$tracked"

    units() {
        printf '[Timer]\nOnCalendar=*-*-* 00:10:00\nPersistent=false\nAccuracySec=1min\n' >"$tracked/rcad-fuzz.timer"
        printf '[Service]\nTimeoutStartSec=29400\nTimeoutStopSec=120\n' >"$tracked/rcad-fuzz.service"
        printf '[Timer]\nOnCalendar=*-*-* 08:30:00\nPersistent=false\n' >"$tracked/rcad-fuzz-triage.timer"
        printf '[Service]\nTimeoutStartSec=14400\nTimeoutStopSec=120\n' >"$tracked/rcad-fuzz-triage.service"
    }

    failed=0
    check() {
        local name=$1 want_rc=$2 needle=$3
        local out rc=0
        out=$({{ just_executable() }} check-triage-waits-for-the-night "$tracked" 2>&1) || rc=$?
        if [ "$rc" -ne "$want_rc" ]; then
            echo "check-triage-waits-for-the-night drifted from its own fixtures: $name wanted exit $want_rc, got $rc"
            sed 's/^/    /' <<<"$out"
            failed=1
            return
        fi
        if ! grep -qF -- "$needle" <<<"$out"; then
            echo "check-triage-waits-for-the-night drifted from its own fixtures: $name did not say \"$needle\""
            sed 's/^/    /' <<<"$out"
            failed=1
        fi
    }

    # One: the units as tracked. 00:10, plus a minute of AccuracySec, plus
    # 29400 s and 120 s, is 08:23:00. The triage timer sets no AccuracySec, so
    # its minute is systemd's default: 08:30 plus 60, 14400 and 120 s is 12:33.
    units
    check "08:30" 0 "fires at 08:30:00, after the night's hard stop at 08:23:00, and is stopped by 12:33:00"

    # Two: inside the night's backstop, which is the morning a day behind.
    sed -i 's/08:30:00/08:15:00/' "$tracked/rcad-fuzz-triage.timer"
    check "08:15 names the night's stop" 1 "the night can run until 08:23:00"
    check "08:15 names its own hour" 1 "the triage timer fires at 08:15:00"

    # Three: one minute is the difference. 08:22 is before the stop that the
    # AccuracySec minute moves to 08:23; a sum that left it out would pass this.
    units
    sed -i 's/08:30:00/08:22:00/' "$tracked/rcad-fuzz-triage.timer"
    check "08:22 is inside the AccuracySec minute" 1 "the night can run until 08:23:00"

    # Four: a backstop that runs into the next night.
    units
    sed -i 's/TimeoutStartSec=14400/TimeoutStartSec=16h/' "$tracked/rcad-fuzz-triage.service"
    check "a sixteen-hour backstop" 1 "past the next night's start at 00:10:00"

    # Five: a night that crosses midnight is counted from its own start. 22:00
    # plus 29580 s is 06:13 the next day, and 06:30 is after it.
    units
    sed -i 's/00:10:00/22:00:00/' "$tracked/rcad-fuzz.timer"
    sed -i 's/08:30:00/06:30:00/' "$tracked/rcad-fuzz-triage.timer"
    check "a night across midnight" 0 "after the night's hard stop at 06:13:00"

    # Six: forms this does not read are refused, not guessed at.
    units
    sed -i 's/^OnCalendar=.*/OnCalendar=daily/' "$tracked/rcad-fuzz-triage.timer"
    check "OnCalendar=daily" 1 "OnCalendar=daily is not one time every day"
    units
    sed -i 's/TimeoutStartSec=14400/TimeoutStartSec=infinity/' "$tracked/rcad-fuzz-triage.service"
    check "an unbounded triage" 1 "TimeoutStartSec=infinity is a span this cannot read"
    units
    sed -i '/TimeoutStopSec/d' "$tracked/rcad-fuzz.service"
    check "a missing timeout" 1 "sets no TimeoutStopSec="
    units
    printf 'OnCalendar=*-*-* 04:00:00\n' >>"$tracked/rcad-fuzz-triage.timer"
    check "a second OnCalendar" 1 "sets OnCalendar= 2 times"

    # Seven: a catch-up run starts at boot, at no hour the files say.
    units
    sed -i 's/Persistent=false/Persistent=true/' "$tracked/rcad-fuzz-triage.timer"
    check "Persistent=true" 1 "sets Persistent=true"

    # Eight: no triage pair at all, which is the tree before §410.
    units
    rm "$tracked/rcad-fuzz-triage.timer"
    check "no triage timer" 1 "rcad-fuzz-triage.timer is not there"

    [ "$failed" -eq 0 ]

# Q146: which target finds the most per core-hour, read straight off the logs
# `fuzz-overnight` already writes, with no new state of its own kept anywhere.
# `docs/decisions.md` §265 is the analysis this reproduces; §265.4's coverage
# table came from a scratch script, and this recipe is that script folded into
# the house shape. `tooling/fuzz-yield/log_stats.py` holds the arithmetic for
# one log — runs, coverage at start/30m/end, the hour it last rose — kept in
# its own file because that half a plain Python test can cover without a
# fixture night on disk. `tooling/fuzz-yield/nights.py` holds which artifact
# files are new on a night and how Q147's verdicts fold in, and says why each
# rule is the one it is; the queue page reads a night through the same two
# files, so the page and this report cannot disagree about it. This recipe
# holds the shell around them: which nights, which files, and whether the code
# changed.
#
# **Whether a target's code changed since the night before** (Q232,
# `docs/decisions.md` §298.2) is answered from the *build* worktree, not the
# log directory: `fuzz-overnight` builds each night in
# `/home/mattias/git/mattiasgronlund/rcad-nightly-fuzz` (overridable through
# `RCAD_NIGHTLY_FUZZ_WORKTREE`, which is how `check-fuzz-yield-selftest`
# points this at a fixture repo it builds itself), whose reflog carries one
# `checkout` per night around 00:10-00:16 — the time window is what tells a
# real nightly build apart from someone's daytime `git checkout` in that same
# worktree, which the reflog also carries and which is not a night's build.
# "Changed" is `git diff --name-only <prev-night> <this-night> -- crates
# fuzz` touching the target's own `fuzz/fuzz_targets/<target>.rs`, the one
# shared file it `#[path]`-includes, or `src/` of any crate in its
# `docs/decisions.md` §298.1 row — that table is copied here as
# `target_shared_file`/`target_crates` because this recipe cannot read a
# decisions file at run time; a new target or a new crate dependency has to
# be added to §298.1 *and* to these two tables, or this recipe silently keeps
# reading the old shape. A night the reflog does not show a checkout for, or
# whose night-before the reflog does not show, says `unknown` rather than
# guessing.
[doc("Per night, per target: core-hours, runs, coverage's start/30m/end, when it last rose, new files by kind, whether its code changed since the night before, and Q147's faults.")]
fuzz-yield from="" to="":
    #!/usr/bin/env bash
    set -uo pipefail
    export LC_ALL=C
    root='{{ fuzz_log_root }}'
    from='{{ from }}'
    to='{{ to }}'
    stats='{{ justfile_directory() }}/tooling/fuzz-yield/log_stats.py'
    nights_py='{{ justfile_directory() }}/tooling/fuzz-yield/nights.py'
    nightly_worktree="${RCAD_NIGHTLY_FUZZ_WORKTREE:-/home/mattias/git/mattiasgronlund/rcad-nightly-fuzz}"

    # `docs/decisions.md` §298.1's table, copied by hand: add a target or a new
    # crate dependency there first, then here.
    declare -A target_shared_file=(
        [where_two_surfaces_cross]="crates/rcad-geom/tests/fuzzing/mod.rs"
        [where_a_cone_or_a_torus_crosses]="crates/rcad-geom/tests/fuzzing/mod.rs"
        [no_step_file_makes_the_reader_panic]="crates/rcad-step/tests/fuzzing/reader.rs"
        [no_model_makes_the_writer_panic]="crates/rcad-step/tests/fuzzing/writer.rs"
        [two_solids_fused_by_a_stranger]="crates/rcad-topo/tests/fuzzing/fuse.rs"
    )
    declare -A target_crates=(
        [where_two_surfaces_cross]="rcad-geom rcad-predicates"
        [where_a_cone_or_a_torus_crosses]="rcad-geom rcad-predicates"
        [no_step_file_makes_the_reader_panic]="rcad-step rcad-topo rcad-mesh rcad-geom rcad-predicates"
        [no_model_makes_the_writer_panic]="rcad-step rcad-topo rcad-mesh rcad-geom rcad-predicates"
        [two_solids_fused_by_a_stranger]="rcad-topo rcad-mesh rcad-geom rcad-predicates"
    )

    # Memoizes one reflog walk per calendar date: `changed_status` asks for
    # both a night and the night before it, and a night is asked about once
    # per target.
    declare -A nightly_commit_for=()
    nightly_commit_for_night() {
        local night="$1"
        if [ -n "${nightly_commit_for[$night]+x}" ]; then
            printf '%s' "${nightly_commit_for[$night]}"
            return 0
        fi
        local line date hour minute sha found=""
        while IFS= read -r line; do
            if [[ "$line" =~ ^[0-9a-f]+[[:space:]]HEAD@\{([0-9]{4}-[0-9]{2}-[0-9]{2})\ ([0-9]{2}):([0-9]{2})\}:\ checkout:\ moving\ from\ [^[:space:]]+\ to\ ([0-9a-f]+)$ ]]; then
                date="${BASH_REMATCH[1]}"; hour="${BASH_REMATCH[2]}"; minute="${BASH_REMATCH[3]}"; sha="${BASH_REMATCH[4]}"
                # The 00:10-00:16 window is what `docs/decisions.md` §298.2
                # observed the nightly build's own checkout land in, as
                # opposed to a same-day manual `git checkout` in that same
                # worktree, which the reflog carries just as plainly.
                if [ "$date" = "$night" ] && [ "$hour" = "00" ] && [ "$minute" -ge 10 ] && [ "$minute" -le 16 ]; then
                    found="$sha"
                    break
                fi
            fi
        done < <(git -C "$nightly_worktree" reflog --date=format:'%Y-%m-%d %H:%M' 2>/dev/null)
        nightly_commit_for["$night"]="$found"
        printf '%s' "$found"
    }

    changed_status() {
        local night="$1" target="$2"
        local own_file="fuzz/fuzz_targets/$target.rs"
        local shared="${target_shared_file[$target]:-}"
        if [ -z "$shared" ]; then
            echo "unknown (not a target docs/decisions.md §298.1 names)"
            return
        fi
        if [ ! -e "$nightly_worktree/.git" ]; then
            echo "unknown (no nightly-fuzz worktree at $nightly_worktree)"
            return
        fi
        local this_sha prev_date prev_sha
        this_sha=$(nightly_commit_for_night "$night")
        if [ -z "$this_sha" ]; then
            echo "unknown (reflog shows no 00:10-00:16 checkout for $night)"
            return
        fi
        prev_date=$(date -d "$night -1 day" +%Y-%m-%d)
        prev_sha=$(nightly_commit_for_night "$prev_date")
        if [ -z "$prev_sha" ]; then
            echo "unknown (reflog shows no checkout for the night before, $prev_date)"
            return
        fi
        local diff f crate
        diff=$(git -C "$nightly_worktree" diff --name-only "$prev_sha" "$this_sha" -- crates fuzz 2>/dev/null)
        if [ -z "$diff" ]; then
            echo "no"
            return
        fi
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            if [ "$f" = "$own_file" ] || [ "$f" = "$shared" ]; then
                echo "yes"
                return
            fi
            for crate in ${target_crates[$target]}; do
                case "$f" in
                    "crates/$crate/src/"*) echo "yes"; return ;;
                esac
            done
        done <<<"$diff"
        echo "no"
    }

    nights=()
    while IFS= read -r d; do
        nights+=("$(basename "$d")")
    done < <(find "$root" -mindepth 1 -maxdepth 1 -type d \
        -name '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' 2>/dev/null | sort)
    if [ ${#nights[@]} -eq 0 ]; then
        echo "no night directories under $root"
        exit 0
    fi

    for night in "${nights[@]}"; do
        [ -n "$from" ] && [[ "$night" < "$from" ]] && continue
        [ -n "$to" ] && [[ "$night" > "$to" ]] && continue
        night_dir="$root/$night"
        echo "night: $night"

        shopt -s nullglob
        logs=("$night_dir"/fuzz*.log)
        shopt -u nullglob
        if [ ${#logs[@]} -eq 0 ]; then
            echo "  no fuzz logs under $night_dir"
            continue
        fi

        for log in "${logs[@]}"; do
            line=$(python3 "$stats" "$log")
            IFS=$'\t' read -r status target fork window_s runs cov_start cov_30 cov_end rise_s <<<"$line"
            case "$status" in
                SKIPPED)
                    echo "  $(basename "$log" .log)"
                    echo "    status: skipped — no time left in the window"
                    continue
                    ;;
                NOLAUNCH)
                    echo "  $(basename "$log" .log)"
                    echo "    status: never launched, no 'Running \`...\`' line in this log"
                    continue
                    ;;
                NODATA)
                    echo "  $target"
                    echo "    status: launched, but no coverage line was ever printed"
                    echo "    code changed since the previous night: $(changed_status "$night" "$target")"
                    continue
                    ;;
                OK) ;;
                *)
                    echo "  $(basename "$log" .log)"
                    echo "    status: log_stats.py said '$status', which this recipe does not know how to read"
                    continue
                    ;;
            esac

            echo "  $target"
            awk -v f="$fork" -v w="$window_s" \
                'BEGIN { printf "    core-hours: %.1f (fork %d x window %.2fh)\n", f * w / 3600, f, w / 3600 }'
            echo "    runs: $runs"
            echo "    coverage: $cov_start at start, $cov_30 at 30m, $cov_end at end"
            awk -v r="$rise_s" 'BEGIN { printf "    last rose: hour %.1f\n", r / 3600 }'
            echo "    code changed since the previous night: $(changed_status "$night" "$target")"
            new_files_and_faults=$(python3 "$nights_py" "$root" "$night" "$target") || exit 1
            sed 's/^/    /' <<<"$new_files_and_faults"
        done
    done

# Pins `fuzz-yield` against two nights this builds itself: round numbers for
# the coverage arithmetic, and a second night whose artifacts carry two files
# forward unchanged (which must not recount as new) beside two genuinely new
# ones (which must). A skipped log and a never-covered target are each other's
# own fixture, and a canned `fuzz-triage-verdicts.tsv` with one matching row,
# one non-matching row, and one row under a different target checks that the
# fault count reads its own target's column and nothing else's. A fourth
# fixture night has a fuzz log but no matching entry in the fake
# nightly-fuzz reflog at all, checking the other way "unknown" can come back:
# not just a target outside §298.1's table, but a real target whose build
# night the reflog cannot place. A fifth fixture night's own checkout is in
# the reflog but the night before it has none at all (Q289): the one arm of
# `changed_status` those first four do not reach, where the night itself is
# placed but the night before it cannot be, so "unknown" has to name the
# earlier date rather than the later one.
[private]
check-fuzz-yield-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    logs="$dir/logs"
    night1="$logs/2026-09-10"
    night2="$logs/2026-09-11"
    mkdir -p "$night1/artifacts/demo_target" "$night2/artifacts/demo_target"

    running() {
        printf '     Running `target/release/%s -artifact_prefix=/x/ -max_total_time=%s -max_len=81 -fork=%s -timeout=10 /corpus %s`\n' \
            "$1" "$3" "$2" "$1"
    }
    run_line() {
        printf '#%s: cov: %s ft: 1 corp: 1 exec/s: 1 oom/timeout/crash: 0/0/0 time: %ss\n' "$1" "$2" "$3"
    }

    {
        running demo_target 4 28800
        run_line 1000 500 0
        run_line 2000 600 1800
        run_line 5000 900 28800
    } >"$night1/fuzz-demo.log"

    {
        running demo_target 2 3600
        run_line 100 900 0
        run_line 200 950 1800
        run_line 400 1000 3600
    } >"$night2/fuzz-demo.log"

    printf 'fuzz-skip: skipped, -42 s left in the window\n' >"$night2/fuzz-skip.log"
    running ghost_target 1 60 >"$night2/fuzz-nodata.log"

    deadbeef="deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
    cafebabe="cafebabecafebabecafebabecafebabecafebabe"
    beadfeed="beadfeedbeadfeedbeadfeedbeadfeedbeadfeed"
    c0ffeec0="c0ffeec0c0ffeec0c0ffeec0c0ffeec0c0ffeec0"
    printf x >"$night1/artifacts/demo_target/crash-$deadbeef"
    printf x >"$night1/artifacts/demo_target/timeout-$cafebabe"
    printf x >"$night2/artifacts/demo_target/crash-$deadbeef"
    printf x >"$night2/artifacts/demo_target/timeout-$cafebabe"
    printf x >"$night2/artifacts/demo_target/crash-$beadfeed"
    printf x >"$night2/artifacts/demo_target/slow-unit-$c0ffeec0"

    verdicts="$night2/fuzz-triage-verdicts.tsv"
    printf 'target\tfiles\tstill_fails\tsample\tgroup\n' >"$verdicts"
    printf 'demo_target\t2\tyes\tsample-a\tpanic-a\n' >>"$verdicts"
    printf 'demo_target\t1\tyes\tsample-d\tpanic-d\n' >>"$verdicts"
    printf 'demo_target\t1\tno\tsample-b\tpanic-b\n' >>"$verdicts"
    printf 'ghost_target\t1\tyes\tsample-c\tpanic-c\n' >>"$verdicts"

    # A small nightly-fuzz worktree of its own, standing in for
    # /home/mattias/git/mattiasgronlund/rcad-nightly-fuzz: three commits, the
    # middle one touching a real target's own crate (a changed night) and the
    # last touching only an unrelated file (an unchanged night), each checked
    # out in turn so the reflog carries a real `checkout` per commit — then
    # nudged onto the fake dates below, since the reflog otherwise stamps a
    # checkout with the moment it actually ran, not the night it stands for.
    nightly_repo="$dir/nightly-fuzz-fixture"
    mkdir -p "$nightly_repo"
    git -C "$nightly_repo" init -q
    git -C "$nightly_repo" config user.email test@test.test
    git -C "$nightly_repo" config user.name test
    mkdir -p "$nightly_repo/crates/rcad-geom/src" "$nightly_repo/crates/rcad-geom/tests/fuzzing" \
        "$nightly_repo/crates/rcad-predicates/src"
    printf 'one\n' >"$nightly_repo/crates/rcad-geom/src/lib.rs"
    printf 'one\n' >"$nightly_repo/crates/rcad-geom/tests/fuzzing/mod.rs"
    printf 'one\n' >"$nightly_repo/crates/rcad-predicates/src/lib.rs"
    printf 'one\n' >"$nightly_repo/README.md"
    git -C "$nightly_repo" add -A
    git -C "$nightly_repo" commit -q -m baseline
    nightly_base=$(git -C "$nightly_repo" rev-parse HEAD)
    printf 'two\n' >"$nightly_repo/crates/rcad-geom/src/lib.rs"
    git -C "$nightly_repo" commit -qam "touch rcad-geom src"
    nightly_changed=$(git -C "$nightly_repo" rev-parse HEAD)
    printf 'two\n' >"$nightly_repo/README.md"
    git -C "$nightly_repo" commit -qam "touch an unrelated file"
    nightly_unchanged=$(git -C "$nightly_repo" rev-parse HEAD)
    printf 'three\n' >"$nightly_repo/README.md"
    git -C "$nightly_repo" commit -qam "touch an unrelated file again"
    nightly_no_prev=$(git -C "$nightly_repo" rev-parse HEAD)

    nightly_reflog="$nightly_repo/.git/logs/HEAD"
    nightly_tab=$'\t'
    checkout_as_night() {
        local sha="$1" fake_date="$2" fake_time="$3" epoch
        git -C "$nightly_repo" checkout -q "$sha"
        epoch=$(date -d "$fake_date $fake_time UTC" +%s)
        sed -E -i "\$ s/^([0-9a-f]{40} [0-9a-f]{40} [^<]+<[^>]+>) [0-9]+ [+-][0-9]{4}${nightly_tab}/\\1 ${epoch} +0000${nightly_tab}/" \
            "$nightly_reflog"
    }
    checkout_as_night "$nightly_base" 2026-09-11 00:12:00
    checkout_as_night "$nightly_changed" 2026-09-12 00:13:00
    checkout_as_night "$nightly_unchanged" 2026-09-13 00:14:00
    # No checkout is stamped for 2026-09-14 at all (as for night5 below), so
    # this one's own night is placed but the night before it, 2026-09-14, is
    # not — the arm §298's fixtures had not reached (Q289).
    checkout_as_night "$nightly_no_prev" 2026-09-15 00:16:00

    night3="$logs/2026-09-12"
    night4="$logs/2026-09-13"
    night5="$logs/2026-09-14"
    night6="$logs/2026-09-15"
    mkdir -p "$night3" "$night4" "$night5" "$night6"
    { running where_two_surfaces_cross 1 60; run_line 10 20 0; run_line 20 25 60; } >"$night3/fuzz-cross.log"
    { running where_two_surfaces_cross 1 60; run_line 10 20 0; run_line 20 25 60; } >"$night4/fuzz-cross.log"
    # No fourth `checkout_as_night` call happens for this date, so the
    # nightly-fuzz fixture reflog carries no 00:10-00:16 checkout for
    # 2026-09-14 itself — the arm Q232's lane hand-probed and no fixture
    # exercised (§298.7, Q250).
    { running where_two_surfaces_cross 1 60; run_line 10 20 0; run_line 20 25 60; } >"$night5/fuzz-cross.log"
    { running where_two_surfaces_cross 1 60; run_line 10 20 0; run_line 20 25 60; } >"$night6/fuzz-cross.log"

    fail() {
        echo "fuzz-yield drifted from its own fixtures: $1"
        echo "--- got ---"; echo "$got"
        exit 1
    }
    yield() {
        RCAD_FUZZ_LOGS="$logs" RCAD_NIGHTLY_FUZZ_WORKTREE="$nightly_repo" \
            {{ just_executable() }} fuzz-yield "$@" 2>&1
    }

    got=$(yield 2026-09-10 2026-09-11) || fail "the recipe itself failed on two ordinary nights"

    grep -q '^night: 2026-09-10$' <<<"$got" || fail "it did not report the first night"
    grep -q '^night: 2026-09-11$' <<<"$got" || fail "it did not report the second night"
    grep -q '^  demo_target$' <<<"$got" || fail "it did not name the target read off the Running line"
    grep -qF '    core-hours: 32.0 (fork 4 x window 8.00h)' <<<"$got" \
        || fail "core-hours is not fork times window for the first night"
    grep -qF '    runs: 5000' <<<"$got" || fail "it did not report the run count"
    grep -qF '    coverage: 500 at start, 600 at 30m, 900 at end' <<<"$got" \
        || fail "coverage at start/30m/end does not match the first night's fixture log"
    grep -qF '    last rose: hour 8.0' <<<"$got" || fail "the last rise hour is wrong"
    grep -qF '    core-hours: 2.0 (fork 2 x window 1.00h)' <<<"$got" \
        || fail "core-hours is not fork times window for the second night"
    grep -qF '    coverage: 900 at start, 950 at 30m, 1000 at end' <<<"$got" \
        || fail "the second night's coverage line is wrong"

    grep -qF 'no earlier night on disk to diff against — counting all 2 as new' <<<"$got" \
        || fail "the first night on disk should count its own baseline artifacts as new, and say why"
    grep -qF 'new files since 2026-09-10: 1 crash, 1 slow-unit' <<<"$got" \
        || fail "carried-over crash-$deadbeef and timeout-$cafebabe were recounted, or the genuinely new files were missed"

    grep -qF '  fuzz-skip' <<<"$got" || fail "the skipped log was not named by its own basename"
    grep -qF 'status: skipped — no time left in the window' <<<"$got" \
        || fail "a skipped target was not reported as skipped"

    grep -qF '  ghost_target' <<<"$got" || fail "the never-covered target was not named"
    grep -qF 'status: launched, but no coverage line was ever printed' <<<"$got" \
        || fail "a target with no coverage line was not reported"

    grep -qF 'faults: night not triaged' <<<"$got" \
        || fail "a night with no verdicts file said something other than not triaged"
    # Two rows still fail and one does not, so counting the wrong value of the
    # column gives 1 and fails here; with one of each it passed unseen.
    grep -qF 'faults: 2 distinct, still failing on main' <<<"$got" \
        || fail "the fault count did not filter the verdicts file down to this target's rows that still fail"

    narrow=$(yield 2026-09-11 2026-09-11) || fail "a single-night range made the recipe fail"
    got="$narrow"
    # Negated with `!`, not written as `grep && fail`: the passing case here is
    # the grep finding nothing, a non-zero status, and `set -e` would take the
    # recipe down on the arm that just succeeded (see the same note at the
    # hand-run fuzz arm above).
    ! grep -q '^night: 2026-09-10$' <<<"$narrow" \
        || fail "a range naming only the second night still reported the first"

    grep -qF 'code changed since the previous night: unknown (not a target docs/decisions.md §298.1 names)' <<<"$got" \
        || fail "demo_target is not a §298.1 target and should have said so, not guessed yes or no"

    changed=$(yield 2026-09-12 2026-09-12) || fail "the changed-night range made the recipe fail"
    grep -qF 'code changed since the previous night: yes' <<<"$changed" \
        || fail "09-12 touches where_two_surfaces_cross's own crate and should read as changed"

    unchanged=$(yield 2026-09-13 2026-09-13) || fail "the unchanged-night range made the recipe fail"
    grep -qF 'code changed since the previous night: no' <<<"$unchanged" \
        || fail "09-13 only touches an unrelated file and should read as unchanged"

    no_checkout=$(yield 2026-09-14 2026-09-14) || fail "the no-checkout-night range made the recipe fail"
    grep -qF 'code changed since the previous night: unknown (reflog shows no 00:10-00:16 checkout for 2026-09-14)' <<<"$no_checkout" \
        || fail "09-14 has no checkout in the fixture reflog and should say unknown, not guess yes or no"

    no_prev_checkout=$(yield 2026-09-15 2026-09-15) || fail "the no-checkout-night-before range made the recipe fail"
    grep -qF 'code changed since the previous night: unknown (reflog shows no checkout for the night before, 2026-09-14)' <<<"$no_prev_checkout" \
        || fail "09-15 has a checkout itself but 09-14 has none, and should say unknown naming 09-14, not guess yes or no"

    echo "fuzz-yield: coverage arithmetic, the artifact diff, the fault count, and the changed-night check all match their fixtures"

[doc("The benchmarks.")]
bench:
    cargo bench --workspace

# What the provenance log costs the three fuzz targets that never read one.
#
# The §144.9 measurement, run on its own because it is the one bench somebody
# comes looking for by name rather than by sweeping them all. Two passes over
# each target's checked-in corpus and a 200 000-draw soak: the draw as the fuzz
# target runs it, then every record that draw made built and freed again. The
# share of the two is the whole of what a stubbed `ProvenanceLog` behind a cargo
# feature could have bought.
#
# **It asserts nothing**, the way §12.5 says a human-read figure should, and
# `docs/decisions.md` §162 records what it said on the day. The two doors it
# measures through are pinned by
# `a_fuzz_draw_hands_its_provenance_back_through_the_door.rs` in `rcad-geom` and
# its namesake in `rcad-topo` — without those a door that stopped collecting
# would read as nought percent, which is §77.6's shape.
#
# It writes each target's worst draw to `target/provenance-cost/` and names the
# path, because a count cannot be replayed and those bytes can.
[doc("What the provenance log costs a fuzz night: the §144.9 measurement.")]
provenance-cost:
    cargo bench -p rcad-step --bench what_the_provenance_log_costs_a_fuzz_night

# Which regions of `crates/*/src` the suite never runs.
#
# **Not in `gate`, and named `coverage` rather than `check-coverage` for that
# reason**: `check-gate-runs-every-check` says a check nobody runs is not a
# check, so a `check-` name would have to be paid on every commit. One run is
# about ten minutes and a `target/llvm-cov-target` of its own that shares
# nothing with the ordinary build, which is a thing to ask for. `bench` is out
# of the gate on the same argument and sits above.
#
# **It prints places and not a percentage.** The first run answered 94.0% and
# nobody could act on that; what the missing 6% *is* turned out to be the
# refusal half of this kernel — invariant panics, named `Error`s, and
# `Decision::Undecidable` arms at call sites nothing has ever reached. Every
# other check in this file pins a count of things rather than a ratio, and a
# ratio is the one number that moves for reasons nobody reads.
#
# The two costs worth knowing before you start it. Instrumentation is paid by
# the *suite*, not the build: 347 s against the 30.7 s critical path §95.5
# measures, one `rcad-step` test going from seconds to 342. And `llvm-tools` is
# in `rust-toolchain.toml` for this and nothing else.
[doc("Which regions of crates/*/src the suite never runs. Not in gate; ~10 minutes.")]
coverage:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p target
    cargo llvm-cov nextest --workspace --json --output-path target/coverage.json
    {{ just_executable() }} coverage-report target/coverage.json

# Read a coverage run back. `coverage` above calls this; it is separate so that
# the reading can be tested without a ten-minute run behind it, which is what
# `check-coverage-selftest` does.
#
# **Three things about llvm-cov's export make the naive read wrong, and two of
# them are silent.**
#
# A generic is exported once per instantiation and its regions are counted again
# each time, so the records have to be collapsed onto their spans: 199 081
# records over 35 368 real spans on this tree. Nothing about the un-collapsed
# number looks wrong.
#
# An inline `#[cfg(test)] mod tests` is ordinary lines of the file it sits in,
# and it is covered by construction — 42% of the region count here. The obvious
# filter is the function's name, and **that one fails silently**: names in the
# export are v0-mangled, so a test for `::tests::` matches nothing and keeps
# every one of them while looking like it worked. The first draft of this did
# exactly that and printed a confident "0 dropped". So the cut is geometric
# instead — the region's own file and start line against that file's first
# `#[cfg(test)]`.
#
# And `crates/*/tests/` needs no filter, because llvm-cov maps only `src` into
# its file summary. Measured, not assumed: the printed and src-only totals agree
# to the digit in all seven crates.
#
# **So it checks itself against the summary before it says anything.** The
# collapsed span count has to equal what llvm-cov's own per-file summary says,
# and a parse that drifts from that fails here rather than printing a plausible
# number. That identity is what catches the next version of the mangling bug.
[doc("Read a coverage run back: which regions of crates/*/src were never run.")]
coverage-report report:
    #!/usr/bin/env python3
    import json
    import re
    import sys
    from collections import defaultdict

    WHICH_CRATE = re.compile(r"/crates/([a-z0-9-]+)/")


    def main():
        with open("{{report}}") as handle:
            export = json.load(handle)["data"][0]

        widest = the_widest_count_for_each_span(export)
        say_so_if_the_summary_disagrees(export, widest)

        per_crate = defaultdict(lambda: [0, 0])
        per_file = defaultdict(lambda: [0, 0, []])
        cut_away = 0
        for (path, line, _, _, _), count in widest.items():
            starts_the_tests = where_the_tests_start(path)
            if starts_the_tests is not None and line >= starts_the_tests:
                cut_away += 1
                continue
            crate = per_crate[WHICH_CRATE.search(path).group(1)]
            here = per_file[path]
            crate[0] += 1
            here[0] += 1
            if count == 0:
                crate[1] += 1
                here[1] += 1
                here[2].append(line)

        print("never run, by crate")
        for crate in sorted(per_crate):
            total, missing = per_crate[crate]
            print(f"  {crate:<20} {missing:6d} of {total:6d}")

        print()
        print("never run, by file")
        worst = sorted(per_file.items(), key=lambda pair: -pair[1][1])
        for path, (total, missing, lines) in worst:
            if missing == 0:
                continue
            print(f"  {short(path):<44} {missing:5d} of {total:5d}  "
                  f"lines {as_runs(sorted(set(lines)))}")

        kept = sum(total for total, _ in per_crate.values())
        print()
        print(f"{kept} regions in crates/*/src, and {cut_away} more inside an inline")
        print("#[cfg(test)] module, which are covered by construction and were cut")
        print(f"{sum(1 for _ in every_record(export))} region records collapsed onto "
              f"{kept + cut_away} spans")


    def the_widest_count_for_each_span(export):
        """The same span is exported once per instantiation of a generic. Keep the
        highest count any of them reached: one instantiation running a branch is
        that branch having run."""
        widest = {}
        for span, count in every_record(export):
            if count > widest.get(span, -1):
                widest[span] = count
        return widest


    def every_record(export):
        for function in export["functions"]:
            paths = function["filenames"]
            for region in function["regions"]:
                line, column, last_line, last_column, count, which_file = region[:6]
                if region[7] != 0 or which_file >= len(paths):
                    continue
                path = paths[which_file]
                if WHICH_CRATE.search(path) is None or "/src/" not in path:
                    continue
                yield (path, line, column, last_line, last_column), count


    def say_so_if_the_summary_disagrees(export, widest):
        summed = 0
        for entry in export["files"]:
            path = entry["filename"]
            if WHICH_CRATE.search(path) is None or "/src/" not in path:
                continue
            summed += entry["summary"]["regions"]["count"]
        if summed != len(widest):
            sys.exit(
                f"llvm-cov's own summary counts {summed} regions in crates/*/src "
                f"and collapsing the records gave {len(widest)}.\n"
                "One of the two reads is wrong, and a number printed from here "
                "would look plausible either way.")


    read_so_far = {}


    def where_the_tests_start(path):
        """The line of the file's first `#[cfg(test)]`, or None if it has none."""
        if path not in read_so_far:
            found = None
            try:
                with open(path) as handle:
                    for number, text in enumerate(handle, 1):
                        if "#[cfg(test)]" in text:
                            found = number
                            break
            except OSError:
                found = None
            read_so_far[path] = found
        return read_so_far[path]


    def as_runs(lines):
        runs = []
        for line in lines:
            if runs and line - runs[-1][1] <= 3:
                runs[-1][1] = line
            else:
                runs.append([line, line])
        return ", ".join(str(a) if a == b else f"{a}-{b}" for a, b in runs)


    def short(path):
        return path.split("/crates/")[-1]


    main()

# `coverage-report` against a synthetic export, for each way the read can be
# wrong. It builds its own two-file tree under `mktemp` and writes its own JSON,
# so it needs no coverage run and sits in `gate` beside `check-corpus-selftest`.
#
# Verified by mutating the recipe above, one at a time, reverting between
# (docs/decisions.md §79's rule, applied to this):
#
# | Mutation | What failed |
# |---|---|
# | the collapse keeps the *last* count rather than the widest | the generic case, on a span that ran reading as never run |
# | `where_the_tests_start` always returns `None` | the cut case, on a line below the attribute being listed |
# | the `"/src/"` test dropped from `every_record` | the summary cross-check, before any output |
# | the cross-check's `sys.exit` deleted | the disagreement case, which then printed a plausible table |
#
# The third is why the cross-check is not merely a nicety: dropping the `src`
# filter is the shape of the mangling bug that already happened once, and the
# only thing that notices is the identity against llvm-cov's own summary.
[doc("coverage-report against a synthetic export, for each way the read can be wrong.")]
check-coverage-selftest:
    #!/usr/bin/env bash
    set -euo pipefail

    work=$(mktemp -d -- "${TMPDIR:-/tmp}/rcad-coverage-selftest.XXXXXX")
    trap 'rm -rf -- "$work"' EXIT

    mkdir -p "$work/crates/thing/src"
    # Twelve lines of kernel, then the inline tests. Written with printf because
    # it is a throwaway fixture under mktemp and not a tracked file.
    for line in $(seq 1 11); do printf 'fn kernel_%s() {}\n' "$line" >>"$work/crates/thing/src/thing.rs"; done
    printf '#[cfg(test)]\nmod tests {\n    fn a_test() {}\n}\n' >>"$work/crates/thing/src/thing.rs"

    thing="$work/crates/thing/src/thing.rs"

    # A region is [line, col, last_line, last_col, count, file, expanded, kind].
    # kind 0 is a code region; the summary count must match the collapsed spans.
    export_of() {
        printf '{"data":[{"files":[{"filename":"%s","summary":{"regions":{"count":%s,"covered":0},"lines":{"count":1,"covered":1},"functions":{"count":1,"covered":1}}}],"functions":[%s],"totals":{}}]}' \
            "$thing" "$2" "$3" >"$work/$1.json"
    }

    failed=0
    check() {
        local name=$1 want_rc=$2
        shift 2
        local out rc needle
        set +e
        out=$({{ just_executable() }} coverage-report "$work/$name.json" 2>&1)
        rc=$?
        set -e
        if [ "$rc" != "$want_rc" ]; then
            echo "FAIL $name: exit $rc, expected $want_rc"
            echo "$out" | sed 's/^/    /'
            failed=1
            return
        fi
        for needle in "$@"; do
            case "$needle" in
            !*)
                if grep -qF -- "${needle#!}" <<<"$out"; then
                    echo "FAIL $name: output says '${needle#!}' and must not"
                    echo "$out" | sed 's/^/    /'
                    failed=1
                fi
                ;;
            *)
                if ! grep -qF -- "$needle" <<<"$out"; then
                    echo "FAIL $name: output does not say '$needle'"
                    echo "$out" | sed 's/^/    /'
                    failed=1
                fi
                ;;
            esac
        done
    }

    # One: the geometric cut. Line 3 is kernel and never run, line 14 is inside
    # `mod tests` and never run. Only the first is anybody's business.
    export_of cut 2 '{"name":"_RNvCs0_5thing6kernel","count":0,"filenames":["'"$thing"'"],"regions":[[3,1,3,9,0,0,0,0],[14,1,14,9,0,0,0,0]]}'
    check cut 0 "lines 3" '!lines 3, 14' "and 1 more inside an inline"

    # Two: a generic exported twice, never run first and run second. Collapsing
    # on the widest count is what makes this a reached region; keeping the last
    # or the first record read would answer differently, and one of those two
    # orders would look right.
    export_of generic 1 '{"name":"_RNvCs0_5thing1a","count":0,"filenames":["'"$thing"'"],"regions":[[5,1,5,9,0,0,0,0]]},{"name":"_RNvCs0_5thing1b","count":7,"filenames":["'"$thing"'"],"regions":[[5,1,5,9,7,0,0,0]]}'
    check generic 0 "never run, by file" '!thing.rs' "1 regions in crates/*/src"

    # Three: the same two records the other way about. §79.2's lesson — a
    # mutation that leaves one order right can leave the other wrong.
    export_of generic-reversed 1 '{"name":"_RNvCs0_5thing1b","count":7,"filenames":["'"$thing"'"],"regions":[[5,1,5,9,7,0,0,0]]},{"name":"_RNvCs0_5thing1a","count":0,"filenames":["'"$thing"'"],"regions":[[5,1,5,9,0,0,0,0]]}'
    check generic-reversed 0 '!thing.rs' "1 regions in crates/*/src"

    # Four: a region of a kind other than code, and a region in a file the
    # summary does not describe. Both are dropped, so the summary still agrees.
    export_of kinds 1 '{"name":"_RNvCs0_5thing1a","count":0,"filenames":["'"$thing"'"],"regions":[[6,1,6,9,0,0,0,0],[7,1,7,9,0,0,0,2]]},{"name":"_RNvCs0_5thing1c","count":0,"filenames":["'"$work"'/crates/thing/tests/a.rs"],"regions":[[1,1,1,9,0,0,0,0]]}'
    check kinds 0 "lines 6" '!lines 6, 7' '!tests/a.rs'

    # Five: the cross-check itself. The summary says three regions and the
    # records collapse to one, which is the shape every parse bug here takes,
    # and it must refuse rather than print a table nobody can tell is wrong.
    export_of disagreement 3 '{"name":"_RNvCs0_5thing1a","count":0,"filenames":["'"$thing"'"],"regions":[[8,1,8,9,0,0,0,0]]}'
    check disagreement 1 "llvm-cov's own summary counts 3 regions" '!never run, by crate'

    if [ "$failed" != "0" ]; then
        echo "^ coverage-report read a synthetic export wrongly"
        exit 1
    fi
    echo "coverage-report: five synthetic exports read as they should be"

[doc("Format the Rust and the TOML in place.")]
fmt:
    cargo fmt --all
    taplo fmt

# Strip `target/` from every worktree git knows about, once nobody has written in
# it for three hours. kache holds the compilation, so a cleaned worktree refills
# from the cache instead of rebuilding.
#
# **Three hours untouched, because a lane's `target/` holds more than the
# compilation.** A measuring lane's probe logs and CSVs are gitignored and live
# there, and its verifier and merger read them after the lane has stopped
# writing. Across 174 lanes, the merger finished at most 53 minutes after its
# lane stopped (§371.5). The newest file anywhere under the tree's `target/`
# directories decides, never `target/`'s own time, which moves only when its own
# entries do. One fresh `target/` keeps the whole tree, and so does a walk that
# `find` could not finish, since then nobody knows how old the tree is.
#
# Separate from `prune-worktrees` on purpose (docs/decisions.md §50.8). That one
# can only run once the work is merged; this one can run any time, and merging
# the two would make the safe half inherit the unsafe half's ceremony until
# nobody ran either. 38 worktrees held 166 GB of `target/` before this existed.
#
# **Asked git rather than guessed from a path.** This used to build the string
# `$(dirname $(git rev-parse --show-toplevel))/rcad-worktrees`, which is only the
# right answer when it is run from the hub — run from a lane it landed on
# `rcad-worktrees/rcad-worktrees`, found nothing there, and said *"there is
# nothing here to clean"*, which reads exactly like a tidy machine. Now that
# nobody works in the hub (§60) that was every run. The listing also reaches the
# sibling trees the glob never covered and the hub's own `target/`, which was the
# single largest at 14 GB.
#
# Three are skipped, and for the same reasons as `prune-worktrees`: the tree
# you are standing in, because you are using it; the tree the overnight fuzz
# unit runs in, because a night deleting its own `fuzz/target` mid-run is the
# same interruption; and any **locked** tree, because a lock means an agent is
# working in there and deleting its `target/` mid-build is exactly the
# interruption the lock exists to prevent.
[doc("Strip target/ from worktrees nobody has written in for three hours. Skips locked ones.")]
clean-targets dir="." fuzz_unit=(justfile_directory() / "tooling/systemd/rcad-fuzz.service"):
    #!/usr/bin/env bash
    set -euo pipefail
    listing=$(git -C "{{dir}}" worktree list --porcelain)
    here=$(git -C "{{dir}}" rev-parse --show-toplevel)
    fuzz_tree=$(sed -n "s|^WorkingDirectory=%h|$HOME|p; s|^WorkingDirectory=/|/|p" "{{fuzz_unit}}")
    [ -n "$fuzz_tree" ] || { echo "{{fuzz_unit}} names no WorkingDirectory, so the overnight fuzz tree cannot be kept"; exit 2; }
    locked=$(awk '/^worktree /{tree = $2} /^locked/{print tree}' <<<"$listing")
    reclaimed=0
    kept=0
    for tree in $(awk '/^worktree /{print $2}' <<<"$listing"); do
        [ -d "$tree" ] || continue
        if [ "$tree" = "$here" ]; then
            echo "kept (you are standing in it): $tree"
            kept=$((kept + 1))
            continue
        fi
        if [ "$tree" = "$fuzz_tree" ]; then
            echo "kept (the overnight fuzz unit runs in it): $tree"
            kept=$((kept + 1))
            continue
        fi
        if grep -qxF "$tree" <<<"$locked"; then
            echo "kept (locked, an agent is using it): $tree"
            kept=$((kept + 1))
            continue
        fi
        mapfile -t targets < <(find "$tree" -maxdepth 2 -type d -name target -prune)
        [ "${#targets[@]}" -gt 0 ] || continue
        if ! recent=$(find "${targets[@]}" -mmin -180 -print -quit 2>/dev/null); then
            echo "kept (find could not read all of its target/, so how old it is is unknown): $tree"
            kept=$((kept + 1))
            continue
        fi
        if [ -n "$recent" ]; then
            echo "kept (its target/ was written in the last three hours): $tree"
            kept=$((kept + 1))
            continue
        fi
        size=$(du -sb --total -- "${targets[@]}" | awk '/total$/{print $1}')
        rm -rf -- "${targets[@]}"
        echo "swept $(numfmt --to=iec "$size"): $tree"
        reclaimed=$((reclaimed + size))
    done
    echo "$(numfmt --to=iec "$reclaimed") reclaimed; $kept worktree(s) kept"

# Pins the trees `clean-targets` must not touch, and the one it used to miss.
#
# A sweep that deletes too much is noticed within the minute; a sweep that
# deletes too little says "nothing to clean" and is believed for a month, which
# is what happened. So the fixture puts a `target/` in all four trees and runs
# the sweep from the lane: the **hub's** must go, because it is the biggest and
# the old path glob never reached it, the **locked** one must survive, the tree
# a fixture fuzz unit names must survive unlocked (§205.4), and the tree the
# sweep is standing in must survive.
[private]
check-clean-targets-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'git -C "$dir/main" worktree unlock "$dir/held" 2>/dev/null || true; rm -rf "$dir"' EXIT
    git init -q -b main "$dir/main"
    git -C "$dir/main" -c user.email=t@t -c user.name=t commit -q --allow-empty -m root
    git -C "$dir/main" worktree add -q "$dir/held" -b held
    git -C "$dir/main" worktree add -q "$dir/free" -b free
    git -C "$dir/main" worktree lock --reason "agent-abc since 2026-09-06T00:00:00Z" "$dir/held"
    git -C "$dir/main" worktree add -q "$dir/nightly" -b nightly
    git -C "$dir/main" worktree add -q "$dir/busy" -b busy
    git -C "$dir/main" worktree add -q "$dir/twofold" -b twofold
    printf '[Service]\nWorkingDirectory=%s\n' "$dir/nightly" >"$dir/rcad-fuzz.service"
    # Every target/ starts four hours old, so each tree below is kept or swept
    # for its own reason and not because the fixture wrote it a moment ago.
    for tree in main held free nightly busy twofold; do
        mkdir -p "$dir/$tree/target/debug/deps"
        head -c 4096 /dev/zero >"$dir/$tree/target/debug/artifact"
        find "$dir/$tree/target" -exec touch -d '4 hours ago' {} +
    done
    # Written a moment ago, three levels down. target/'s own time stays four
    # hours old, because a directory's time moves only when its own entries do.
    printf 'probe log\n' >"$dir/busy/target/debug/deps/fresh"
    mkdir -p "$dir/twofold/fuzz/target"
    printf 'corpus\n' >"$dir/twofold/fuzz/target/fresh"
    # Stands in for a file a build deletes while find is walking past it: either
    # way find cannot say how old the tree is, and says so with its exit code.
    git -C "$dir/main" worktree add -q "$dir/sealed" -b sealed
    mkdir -p "$dir/sealed/target/debug/unreadable"
    find "$dir/sealed/target" -exec touch -d '4 hours ago' {} +
    chmod 000 "$dir/sealed/target/debug/unreadable"
    if find "$dir/sealed/target" >/dev/null 2>&1; then
        echo "clean-targets-selftest: find read a directory with mode 000, so this is running as root and the unreadable case cannot be built"
        exit 1
    fi
    got=$(just clean-targets "$dir/free" "$dir/rcad-fuzz.service")
    fail() {
        echo "clean-targets drifted from its own fixtures: $1"
        echo "--- got ---"; echo "$got"
        exit 1
    }
    [ ! -d "$dir/main/target" ] || fail "the hub's target/ survived, which is the case the old path glob missed"
    [ -d "$dir/held/target" ] || fail "a locked worktree was swept while an agent was working in it"
    [ -d "$dir/free/target" ] || fail "the sweep deleted the target/ of the tree it was standing in"
    [ -d "$dir/nightly/target" ] || fail "the sweep deleted the target/ of the tree the overnight fuzz unit runs in"
    grep -qF "kept (locked, an agent is using it): $dir/held" <<<"$got" \
        || fail "the locked worktree was not reported as kept"
    grep -qF "kept (you are standing in it): $dir/free" <<<"$got" \
        || fail "the current worktree was not reported as kept"
    grep -qF "kept (the overnight fuzz unit runs in it): $dir/nightly" <<<"$got" \
        || fail "the overnight fuzz tree was not reported as kept"
    [ -f "$dir/busy/target/debug/deps/fresh" ] \
        || fail "an unlocked tree was swept with a file in its target/ written a moment ago (§371.5)"
    grep -qF "kept (its target/ was written in the last three hours): $dir/busy" <<<"$got" \
        || fail "the tree with a fresh target/ was not reported as kept"
    [ -d "$dir/twofold/target" ] && [ -d "$dir/twofold/fuzz/target" ] \
        || fail "a tree with one fresh target/ and one old one was partly swept; a fresh one anywhere keeps the tree whole"
    [ -d "$dir/sealed/target" ] \
        || fail "a tree find could not read all of was swept, as if it had read it and found it old"
    grep -qF "kept (find could not read all of its target/, so how old it is is unknown): $dir/sealed" <<<"$got" \
        || fail "the tree find could not read was not reported as kept"
    grep -qE "^[0-9.]+K reclaimed; 6 worktree\(s\) kept$" <<<"$got" \
        || fail "the tally is wrong, so a sweep that found nothing would read like a tidy machine"

# Mark worktrees whose run is over, so `prune-worktrees` removes them without
# waiting out its hour (§315.2).
#
# A merger runs this on its lane's tree, its verifier's and its own once its
# push has landed, and the `lanes` workflow runs `prune-worktrees` straight
# after. The hour is there for a tree whose owner nobody can name. A merger can
# name all three, and waiting the hour out keeps three `target/`s on the disk.
#
# The mark is a file in the tree's own git directory, so it goes when the tree
# goes and never shows in `git status`. It skips the hour and nothing else:
# `prune-worktrees` still keeps a marked tree that is not on `main`, is dirty,
# or holds a real fuzz find. A locked tree is refused, because its owner is
# still at work, so the merger unlocks its own tree first. The hub is refused
# because it is never a lane's tree. Every tree is checked before any is
# marked, so a refusal marks nothing.
[doc("Mark worktrees as finished, so prune-worktrees removes them without waiting an hour.")]
mark-finished +trees:
    #!/usr/bin/env bash
    set -euo pipefail
    tops=()
    gitdirs=()
    for tree in "$@"; do
        top=$(git -C "$tree" rev-parse --show-toplevel)
        gitdir=$(git -C "$top" rev-parse --absolute-git-dir)
        common=$(git -C "$top" rev-parse --path-format=absolute --git-common-dir)
        [ "$gitdir" != "$common" ] || { echo "$top is the hub, which is never a lane's tree"; exit 1; }
        [ ! -e "$gitdir/locked" ] || { echo "$top is locked, so its owner is still at work: $(cat "$gitdir/locked")"; exit 1; }
        tops+=("$top")
        gitdirs+=("$gitdir")
    done
    for i in "${!gitdirs[@]}"; do
        touch "${gitdirs[$i]}/rcad-run-over"
        echo "marked: ${tops[$i]}"
    done

# Remove lane worktrees whose work has landed and whose lane is over, then the
# branches `main` already holds.
#
# The closing gate runs this, because nothing else reclaims a worktree: the
# harness sweep keeps any worktree holding a commit (§50.8). A worktree is
# removed only when every one of these holds, and each is here because it is
# the only thing that tells a finished lane from a live one or from a tree
# holding something nowhere else has:
#
# - **not the hub, and not the tree the recipe runs in.** Git refuses to remove
#   the hub, and you are using the other one;
# - **not the tree the overnight fuzz unit runs in,** read from the unit's
#   `WorkingDirectory`. Its lock and its `fuzz/artifacts/` both keep it today,
#   but a lock is released by `release-lanes`, and the night's artifacts are
#   triaged away (§205.4);
# - **unlocked.** A lock names the agent that owns the tree (§55);
# - **not holding `main`.** `main` is an ancestor of itself, so without this the
#   tree carrying it is removed like any merged lane, which happened on
#   2026-09-08 (§76). §60 says it lives in a worktree and never the hub;
# - **HEAD on `main` or on `origin/main`.** Either ref keeps every commit the
#   tree can reach. Asking about HEAD's commit and never about a branch name is
#   §76's second fix: a detached tree's `HEAD` resolved through the wrong tree;
# - **nothing uncommitted, untracked files included;**
# - **no `fuzz/artifacts/`.** It is gitignored, so a tree holding the only copy
#   of a crash input reads as clean (§92.3). What `check-fuzz-overnight-selftest`
#   writes there does not count: it is a line of text under a name holding
#   `-overnight-selftest-`, which libFuzzer never writes, and a gate killed
#   mid-selftest leaves it behind for ever (§315.3);
# - **HEAD has not moved for an hour, unless `mark-finished` said the run is
#   over.** A lane that has just started sits at its base, which is on `main`,
#   clean and unlocked, and the harness does not lock a workflow lane.
#   `logs/HEAD` rather than `index`, because `git status` rewrites the index and
#   this recipe runs it. The mark is how a merged run removes its own trees the
#   minute it lands rather than an hour later (§315.2);
# - **no process has its working directory inside it.**
#
# Until §205 a detached tree was kept whatever it held, and lanes here mostly
# end detached: on 2026-09-22 this kept 55 trees and removed 7. The rule is
# rscene's (`eed893f`) with the three rcad cases added.
#
# **Then it deletes each branch `main` holds that no tree has checked out and
# no queue row holds** (§458). Such a branch has no commit `main` lacks, so
# deleting it loses a name and its reflog, and a spike that is never merged by
# design (§50.4) keeps its commits. The hold is there for a lane that commits
# nothing: its branch sits at its base, on `main`, and its verifier still reads
# it by name. The delete is `git branch -d` in the tree holding `main`, so git
# checks again, at the delete, that each branch is merged into `main` and
# checked out nowhere. That is why a branch only `origin/main` holds waits for
# `ff-main`, and why the recipe fails when no tree holds `main`.
[doc("Remove lane worktrees that are clean, landed on main, unlocked, and idle for an hour or marked finished; then delete the branches main holds that no tree or queue row uses.")]
prune-worktrees dir="." fuzz_unit=(justfile_directory() / "tooling/systemd/rcad-fuzz.service"):
    #!/usr/bin/env bash
    set -euo pipefail
    [ -r /proc/self/cwd ] || { echo "no /proc, so nothing can say whether a process is running in a worktree"; exit 2; }
    here=$(git -C "{{dir}}" rev-parse --show-toplevel)
    fuzz_tree=$(sed -n "s|^WorkingDirectory=%h|$HOME|p; s|^WorkingDirectory=/|/|p" "{{fuzz_unit}}")
    [ -n "$fuzz_tree" ] || { echo "{{fuzz_unit}} names no WorkingDirectory, so the overnight fuzz tree cannot be kept"; exit 2; }
    landed=(main)
    git -C "$here" rev-parse --verify -q origin/main >/dev/null && landed+=(origin/main)
    now=$(date +%s)
    cwds=$(for p in /proc/[0-9]*; do readlink "$p/cwd" 2>/dev/null || true; done)
    git -C "$here" worktree prune
    kept=0
    keep() {
        echo "kept ($1): $tree"
        kept=$((kept + 1))
    }
    on_a_landed_ref() {
        local ref
        for ref in "${landed[@]}"; do
            git -C "$here" merge-base --is-ancestor "$head" "$ref" && return 0
        done
        return 1
    }
    # The first entry is the hub, which `git worktree remove` refuses. `branch`
    # is last because a detached tree has none, and `read` folds two tabs in a
    # row into one, which would shift every field after an empty one.
    while IFS=$'\t' read -r tree head locked branch; do
        gitdir=$(git -C "$tree" rev-parse --absolute-git-dir)
        moved="$gitdir/logs/HEAD"
        [ -f "$moved" ] || moved="$gitdir/HEAD"
        idle=$(((now - $(stat -c %Y "$moved")) / 60))
        if [ "$tree" = "$here" ]; then
            keep "you are standing in it"
        elif [ "$tree" = "$fuzz_tree" ]; then
            keep "the overnight fuzz unit runs in it"
        elif [ "$locked" = 1 ]; then
            keep "locked, an agent is using it"
        elif [ "$branch" = refs/heads/main ]; then
            keep "holds main, which a worktree carries by rule, never the hub -- §60"
        elif ! on_a_landed_ref; then
            keep "HEAD ${head:0:8} is not on ${landed[*]}"
        elif [ -n "$(git -C "$tree" status --porcelain)" ]; then
            keep "uncommitted changes"
        elif [ -n "$(find "$tree/fuzz/artifacts" -type f -not -name '*-overnight-selftest-*' -print -quit 2>/dev/null)" ]; then
            keep "fuzz/artifacts holds files, and nothing else may have a copy"
        elif [ "$idle" -lt 60 ] && [ ! -e "$gitdir/rcad-run-over" ]; then
            keep "HEAD moved $idle minutes ago"
        elif printf '%s\n' "$cwds" | awk -v p="$tree" '$0 == p || index($0, p "/") == 1 { found = 1 } END { exit !found }'; then
            keep "a process is running in it"
        else
            git -C "$here" worktree remove "$tree"
            echo "removed: $tree [${branch#refs/heads/}${branch:+ }at ${head:0:8}]"
        fi
    done < <(git -C "$here" worktree list --porcelain | awk '
        function flush() { if (tree != "" && n > 1) print tree "\t" head "\t" locked "\t" branch }
        /^worktree / { flush(); tree = substr($0, 10); head = ""; branch = ""; locked = 0; n++ }
        /^HEAD /     { head = $2 }
        /^branch /   { branch = $2 }
        /^locked/    { locked = 1 }
        END          { flush() }')
    main_tree=$(git -C "$here" worktree list --porcelain \
        | awk '/^worktree / { tree = substr($0, 10) } $0 == "branch refs/heads/main" { print tree }')
    [ -n "$main_tree" ] || { echo "no worktree holds main, so no branch was deleted: §60 keeps main in a worktree of its own"; exit 1; }
    attached=$(git -C "$here" worktree list --porcelain | sed -n 's|^branch refs/heads/||p')
    held=$(cd "$here" && python3 '{{justfile_directory()}}/tooling/queue/queue.py' held)
    unused=$(git -C "$here" for-each-ref --merged=main --format='%(refname:lstrip=2)' refs/heads/ \
        | awk -v keep="$attached"$'\n'"$held" 'BEGIN { split(keep, k, "\n"); for (i in k) kept[k[i]] = 1 } !($0 in kept)')
    deleted=0
    if [ -n "$unused" ]; then
        printf '%s\n' "$unused" | xargs -d '\n' git -C "$main_tree" branch -d >/dev/null
        deleted=$(printf '%s\n' "$unused" | wc -l)
    fi
    echo "$kept worktree(s) kept; $deleted branch(es) main holds deleted"

# `prune-worktrees` against a throwaway repository laid out like this one: a
# detached hub, `main` in a worktree of its own, one worktree for each reason to
# keep a tree, and four with none.
#
# Each keep case fails exactly one of the recipe's conditions and passes the
# rest, so deleting any single condition removes exactly one tree it should
# have kept, and this names which. The first two removed trees are the two
# shapes a finished lane ends in here: detached on a commit only `origin/main`
# has, and on a branch merged into `main`. The first also holds an ignored
# `target/`, which `git worktree remove` must not refuse over. Everything is
# aged two hours except `just-started`, which is the case the age exists for,
# and `marked`, which `mark-finished` lets past the age (§315.2). `fakes` holds
# only what `check-fuzz-overnight-selftest` leaves when it is killed (§315.3).
#
# Then the branches (§458). `merged` loses its tree, so its branch goes with
# `landed` and `released`, which no tree ever had. `runner` is checked out,
# `held` is held by a queue row, `unlanded` is on no landed ref, and
# `origin-only` is only on `origin/main`, so all four stay, as does `main`.
# `released` was held, and its row's release is what lets it go.
[private]
check-prune-worktrees-selftest:
    #!/usr/bin/env bash
    set -euo pipefail
    # Resolved, because `/proc/*/cwd` is, and a symlink in `TMPDIR` would
    # otherwise make the busy tree look idle.
    dir=$(realpath "$(mktemp -d)")
    busy=
    got=
    trap '[ -z "$busy" ] || kill "$busy" 2>/dev/null || true; git -C "$dir/hub" worktree unlock "$dir/locked" 2>/dev/null || true; rm -rf "$dir"' EXIT
    fail() {
        echo "prune-worktrees drifted from its own fixtures: $1"
        echo "--- got ---"; echo "$got"
        exit 1
    }
    git init -q -b main "$dir/hub"
    git -C "$dir/hub" config user.email t@t
    git -C "$dir/hub" config user.name t
    printf 'target/\nfuzz/artifacts/\n' >"$dir/hub/.gitignore"
    git -C "$dir/hub" add .gitignore
    git -C "$dir/hub" commit -q -m root
    git -C "$dir/hub" checkout -q --detach
    git -C "$dir/hub" worktree add -q "$dir/wave" main
    git -C "$dir/hub" worktree add -q "$dir/runner" -b runner
    git -C "$dir/hub" worktree add -q "$dir/merged" -b merged
    for name in finished just-started marked fakes unmerged dirty untracked fuzzed locked busy nightly; do
        git -C "$dir/hub" worktree add -q --detach "$dir/$name" main
    done
    printf '[Service]\nWorkingDirectory=%s\n' "$dir/nightly" >"$dir/rcad-fuzz.service"
    git -C "$dir/finished" commit -q --allow-empty -m "landed on origin/main only"
    git -C "$dir/hub" update-ref refs/remotes/origin/main "$(git -C "$dir/finished" rev-parse HEAD)"
    mkdir "$dir/finished/target"; echo build >"$dir/finished/target/out"
    git -C "$dir/merged" commit -q --allow-empty -m "landed work"
    git -C "$dir/wave" merge -q merged
    git -C "$dir/unmerged" commit -q --allow-empty -m "on no landed ref"
    for name in landed held released; do
        git -C "$dir/hub" branch "$name" main
    done
    git -C "$dir/hub" branch unlanded "$(git -C "$dir/unmerged" rev-parse HEAD)"
    git -C "$dir/hub" branch origin-only origin/main
    printf 'take\tQ1\t2026-10-19T00:00:00Z\t%s\theld\t-\t2\ntake\tQ2\t2026-10-19T00:00:00Z\t%s\treleased\t-\t2\nrelease\tQ2\t2026-10-19T01:00:00Z\t%s\tdone\n' \
        "$dir/runner" "$dir/runner" "$dir/runner" >"$dir/hub/.git/rcad-queue-claims"
    echo change >"$dir/dirty/.gitignore"
    echo new >"$dir/untracked/new"
    mkdir -p "$dir/fuzzed/fuzz/artifacts/target"; echo crash >"$dir/fuzzed/fuzz/artifacts/target/crash-1"
    mkdir -p "$dir/fakes/fuzz/artifacts/target"; echo "what a target found" >"$dir/fakes/fuzz/artifacts/target/slow-unit-overnight-selftest-1-2"
    git -C "$dir/hub" worktree lock --reason "agent-abc since 2026-09-06T00:00:00Z" "$dir/locked"
    for name in wave runner merged finished fakes unmerged dirty untracked fuzzed locked busy nightly; do
        gitdir=$(git -C "$dir/$name" rev-parse --absolute-git-dir)
        touch -d '2 hours ago' "$gitdir/HEAD" "$gitdir/logs/HEAD"
    done
    # A refusal marks nothing: `just-started` is named first, and it is still
    # kept for its age below.
    ! just mark-finished "$dir/just-started" "$dir/locked" >/dev/null 2>&1 \
        || fail "mark-finished marked a locked tree, whose owner is still at work"
    ! just mark-finished "$dir/hub" >/dev/null 2>&1 \
        || fail "mark-finished marked the hub"
    just mark-finished "$dir/marked" >/dev/null
    (cd "$dir/busy/" && exec sleep 300) &
    busy=$!
    got=$(just prune-worktrees "$dir/runner" "$dir/rcad-fuzz.service")
    [ -d "$dir/hub/.git" ] || fail "the hub was removed"
    expect_kept() {
        [ -d "$dir/$1" ] || fail "the $1 tree was removed"
        grep -F "): $dir/$1" <<<"$got" | grep -qF "kept ($2" \
            || fail "the $1 tree was not reported as kept for '$2'"
    }
    expect_kept wave "holds main"
    expect_kept runner "you are standing in it"
    expect_kept just-started "HEAD moved"
    expect_kept unmerged "HEAD "
    expect_kept dirty "uncommitted changes"
    expect_kept untracked "uncommitted changes"
    expect_kept fuzzed "fuzz/artifacts holds files"
    expect_kept locked "locked, an agent is using it"
    expect_kept busy "a process is running in it"
    expect_kept nightly "the overnight fuzz unit runs in it"
    for name in finished merged marked fakes; do
        [ ! -e "$dir/$name" ] || fail "the $name tree was not removed"
        grep -qF "removed: $dir/$name " <<<"$got" || fail "the $name tree was not reported as removed"
    done
    [ "$(grep -c '^removed' <<<"$got")" = 4 ] || fail "more than the four finished trees were removed"
    for branch in main runner held unlanded origin-only; do
        git -C "$dir/hub" rev-parse -q --verify "refs/heads/$branch" >/dev/null || fail "the $branch branch was deleted"
    done
    for branch in merged landed released; do
        ! git -C "$dir/hub" rev-parse -q --verify "refs/heads/$branch" >/dev/null || fail "the $branch branch was not deleted"
    done
    grep -qxF "10 worktree(s) kept; 3 branch(es) main holds deleted" <<<"$got" \
        || fail "the tally is not the ten kept trees and the three deleted branches"

# Where this repo stands, in one call.
#
# Collecting that from cold took twelve tool calls and a lookup lane on
# 2026-09-14, and every ingredient was already here and simply never assembled:
# `lanes` has who holds what, `gh` has the last green, `decisions-toc` has how
# far the record has got. The one fact nothing printed is the one that took
# longest — which *branches* carry something `main` does not — because `lanes`
# lists worktrees, and a worktree is not a branch.
#
# **Five rows, and the first of them is the one a recipe cannot compute.** What
# unit the work is in is a judgement, so it is written down in
# `docs/decisions.md` §0 and this prints it; §102 argues why there and not in a
# file of its own. The other four are facts, and they are read fresh every time.
#
# **The queue's ready rows follow §0**, because since §230 they are what §0's
# "Next" line used to be: what the free slots take. `queue ready` prints them in
# the order a fill does; its stderr is left to show, so a queue it cannot read
# says why here rather than looking empty.
#
# **The morning's fuzz triage follows the queue**, because a group still
# failing on `main` that no open row names is queue work nobody has filed yet.
# Triage itself files nothing (§410.5).
#
# **It never fails.** A row that cannot be answered says so in place of its
# answer — the shape `fuzz-watermark` already has, and for the same reason: a
# survey that exits non-zero because `gh` was not on PATH is a survey nobody
# runs before deciding what to do next.
[doc("Where the work is, who holds what, and what is not landed on main yet.")]
status dir=".":
    #!/usr/bin/env bash
    set -uo pipefail

    echo "=== where the work is (docs/decisions.md §0) ==="
    block=$({{ just_executable() }} decision 0 2>&1) || block="docs/decisions.md has no §0; \`just check-where-the-work-is\` says what it should hold"
    echo "$block"
    reviewed=$(sed -n 's/^reviewed: *//p' <<<"$block" | head -1)
    if [ -n "$reviewed" ] && stamp=$(date -d "$reviewed" +%s 2>/dev/null); then
        echo "(last reviewed $(( ( $(date +%s) - stamp ) / 86400 )) days ago)"
    fi

    echo
    echo "=== ready in the queue (docs/queue.md, §230) ==="
    {{ just_executable() }} queue ready
    echo "(\`just queue\` for what is running and waiting too, \`just queue next\` for what the free slots take)"

    echo
    echo "=== the morning's fuzz triage (§410) ==="
    {{ just_executable() }} _status-triage '{{ fuzz_log_root }}' '{{ queue_file }}'

    echo
    echo "=== the board ==="
    {{ just_executable() }} _plan-summary
    echo "(\`just plan\` for the roadmap with a box beside every item, \`just plan open\` for what is left)"

    echo
    echo "=== lanes ==="
    {{ just_executable() }} lanes '{{dir}}'

    echo
    echo "=== branches carrying work main does not have ==="
    {{ just_executable() }} _status-branches '{{dir}}' main

    echo
    echo "=== main against the last green ==="
    {{ just_executable() }} _status-green '{{dir}}' main

    echo
    echo "=== docs/decisions.md ==="
    {{ just_executable() }} decisions-toc | awk '
        { n = $1 + 0; if (n > top) top = n; seen[n] = 1; count += 1 }
        END {
            if (!count) { print "the toc printed nothing, so this counted no sections"; exit }
            gaps = ""
            for (i = 1; i < top; i++) if (!(i in seen)) gaps = gaps (gaps ? ", " : "") i
            printf "%d sections, highest is %d%s\n", count, top, \
                (gaps ? "; no section " gaps " — a gap is normal, a number is picked against every branch" : "")
        }'

plan_file := "docs/plan.md"
roadmap_file := "docs/roadmap.md"

# The roadmap with a box beside every item, and what fills each box.
#
# **`docs/roadmap.md` may not carry this and never will.** §1 of
# `docs/decisions.md` says it is the north star and not a description of this
# codebase — that is why it has one commit in the repository's whole history,
# and why a later reader is told not to "fix" the code back to match it. So the
# state goes beside it rather than in it, and this recipe renders the two
# together. `docs/decisions.md` §105.
#
# **`docs/plan.md` holds no titles.** It is a line per item: the roadmap number,
# a state, and the evidence. The titles come from the roadmap at render time, so
# there is exactly one copy of them and `plan.md` cannot drift into describing a
# roadmap that has been rewritten. The item list is not stored either — it is
# derived, and `check-plan` fails when the two disagree.
#
# `just plan open` leaves out what is finished, which is the list lanes are cut
# from.
[doc("The roadmap with a box beside every item: `just plan`, or `just plan open`.")]
plan filter="":
    #!/usr/bin/env bash
    set -uo pipefail
    {{ just_executable() }} _plan-items '{{ roadmap_file }}' | awk -F'\t' -v filter='{{filter}}' '
        FILENAME == "-" || started { }
        { items[$1] = $2; section[$1] = $3; order[++n] = $1 }
        END {
            while ((getline line < "{{ plan_file }}") > 0) {
                if (line !~ /^[0-9]/) continue
                split(line, f, /[ \t]+/)
                id = f[1]; state[id] = f[2]
                sub(/^[^ \t]+[ \t]+[^ \t]+[ \t]*/, "", line); why[id] = line
            }
            for (i = 1; i <= n; i++) {
                id = order[i]
                s = (id in state) ? state[id] : "unaudited"
                if (filter == "open" && (s == "done" || s == "n/a")) continue
                if (section[id] != lastsection) {
                    printf "\n%s\n", section[id]
                    lastsection = section[id]
                }
                printf "  [%s] %-5s %-10s %s\n", (s == "done" || s == "n/a") ? "x" : " ", id, s, items[id]
                if (why[id] != "") printf "              %s\n", why[id]
            }
        }'
    echo
    {{ just_executable() }} _plan-summary

# The counts, on one line, so `status` can carry the plan without printing it.
[private]
_plan-summary:
    #!/usr/bin/env bash
    set -uo pipefail
    {{ just_executable() }} _plan-items '{{ roadmap_file }}' | awk -F'\t' '
        { order[++n] = $1 }
        END {
            while ((getline line < "{{ plan_file }}") > 0) {
                if (line !~ /^[0-9]/) continue
                split(line, f, /[ \t]+/); state[f[1]] = f[2]
            }
            for (i = 1; i <= n; i++) {
                id = order[i]
                count[(id in state) ? state[id] : "unaudited"] += 1
            }
            printf "plan: %d items — %d done, %d partly, %d todo, %d unaudited, %d n/a\n", \
                n, count["done"], count["partly"], count["todo"], \
                count["unaudited"], count["n/a"]
        }'

# The roadmap's build items, derived rather than listed anywhere.
#
# An item is a **deepest heading under §3 to §11** — the layers and the testing
# apparatus. §1 and §2 are scope and foundational argument, §12 to §15 are the
# milestone list, the risk register and the reading, and none of those is a
# thing that gets built. A `## N.` with `### N.M` children contributes the
# children; one without contributes itself, which is how §3 and §8 get a line.
#
# Deriving it is the point. A stored list is a second copy of the roadmap's
# shape, and §60's argument applies to a shape exactly as it applies to a
# record: the copy is what goes stale when a section is added.
[private]
_plan-items file:
    #!/usr/bin/env bash
    set -uo pipefail
    awk -F'\n' '
        /^## [0-9]+\./ {
            flush()
            rest = substr($0, 4); p = index(rest, " ")
            top = substr(rest, 1, p - 1); sub(/\.$/, "", top)
            title = substr(rest, p + 1)
            want = (top + 0 >= 3 && top + 0 <= 11)
            heading = "roadmap §" top "  " title
            kids = 0
            next
        }
        /^### [0-9]+\.[0-9]+ / {
            if (!want) next
            kids = 1
            rest = substr($0, 5); p = index(rest, " ")
            printf "%s\t%s\t%s\n", substr(rest, 1, p - 1), substr(rest, p + 1), heading
        }
        END { flush() }
        function flush() {
            if (want && !kids && top != "") printf "%s\t%s\t%s\n", top, title, heading
        }' '{{file}}'

# `docs/plan.md` still describes `docs/roadmap.md`, and says nothing it cannot
# show you.
#
# **The item lists must agree exactly.** A roadmap gaining a subsection that
# `plan.md` never hears about is the whole failure this file could otherwise
# have: it would go on reading complete while covering a roadmap that has moved.
# So the list is derived on both sides of the comparison and a difference in
# either direction fails, naming the numbers.
#
# **A box is ticked only against evidence that exists.** `done` and `n/a` are
# the two states that tick, and a `done` whose evidence names a path under
# `crates/` or `docs/` is checked against the disk. That is §15.6's rule — a
# published bound needs a test — applied to a published checkbox. It cannot
# check that the evidence *proves* the item, which is why the audit that fills
# this file names a module or a test rather than an opinion.
[doc("docs/plan.md still covers docs/roadmap.md, and every ticked box names something real.")]
check-plan:
    #!/usr/bin/env bash
    set -uo pipefail
    {{ just_executable() }} _plan-check '{{ roadmap_file }}' '{{ plan_file }}'

# Held apart from the recipe above so the selftest can run it over fixtures
# whose answer is known.
[private]
_plan-check roadmap plan:
    #!/usr/bin/env bash
    set -uo pipefail
    roadmap='{{roadmap}}'
    plan='{{plan}}'
    [ -f "$plan" ] || { echo "$plan does not exist, so nothing records how far the roadmap has got"; exit 1; }

    wanted=$({{ just_executable() }} _plan-items "$roadmap" | cut -f1 | sort -u)
    [ -n "$wanted" ] || { echo "no build items were parsed out of $roadmap, so this compared nothing"; exit 1; }
    got=$(grep -E '^[0-9]' "$plan" | awk '{ print $1 }' | sort -u)

    missing=$(comm -23 <(echo "$wanted") <(echo "$got") | tr '\n' ' ')
    extra=$(comm -13 <(echo "$wanted") <(echo "$got") | tr '\n' ' ')
    if [ -n "${missing// }" ] || [ -n "${extra// }" ]; then
        [ -z "${missing// }" ] || echo "in $roadmap but not in $plan: $missing"
        [ -z "${extra// }" ] || echo "in $plan but not in $roadmap: $extra"
        echo "^ the plan no longer covers the roadmap, so its completeness means nothing"
        exit 1
    fi

    dupes=$(grep -E '^[0-9]' "$plan" | awk '{ print $1 }' | sort | uniq -d | tr '\n' ' ')
    if [ -n "${dupes// }" ]; then
        echo "$plan lists these items twice, and the second wins silently: $dupes"
        exit 1
    fi

    bad=0
    while read -r id state rest; do
        case "$state" in
        done|partly|todo|unaudited|n/a) ;;
        *) echo "$id: '$state' is not a state; they are done, partly, todo, unaudited, n/a"; bad=1; continue ;;
        esac
        if [ -z "$rest" ]; then
            echo "$id: state '$state' with no evidence after it"
            bad=1
            continue
        fi
        [ "$state" = "done" ] || continue
        for token in $(tr ',;' '  ' <<<"$rest"); do
            case "$token" in
            crates/*|docs/*|fuzz/*) [ -e "${token%%,}" ] || { echo "$id is done on '$token', which is not in the tree"; bad=1; } ;;
            esac
        done
    done < <(grep -E '^[0-9]' "$plan")
    [ "$bad" -eq 0 ] || { echo "^ a ticked box naming something that is not there is worse than an empty one"; exit 1; }

# Pins the derivation and the comparison against fixtures, because the live
# files cannot exercise either: they agree today by construction, so a
# `_plan-check` that had stopped comparing would pass every run.
#
# The fixtures are the four ways this goes wrong — a roadmap that grew an item,
# a plan that invented one, a box ticked against a path that is not there, and a
# state nobody defined — plus a good pair, because a check that rejects
# everything passes every negative case.
[private]
check-plan-selftest:
    #!/usr/bin/env bash
    set -uo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    fail() {
        echo "plan drifted from its own fixtures: $1"
        echo "--- got ---"; echo "$got"
        exit 1
    }

    cat > "$dir/roadmap.md" <<'MD'
    # A roadmap
    ## 1. Scope
    ### 1.1 Not a build item
    ## 3. Layer 0
    ## 4. Layer 1
    ### 4.1 First
    ### 4.2 Second — with an em-dash in the title
    ## 12. Milestones
    ### 12.1 Also not a build item
    MD
    sed -i 's/^    //' "$dir/roadmap.md"

    got=$(just _plan-items "$dir/roadmap.md" | cut -f1 | tr '\n' ' ')
    [ "$got" = "3 4.1 4.2 " ] \
        || fail "the item list is '$got', expected '3 4.1 4.2 ' — §1 and §12 are not build items, and §3 has no children"

    printf '3 done crates\n4.1 todo nothing yet\n4.2 n/a prose only\n' > "$dir/plan.md"
    got=$(just _plan-check "$dir/roadmap.md" "$dir/plan.md" 2>&1) \
        || fail "a plan that covers the roadmap was rejected"

    printf '3 done crates\n4.1 todo nothing yet\n' > "$dir/short.md"
    got=$(just _plan-check "$dir/roadmap.md" "$dir/short.md" 2>&1) \
        && fail "a plan missing an item the roadmap has was accepted"
    grep -qF "but not in $dir/short.md: 4.2" <<<"$got" \
        || fail "the missing item was not named"

    printf '3 done crates\n4.1 todo x\n4.2 todo x\n9.9 todo invented\n' > "$dir/extra.md"
    got=$(just _plan-check "$dir/roadmap.md" "$dir/extra.md" 2>&1) \
        && fail "a plan naming an item the roadmap does not have was accepted"
    grep -qF "9.9" <<<"$got" || fail "the invented item was not named"

    printf '3 done crates/there-is-no-such-directory\n4.1 todo x\n4.2 todo x\n' > "$dir/liar.md"
    got=$(just _plan-check "$dir/roadmap.md" "$dir/liar.md" 2>&1) \
        && fail "a ticked box naming a path that is not in the tree was accepted"
    grep -qF "is not in the tree" <<<"$got" || fail "the absent path was not named"

    printf '3 finished crates\n4.1 todo x\n4.2 todo x\n' > "$dir/state.md"
    got=$(just _plan-check "$dir/roadmap.md" "$dir/state.md" 2>&1) \
        && fail "an undefined state was accepted"

    printf '3 done\n4.1 todo x\n4.2 todo x\n' > "$dir/bare.md"
    got=$(just _plan-check "$dir/roadmap.md" "$dir/bare.md" 2>&1) \
        && fail "an item with a state and no evidence was accepted"

    # As in check-status-selftest: every assertion above is `command && fail`,
    # so the last one leaves its own non-zero status behind when it passes.
    exit 0

# The queue of `docs/decisions.md` §230: one file holding a row per open item,
# and a fill that gives every free slot the highest ready row that fits. Four
# slots stay (447.3 replaces §397.7's load bar with a bar on what the load
# costs, and four slots pass it); one of them is kept for a Sonnet row while
# one is ready (§447.3). §230.8 had six. It lives here so that `queue next`
# and the line `check-queue` prints on a pass count against the same one.
queue_file := "docs/queue.md"
queue_slots := "4"

# How many rows tagged `small` one lane takes at once (§352.4). Five small rows
# of about ten minutes each fit the 45 minutes a lane is given (`lane.md`), with
# the gate run once for all of them.
queue_bundle := "5"

# Files two lanes may hold at once (§424.4): a whole-file entry on one of
# these, or the same item in it, only meets once two running lanes, rows held
# elsewhere or rows taken above already hold it. A directory above the file
# still meets everything under it, and every other path keeps §230.3's rule.
queue_shared_files := "crates/rcad-topo/src/fuse/arrange.rs,crates/rcad-topo/src/fuse/assemble.rs"

# How many slots are held, when a fixture needs to say so. Empty — always, outside
# a selftest — means `queue next` counts the machine (§263.4): a queue file under
# `mktemp` has no machine of its own, and one counted from wherever the selftest
# happens to run is §173's check that answers for its environment.
queue_running := ""

# Where `queue-page` writes, so a selftest can point it at a scratch directory
# instead of Mattias's real page (§230, §263). `check-queue-page-selftest` and
# `check-queue-api-selftest` both set `RCAD_QUEUE_PAGE_DIR`, and the gate must
# never write `~/rcad-queue-page` — the two facts are the same one. Both set
# `RCAD_FUZZ_LOGS` too, so the page they render reads a fixture night or none,
# never whatever `~/rcad-fuzz-logs` holds on the machine running the gate.
queue_page_dir := env_var_or_default("RCAD_QUEUE_PAGE_DIR", env_var("HOME") / "rcad-queue-page")

# **One parse, and both readers use it.** `queue` decides what to dispatch and
# `check-queue` decides whether the file is sound. If each split a row its own
# way, a row could pass the check and still be read differently by the fill. So
# this is the one place that knows what a row is: a line inside a fence, five
# fields and then the description (§230.2).
#
# It prints a record per `##` heading, per fence line and per row, and one more
# when a fence is left open at the end. Fields are split by the unit separator
# `\037`, because no row can hold one and a tab or a space can.
[doc("Split docs/queue.md into its headings, fences and rows, once, for queue and check-queue to share.")]
_queue-rows file:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -f '{{ file }}' ] || { echo "{{ file }}: no such file" >&2; exit 1; }
    LC_ALL=C awk '
        BEGIN { S = "\037"; head = ""; inside = 0 }
        /^```/ {
            print "F" S NR S (inside ? "close" : "open") S head
            if (!inside) opened = NR
            inside = !inside
            next
        }
        inside && /[^ \t]/ {
            rest = $0
            for (i = 1; i <= 5; i++) sub(/^[ \t]*[^ \t]+/, "", rest)
            sub(/^[ \t]+/, "", rest)
            print "R" S NR S head S NF S $1 S $2 S $3 S $4 S $5 S rest S $0
            next
        }
        inside { next }
        /^## / { head = substr($0, 4); print "H" S NR S head }
        END { if (inside) print "U" S opened S head }
    ' '{{ file }}'

# What to dispatch next, read from `docs/queue.md` (§230).
#
# With no mode it prints the ready rows, highest tier first, then what is
# running, then what is waiting and on which rows, then how many are parked.
# `ready` prints the ready rows and nothing else, for `status` to show. `next
# [N]` is §230.3's fill: each slot takes the first ready row of the highest tier
# that meets no running lane, no row taken above it and no pinned row skipped
# above it, and every row it passes over says which of its entries met which.
# N defaults to the free slots. `blocked` prints the line `next` passes a row
# over with, for every ready row whose write set meets a running lane's, as if
# nothing were taken or skipped above it: the rows a fill holds back however
# many slots are free, less those only a skipped pinned row holds back. The
# queue page reads it (Q1510), so the rule for when two write sets meet stays
# here alone.
#
# **The order comes from the tier field, not from where a row sits.**
# `check-queue` makes the two agree, but the fill does not lean on that having
# run, and its fixtures put a Tier 3 block above Tier 2.5, and Tier 2.2 above
# Tier 2, to show it. The tiers go 1, 2, 2.2, 2.5, 3, 4, 5 (§307, §403), and a
# row whose tier is none of them is refused rather than left out of the fill.
#
# **Tiers 1 and 5 go in class order** (§352.3, §403.3). A defect's description
# may start with a class: how bad the defect is, then how likely a user's model
# meets it. A and B are tier 1 and C and D tier 5, so the fill walks tier 1 as
# wrong/A, wrong/B, crash/A, crash/B, refuses/A, refuses/B, then the rows with
# no class, and tier 5 as wrong/C, crash/C, refuses/C, then the rows with no
# class that wait on a tier 5 row (§435.5), then the same for D. The measure
# line counts the rows with no class in each of the two tiers (§435.7). The
# file's order only breaks ties inside one class. The line order cannot carry
# it: the merge driver keeps the frame side's order within a block, so a merge
# across a re-tag would undo it.
#
# **Rows tagged `small` go out in bundles** (§352.4): one lane takes up to
# `queue_bundle` of them, and its line is `take Q1,Q2 (a bundle of 2 small rows,
# one lane)` with each row's text indented under it. A full bundle that meets
# nothing running goes to the first slot after the pinned rows, ahead of tier 1.
# Otherwise a small row
# waits for the walk to reach its tier, and takes the next ready small rows with
# it. It is never taken alone, and the rows of one bundle may overlap each other,
# since one lane does them all. The plain output ends with §352.6's measure,
# then the count of §450.3's families.
#
# **Rows Mattias pinned go first** (§430). A description starting `pinned/<n>`
# is a row he put at the head of the queue, and the fill takes the ready ones
# before anything else, the full bundle too, in the order of n. Not in the
# order of the file, for the reason above: the merge driver keeps one side's
# line order. A class or `small` after the pin still counts. A pinned row a
# running lane blocks is skipped with the usual line, and one that waits is not
# ready, so a chain of pinned rows goes out one row at a time as each lands.
# Every row the fill reaches after a skipped pinned row, a later pin and the
# full bundle included, is skipped too where it meets that row's write set,
# with a line ending `pinned and skipped above` (§430.7): so the lanes in the
# pin's way drain and no new one takes their place, and the pin is taken once
# they have. A skipped pin counts as a holder of a `queue_shared_files` file it
# names, as a row taken above does.
#
# **A row says which row it came from** (§432), in the word after the pin and
# the class: `from/<id>` when running `<id>` is why it exists, `was/<id>` when it
# files `<id>` again, `from/-` when nothing else led to it. A fault a crash file
# or a corpus file shows says `from/fuzz:<target>` or `from/step:<file>` instead
# (§433), and `add` checks that the target or the file is there. `add` refuses a
# row without the word, and `just land` writes `from/<the lane's row>` for a
# lane that names none. The fill never reads it; it is there to count how far
# each row's work grows, and how much each fuzz target and corpus file found.
#
# **Two write sets meet** on the same path, unless both name items in it and the
# items differ (§230.6); on a directory ending in `/` that holds the other path;
# and `-` meets nothing. The directory test is a prefix test on a name that ends
# in `/`, so `crates/rcad-fuse/` does not hold `crates/rcad-fuse-extra/x.rs`.
#
# **A whole-file entry on a `queue_shared_files` file, or the same item in it,
# only meets once two holders already have it** (§424.4, §424.8): a running
# lane, a row held elsewhere, a row taken above or a pinned row skipped above
# (§430.7), any two of the four. The third such entry is what meets; the first
# two do not. A directory that holds
# the file is not such an entry, so it still meets everything under it at once,
# and every path off the list keeps the plain rule above.
#
# What it cannot read — an open fence, a short row, a state it does not know —
# it refuses rather than guesses at, and points at `check-queue` for the why.
#
# **`families` lists the places to trace before fixing one row** (§450.3 rule
# 1): three or more open rows, not parked, whose write sets name one
# `tests/*.rs` file. A row whose text, after its pin, class and from word, starts
# `Trace the family on <file>` is a trace, open or closed, and the ids after the
# file are the rows it covered. A file a trace has been on is a family again
# only once three open rows no trace named share it. The plain output counts
# them on its last line, and the queue page lists them. The logic is
# `tooling/queue/families.py`.
#
# **The verbs change the file, one row at a time** (§263): `take`, `add`,
# `done`, `drop`, `park`, `after`, `rank`, `tier`, `tag`, `pick`, `pin` and
# `unpin`, with `show`, `running` and `families` to read, and `narrow`, which changes a hold
# and no row. `tier` moves an open row to another tier and, like
# `add`, writes that tier's heading when the file has none (§307). `tag` sets,
# replaces or removes a row's class or `small` (§352.2), and a class moves the
# row to the tier it names (§403.4). `pin` and `unpin` are Mattias's alone
# (§430): the queue write guard asks him before any command that runs one, and
# of the other verbs only `take`, `done` and `pick` touch a pinned row.
# Only `done` ends a wait, so `after <id> -` sets a waiting row back to `todo`:
# a drop that leaves rows waiting on it is refused, with the `after` step for
# each of them, and goes through with those steps in the same `apply` (§451).
# Each takes the lock on the claims file in the git common directory, checks the
# file as it would be with `check-queue`, and writes only if that passes. `just
# queue take` with no arguments, or any verb given the wrong ones, prints the
# usage of all of them. The logic is `tooling/queue/queue.py`; this only hands
# it the arguments.
#
# **`apply` runs several of those verbs as one batch** (§309): `just queue
# apply take Q241 lane-a + take Q270 lane-b + add 2 sonnet - 'from/Q241 what' +
# after @1 Q270`. A standalone `+` separates the steps, which land on the file in
# order, each seeing the ones before it, under one hold of the claims lock; a
# refused step names its own number and text and aborts the whole batch before
# anything is written. `@1`, `@2`, ... stand for the ids the batch's own first,
# second, ... `add` hands out.
#
# **`next` counts the machine, not this copy** (§263.4). A slot is held by every
# worktree an agent has locked that is not a session's own tree — every lane and
# every verifier, whichever dispatcher sent it — and by every row taken with no
# tree yet. `lane:` rows in this copy still say which write sets are busy, and so
# do rows another dispatcher holds, from its hold or its own copy.
#
# **A lane narrows its hold once it knows where it works** (§424.3, §424.7).
# `narrow <id> <write set>` writes the claims file alone, so a lane runs it from
# its own tree, and the fill reads the narrowed set in place of the one the row
# was taken with: from the hold for a row held elsewhere, and from the claims
# file's `narrowed` records for this copy's own `lane:` rows, which the plain
# listing marks `narrowed to`. Every entry lies inside the taken set. One inside
# it but outside the current set widens the hold back, and `narrow` asks `meets
# <id> <write set>` whether that meets another hold: `meets` reads holds in
# `elsewhere`'s records from its input and prints the skip line of the first
# one the write set meets, so the rule for when two write sets meet stays here
# alone.
#
# **Every verb that writes — `take`, `add`, `done`, `drop`, `park`, `after`,
# `rank`, `tier`, `tag`, `pick`, `pin`, `unpin`, `apply`, `narrow` — also runs `queue-page` after it**, so the page
# stays current as a side effect instead of needing its own trigger (Q254). Its
# own exit code is what this returns; a render that fails says so on stderr and
# fails nothing, since a bad page is not a reason to lose a queue write that
# already landed. `show`, `running` and `families` only read, so none runs it.
[doc("What to dispatch from docs/queue.md, and the verbs that change it one row at a time: `just queue take` prints their usage.")]
queue mode="" *args:
    #!/usr/bin/env bash
    set -uo pipefail
    mode="${1:-}"
    case "$mode" in
        take|add|done|drop|park|after|rank|tier|tag|pick|pin|unpin|apply|narrow)
            QUEUE_FILE='{{ queue_file }}' QUEUE_JUST='{{ just_executable() }}' QUEUE_JUSTFILE='{{ justfile() }}' \
                python3 '{{ justfile_directory() }}/tooling/queue/queue.py' "$@"
            status=$?
            {{ just_executable() }} --justfile '{{ justfile() }}' --working-directory "$PWD" queue-page || true
            exit "$status" ;;
        show|running|families)
            QUEUE_FILE='{{ queue_file }}' QUEUE_JUST='{{ just_executable() }}' QUEUE_JUSTFILE='{{ justfile() }}' \
                exec python3 '{{ justfile_directory() }}/tooling/queue/queue.py' "$@" ;;
        help)
            printf '%s\n' \
                'just queue                                   ready rows by tier, then running, waiting, parked' \
                'just queue ready                             the ready rows alone, for status to show' \
                'just queue blocked                           each ready row a running lane holds back, as next would skip it' \
                'just queue next [N]                          what N free slots take; N defaults to the free slots on this machine' \
                'just queue show <id>                         one row, its hold, and its state in other worktrees' \
                'just queue running                           what holds a slot on this machine, one line each' \
                'just queue families [--count]                three or more open rows on one tests/*.rs file that no trace named (§450.3); --count prints how many' \
                'just queue narrow <id> <write set>           narrow a held row to entries inside the set it was taken with; a lane runs it (§424.7)' \
                'just queue meets <id> <write set>            the skip line for the first hold read from input that the write set meets; narrow asks it' \
                'just queue take <id> <branch>                dispatch a ready row to <branch>: state lane:<branch>, held until done, drop or park' \
                'just queue add <tier> <model> <write set> <what ending in §N>   a new todo row at the foot of its tier; prints the id. <what> starts with from/<id>, was/<id>, from/-, from/fuzz:<target> or from/step:<file>: where the row came from (§432, §433)' \
                'just queue done <id> <merge sha>             close a row as done:<sha>, moved under Closed' \
                'just queue drop <id> <§N>                    close a row as dropped:§N, moved under Closed' \
                'just queue park <id> <§N>                    mark a row parked:§N, left in its tier' \
                'just queue after <id> <id>[,<id>...]         mark a row waiting on others: state after:<ids>' \
                'just queue after <id> -                      a row that waits goes back to todo, for a row whose wait was dropped (§451)' \
                'just queue rank <id> before <id>             move a row to sit just before another, in their shared tier' \
                'just queue tier <id> <tier>                  move an open row to the foot of another tier' \
                'just queue tag <id> <class>|small|-          set, replace or remove a row class or small mark' \
                'just queue pick <id> ours|theirs             keep one side of a row the merge driver left in conflict' \
                'just queue pin <id> [<id>...]                only Mattias runs this (§430): marks each open row pinned, moved to the front of tier 1' \
                'just queue unpin <id> [<id>...]              only Mattias runs this too: takes the pin off; the row stays where it is' \
                'just queue apply <verb> <args> [+ <verb> <args>]...   run several of the verbs above as one all-or-nothing batch' \
                'just queue help                              this list'
            exit 0 ;;
        ""|ready|blocked|next|meets) ;;
        *) echo "queue: '$mode' is not a mode or a verb; run 'just queue help' for every mode and verb it takes" >&2; exit 1 ;;
    esac
    n="${2:-}"
    if [ "$mode" = meets ]; then
        [ $# -eq 3 ] || { echo "queue: meets takes an id and a write set" >&2; exit 1; }
        [ ! -t 0 ] || { echo "queue: meets reads the holds it tests from its input, and its input is a terminal" >&2; exit 1; }
        n=""
    elif [ $# -gt 2 ]; then echo "queue: $mode takes at most one count" >&2; exit 1; fi
    if [ -n "$n" ]; then
        [ "$mode" = next ] || { echo "queue: a count goes with next, and only with next" >&2; exit 1; }
        case "$n" in *[!0-9]*) echo "queue: '$n' is not a number of slots" >&2; exit 1 ;; esac
    fi
    if [ "$mode" = next ]; then
        triage=$({{ just_executable() }} --justfile '{{ justfile() }}' --working-directory "$PWD" _triage-refusal '{{ fuzz_log_root }}' '{{ queue_file }}')
        trc=$?
        if [ "$trc" -ne 0 ]; then
            echo "$triage" >&2
            exit "$trc"
        fi
        [ -z "$triage" ] || echo "$triage"
    fi
    rows=""
    machine=0
    elsewhere=""
    narrowed=""
    if [ "$mode" = meets ]; then
        elsewhere=$(cat)
    else
        rows=$({{ just_executable() }} --justfile '{{ justfile() }}' --working-directory "$PWD" _queue-rows '{{ queue_file }}') || exit 1
        machine='{{ queue_running }}'
        if [ -z "$machine" ]; then
            tool='{{ justfile_directory() }}/tooling/queue/queue.py'
            machine=$(QUEUE_FILE='{{ queue_file }}' python3 "$tool" running --count) || exit 1
            elsewhere=$(QUEUE_FILE='{{ queue_file }}' python3 "$tool" elsewhere) || exit 1
            narrowed=$(QUEUE_FILE='{{ queue_file }}' python3 "$tool" narrowed) || exit 1
        fi
    fi
    families=""
    if [ -z "$mode" ]; then
        families=$(QUEUE_FILE='{{ queue_file }}' python3 '{{ justfile_directory() }}/tooling/queue/queue.py' families --count) || exit 1
    fi
    { printf '%s\n' "$rows"; [ -z "$elsewhere" ] || printf '%s\n' "$elsewhere"; [ -z "$narrowed" ] || printf '%s\n' "$narrowed"; } \
        | LC_ALL=C awk -v mode="$mode" -v n="$n" -v machine="$machine" -v cand_id="${2:-}" -v cand_ws="${3:-}" \
        -v families="$families" \
        -v slots='{{ queue_slots }}' -v bundle='{{ queue_bundle }}' -v file='{{ queue_file }}' \
        -v shared_files='{{ queue_shared_files }}' '
        BEGIN {
            FS = "\037"
            nt = split("1 2 2.2 2.5 3 4 5", tiers, " ")
            for (t = 1; t <= nt; t++) known[tiers[t]] = 1
            nc = split("wrong/A wrong/B wrong/C crash/A crash/B crash/C refuses/A refuses/B refuses/C - wrong/D crash/D refuses/D", classes, " ")
            for (k = 1; k <= nc; k++) if (classes[k] != "-") isclass[classes[k]] = 1
            bundle += 0
            if (bundle < 1) { printf "queue: queue_bundle is %d, and a bundle holds at least one row\n", bundle > "/dev/stderr"; bad = 1; exit 1 }
            ns = split(shared_files, sharedlist, ",")
            for (si = 1; si <= ns; si++) if (sharedlist[si] != "") shared[sharedlist[si]] = 1
        }
        $1 == "U" { refuse($2, "a fence is never closed"); next }
        $1 != "R" { next }
        $2 == "elsewhere" { e++; eid[e] = $5; est[e] = $7; ews[e] = $9; emodel[e] = $11; eraw[e] = $12; heldelse[$5] = e; next }
        $2 == "closedelsewhere" { c++; cst[c] = $7; craw[c] = $11; closedelse[$5] = c; next }
        $2 == "narrowed" { nws[$5] = $9; next }
        $4 < 6 { refuse($2, "a row of " $4 " fields"); next }
        !($6 in known) { refuse($2, "the tier \"" $6 "\""); next }
        {
            r++
            ln[r] = $2; id[r] = $5; tier[r] = $6; st[r] = $7; model[r] = $8; ws[r] = $9; raw[r] = $11
            at[$5] = r
            split($10, word, " ")
            pin[r] = (word[1] ~ /^pinned\/[1-9][0-9]*$/) ? substr(word[1], 8) + 0 : 0
            first = pin[r] ? word[2] : word[1]
            cl[r] = (($6 == "1" || $6 == "5") && (first in isclass)) ? first : "-"
            small[r] = (first == "small")
        }
        END {
            if (bad) exit 1
            running = machine + 0
            if (mode == "meets") {
                r++; id[r] = cand_id; tier[r] = "-"; ws[r] = cand_ws
                blocked(r, 1)
                exit 0
            }
            for (i = 1; i <= r; i++) {
                s = st[i]
                if (s == "todo") kind[i] = "ready"
                else if (s ~ /^lane:/) {
                    kind[i] = "running"; lanes++
                    if (id[i] in nws) { ws[i] = nws[id[i]]; narrowedrow[i] = 1 }
                }
                else if (s ~ /^after:/) {
                    kind[i] = "ready"
                    m = split(substr(s, 7), a, ",")
                    for (j = 1; j <= m; j++)
                        if (!(a[j] in at) || st[at[a[j]]] !~ /^done:/) kind[i] = "waiting"
                }
                else if (s ~ /^parked:/) { kind[i] = "parked"; parkedin[tier[i]]++ }
                else if (s ~ /^(done|dropped):/) kind[i] = "closed"
                else refuse(ln[i], "the state \"" s "\"")
                if (kind[i] == "ready" && (id[i] in heldelse)) kind[i] = "elsewhere"
                if ((kind[i] == "ready" || kind[i] == "waiting") && (id[i] in closedelse)) {
                    kind[i] = "closedelsewhere"; cwhere[i] = cst[closedelse[id[i]]]
                }
            }
            if (bad) exit 1
            w = 0
            for (i = 1; i <= r; i++)
                if (kind[i] == "ready" && pin[i]) {
                    for (x = ++w; x > 1 && pin[walk[x - 1]] > pin[i]; x--) walk[x] = walk[x - 1]
                    walk[x] = i
                }
            pinned_n = w
            for (t = 1; t <= nt; t++)
                for (k = 1; k <= nc; k++)
                    for (i = 1; i <= r; i++)
                        if (kind[i] == "ready" && !pin[i] && tier[i] == tiers[t] && cl[i] == classes[k]) walk[++w] = i

            if (mode == "ready") {
                for (x = 1; x <= w; x++) print raw[walk[x]]
                exit 0
            }

            if (mode == "blocked") {
                for (x = 1; x <= w; x++) blocked(walk[x], 1)
                exit 0
            }

            if (mode == "next") {
                if (n == "") { n = slots - running; if (n < 0) n = 0 }
                n += 0
                if (running + n > slots)
                    printf "note: %d running and %d more is past the %d slots of §397.7\n", running, n, slots
                lanes_n = 0; taken_n = 0; skipped = 0; sonnet_taken = 0
                running_sonnet = running_has_sonnet()
                for (x = 1; x <= pinned_n && lanes_n < n; x++) take_at(x)
                if (lanes_n < n) take_full_bundle()
                for (x = pinned_n + 1; x <= w && lanes_n < n; x++) take_at(x)
                if (n == 0) printf "took 0 of 0: every one of the %d slots is held\n", slots
                else if (lanes_n == n) printf "took %d of %d\n", lanes_n, n
                else if (skipped) printf "took %d of %d: every other ready row meets a running lane, a row taken above or a pinned row skipped above\n", lanes_n, n
                else if (w == 0) printf "took 0 of %d: no row is ready\n", n
                else printf "took %d of %d: no other row is ready\n", lanes_n, n
                exit 0
            }

            print "ready, in the order a fill takes them:"
            if (w == 0) print "    none"
            cur = ""
            for (x = 1; x <= w; x++) {
                i = walk[x]
                if (tier[i] != cur) { print "  tier " tier[i]; cur = tier[i] }
                print "    " raw[i]
            }
            printf "running, %d of %d slots on this machine (`just queue running` names them); the rows held:\n", running, slots
            if (!lanes && !e) print "    none"
            for (i = 1; i <= r; i++)
                if (kind[i] == "running") {
                    print "    " raw[i]
                    if (i in narrowedrow) print "      narrowed to " ws[i]
                }
            for (j = 1; j <= e; j++) print "    " eraw[j]
            print "waiting:"
            none = 1
            for (t = 1; t <= nt; t++)
                for (i = 1; i <= r; i++)
                    if (kind[i] == "waiting" && tier[i] == tiers[t]) {
                        print "    " raw[i]
                        none = 0
                        m = split(substr(st[i], 7), a, ",")
                        line = ""
                        for (j = 1; j <= m; j++)
                            line = line (j > 1 ? ", " : "") a[j] " (" ((a[j] in at) ? st[at[a[j]]] : "not a row") ")"
                        print "      waits on " line
                    }
            if (none) print "    none"
            line = ""
            for (t = 1; t <= nt; t++)
                if (parkedin[tiers[t]]) line = line (line == "" ? "" : ", ") parkedin[tiers[t]] " in tier " tiers[t]
            print "parked: " (line == "" ? "none" : line)
            line = ""
            for (i = 1; i <= r; i++)
                if (kind[i] == "closedelsewhere") line = line (line == "" ? "" : ", ") id[i] " (" cwhere[i] ")"
            print "closed elsewhere: " (line == "" ? "none" : line)
            for (i = 1; i <= r; i++) {
                if (kind[i] == "parked" || kind[i] == "closed" || kind[i] == "closedelsewhere") continue
                if (cl[i] ~ /\/[AB]$/) { ab++; abof[substr(cl[i], 1, index(cl[i], "/") - 1)]++ }
                else if (cl[i] ~ /\/C$/) inc++
                else if (cl[i] ~ /\/D$/) ind++
                else if (tier[i] == "1") unclassed++
                else if (tier[i] == "5") unclassed5++
            }
            for (x = 1; x <= w; x++) if (small[walk[x]]) smallready++
            printf "tier 1, open and not parked: %d in A or B (%d wrong, %d crash, %d refuses), %d with no class; tier 5: %d in C, %d in D, %d with no class; %d small row%s ready, and a bundle is %d\n", \
                ab, abof["wrong"], abof["crash"], abof["refuses"], unclassed, inc, ind, unclassed5, smallready, (smallready == 1 ? "" : "s"), bundle
            printf "families with no trace: %d (§450.3); just queue families lists them\n", families
        }
        function refuse(line, msg) {
            printf "queue: %s:%s: cannot read %s; just check-queue says what is wrong\n", file, line, msg > "/dev/stderr"
            bad = 1
        }
        function take_at(x,    i, y, m, sp) {
            i = walk[x]
            if (i in took) return
            if (!pin[i] && model[i] != "sonnet" && !running_sonnet && !sonnet_taken && lanes_n == n - 1 && !blocked(i, 0)) {
                sp = sonnet_slot_pos()
                if (sp) { take_at(sp); return }
            }
            if (blocked(i, 1)) {
                skipped++
                if (pin[i]) pinheld[++pinheld_n] = i
                return
            }
            if (!small[i]) {
                took[i] = 1; taken[++taken_n] = i; lanes_n++
                if (model[i] == "sonnet") sonnet_taken = 1
                print "take " raw[i]
                return
            }
            m = 1; pick[1] = i
            for (y = x + 1; y <= w && m < bundle; y++)
                if (small[walk[y]] && !(walk[y] in took) && !blocked(walk[y], 0)) pick[++m] = walk[y]
            take_bundle(m)
        }
        function take_full_bundle(    x, y, m, sp, allsonnet) {
            m = 0
            for (x = 1; x <= w && m < bundle; x++)
                if (small[walk[x]] && !(walk[x] in took) && !blocked(walk[x], 0)) pick[++m] = walk[x]
            if (m != bundle) return
            allsonnet = 1
            for (y = 1; y <= m; y++) if (model[pick[y]] != "sonnet") allsonnet = 0
            if (!allsonnet && !running_sonnet && !sonnet_taken && lanes_n == n - 1) {
                sp = sonnet_slot_pos()
                if (sp) { take_at(sp); return }
            }
            take_bundle(m)
        }
        # Q1932, §447.3: one of the free slots is kept for a Sonnet row while one
        # is ready and no running lane is a Sonnet row (a bundled lane counts as
        # Sonnet only when every row in it is). `sonnet_slot_pos` finds the first
        # such row still available in fill order, skipping a small row whose
        # bundle would mix in an Opus row, since the bundle it would take is not
        # a Sonnet take.
        function running_has_sonnet(    i, j, b) {
            for (i = 1; i <= r; i++) {
                if (kind[i] != "running") continue
                b = st[i]
                if (!(b in rb_seen)) { rb_seen[b] = 1; rb_all_sonnet[b] = 1 }
                if (model[i] != "sonnet") rb_all_sonnet[b] = 0
            }
            for (j = 1; j <= e; j++) {
                b = est[j]
                if (!(b in rb_seen)) { rb_seen[b] = 1; rb_all_sonnet[b] = 1 }
                if (emodel[j] != "sonnet") rb_all_sonnet[b] = 0
            }
            for (b in rb_seen) if (rb_all_sonnet[b]) return 1
            return 0
        }
        function bundle_is_pure_sonnet(x,    y, m, allsonnet) {
            m = 1; allsonnet = (model[walk[x]] == "sonnet")
            for (y = x + 1; y <= w && m < bundle; y++)
                if (small[walk[y]] && !(walk[y] in took) && !blocked(walk[y], 0)) {
                    m++
                    if (model[walk[y]] != "sonnet") allsonnet = 0
                }
            return allsonnet
        }
        function sonnet_slot_pos(    x) {
            for (x = pinned_n + 1; x <= w; x++) {
                if (walk[x] in took) continue
                if (model[walk[x]] != "sonnet") continue
                if (blocked(walk[x], 0)) continue
                if (!small[walk[x]] || bundle_is_pure_sonnet(x)) return x
            }
            return 0
        }
        function blocked(i, say,    j, sharedcount, h1, h2) {
            sharedcount = 0
            for (j = 1; j <= r; j++)
                if (kind[j] == "running" && sets_meet(ws[i], ws[j])) {
                    if (meet_shared) {
                        sharedcount++
                        if (sharedcount == 1) h1 = id[j] " (held by " st[j] ")"
                        else if (sharedcount == 2) {
                            h2 = id[j] " (held by " st[j] ")"
                            if (say) printf "skip %s (tier %s): its %s is shared, and %s and %s already hold it\n", id[i], tier[i], mine, h1, h2
                            return 1
                        }
                        continue
                    }
                    if (say) printf "skip %s (tier %s): its %s meets %s\047s %s, held by %s\n", id[i], tier[i], mine, id[j], theirs, st[j]
                    return 1
                }
            for (j = 1; j <= e; j++)
                if (sets_meet(ws[i], ews[j])) {
                    if (meet_shared) {
                        sharedcount++
                        if (sharedcount == 1) h1 = eid[j] " (held elsewhere by " est[j] ")"
                        else if (sharedcount == 2) {
                            h2 = eid[j] " (held elsewhere by " est[j] ")"
                            if (say) printf "skip %s (tier %s): its %s is shared, and %s and %s already hold it\n", id[i], tier[i], mine, h1, h2
                            return 1
                        }
                        continue
                    }
                    if (say) printf "skip %s (tier %s): its %s meets %s\047s %s, held elsewhere by %s\n", id[i], tier[i], mine, eid[j], theirs, est[j]
                    return 1
                }
            for (j = 1; j <= taken_n; j++)
                if (sets_meet(ws[i], ws[taken[j]])) {
                    if (meet_shared) {
                        sharedcount++
                        if (sharedcount == 1) h1 = id[taken[j]] " (taken above)"
                        else if (sharedcount == 2) {
                            h2 = id[taken[j]] " (taken above)"
                            if (say) printf "skip %s (tier %s): its %s is shared, and %s and %s already hold it\n", id[i], tier[i], mine, h1, h2
                            return 1
                        }
                        continue
                    }
                    if (say) printf "skip %s (tier %s): its %s meets %s\047s %s, taken above\n", id[i], tier[i], mine, id[taken[j]], theirs
                    return 1
                }
            # §430.7: a row taken into the write set of a skipped pinned row
            # would hold the pin back again once the lanes in its way land.
            for (j = 1; j <= pinheld_n; j++)
                if (sets_meet(ws[i], ws[pinheld[j]])) {
                    if (meet_shared) {
                        sharedcount++
                        if (sharedcount == 1) h1 = id[pinheld[j]] " (pinned and skipped above)"
                        else if (sharedcount == 2) {
                            h2 = id[pinheld[j]] " (pinned and skipped above)"
                            if (say) printf "skip %s (tier %s): its %s is shared, and %s and %s already hold it\n", id[i], tier[i], mine, h1, h2
                            return 1
                        }
                        continue
                    }
                    if (say) printf "skip %s (tier %s): its %s meets %s\047s %s, pinned and skipped above\n", id[i], tier[i], mine, id[pinheld[j]], theirs
                    return 1
                }
            return 0
        }
        function take_bundle(m,    y, ids, allsonnet) {
            ids = ""
            allsonnet = 1
            for (y = 1; y <= m; y++) {
                ids = ids (y > 1 ? "," : "") id[pick[y]]
                took[pick[y]] = 1; taken[++taken_n] = pick[y]
                if (model[pick[y]] != "sonnet") allsonnet = 0
            }
            if (allsonnet) sonnet_taken = 1
            printf "take %s (a bundle of %d small row%s, one lane)\n", ids, m, (m == 1 ? "" : "s")
            for (y = 1; y <= m; y++) print "    " raw[pick[y]]
            lanes_n++
        }
        function sets_meet(x, y,    ex, ey, nx, ny, i, j, shmine, shtheirs, sharedfound) {
            nx = split(x, ex, ","); ny = split(y, ey, ",")
            for (i = 1; i <= nx; i++)
                for (j = 1; j <= ny; j++)
                    if (entries_meet(ex[i], ey[j])) {
                        if (!shared_match) { mine = ex[i]; theirs = ey[j]; meet_shared = 0; return 1 }
                        if (!sharedfound) { sharedfound = 1; shmine = ex[i]; shtheirs = ey[j] }
                    }
            if (sharedfound) { mine = shmine; theirs = shtheirs; meet_shared = 1; return 1 }
            return 0
        }
        function entries_meet(x, y,    px, py, ix, iy, h, m) {
            shared_match = 0
            if (x == "-" || y == "-") return 0
            px = x; ix = ""; h = index(x, "#")
            if (h) { px = substr(x, 1, h - 1); ix = substr(x, h + 1) }
            py = y; iy = ""; h = index(y, "#")
            if (h) { py = substr(y, 1, h - 1); iy = substr(y, h + 1) }
            if (px == py) {
                m = !(ix != "" && iy != "" && ix != iy)
                if (m && (px in shared)) shared_match = 1
                return m
            }
            if (px ~ /\/$/ && index(py, px) == 1) return 1
            if (py ~ /\/$/ && index(px, py) == 1) return 1
            return 0
        }
    '

# Renders `docs/queue.md`'s history and current state as one page (Q254),
# writing to `{{ queue_page_dir }}` — `~/rcad-queue-page` unless
# `RCAD_QUEUE_PAGE_DIR` overrides it, which the two selftests below do so the
# gate never touches Mattias's real page. `queue` runs this after every verb
# that writes, and so does `ff-main`; run by hand, it just re-renders now.
#
# The logic is `tooling/queue-page/render.py`; this only hands it the
# directory to write and `{{ fuzz_log_root }}`, which the page's fuzzing
# section reads the overnight fuzz job's nights from. The renderer writes
# through a temporary file and a rename on its own — see `write_atomically`
# there — so this recipe does not repeat that. It also hands it this `just` and
# this justfile, for the `queue blocked` it runs in the tree holding main.
#
# The fuzzing section is only as fresh as the last render: the page re-renders
# on a queue write, `ff-main` or this recipe, not when a fuzz night ends.
[doc("Render docs/queue.md's history, current state and fuzz nights as one page, to RCAD_QUEUE_PAGE_DIR or ~/rcad-queue-page.")]
queue-page:
    @QUEUE_JUST='{{ just_executable() }}' QUEUE_JUSTFILE='{{ justfile() }}' \
        python3 '{{ justfile_directory() }}/tooling/queue-page/render.py' '{{ queue_page_dir }}' '{{ fuzz_log_root }}'

# Renders a scratch repository's `docs/queue.md` history into a scratch
# directory and checks both charts' counts, by commit, against a count taken
# by hand from the fixture's own rows — never from `render.py`'s own `tally()`,
# since a check that asks the code under test for its expected answer cannot
# fail (Q254).
#
# Three commits are enough to move every count `tally()` tracks at least once:
# an open row closing, a row parking, and a tier gaining and losing a row. The
# third also opens a row in tiers 2.2 and 5, and the render starts from a cache
# holding the third commit's tally as a five-tier renderer wrote it, as the real
# page's cache did when tiers 2.2 and 5 reached the page (§403.8). The
# renderer's `.history-cache.json` holds one tally per commit sha verbatim, so
# reading it back is reading the render's real output, not recomputing it.
#
# The first two commits share a day and the third skips one, so the Queue
# statistics table is checked against hand counts for a day that must take its
# last commit's shape, and for a day with no commit, which keeps the day
# before's shape and adds and closes nothing.
#
# The Running rows table reads a claims file written by hand, beside a lane's
# tree and a verifier's detached tree, locked the way the worktree hook locks
# them (§55). Its takes are one whose tier is not the row's tier now, as after a
# `tier` move; one that records no tier, so the row's tier in main's copy
# stands in; one for a row main's copy does not hold; one with neither; and one
# released, which must not show.
#
# A fourth commit, on a day of its own, adds the rows the table of rows the fill
# will not take reads (Q1510), each reason beside the rows it holds back (§444):
# one row waiting on a running row, a done one and an id that is no row, which
# names the first and last; one waiting on a dropped row, which is not done, so
# the row is not ready either; a second parked row; and four ready rows, two
# meeting the same `lane:` row in main's copy, so one reason holds both back,
# one meeting a row another dispatcher holds in the claims file, and one on a
# `queue_shared_files` path two `lane:` rows already hold, whose skip line
# `just queue blocked` words differently (§424.4); a fifth meets nothing and
# must not show. The table is checked against that hand count, and again with
# the copy in the tree holding main left different from main's commit, when its
# third group is not worked out.
#
# The same commit pins five rows in tier 1, out of line order, for the Pinned
# table (§430): one waiting on two rows not done, one meeting a `lane:` row in
# main's copy, one the claims file holds though main's copy says `todo`, one
# `lane:` in main's copy with no take behind it, and one nothing holds back.
# A closed row keeps its pin and must not show. With the third group not worked
# out, the ready pin that met a lane must say so, not "nothing". A fifth commit
# takes every pin off, and the table must then say nothing is pinned.
#
# The Queue section (§455) is checked tier by tier on the fourth commit: how
# many rows are ready and how many blocked under each model, then the rows, one
# line per run of neighbours that share both. Its rows are blocked by each
# reason the table above names, and the rows that run, by the claims file or by
# main's copy, must not show. Two blocked rows with two running rows between them
# share a line; a blocked sonnet row beside a blocked opus row starts its own;
# two blocked opus rows with a ready row between them get a line each. The
# claims file holds tier 2.2's and tier 5's first rows, so each of those tiers
# has a second row that is ready. With the third group not worked out, the rows
# it held back must show as ready, under a note that says so.
#
# Every row of main's copy gets a page (§444), checked for its tier, class,
# write set and text, for where it came from, and for the rows that came from
# it (§455), which must be the chain above each of them turned round: Q30
# hangs on Q5 only without the source its text names, so it is not below Q5,
# and the two rows that name each other stop. The fourth commit's subject
# names Q5's lane, so lineage hangs the rows it adds on Q5, and Q5 on Q3 and Q3
# on Q1, each closed by the commit that added the next; its rows also take a
# parent from their own word, from a crash file their text names (§433.6), and
# from a STEP file, and two name each other, which the page must stop on. The
# fifth commit files a row from one of those. Between renders a word is planted
# in the fourth commit's kept summary, so the page shows it only if the summary
# was served and not worked out again, and the fifth commit's row shows the
# planted word one step up; then the cache is marked with another shape, and
# the page must work every summary out again. The second render must also
# remove a page planted for a row main's copy does not hold, and leave a page
# that did not change unwritten.
#
# The Families section (§450.3) says there is none at the fourth commit, whose
# rows name no `tests/*.rs` file. The fifth commit adds three open rows on one
# test file, one by an item and one in tier 5, a parked fourth that is no
# member, and three on another file that a closed trace names, so only the
# first file is a family.
#
# The fuzzing section reads a fixture log root with one night of each kind the
# table tells apart: a finished night with its first artifacts (09-10), a build
# that failed (09-11), no directory at all (09-12), a triaged night with new
# finds, carried-over ones and a skipped log (09-13), and an unfinished newest
# night that `latest` does not name yet (09-14). Every expected cell is worked
# out by hand from the fixture logs. A second render then checks the fuzz
# cache both ways: a log left alone is served from it, a log that grew is read
# again.
[private]
[doc("queue-page's charts, tables, row pages and fuzzing section, checked against hand counts of a scratch repository and fixture fuzz nights.")]
check-queue-page-selftest:
    #!/usr/bin/env bash
    set -uo pipefail
    mkdir -p '{{ justfile_directory() }}/target'
    root=$(mktemp -d '{{ justfile_directory() }}/target/queue-page-selftest.XXXXXX')
    trap 'rm -rf "$root"' EXIT
    j='{{ just_executable() }}'
    hub="$root/rcad"
    out="$root/out"
    mkdir -p "$hub/docs"
    fail() {
        echo "check-queue-page-selftest: $1"
        exit 1
    }
    g() { git -C "$hub" -c user.name=selftest -c user.email=selftest@invalid "$@"; }
    g init -q -b main

    cat > "$hub/docs/queue.md" <<'MD'
    # Queue

    ## Tier 1

    ```
    Q1  1  todo  opus  docs/a.md  the first row §230
    Q2  1  todo  opus  docs/b.md  the second row §230
    ```

    ## Tier 2

    ```
    ```

    ## Tier 2.5

    ```
    ```

    ## Tier 3

    ```
    ```

    ## Tier 4

    ```
    ```

    ## Closed

