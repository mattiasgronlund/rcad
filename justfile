    swap() {
        S="$2" R="$3" awk '{ i = index($0, ENVIRON["S"]); if (i) $0 = substr($0, 1, i - 1) ENVIRON["R"] substr($0, i + length(ENVIRON["S"])); print }' "$1"
    }
