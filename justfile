    share_guard='if (LANES.length > 1 && args.shareOneRun !== true) throw new Error('
    share_message='one Workflow call per row'
    answers_flag='`--answers ${answers.join('
    answers_confirmed="    also_answers_confirmed: { type: 'array'"
    answers_lane='**A fix lane runs its family at the end** (§450.3 rule 4).'
    answers_prep='name the same file in their write sets'
    answers_verifier='## Also answers'
    answers_merger='gets a `done` step too, with the same'
    answers_asked='${alsoAnswersNote(r)}'
    answers_told='${answeredNote(lane, prior)}'
    settings=.claude/settings.json
    script=tooling/verify-lane/verify_lane.py
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    commit() {
        git -C "$1" add -A
        git -C "$1" -c user.name=check -c user.email=check@localhost -c commit.gpgsign=false commit -q --no-verify -m "$2"
    }
    fixture="$dir/fixture"
    mkdir -p "$fixture/crates/k/src" "$fixture/crates/k/tests" "$fixture/fuzz/corpus/t" "$fixture/docs"
    git -C "$fixture" init -q
    printf '%s\n' '//! A crate.' '' '/// Adds one.' 'pub fn one(x: u32) -> u32 {' '    x + 1' '}' '' \
        'mod inner {' '    pub fn two() -> u32 {' '        2' '    }' '}' '' \
        '#[cfg(test)]' 'mod tests {' '    #[test]' '    fn one_adds_one() {' '        assert_eq!(super::one(1), 2);' '    }' '}' \
        > "$fixture/crates/k/src/lib.rs"
    printf '%s\n' 'pub fn old() {}' > "$fixture/crates/k/src/old.rs"
    printf '%s\n' '#[test]' 'fn pinned() {}' > "$fixture/crates/k/tests/pins.rs"
    printf '%s\n' 'seed' > "$fixture/fuzz/corpus/t/seed_old"
    printf '%s\n' '# Notes.' > "$fixture/docs/a.md"
    printf '%s\n' '# Builds.' 'build:' '    cargo build' '' '# Checks.' 'check-things:' '    #!/usr/bin/env bash' '    echo "fine"' \
        > "$fixture/justfile"
    commit "$fixture" base
    printf '%s\n' '//! A crate that adds.' '' '/// Adds one to x.' 'pub fn one(x: u32) -> u32 {' '    x + 1' '}' '' \
        'mod inner {' '    pub fn two() -> u32 {' '        3' '    }' '}' '' \
        '#[cfg(test)]' 'mod tests {' '    #[test]' '    fn one_adds_one() {' '        assert_eq!(super::one(1), 2);' '    }' '' \
        '    #[test]' '    fn one_adds_one_to_two() {' '        assert_eq!(super::one(2), 3);' '    }' '}' '' \
        'pub fn three() -> u32 {' '    3' '}' \
        > "$fixture/crates/k/src/lib.rs"
    git -C "$fixture" mv crates/k/src/old.rs crates/k/src/moved.rs
    git -C "$fixture" mv fuzz/corpus/t/seed_old fuzz/corpus/t/seed_new
    printf '%s\n' '#[test]' 'fn pinned() {' '    assert!(true);' '}' > "$fixture/crates/k/tests/pins.rs"
    printf '%s\n' '# Notes, and more.' > "$fixture/docs/a.md"
    printf '%s\n' '# Builds it all.' 'build:' '    #!/usr/bin/env bash' '    cargo build' '' '# Checks.' 'check-things:' \
        '    #!/usr/bin/env bash' '    echo "all fine"' '    test -f justfile' \
        > "$fixture/justfile"
    commit "$fixture" branch
    many="$dir/many"
    mkdir -p "$many/crates/k/src"
    git -C "$many" init -q
    printf '%s\n' '//! A crate.' > "$many/crates/k/src/lib.rs"
    commit "$many" base
    seq -f 'pub fn f%g() {}' 1 15 >> "$many/crates/k/src/lib.rs"
    commit "$many" branch
    scan() {
        local n t at prev line types prog got failed
        n=$(grep -cxF -- "$create" "$1" || true)
        if [ "$n" != 1 ]; then
            echo "$1 has the line '$create' $n times, expected once"
            return 1
        fi
        if grep -nE 'checkout -B|switch -C' "$1" | grep -vF 'Never reach for'; then
            echo "$1 resets a branch on the lines above; a lane must create its own (§237)"
            return 2
        fi
        if ! grep -qF -- "$refusal" "$1"; then
            echo "$1 does not tell a lane what to do when the switch refuses,"
            echo "and without that the nearest fix a lane knows is the reset"
            return 3
        fi
        n=$(grep -vE '^[[:space:]]*//' "$1" | grep -cE '(^|[^A-Za-z_])agent\(' || true)
        types=$(grep -oE "agentType: '[a-z-]+'" "$1" | cut -d"'" -f2 || true)
        if [ "$n" != "$(printf '%s' "$types" | grep -c '' || true)" ]; then
            echo "$1 starts $n agents and names a type for $(printf '%s' "$types" | grep -c '' || true);"
            echo "an agent with no type never loads its file in $2 (§261.6)"
            return 4
        fi
        for t in lane verifier merger lander; do
            if ! grep -qxF -- "$t" <<<"$types"; then
                echo "$1 sends no agent of type $t"
                return 4
            fi
        done
        for t in $types; do
            if ! grep -qxF -- "name: $t" "$2/$t.md" 2>/dev/null; then
                echo "$1 names the agent type $t, and no $2/$t.md defines it"
                return 4
            fi
        done
        n=$(grep -cF -- 'agent(MERGE(' "$1" || true)
        at=$(grep -cF -- 'agent(LAND(' "$1" || true)
        if [ "$n" != 1 ] || [ "$at" != 1 ] \
            || ! grep -A1 -F -- "$serial" "$1" | grep -qF -- 'lastMerge = run.catch('; then
            echo "$1 does not start its one merger and its one lander behind the merge before it:"
            echo "expected one 'agent(MERGE(', one 'agent(LAND(', and '$serial' with 'lastMerge = run.catch(' on the next line (§266.4)"
            return 5
        fi
        prev=0
        for line in "${pushes[@]}"; do
            n=$(grep -cxF -- "$line" "$2/merger.md" || true)
            if [ "$n" != 1 ]; then
                echo "$2/merger.md has the line '$line' $n times, expected once"
                return 6
            fi
            at=$(grep -nxF -- "$line" "$2/merger.md" | cut -d: -f1)
            if [ "$at" -le "$prev" ]; then
                echo "$2/merger.md has '$line' before a line it must follow: fetch, ancestor check, push, ff-main"
                return 6
            fi
            prev=$at
        done
        if grep -nF 'git push' "$1" "$2/lane.md" "$2/verifier.md" "$2/lander.md"; then
            echo "only the merger and just land push, and the lines above tell another role to (§266)"
            return 6
        fi
        if ! grep -qF -- "$shared_prefix" "$3" || ! grep -qF -- "$shared_guard" "$3"; then
            echo "$3 does not carry the mise exec -- rule and the Bash guard rule for every role (§266)"
            return 7
        fi
        if grep -qF -- "$shared_guard" "$1"; then
            echo "$1 carries a second copy of the shared shell rule; it belongs only in $3 (§266)"
            return 7
        fi
        n=$(grep -cF -- "$rev_parse" "$1" || true)
        if [ "$n" -lt 2 ]; then
            echo "$1 does not tell the verifier, in both its prompt and its schema, to find its own tree with '$rev_parse'; naming only the lane's tree is what made a verifier echo that path back as its own (§263.4)"
            return 8
        fi
        if ! grep -qF -- "$rev_parse" "$2/verifier.md"; then
            echo "$2/verifier.md does not tell the verifier to find its own tree with '$rev_parse'"
            return 8
        fi
        n=$(grep -cF -- "$mutation" "$1" || true)
        if [ "$n" -lt 3 ]; then
            echo "$1 does not give the verdict a way to report a '$mutation' that stands in for the revert, named in the readiness check, VERIFY's prompt and verdictSchema alike ('grep -c $mutation $1' shows $n, want at least 3; §266)"
            return 9
        fi
        if ! grep -qF -- "$pins_line" "$1"; then
            echo "$1 does not gate a pins-only merge on there being nothing to revert (\"$pins_line\"); without that exact line an empty sourcePaths on its own would read as pins-only, which §287 refuses to infer"
            return 10
        fi
        if ! grep -qF -- "$pins_refusal" "$1"; then
            echo "$1 no longer refuses a lane with no declared source and no pinsOnly flag; the field would then not be the only way past the check (§287)"
            return 10
        fi
        if ! grep -qF -- "$pins_conflict" "$1"; then
            echo "$1 no longer refuses a pinsOnly lane that also declares a source to revert; there is something to revert then, and it must stay refused (§287)"
            return 10
        fi
        if ! grep -qF -- "$pins_verify" "$1"; then
            echo "$1 does not tell the verifier's own prompt that this lane is pinsOnly, so a verifier would still be asked for a revert that has nothing to revert (§287)"
            return 10
        fi
        for t in lane verifier merger lander; do
            if ! grep -qF -- "$foreground_rule" "$2/$t.md"; then
                echo "$2/$t.md does not say every command stays in the foreground; a backgrounded gate or test run reports back before it finishes and nothing wakes this role for the result (Q216)"
                return 11
            fi
            if grep -nF -- 'run_in_background: true' "$2/$t.md"; then
                echo "$2/$t.md tells this role to background a command on the lines above, against its own foreground rule (Q216)"
                return 11
            fi
        done
        if ! grep -qxF -- "$prune_guard" "$1"; then
            echo "$1 does not start the pruner only behind a merge; a run that did not land is the dispatcher's to judge (§315.2)"
            return 12
        fi
        if ! grep -qxF -- "$prune_command" "$1" || ! grep -qF -- "$prune_allowed" "$settings"; then
            echo "$1 does not send the pruner the exact command $settings allows, so it would stop to ask with nobody there to answer (§315.2)"
            return 12
        fi
        if ! grep -qF -- "$mark_line" "$1"; then
            echo "$1 does not tell the merger to mark its run's trees finished, so prune-worktrees keeps them for an hour (§315.2)"
            return 12
        fi
        n=$(grep -cxF -- "$verified_def" "$1" || true)
        if [ "$n" != 2 ]; then
            echo "$1 does not define 'verified' as the verifier having said merge or fix_first, once in merged() and once in handedBack() (want 2, found $n); a row the verifier called ready that still did not merge would then have no way to say so in its own line (§304.4)"
            return 13
        fi
        n=$(grep -cF -- "$verified_use" "$1" || true)
        if [ "$n" != 3 ]; then
            echo "$1 does not read that 'verified' flag in all three of a row's own returned lines -- merger-returned-nothing, merger-declined, handed-back (want 3, found $n); a row the verifier called merge or fix_first would still read plain 'not merged', with nothing marking it as verified, not merged (§304.4)"
            return 13
        fi
        n=$(grep -cxF -- "$docs_diff" "$2/merger.md" || true)
        if [ "$n" != 1 ]; then
            echo "$2/merger.md has the line '$docs_diff' $n times, expected once; without it a merger cannot tell a catch-up over docs alone from one over code (§367)"
            return 14
        fi
        if ! grep -qE -- "$docs_constant" "$1" || ! grep -qxF -- "$docs_brief" "$1"; then
            echo "$1 does not define DOCS_CATCH_UPS and hand it to the merger in the brief line '$docs_brief', so nothing bounds a merger's catch-ups over docs alone (§367)"
            return 14
        fi
        if ! grep -qF -- "$docs_field" "$1" || ! grep -qF -- "$docs_required" "$1"; then
            echo "$1 does not make docs_catch_ups a property the merger's schema requires, so a merger need not say how many catch-ups over docs alone it used (§367)"
            return 14
        fi
        n=$(grep -cF -- "$pass_rule" "$1" || true)
        if [ "$n" -lt 2 ]; then
            echo "$1 does not tell the verifier, in both VERIFY's prompt and the pinsOnly note, that step 3's gate already proves the tests pass; without that a verifier runs the named tests a second time for no new information (§370)"
            return 15
        fi
        if ! grep -qF -- "$pass_rule" "$2/verifier.md"; then
            echo "$2/verifier.md does not carry the same rule, that step 3's gate already proves the tests pass (§370)"
            return 15
        fi
        if ! grep -qxF -- "$runs_command" "$1" || ! grep -qxF -- "$runs_handed" "$1"; then
            echo "$1 does not hand the verifier the lines-that-run command, the recipe run on the base and the branch; without it there is no count of 0 to waive the revert on (§375, §382)"
            return 16
        fi
        if ! grep -qxF -- "$runs_diff" "$4"; then
            echo "$4's lines-that-run recipe does not read the whole-file diff of the two commits it is given with every flag spelled out ('$runs_diff'); with less context it cannot see the #[cfg(test)] or recipe header above a changed line (§375)"
            return 16
        fi
        if ! grep -qxF -- "$runs_count" "$1"; then
            echo "$1 does not read the count off the last line of the lines-that-run print ('$runs_count'); a looser reading would take a count the recipe did not print (§382)"
            return 16
        fi
        if ! grep -qF -- "$runs_waive" "$1"; then
            echo "$1 does not waive the revert on a lines-that-run count of 0 alone ('$runs_waive'); a lane that changes what runs would then merge on a test that never failed (§375)"
            return 16
        fi
        for t in "$runs_refusal" "$runs_unreported" "$runs_other"; do
            if ! grep -qF -- "$t" "$1"; then
                echo "$1 no longer refuses with '$t'; a lane would then merge on a print that is not empty, missing, or from another command (§375)"
                return 16
            fi
        done
        if ! grep -qF -- "$runs_required" "$1"; then
            echo "$1 does not make the verdict schema require lines_that_run_command and lines_that_run, so a verifier need not report the print at all (§375)"
            return 16
        fi
        if ! grep -qF -- "$runs_rule" "$2/verifier.md" || grep -qF -- "$old_md_rule" "$2/verifier.md"; then
            echo "$2/verifier.md does not carry the moved-text rule on the lines-that-run print in place of the old 'any file not ending in .md' bar (§375)"
            return 16
        fi
        line=$(grep -E -- "$runs_awk" "$4" || true)
        prog=${line#*"| awk '"}
        prog=${prog%"'"}
        got=$(git -C "$fixture" diff --no-color --no-ext-diff -M --src-prefix=a/ --dst-prefix=b/ -U1000000 HEAD~1 HEAD | awk "$prog" 2>&1 || true)
        if [ "$got" != "$runs_want" ]; then
            echo "the lines-that-run recipe in $4 printed, on the fixture repo:"
            printf '%s\n' "$got"
            echo "and should have printed exactly:"
            printf '%s\n' "$runs_want"
            echo "a line it skips that runs lets a behaviour change merge with no failing test (§375)"
            return 16
        fi
        got=$(git -C "$fixture" diff --no-color --no-ext-diff -M --src-prefix=a/ --dst-prefix=b/ -U1000000 HEAD HEAD | awk "$prog" 2>&1 || true)
        if [ "$got" != "$runs_empty" ]; then
            echo "the lines-that-run recipe in $4 printed '$got' for an empty diff, not '$runs_empty'; a git diff that failed would read as nothing that runs changed (§375)"
            return 16
        fi
        got=$(git -C "$many" diff --no-color --no-ext-diff -M --src-prefix=a/ --dst-prefix=b/ -U1000000 HEAD~1 HEAD | awk "$prog" 2>&1 || true)
        if [ "$got" != "$many_want" ]; then
            echo "the lines-that-run recipe in $4 printed, on a commit that adds fifteen functions:"
            printf '%s\n' "$got"
            echo "and should have printed the first ten, then 'lines that run: 15'; a verifier copies the whole print into its report (§382)"
            return 17
        fi
        if ! grep -qF -- "$notes_bound" "$1" || ! grep -qF -- "$notes_rule" "$2/verifier.md"; then
            echo "$1's verdict schema or $2/verifier.md no longer holds a verifier's notes to five lines; unbounded, they were about a third of its report (§382)"
            return 17
        fi
        if ! grep -qxF -- "$land_only" "$1" || ! grep -qxF -- "$land_first" "$1"; then
