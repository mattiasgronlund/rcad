    chain() { grep '^<dt>Came from</dt>' "$out/rows/$1.html" | grep -oE '<li><code>(<a href="[TDQ][0-9]+\.html">)?[TDQ][0-9]+<' | grep -oE '[TDQ][0-9]+<$' | tr -d '<' | tr '\n' ' '; }
