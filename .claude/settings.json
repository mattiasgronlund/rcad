{
  "env": {
    "CLAUDE_CODE_THRIFTY_SONIC": "false"
  },
  "extraKnownMarketplaces": {
    "mattiasgronlund-local": {
      "source": {
        "source": "github",
        "repo": "mattiasgronlund/claude-questions",
        "ref": "v0.3.9"
      }
    }
  },
  "enabledPlugins": {
    "questions@mattiasgronlund-local": true,
    "guardrails@mattiasgronlund-local": true,
    "practices@mattiasgronlund-local": true
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\"",
    "refreshInterval": 5
  },
  "permissions": {
    "allow": [
      "EnterWorktree",
      "ExitWorktree",
      "Bash(git worktree lock:*)",
      "Bash(git worktree unlock:*)",
      "Bash(mise exec -- just prune-worktrees)",
      "Bash(mise exec -- just clean-targets)",
      "Bash(mise exec -- just release-lanes:*)",
      "Bash(mise exec -- just land:*)"
    ],
    "deny": [
      "Artifact",
      "ArtifactComments",
      "ArtifactData"
    ]
  },
  "deniedMcpServers": [
    { "serverUrl": "https://api.anthropic.com/v1/pages/mcp" }
  ],
  "skillOverrides": {
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:xlsx": "off",
    "claude-in-chrome": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off",
    "dataviz": "name-only",
    "claude-api": "name-only",
    "workflow-authoring": "name-only",
    "update-config": "name-only",
    "schedule": "name-only",
    "keybindings-help": "name-only",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "security-review": "user-invocable-only",
    "loop": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "run": "user-invocable-only"
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-hub.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-guardrails.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-create.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/queue-write-guard.sh\"",          "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/decisions-zero.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
