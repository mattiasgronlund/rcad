{
  "env": {
    "CLAUDE_CODE_THRIFTY_SONIC": "false"
  },
  "extraKnownMarketplaces": {
    "mattiasgronlund-local": {
      "source": {
        "source": "github",
        "repo": "mattiasgronlund/claude-questions",
        "ref": "v0.3.9"
      }
    }
  },
  "enabledPlugins": {
    "questions@mattiasgronlund-local": true,
    "guardrails@mattiasgronlund-local": true,
    "practices@mattiasgronlund-local": true
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\"",
    "refreshInterval": 5
  },
  "permissions": {
    "allow": [
      "EnterWorktree",
      "ExitWorktree",
      "Bash(git worktree lock:*)",
      "Bash(git worktree unlock:*)",
      "Bash(mise exec -- just prune-worktrees)",
      "Bash(mise exec -- just clean-targets)",
      "Bash(mise exec -- just release-lanes:*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-hub.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-guardrails.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-create.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/queue-write-guard.sh\"",          "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/decisions-zero.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
