[Unit]
Description=rcad overnight fuzzing (docs/decisions.md §81)

[Service]
Type=oneshot

# `%h` is the user's home directory, so the pair of files is the same on any
# machine that lays its worktrees out the way this one does. The tree is not
# `main`'s worktree and not the hub: `fuzz-overnight` refuses the hub outright,
# and this one is locked with the reason `overnight fuzzing` so that a by-hand
# lock sweep can see it belongs to a machine (§81.4).
WorkingDirectory=%h/git/mattiasgronlund/rcad-nightly-fuzz

# The night calls `cargo` by name, and systemd has no profile to find one in.
# `cargo` here is rustup's shim in `~/.cargo/bin`; the only files on this machine
# that add that directory are `~/.bashrc` and `~/.profile`, and systemd --user
# reads neither. mise supplies `just`, `cargo-fuzz` and `kache` — it pins no
# rust, so it does not supply `cargo`.
#
# Five nights ran anyway, on a PATH the user manager had inherited from a login
# session. The reboot of 2026-09-15 took that away, and the night wrote one line
# — `cargo: command not found` — and fuzzed nothing for eight hours. Inherited is
# not set, and this line is the difference.
#
# The ordinary entries are spelled out because `Environment=PATH=` replaces the
# whole variable rather than adding to the front of it.
Environment=PATH=%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin

# mise by absolute path, for the same reason one line up: `just`, `cargo-fuzz`
# and the RUSTC_WRAPPER=kache that mise.toml sets are all absent from a systemd
# environment, and cargo fails outright on a wrapper it cannot find.
ExecStart=%h/.local/bin/mise exec -- just fuzz-overnight 28800

# The outer backstop. `fuzz-overnight` divides its own window against the clock
# and stops at 08:10 on its own; this is what makes 08:10 true when it does not.
# Ten minutes of grace, then SIGTERM, then SIGKILL.
#
# `TimeoutStartSec=` and not `RuntimeMaxSec=`, which is the one thing here that
# was wrong and silent: with `Type=oneshot` the whole run counts as *starting*,
# so `RuntimeMaxSec=` is ignored — `systemd-analyze --user verify` says so, and
# nothing at 08:10 would have. For a oneshot this is the knob that bounds
# `ExecStart`, and its default is infinity.
TimeoutStartSec=29400
TimeoutStopSec=120

# Lanes compile at night too. One target at a time is one core of 24, but it is
# a core somebody else may want more.
Nice=10
IOSchedulingClass=idle
